macro Move(a, b) {
	local tmp = b;
	setE(tmp);
	$(PSW_N) = (tmp s< 0);
	$(PSW_Z) = (tmp == 0);
	a = tmp;
}

# MOV Rwn, Rwm
:mov rwn, rwm is ExtCountDec & op=0xF0 & rwn & rwm {
	Move(rwn, rwm);
}

# MOV Rwn, #data4
:mov rwm, "#"^data4 is ExtCountDec & op=0xE0 & rwm & data4 {
	Move(rwm, zext(data4:1));
}

# MOV reg, #data16
:mov ShortMemAddrW, DataImmW is ExtCountDec & op=0xE6 & ShortMemAddrW; DataImmW {
	Move(ShortMemAddrW, DataImmW);
}

# MOV Rwn, [Rwm] where Rwn==Rwm - Switch table load pattern (same register for dest and ptr)
# Uses c166_switch_load pcodeop - injector checks if followed by jmpi and emits segment() if so
:mov rwn, [rwm] is ExtCountDec & op=0xA8 & rwn & rwm & RWnRWmEqual {
	local val:2 = c166_switch_load(rwn);
	rwn = val;
}

# MOV Rwn, [Rwm]
:mov rwn, RwmIndW is op=0xA8 & rwn & RwmIndW & ExtCountDec {
	Move(rwn, RwmIndW);
}

# MOV Rwn, [Rwm+]
:mov rwn, RwmIndWP is op=0x98 & rwn & RwmIndWP & ExtCountDec {
	Move(rwn, RwmIndWP);
}

# MOV [Rwm], Rwn
:mov RwmIndW, rwn is op=0xB8 & rwn & RwmIndW & ExtCountDec {
	Move(RwmIndW, rwn);
}

# MOV [-Rwm], Rwn
:mov RwmIndWM, rwn is op=0x88 & rwn & RwmIndWM & ExtCountDec {
	Move(RwmIndWM, rwn);
}

# MOV [Rwn], [Rwm]
:mov RwnIndW, RwmIndW is op=0xC8 & RwnIndW & RwmIndW & ExtCountDec {
	Move(RwnIndW, RwmIndW);
}

# MOV [Rwn+], [Rwm]
:mov RwnIndWP, RwmIndW is op=0xD8 & RwnIndWP & RwmIndW & ExtCountDec {
	Move(RwnIndWP, RwmIndW);
}

# MOV [Rwn], [Rwm+]
:mov RwnIndW, RwmIndWP is op=0xE8 & RwnIndW & RwmIndWP & ExtCountDec {
	Move(RwnIndW, RwmIndWP);
}

