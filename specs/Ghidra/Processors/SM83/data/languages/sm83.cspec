<compiler_spec>
  <data_organization>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="1"/>
    <pointer_size value="2"/>
    <integer_size value="2"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="BC"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="DE"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="BC"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="DE"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
      <killedbycall>
        <register name="F"/>
      </killedbycall>
    </prototype>
  </default_proto>
  <prototype name="__asm_a" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <prototype name="__asm_hl" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <!-- status returned in flags, e.g. carry -->
  <prototype name="__asm_f" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="1"><register name="F"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
  </prototype>
  <prototype name="__asm_void" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <!-- callee preserves BC, DE and HL -->
  <prototype name="__asm_saved" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="HL"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="BC"/>
      <register name="DE"/>
      <register name="HL"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <!-- interrupt handler: no arguments, every register preserved -->
  <prototype name="__interrupt" extrapop="2" stackshift="2" strategy="register">
    <input>
    </input>
    <output>
    </output>
    <unaffected>
      <register name="AF"/>
      <register name="BC"/>
      <register name="DE"/>
      <register name="HL"/>
      <register name="SP"/>
    </unaffected>
  </prototype>
  <!-- SDCC (GBDK-2020) default calling convention, version 1 (sdcccall 1): first parameter in A (8 bits), DE (16)
       or DEBC (32); the second in E (after A), BC (16 bits after A or DE) or A (after BC/DEBC); the rest on the stack,
       popped by the callee (extrapop 2 assumes no stack parameters: with unknown, callers lose track of SP and
       decompile with the return addresses on the stack; a function that pops parameters needs its purge set).
       8-bit results in A, 16-bit in BC, 32-bit in DEBC -->
  <prototype name="__sdcccall1" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="1" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      <pentry minsize="2" maxsize="2"><register name="BC"/></pentry>
      <pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <!-- SDCC sdcccall 0: every parameter on the stack (caller pops); 8-bit results in E, 16-bit in DE, 32-bit in HLDE -->
  <prototype name="__sdcccall0" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="1"><register name="E"/></pentry>
      <pentry minsize="2" maxsize="2"><register name="DE"/></pentry>
      <pentry minsize="4" maxsize="4"><addr space="join" piece1="HL" piece2="DE"/></pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
    <killedbycall>
      <register name="F"/>
    </killedbycall>
  </prototype>
  <!-- inline jump table dispatcher: word table after the call, indexed by A -->
  <callfixup name="sm83_inline_jump_table">
    <pcode dynamic="true">
    </pcode>
  </callfixup>
  <callotherfixup targetop="bank_ram">
    <pcode dynamic="true">
      <input name="value"/>
    </pcode>
  </callotherfixup>
</compiler_spec>
