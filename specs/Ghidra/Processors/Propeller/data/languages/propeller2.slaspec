:^CS^"setnib" DR, SV, "#"^nsel is CS & fb22=0 & fb23=0 & fb24=0 & fb25=0 & fb26=0 & fb27=1 & DR & SV & RT [ nsel = (fb21 << 2) | (fb20 << 1) | (fb19 << 0); ] { build CS; local vd:4 = DR; local vs:4 = SV; local sh:4 = nsel * 4; res = (vd & ~(0xf << sh)) | ((vs & 0xf) << sh); DR = res; build RT; }
