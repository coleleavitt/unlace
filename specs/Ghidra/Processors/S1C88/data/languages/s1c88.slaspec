:ADC "A", MHL is dmode=1 & umode=0 & o0=0x0B; MHL {  a:1 = A; b:1 = *:1 MHL; r:1 = 0; bcdAdd(a, b, C, r); A = r; }
:ADC "A", MHL is umode=1 & o0=0x0B; MHL {  a:1 = A; b:1 = *:1 MHL; r:1 = 0; unpAdd(a, b, C, r, D); A = r; }
