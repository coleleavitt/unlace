# RISC-V bit manipulation: Zba, Zbb, Zbc and Zbs (Bitmanip 1.0.0), Zbkb and Zbkx
# (Scalar Crypto 1.0.1) and Zicond (1.0). Instructions common to RV32 and RV64;
# the RV64-only word forms are in riscv.rv64b.sinc. Encodings checked against
# LLVM's RISC-V assembler and disassembler.

@if ADDRSIZE == "32"
@define XLENBITS "32"
@define XLENMASK "0x1f"
@else
@define XLENBITS "64"
@define XLENMASK "0x3f"
@endif

define pcodeop clmul;
define pcodeop clmulh;
define pcodeop clmulr;
define pcodeop orc_b;
define pcodeop brev8;
define pcodeop xperm4;
define pcodeop xperm8;

# Zba

:sh1add rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x2 & funct7=0x10
{
	rd = rs2 + (rs1 << 1);
}

:sh2add rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x4 & funct7=0x10
{
	rd = rs2 + (rs1 << 2);
}

:sh3add rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x6 & funct7=0x10
{
	rd = rs2 + (rs1 << 3);
}

# Zbb

:andn rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x7 & funct7=0x20
{
	rd = rs1 & ~rs2;
}

:orn rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x6 & funct7=0x20
{
	rd = rs1 | ~rs2;
}

:xnor rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x4 & funct7=0x20
{
	rd = ~(rs1 ^ rs2);
}

:clz rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x600
{
	rd = lzcount(rs1);
}

:ctz rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x601
{
	local x:$(XLEN) = rs1;
	local below:$(XLEN) = (x & -x) - 1;
	rd = popcount(below);
}

:cpop rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x602
{
	rd = popcount(rs1);
}

:max rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x6 & funct7=0x05
{
	local a:$(XLEN) = rs1;
	local b:$(XLEN) = rs2;
	rd = a;
	if (a s>= b) goto inst_next;
	rd = b;
}

:maxu rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x7 & funct7=0x05
{
	local a:$(XLEN) = rs1;
	local b:$(XLEN) = rs2;
	rd = a;
	if (a >= b) goto inst_next;
	rd = b;
}

:min rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x4 & funct7=0x05
{
	local a:$(XLEN) = rs1;
	local b:$(XLEN) = rs2;
	rd = a;
	if (a s<= b) goto inst_next;
	rd = b;
}

:minu rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x5 & funct7=0x05
{
	local a:$(XLEN) = rs1;
	local b:$(XLEN) = rs2;
	rd = a;
	if (a <= b) goto inst_next;
	rd = b;
}

:sext.b rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x604
{
	rd = sext(rs1:1);
}

:sext.h rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x605
{
	rd = sext(rs1:2);
}

:rol rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x1 & funct7=0x30
{
	local x:$(XLEN) = rs1;
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = (x << sh) | (x >> ($(XLENBITS) - sh));
}

:ror rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x5 & funct7=0x30
{
	local x:$(XLEN) = rs1;
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = (x >> sh) | (x << ($(XLENBITS) - sh));
}

:rori rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x13 & funct3=0x5 & op2631=0x18
{
	local x:$(XLEN) = rs1;
	rd = (x >> shamt6) | (x << ($(XLENBITS) - shamt6));
}

:orc.b rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x5 & op2031=0x287
{
	rd = orc_b(rs1);
}

@if ADDRSIZE == "32"
:rev8 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x5 & op2031=0x698
{
	local x:4 = rs1;
	rd = (x << 24) | ((x & 0xff00) << 8) | ((x >> 8) & 0xff00) | (x >> 24);
}

:zext.h rd,rs1 is rs1 & rd & op0006=0x33 & funct3=0x4 & funct7=0x04 & op2024=0
{
	rd = zext(rs1:2);
}
@endif

# Zbc (clmul and clmulh are also Zbkc)

:clmul rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x1 & funct7=0x05
{
	rd = clmul(rs1, rs2);
}

:clmulh rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x3 & funct7=0x05
{
	rd = clmulh(rs1, rs2);
}

:clmulr rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x2 & funct7=0x05
{
	rd = clmulr(rs1, rs2);
}

# Zbs

:bclr rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x1 & funct7=0x24
{
	local one:$(XLEN) = 1;
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = rs1 & ~(one << sh);
}

:bclri rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x13 & funct3=0x1 & op2631=0x12
{
	local one:$(XLEN) = 1;
	rd = rs1 & ~(one << shamt6);
}

:bext rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x5 & funct7=0x24
{
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = (rs1 >> sh) & 1;
}

:bexti rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x13 & funct3=0x5 & op2631=0x12
{
	rd = (rs1 >> shamt6) & 1;
}

:binv rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x1 & funct7=0x34
{
	local one:$(XLEN) = 1;
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = rs1 ^ (one << sh);
}

:binvi rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x13 & funct3=0x1 & op2631=0x1a
{
	local one:$(XLEN) = 1;
	rd = rs1 ^ (one << shamt6);
}

:bset rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x1 & funct7=0x14
{
	local one:$(XLEN) = 1;
	local sh:$(XLEN) = rs2 & $(XLENMASK);
	rd = rs1 | (one << sh);
}

:bseti rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x13 & funct3=0x1 & op2631=0x0a
{
	local one:$(XLEN) = 1;
	rd = rs1 | (one << shamt6);
}

# Zbkb

:pack rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x4 & funct7=0x04
{
@if ADDRSIZE == "32"
	rd = (zext(rs2:2) << 16) | zext(rs1:2);
@else
	rd = (zext(rs2:4) << 32) | zext(rs1:4);
@endif
}

:packh rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x7 & funct7=0x04
{
	rd = (zext(rs2:1) << 8) | zext(rs1:1);
}

:brev8 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x5 & op2031=0x687
{
	rd = brev8(rs1);
}

@if ADDRSIZE == "32"
define pcodeop zip;
define pcodeop unzip;

:zip rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x08f
{
	rd = zip(rs1);
}

:unzip rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x5 & op2031=0x08f
{
	rd = unzip(rs1);
}
@endif

# Zbkx

:xperm4 rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x2 & funct7=0x14
{
	rd = xperm4(rs1, rs2);
}

:xperm8 rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x4 & funct7=0x14
{
	rd = xperm8(rs1, rs2);
}

# Zicond

:czero.eqz rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x5 & funct7=0x07
{
	local v:$(XLEN) = rs1;
	local c:$(XLEN) = rs2;
	rd = 0;
	if (c == 0) goto inst_next;
	rd = v;
}

:czero.nez rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x7 & funct7=0x07
{
	local v:$(XLEN) = rs1;
	local c:$(XLEN) = rs2;
	rd = 0;
	if (c != 0) goto inst_next;
	rd = v;
}
