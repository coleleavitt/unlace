mvdst: "RETE" is rm_gd=7 & rm_dst=6 { RETE = MVTMP; }
mvdst: "EMUDAT" is rm_gd=7 & rm_dst=7 { EMUDAT = MVTMP; }

ins16: mvdst^" = "^mvsrc is op4=0x3 & mvdst & mvsrc { MVTMP = mvsrc; build mvdst; }

# ---------------------------------------------------------------- ALU2op
ins16: dA^" >>>= "^dB is op6=0x10 & a2_opc=0 & dA & dB { dA = dA s>> dB; logflags(dA); }
ins16: dA^" >>= "^dB is op6=0x10 & a2_opc=1 & dA & dB { dA = dA >> dB; logflags(dA); }
ins16: dA^" <<= "^dB is op6=0x10 & a2_opc=2 & dA & dB { dA = dA << dB; logflags(dA); }
ins16: dA^" *= "^dB is op6=0x10 & a2_opc=3 & dA & dB { dA = dA * dB; }
ins16: dA^" = ("^dA2^" + "^dB^") << 0x1" is op6=0x10 & a2_opc=4 & dA & dA2 & dB { local s:4 = dA + dB; addflags(dA, dB, s); dA = s << 1; }
ins16: dA^" = ("^dA2^" + "^dB^") << 0x2" is op6=0x10 & a2_opc=5 & dA & dA2 & dB { local s:4 = dA + dB; addflags(dA, dB, s); dA = s << 2; }
ins16: "DIVQ ("^dA^", "^dB^")" is op6=0x10 & a2_opc=8 & dA & dB { dA = divq(dA, dB, AQ); AQ = (dA & 0x1) == 0; }
ins16: "DIVS ("^dA^", "^dB^")" is op6=0x10 & a2_opc=9 & dA & dB { AQ = (dA s< 0) != (dB s< 0); dA = divs(dA, dB); }
ins16: dA^" = "^dBL^" (X)" is op6=0x10 & a2_opc=10 & dA & dBL { dA = sext(dBL); nzflags(dA); }
ins16: dA^" = "^dBL^" (Z)" is op6=0x10 & a2_opc=11 & dA & dBL { dA = zext(dBL); nzflags(dA); }
ins16: dA^" = "^dBB^" (X)" is op6=0x10 & a2_opc=12 & dA & dBB { dA = sext(dBB); nzflags(dA); }
ins16: dA^" = "^dBB^" (Z)" is op6=0x10 & a2_opc=13 & dA & dBB { dA = zext(dBB); nzflags(dA); }
ins16: dA^" = -"^dB is op6=0x10 & a2_opc=14 & dA & dB { local z:4 = 0; local s:4 = dB; dA = -s; subflags(z, s, dA); }
ins16: dA^" = ~"^dB is op6=0x10 & a2_opc=15 & dA & dB { dA = ~dB; logflags(dA); }

# ---------------------------------------------------------------- PTR2op
ins16: pA^" -= "^pB is op7=0x22 & p2_opc=0 & pA & pB { pA = pA - pB; }
ins16: pA^" = "^pB^" << 0x2" is op7=0x22 & p2_opc=1 & pA & pB { pA = pB << 2; }
ins16: pA^" = "^pB^" >> 0x2" is op7=0x22 & p2_opc=3 & pA & pB { pA = pB >> 2; }
ins16: pA^" = "^pB^" >> 0x1" is op7=0x22 & p2_opc=4 & pA & pB { pA = pB >> 1; }
ins16: pA^" += "^pB^" (BREV)" is op7=0x22 & p2_opc=5 & pA & pB { pA = add_brev(pA, pB); }
ins16: pA^" = ("^pA2^" + "^pB^") << 0x1" is op7=0x22 & p2_opc=6 & pA & pA2 & pB { pA = (pA + pB) << 1; }
ins16: pA^" = ("^pA2^" + "^pB^") << 0x2" is op7=0x22 & p2_opc=7 & pA & pA2 & pB { pA = (pA + pB) << 2; }

# ---------------------------------------------------------------- LOGI2op
ins16: "CC = !BITTST ("^dA^", "^lg_imm^")" is op5=0x09 & lg_opc=0 & dA & lg_imm { CC = (dA & (1:4 << lg_imm)) == 0; }
ins16: "CC = BITTST ("^dA^", "^lg_imm^")" is op5=0x09 & lg_opc=1 & dA & lg_imm { CC = (dA & (1:4 << lg_imm)) != 0; }
ins16: "BITSET ("^dA^", "^lg_imm^")" is op5=0x09 & lg_opc=2 & dA & lg_imm { dA = dA | (1:4 << lg_imm); logflags(dA); }
ins16: "BITTGL ("^dA^", "^lg_imm^")" is op5=0x09 & lg_opc=3 & dA & lg_imm { dA = dA ^ (1:4 << lg_imm); logflags(dA); }
ins16: "BITCLR ("^dA^", "^lg_imm^")" is op5=0x09 & lg_opc=4 & dA & lg_imm { dA = dA & ~(1:4 << lg_imm); logflags(dA); }
ins16: dA^" >>>= "^lg_imm is op5=0x09 & lg_opc=5 & dA & lg_imm { dA = dA s>> lg_imm; logflags(dA); }
ins16: dA^" >>= "^lg_imm is op5=0x09 & lg_opc=6 & dA & lg_imm { dA = dA >> lg_imm; logflags(dA); }
ins16: dA^" <<= "^lg_imm is op5=0x09 & lg_opc=7 & dA & lg_imm { dA = dA << lg_imm; logflags(dA); }

# ---------------------------------------------------------------- COMP3op
ins16: dC^" = "^dA^" + "^dB is op4=0x5 & c3_opc=0 & dC & dA & dB { local a:4 = dA; local b:4 = dB; dC = a + b; addflags(a, b, dC); }
ins16: dC^" = "^dA^" - "^dB is op4=0x5 & c3_opc=1 & dC & dA & dB { local a:4 = dA; local b:4 = dB; dC = a - b; subflags(a, b, dC); }
ins16: dC^" = "^dA^" & "^dB is op4=0x5 & c3_opc=2 & dC & dA & dB { dC = dA & dB; logflags(dC); }
ins16: dC^" = "^dA^" | "^dB is op4=0x5 & c3_opc=3 & dC & dA & dB { dC = dA | dB; logflags(dC); }
ins16: dC^" = "^dA^" ^ "^dB is op4=0x5 & c3_opc=4 & dC & dA & dB { dC = dA ^ dB; logflags(dC); }
ins16: pC^" = "^pA^" + "^pB is op4=0x5 & c3_opc=5 & pC & pA & pB { pC = pA + pB; }
ins16: pC^" = "^pA^" + ("^pB^" << 0x1)" is op4=0x5 & c3_opc=6 & pC & pA & pB { pC = pA + (pB << 1); }
ins16: pC^" = "^pA^" + ("^pB^" << 0x2)" is op4=0x5 & c3_opc=7 & pC & pA & pB { pC = pA + (pB << 2); }

# ---------------------------------------------------------------- COMPI2opD / COMPI2opP
ins16: dA^" = "^ci_imm^" (X)" is op5=0x0c & ci_op=0 & dA & ci_imm { dA = ci_imm; }
ins16: dA^" += "^ci_imm is op5=0x0c & ci_op=1 & dA & ci_imm { local a:4 = dA; local b:4 = ci_imm; dA = a + b; addflags(a, b, dA); }
ins16: pA^" = "^ci_imm^" (X)" is op5=0x0d & ci_op=0 & pA & ci_imm { pA = ci_imm; }
ins16: pA^" += "^ci_imm is op5=0x0d & ci_op=1 & pA & ci_imm { pA = pA + ci_imm; }

