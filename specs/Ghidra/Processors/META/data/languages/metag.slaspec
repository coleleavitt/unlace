:MGETD SR19^MGD1^MGD2^MGD3^MGD4^MGD5^MGD6^MGD7, "["SB"++]" is maj=12 & minor=8 & f0_2=0 & SR19 & SP19 & SB & MGD1 & MGD2 & MGD3 & MGD4 & MGD5 & MGD6 & MGD7 [ mr1 = r19 + 1; mr2 = r19 + 2; mr3 = r19 + 3; mr4 = r19 + 4; mr5 = r19 + 5; mr6 = r19 + 6; mr7 = r19 + 7; ] {
  SR19 = *:4 SB; SB = SB + 4; build MGD1; build MGD2; build MGD3; build MGD4; build MGD5; build MGD6; build MGD7;
}
:MSETD "["SB"++]", SR19^MSD1^MSD2^MSD3^MSD4^MSD5^MSD6^MSD7 is maj=11 & minor=8 & f0_2=0 & SR19 & SP19 & SB & MSD1 & MSD2 & MSD3 & MSD4 & MSD5 & MSD6 & MSD7 [ mr1 = r19 + 1; mr2 = r19 + 2; mr3 = r19 + 3; mr4 = r19 + 4; mr5 = r19 + 5; mr6 = r19 + 6; mr7 = r19 + 7; ] {
  *:4 SB = SR19; SB = SB + 4; build MSD1; build MSD2; build MSD3; build MSD4; build MSD5; build MSD6; build MSD7;
}
:MGETL SR19^MGL1^MGL2^MGL3^MGL4^MGL5^MGL6^MGL7, "["SB"++]" is maj=12 & minor=9 & f0_2=0 & SR19 & SP19 & SB & MGL1 & MGL2 & MGL3 & MGL4 & MGL5 & MGL6 & MGL7 [ mr1 = r19 + 1; mr2 = r19 + 2; mr3 = r19 + 3; mr4 = r19 + 4; mr5 = r19 + 5; mr6 = r19 + 6; mr7 = r19 + 7; ] {
  SR19 = *:4 SB; SP19 = *:4 (SB + 4); SB = SB + 8; build MGL1; build MGL2; build MGL3; build MGL4; build MGL5; build MGL6; build MGL7;
}
:MSETL "["SB"++]", SR19^MSL1^MSL2^MSL3^MSL4^MSL5^MSL6^MSL7 is maj=11 & minor=9 & f0_2=0 & SR19 & SP19 & SB & MSL1 & MSL2 & MSL3 & MSL4 & MSL5 & MSL6 & MSL7 [ mr1 = r19 + 1; mr2 = r19 + 2; mr3 = r19 + 3; mr4 = r19 + 4; mr5 = r19 + 5; mr6 = r19 + 6; mr7 = r19 + 7; ] {
  *:4 SB = SR19; *:4 (SB + 4) = SP19; SB = SB + 8; build MSL1; build MSL2; build MSL3; build MSL4; build MSL5; build MSL6; build MSL7;
}

# Conditional SET (major 10, minor 4): bits 0 and 9 give the size, bit 7 the linked form.
P10r19: d1_19 is u10=1 & d1_19 { export d1_19; }
P10r19: d0_19 is u10=2 & d0_19 { export d0_19; }
P10r19: a1_19 is u10=3 & a1_19 { export a1_19; }
P10r19: a0_19 is u10=4 & a0_19 { export a0_19; }
CSB: "["SB"]" is SB { export SB; }
:SETB^CC CSB, U10r19 is maj=10 & minor=4 & b7=0 & b8=0 & b0=0 & b9=0 & CC & CSB & U10r19 {
  if (!CC) goto inst_next;
  v:4 = U10r19; *:1 CSB = v:1;
}
:SETW^CC CSB, U10r19 is maj=10 & minor=4 & b7=0 & b8=0 & b0=1 & b9=0 & CC & CSB & U10r19 {
  if (!CC) goto inst_next;
  v:4 = U10r19; *:2 CSB = v:2;
}
:SETD^CC CSB, U10r19 is maj=10 & minor=4 & b7=0 & b8=0 & b0=0 & b9=1 & CC & CSB & U10r19 {
  if (!CC) goto inst_next;
  v:4 = U10r19; *:4 CSB = v;
}
:SETL^CC CSB, U10r19 is maj=10 & minor=4 & b7=0 & b8=0 & b0=1 & b9=1 & CC & CSB & U10r19 & P10r19 {
  if (!CC) goto inst_next;
  v:8 = (zext(P10r19) << 32) | zext(U10r19); *:8 CSB = v;
}

