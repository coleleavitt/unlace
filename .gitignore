/target

# Hex-Rays plugin .so binaries — large, local-only.
# Source copies live at ~/Downloads/Software/IDAPro/ida-pro-9.3sp1/
# and at hexrays/<ida-version>/*.so on disk (gitignored).
hexrays/

# Legacy reference scratch path. The tracked decompiled/reference corpus now
# lives under research/decompiled-references/.
references/

# Iced ecosystem clones — local reference mirrors of iced + widget repos
# used as implementation references for the unlace GUI. Only README.md
# is tracked; the clones themselves are ~400MB and reproducible via
# the documented `git clone --depth=1` commands.
research/iced-ecosystem/iced/
research/iced-ecosystem/iced_aw/
research/iced-ecosystem/iced_audio/
research/iced-ecosystem/iced-code-editor/
research/iced-ecosystem/iced_term/
research/iced-ecosystem/frostbyte_terminal/
research/iced-ecosystem/plotters-iced/
research/iced-ecosystem/cosmic-time/
research/iced-ecosystem/cosmic-files/
research/iced-ecosystem/halloy/
research/iced-ecosystem/sniffnet/
research/iced-ecosystem/Neothesia/
research/iced-ecosystem/book/
research/iced-ecosystem/cookbook/
research/iced-ecosystem/awesome-iced/

# Large research mirrors — not committed; clone or copy locally to inspect.
research/gdb/
research/windows-debug/
research/ida-sig-til-samples/

# Keep Windows dbgsrv reference dump directories visible to local tooling even
# when a global gitignore has a broad "*.exe" rule.
!research/decompiled-references/ida/dbgsrv/win32_remote32.exe/
!research/decompiled-references/ida/dbgsrv/win32_remote32.exe/**
!research/decompiled-references/ida/dbgsrv/win64_remote.exe/
!research/decompiled-references/ida/dbgsrv/win64_remote.exe/**

# perf / flamegraph raw capture — large + non-reproducible. The rendered
# SVGs + the text top-N reports under docs/profiling/ ARE tracked; only
# the multi-hundred-MB raw captures and intermediate folded stacks are not.
perf.data
perf.data.old
*.folded

# jfc agent worktrees + scratch
.jfc-worktrees/
session-ses_*.md
ida-notes
notes
rust_out
.worktrees/
.claude/

# CodeGraph local index/cache (per-machine, not source)
.codegraph/
