define i64 @scaled_index(ptr %p, i64 %i) {
  %a = getelementptr inbounds i64, ptr %p, i64 %i
  %v = load i64, ptr %a
  ret i64 %v
}
define i64 @field(i64 %x) {
  %s = lshr i64 %x, 8
  %m = and i64 %s, 4095
  ret i64 %m
}
define i64 @pick(i64 %c, i64 %a, i64 %b) {
  %z = icmp eq i64 %c, 0
  %r = select i1 %z, i64 %a, i64 %b
  ret i64 %r
}
define i64 @mac(i64 %acc, i64 %a, i64 %b) {
  %m = mul i64 %a, %b
  %r = add i64 %acc, %m
  ret i64 %r
}
