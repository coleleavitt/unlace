}

:psq_stu fD,PSQ_D(A),1,PSQ_I is $(NOTVLE) & OP=61 & fD & PSD1 & A & A_BITS!=0 & PSQ_W=1 & PSQ_I & PSQ_GQR & PSQ_IC!=0 & PSQ_D {
