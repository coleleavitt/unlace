CS: "" is cond=15 { }
CS: "_ret_ " is cond=0 { }
CS: "if_nc_and_nz " is cond=1 { if (!(!C && !Z)) goto inst_next; }
CS: "if_nc_and_z " is cond=2 { if (!(!C && Z)) goto inst_next; }
CS: "if_nc " is cond=3 { if (!(!C)) goto inst_next; }
CS: "if_c_and_nz " is cond=4 { if (!(C && !Z)) goto inst_next; }
CS: "if_nz " is cond=5 { if (!(!Z)) goto inst_next; }
CS: "if_c_ne_z " is cond=6 { if (!(C != Z)) goto inst_next; }
CS: "if_nc_or_nz " is cond=7 { if (!(!C || !Z)) goto inst_next; }
CS: "if_c_and_z " is cond=8 { if (!(C && Z)) goto inst_next; }
CS: "if_c_eq_z " is cond=9 { if (!(C == Z)) goto inst_next; }
CS: "if_z " is cond=10 { if (!(Z)) goto inst_next; }
CS: "if_nc_or_z " is cond=11 { if (!(!C || Z)) goto inst_next; }
CS: "if_c " is cond=12 { if (!(C)) goto inst_next; }
CS: "if_c_or_nz " is cond=13 { if (!(C || !Z)) goto inst_next; }
CS: "if_c_or_z " is cond=14 { if (!(C || Z)) goto inst_next; }
RT: is cond=0 { return [RA]; }
RT: is cond { }

COGD: da is dn [ da = dn * 4; ] { export *[cog]:4 da; }
COGS: sa is sn [ sa = sn * 4; ] { export *[cog]:4 sa; }
DR: d is d & COGD { export COGD; }
DR: d is d & dn=496 { export IJMP3; }
DR: d is d & dn=497 { export IRET3; }
DR: d is d & dn=498 { export IJMP2; }
DR: d is d & dn=499 { export IRET2; }
DR: d is d & dn=500 { export IJMP1; }
DR: d is d & dn=501 { export IRET1; }
DR: d is d & dn=502 { export PA; }
DR: d is d & dn=503 { export PB; }
DR: d is d & dn=504 { export PTRA; }
DR: d is d & dn=505 { export PTRB; }
DR: d is d & dn=506 { export DIRA; }
DR: d is d & dn=507 { export DIRB; }
DR: d is d & dn=508 { export OUTA; }
DR: d is d & dn=509 { export OUTB; }
DR: d is d & dn=510 { export INA; }
DR: d is d & dn=511 { export INB; }
SRG: s is s & COGS { export COGS; }
SRG: s is s & sn=496 { export IJMP3; }
SRG: s is s & sn=497 { export IRET3; }
SRG: s is s & sn=498 { export IJMP2; }
SRG: s is s & sn=499 { export IRET2; }
SRG: s is s & sn=500 { export IJMP1; }
SRG: s is s & sn=501 { export IRET1; }
SRG: s is s & sn=502 { export PA; }
SRG: s is s & sn=503 { export PB; }
SRG: s is s & sn=504 { export PTRA; }
SRG: s is s & sn=505 { export PTRB; }
SRG: s is s & sn=506 { export DIRA; }
SRG: s is s & sn=507 { export DIRB; }
SRG: s is s & sn=508 { export OUTA; }
SRG: s is s & sn=509 { export OUTB; }
SRG: s is s & sn=510 { export INA; }
SRG: s is s & sn=511 { export INB; }
SV: SRG is ibit=0 & SRG { export SRG; }
SV: "#"^sn is ibit=1 & sn & augs_on=0 { export *[const]:4 sn; }
SV: "#"^k is ibit=1 & sn & augs_on=1 & augs_v [ k = (augs_v << 9) | sn; ] { export *[const]:4 k; }
DL19: DR is lb19=0 & DR { export DR; }
DL19: "#"^dn is lb19=1 & dn & augd_on=0 { export *[const]:4 dn; }
DL19: "#"^k is lb19=1 & dn & augd_on=1 & augd_v [ k = (augd_v << 9) | dn; ] { export *[const]:4 k; }
DL18: DR is lb18=0 & DR { export DR; }
DL18: "#"^dn is lb18=1 & dn & augd_on=0 { export *[const]:4 dn; }
DL18: "#"^k is lb18=1 & dn & augd_on=1 & augd_v [ k = (augd_v << 9) | dn; ] { export *[const]:4 k; }

# {#}S/PTRx hub (or LUT) address, per access size.
HA1: SRG is ibit=0 & SRG { export SRG; }
HA1: "#"^sn is ibit=1 & s8=0 & sn & augs_on=0 { export *[const]:4 sn; }
HA1: "#"^k is ibit=1 & sn & augs_on=1 & augs_v [ k = (augs_v << 9) | sn; ] { export *[const]:4 k; }
HA1: "ptra["^sidx6^"]" is ibit=1 & s8=1 & s7=0 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRA + sidx6 * 1; export a; }
HA1: "ptrb["^sidx6^"]" is ibit=1 & s8=1 & s7=1 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRB + sidx6 * 1; export a; }
HA1: "++ptra["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRA = PTRA + sidx5 * 1; local a:4 = PTRA; export a; }
HA1: "++ptrb["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRB = PTRB + sidx5 * 1; local a:4 = PTRB; export a; }
HA1: "ptra++["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRA; PTRA = PTRA + sidx5 * 1; export a; }
HA1: "ptrb++["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRB; PTRB = PTRB + sidx5 * 1; export a; }
HA2: SRG is ibit=0 & SRG { export SRG; }
HA2: "#"^sn is ibit=1 & s8=0 & sn & augs_on=0 { export *[const]:4 sn; }
HA2: "#"^k is ibit=1 & sn & augs_on=1 & augs_v [ k = (augs_v << 9) | sn; ] { export *[const]:4 k; }
HA2: "ptra["^sidx6^"]" is ibit=1 & s8=1 & s7=0 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRA + sidx6 * 2; export a; }
HA2: "ptrb["^sidx6^"]" is ibit=1 & s8=1 & s7=1 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRB + sidx6 * 2; export a; }
HA2: "++ptra["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRA = PTRA + sidx5 * 2; local a:4 = PTRA; export a; }
HA2: "++ptrb["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRB = PTRB + sidx5 * 2; local a:4 = PTRB; export a; }
HA2: "ptra++["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRA; PTRA = PTRA + sidx5 * 2; export a; }
HA2: "ptrb++["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRB; PTRB = PTRB + sidx5 * 2; export a; }
HA4: SRG is ibit=0 & SRG { export SRG; }
HA4: "#"^sn is ibit=1 & s8=0 & sn & augs_on=0 { export *[const]:4 sn; }
HA4: "#"^k is ibit=1 & sn & augs_on=1 & augs_v [ k = (augs_v << 9) | sn; ] { export *[const]:4 k; }
HA4: "ptra["^sidx6^"]" is ibit=1 & s8=1 & s7=0 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRA + sidx6 * 4; export a; }
HA4: "ptrb["^sidx6^"]" is ibit=1 & s8=1 & s7=1 & s6=0 & sidx6 & augs_on=0 { local a:4 = PTRB + sidx6 * 4; export a; }
HA4: "++ptra["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRA = PTRA + sidx5 * 4; local a:4 = PTRA; export a; }
HA4: "++ptrb["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=0 & sidx5 & augs_on=0 { PTRB = PTRB + sidx5 * 4; local a:4 = PTRB; export a; }
HA4: "ptra++["^sidx5^"]" is ibit=1 & s8=1 & s7=0 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRA; PTRA = PTRA + sidx5 * 4; export a; }
HA4: "ptrb++["^sidx5^"]" is ibit=1 & s8=1 & s7=1 & s6=1 & s5=1 & sidx5 & augs_on=0 { local a:4 = PTRB; PTRB = PTRB + sidx5 * 4; export a; }

# Branch through S: #S is relative to the next instruction (longs in hub execution), S a register.
BS: dest is ibit=1 & ss [ dest = inst_next + ss * 4; ] { export *[hub]:4 dest; }
JA: dest is rbit=1 & a20s [ dest = inst_next + a20s; ] { export *[hub]:4 dest; }
JA: dest is rbit=0 & a20 [ dest = a20 + 0; ] { export *[hub]:4 dest; }
WREG: "pa" is ww=0 { export PA; }
WREG: "pb" is ww=1 { export PB; }
WREG: "ptra" is ww=2 { export PTRA; }
WREG: "ptrb" is ww=3 { export PTRB; }

FCZ: "" is cbit=0 & zbit=0 { }
FCZ: " wc" is cbit=1 & zbit=0 { C = cf; }
FCZ: " wz" is cbit=0 & zbit=1 { Z = zf; }
FCZ: " wcz" is cbit=1 & zbit=1 { C = cf; Z = zf; }
FC: "" is cbit=0 { }
FC: " wc" is cbit=1 { C = cf; }
FZ: "" is zbit=0 { }
FZ: " wz" is zbit=1 { Z = zf; }

:nop is cond=0 & fb27=0 & fb26=0 & fb25=0 & fb24=0 & fb23=0 & fb22=0 & fb21=0 & fb20=0 & fb19=0 & fb18=0 & dn=0 & sn=0 { }
:^CS^"ror" DR, SV^FCZ is CS & fb21=0 & fb22=0 & fb23=0 & fb24=0 & fb25=0 & fb26=0 & fb27=0 & DR & SV & FCZ & RT { build CS; local vd:4 = DR; local vs:4 = SV; local sh:4 = vs & 31; res = (vd >> sh) | (vd << (32 - sh)); local cb:4 = (vd >> ((sh - 1) & 31)) & 1; cf = ((zext(sh != 0) * cb) | (zext(sh == 0) * (vd & 1))) != 0; zf = res == 0; DR = res; build FCZ; build RT; }
