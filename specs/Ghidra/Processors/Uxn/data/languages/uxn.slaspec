# Uxn virtual machine (Varvara), written for unlace from the Uxn reference
# (https://wiki.xxiivv.com/site/uxntal_reference.html, opcode table and semantics).
# Generated constructor bodies: one per opcode, short (2), return (r) and keep (k) mode.

define endian=big;
define alignment=1;

define space ram type=ram_space size=2 default;
define space wst type=ram_space size=1;
define space rst type=ram_space size=1;
define space register type=register_space size=1;

define register offset=0x00 size=2 [ PC ];
define register offset=0x02 size=1 [ WP RP ];

define token opc(8)
  op5  = (0,4)
  s2   = (5,5)
  rm   = (6,6)
  km   = (7,7)
  opb  = (0,7)
;
define token imm8tok(8)
  imm8 = (0,7)
;
define token imm16tok(16)
  imm16  = (0,15)
  simm16 = (0,15) signed
;

define pcodeop deviceIn;
define pcodeop deviceOut;

Rel: dest is simm16 [ dest = inst_next + simm16; ] { export *:2 dest; }

:BRK is opb=0x00 { brk:2 = 0; return [brk]; }
:JCI Rel is opb=0x20 ; Rel { WP = WP - 1; c:1 = *[wst]:1 WP; if (c != 0) goto Rel; }
:JMI Rel is opb=0x40 ; Rel { goto Rel; }
:JSI Rel is opb=0x60 ; Rel { call Rel; }
:LIT imm8 is opb=0x80 ; imm8 { *[wst]:1 WP = imm8; WP = WP + 1; }
:LIT2 imm16 is opb=0xa0 ; imm16 { *[wst]:2 WP = imm16; WP = WP + 2; }
:LITr imm8 is opb=0xc0 ; imm8 { *[rst]:1 RP = imm8; RP = RP + 1; }
:LIT2r imm16 is opb=0xe0 ; imm16 { *[rst]:2 RP = imm16; RP = RP + 2; }

:INC is op5=1 & s2=0 & rm=0 & km=0 {
  p:1 = WP;
  p = p - 1;
  t0:1 = *[wst]:1 p;
  WP = p;
  r0:1 = t0 + 1;
  *[wst]:1 WP = r0;
  WP = WP + 1;
}
:INC2 is op5=1 & s2=1 & rm=0 & km=0 {
  p:1 = WP;
  p = p - 2;
  t0:2 = *[wst]:2 p;
  WP = p;
  r0:2 = t0 + 1;
  *[wst]:2 WP = r0;
  WP = WP + 2;
}
:INCr is op5=1 & s2=0 & rm=1 & km=0 {
  p:1 = RP;
  p = p - 1;
  t0:1 = *[rst]:1 p;
  RP = p;
  r0:1 = t0 + 1;
  *[rst]:1 RP = r0;
