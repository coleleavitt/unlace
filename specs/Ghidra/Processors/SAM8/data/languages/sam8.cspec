<?xml version="1.0" encoding="UTF-8"?>

<!-- Samsung SAM8 / SAM88RCRI: the system stack is in the register file, addressed by SPL
     (D9h), and grows down; CALL pushes the 16-bit return address high byte at the lower
     address. Samsung documents no C calling convention for these cores, so the default
     model is assembly code: no fixed argument or return registers. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="1"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <long_double_size value="4"/>
  </data_organization>
  <global>
    <range space="code"/>
    <range space="data"/>
    <range space="rf"/>
  </global>
  <stackpointer register="SPL" space="rf" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="2" stackshift="2">
      <input>
      </input>
      <output>
      </output>
      <unaffected>
        <register name="SPL"/>
      </unaffected>
      <killedbycall>
        <register name="C"/>
        <register name="Z"/>
        <register name="S"/>
        <register name="V"/>
        <register name="D"/>
        <register name="H"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
