REL8: rel is d8 [ rel = inst_start + d8; ] { export *:4 rel; }
REL16: rel is d16 [ rel = inst_start + d16; ] { export *:4 rel; }
LENA: l_reg is l_isreg=1 & l_reg { export l_reg; }
LENA: "#"^l_imm is l_isreg=0 & l_imm { export *[const]:4 l_imm; }
LENB: l_reg is l_isreg=1 & l_reg { export l_reg; }
LENB: "#"^l_imm is l_isreg=0 & l_imm { export *[const]:4 l_imm; }

