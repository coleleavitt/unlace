# Imagination Technologies META (Meta 1.1, 1.2 and 2.1 general-purpose instruction set).
# Written for unlace from the binutils-gdb META opcode table and disassembler
# (include/opcode/metag.h, opcodes/metag-dis.c) for the encodings, and the META ABI as
# the Linux arch/metag port and GCC's metag back end used it. No GPL text is copied: the
# constructors below are written from the field layouts those files document.
# Every instruction is one 32-bit little-endian word. Registers live in units: D0, D1
# (data), A0, A1 (address), CT (control), PC, TR, TT and FX; each operand field names a
# register number inside a unit chosen by other bits of the word.

define endian=little;
define alignment=4;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x0 size=4 [ D0Re0 D0Ar6 D0Ar4 D0Ar2 D0FrT D0.5 D0.6 D0.7 D0.8 D0.9 D0.10 D0.11 D0.12 D0.13 D0.14 D0.15 D0.16 D0.17 D0.18 D0.19 D0.20 D0.21 D0.22 D0.23 D0.24 D0.25 D0.26 D0.27 D0.28 D0.29 D0.30 D0.31 ];
define register offset=0x80 size=4 [ D1Re0 D1Ar5 D1Ar3 D1Ar1 D1RtP D1.5 D1.6 D1.7 D1.8 D1.9 D1.10 D1.11 D1.12 D1.13 D1.14 D1.15 D1.16 D1.17 D1.18 D1.19 D1.20 D1.21 D1.22 D1.23 D1.24 D1.25 D1.26 D1.27 D1.28 D1.29 D1.30 D1.31 ];
define register offset=0x100 size=4 [ A0StP A0FrP A0.2 A0.3 A0.4 A0.5 A0.6 A0.7 A0.8 A0.9 A0.10 A0.11 A0.12 A0.13 A0.14 A0.15 CPC0 ];
define register offset=0x180 size=4 [ A1GbP A1LbP A1.2 A1.3 A1.4 A1.5 A1.6 A1.7 A1.8 A1.9 A1.10 A1.11 A1.12 A1.13 A1.14 A1.15 CPC1 ];
define register offset=0x200 size=4 [ TXENABLE TXMODE TXSTATUS TXRPT TXTIMER TXL1START TXL1END TXL1COUNT TXL2START TXL2END TXL2COUNT TXBPOBITS TXMRSIZE TXTIMERI TXDRCTRL TXDRSIZE TXCATCH0 TXCATCH1 TXCATCH2 TXCATCH3 TXDEFR TXCPRS TXCLKCTRL TXINTERN0 TXAMAREG0 TXAMAREG1 TXAMAREG2 TXAMAREG3 TXDIVTIME TXPRIVEXT TXACTCYC TXIDLECYC ];
define register offset=0x280 size=4 [ PC PCX RD ];
define register offset=0x300 size=4 [ TXSTAT TXMASK TXSTATI TXMASKI TXPOLL TXGPIOI TXPOLLI TXGPIOO ];
define register offset=0x380 size=4 [ TTEXEC TTCTRL TTMARK TTREC GTEXEC ];
define register offset=0x400 size=4 [ FX.0 FX.1 FX.2 FX.3 FX.4 FX.5 FX.6 FX.7 FX.8 FX.9 FX.10 FX.11 FX.12 FX.13 FX.14 FX.15 ];
define register offset=0x500 size=1 [ NF ZF VF CF ];
define register offset=0x400 size=8 [ FXD.0 FXD.2 FXD.4 FXD.6 FXD.8 FXD.10 FXD.12 FXD.14 ];
define register offset=0x404 size=8 [ FXD.1 FXD.3 FXD.5 FXD.7 FXD.9 FXD.11 FXD.13 FXD.15 ];
define register offset=0x700 size=8 [ ACF ];
define register offset=0x708 size=4 [ DSPRAM ];
define register offset=0x600 size=8 [ contextreg ];
define context contextreg
  md0_1 = (0,4)
  md1_1 = (0,4)
  ma0_1 = (0,4)
  ma1_1 = (0,4)
  mr1 = (0,4)
  md0_2 = (5,9)
  md1_2 = (5,9)
  ma0_2 = (5,9)
  ma1_2 = (5,9)
  mr2 = (5,9)
  md0_3 = (10,14)
  md1_3 = (10,14)
  ma0_3 = (10,14)
  ma1_3 = (10,14)
  mr3 = (10,14)
  md0_4 = (15,19)
  md1_4 = (15,19)
  ma0_4 = (15,19)
  ma1_4 = (15,19)
  mr4 = (15,19)
  md0_5 = (20,24)
  md1_5 = (20,24)
  ma0_5 = (20,24)
  ma1_5 = (20,24)
  mr5 = (20,24)
  md0_6 = (25,29)
  md1_6 = (25,29)
  ma0_6 = (25,29)
  ma1_6 = (25,29)
  mr6 = (25,29)
  md0_7 = (30,34)
  md1_7 = (30,34)
  ma0_7 = (30,34)
  ma1_7 = (30,34)
  mr7 = (30,34)
;

define token instr(32)
  maj    = (28,31)
  minor  = (24,27)
  sbit   = (27,27)
  cbit   = (26,26)
  ibit   = (25,25)
  ubit   = (24,24)
