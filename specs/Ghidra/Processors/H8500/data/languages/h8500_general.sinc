:ADDX.B SRCB1, gRB is (eamode=0xa | eamode=0xb | eamode=0xc | eamode=0xd) & eaw=0 & SRCB1; g5=0x14 & gRB { local src:1 = SRCB1; local c:1 = zext($(C)); local t:1 = gRB + src; $(C) = carry(gRB, src) || carry(t, c); $(V) = scarry(gRB, src) ^^ scarry(t, c); gRB = t + c; $(N) = gRB s< 0; $(Z) = $(Z) && (gRB == 0); }
