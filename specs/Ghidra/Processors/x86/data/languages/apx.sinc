# Intel APX (Advanced Performance Extensions) for the 64-bit x86 language: the extended GPRs
# R16-R31, the REX2 prefix (D5), the extended EVEX prefix of the legacy instructions promoted to
# EVEX map 4, and JMPABS. Written from the Intel APX Architecture Specification 355828-009
# (sections 3.1.2-3.1.5); see specs/Ghidra/Processors/x86/README.md for what is modelled and the gaps. The map-4
# constructors are in apx_map4.sinc and the REX2 map-1 ones in apx_rex2map1.sinc, both
# generated by scripts/gen_x86_apx.py.
#
# Decode state (context fields declared in ia.sinc): rexR4/rexX4/rexB4 are the fifth register-id
# bits; a REX2 prefix sets rexprefix=1 (byte registers 4-7 are SPL..DIL) and rex2prefix=1, and with
# M0=1 it selects legacy map 1 as vexMode=3 & vexMMMMM=1. The map-4 EVEX prefix selects
# vexMode=3 & vexMMMMM=4 (no legacy, VEX or EVEX constructor matches vexMode=3, and disp8 is not
# scaled), keeps the NDD register id in evexV5 (V4:vvvv) and sets apxND/apxNF, and for CCMP/CTEST
# keeps the raw dfv (EVEX.[OF,SF,ZF,CF]) and source condition (EVEX.[SC3..SC0]) bits.

define register offset=0x3000 size=8 [ R16 R17 R18 R19 R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 ];
define register offset=0x3000 size=4 [ R16D _ R17D _ R18D _ R19D _ R20D _ R21D _ R22D _ R23D _ R24D _ R25D _ R26D _ R27D _ R28D _ R29D _ R30D _ R31D _ ];
define register offset=0x3000 size=2 [ R16W _ _ _ R17W _ _ _ R18W _ _ _ R19W _ _ _ R20W _ _ _ R21W _ _ _ R22W _ _ _ R23W _ _ _ R24W _ _ _ R25W _ _ _ R26W _ _ _ R27W _ _ _ R28W _ _ _ R29W _ _ _ R30W _ _ _ R31W _ _ _ ];
define register offset=0x3000 size=1 [ R16B _ _ _ _ _ _ _ R17B _ _ _ _ _ _ _ R18B _ _ _ _ _ _ _ R19B _ _ _ _ _ _ _ R20B _ _ _ _ _ _ _ R21B _ _ _ _ _ _ _ R22B _ _ _ _ _ _ _ R23B _ _ _ _ _ _ _ R24B _ _ _ _ _ _ _ R25B _ _ _ _ _ _ _ R26B _ _ _ _ _ _ _ R27B _ _ _ _ _ _ _ R28B _ _ _ _ _ _ _ R29B _ _ _ _ _ _ _ R30B _ _ _ _ _ _ _ R31B _ _ _ _ _ _ _ ];

@define APX_MAP4 "vexMode=3 & vexMMMMM=4"
@define APX_PP_V "prefix_f2=0 & prefix_f3=0"

define token apxrex2 (8)
  rex2_m0 = (7,7)
  rex2_r4 = (6,6)
  rex2_x4 = (5,5)
  rex2_b4 = (4,4)
  rex2_w  = (3,3)
  rex2_r3 = (2,2)
  rex2_x3 = (1,1)
  rex2_b3 = (0,0)
;

define token apxevex0 (8)
  apx_r3  = (7,7)
  apx_x3  = (6,6)
  apx_b3  = (5,5)
  apx_r4  = (4,4)
  apx_b4  = (3,3)
  apx_mmm = (0,2)
;

define token apxevex1 (8)
  apx_w    = (7,7)
  apx_vvvv = (3,6)
  apx_u    = (2,2)
  apx_pp   = (0,1)
;

define token apxevex2 (8)
  apx_zll  = (5,7)
  apx_nd   = (4,4)
  apx_v4   = (3,3)
  apx_nf   = (2,2)
  apx_scc  = (0,3)
;

# The ModRM reg/rm (and SIB index/base) fields read as R16-R23 (bit 3 of the id clear) or R24-R31.
define token apxmodrm (8)
  apx_g64a = (3,5)
  apx_g64b = (3,5)
  apx_g32a = (3,5)
  apx_g32b = (3,5)
  apx_g16a = (3,5)
  apx_g16b = (3,5)
  apx_g8a  = (3,5)
  apx_g8b  = (3,5)
  apx_r64a = (0,2)
  apx_r64b = (0,2)
  apx_r32a = (0,2)
  apx_r32b = (0,2)
  apx_r16a = (0,2)
  apx_r16b = (0,2)
  apx_r8a  = (0,2)
  apx_r8b  = (0,2)
;

attach variables [ apx_g64a apx_r64a ] [ R16 R17 R18 R19 R20 R21 R22 R23 ];
attach variables [ apx_g64b apx_r64b ] [ R24 R25 R26 R27 R28 R29 R30 R31 ];
attach variables [ apx_g32a apx_r32a ] [ R16D R17D R18D R19D R20D R21D R22D R23D ];
attach variables [ apx_g32b apx_r32b ] [ R24D R25D R26D R27D R28D R29D R30D R31D ];
attach variables [ apx_g16a apx_r16a ] [ R16W R17W R18W R19W R20W R21W R22W R23W ];
attach variables [ apx_g16b apx_r16b ] [ R24W R25W R26W R27W R28W R29W R30W R31W ];
attach variables [ apx_g8a apx_r8a ]   [ R16B R17B R18B R19B R20B R21B R22B R23B ];
attach variables [ apx_g8b apx_r8b ]   [ R24B R25B R26B R27B R28B R29B R30B R31B ];

attach variables [ apxNDD64 ] [ RAX RCX RDX RBX RSP RBP RSI RDI R8 R9 R10 R11 R12 R13 R14 R15
                                R16 R17 R18 R19 R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 ];
attach variables [ apxNDD32 ] [ EAX ECX EDX EBX ESP EBP ESI EDI R8D R9D R10D R11D R12D R13D R14D R15D
                                R16D R17D R18D R19D R20D R21D R22D R23D R24D R25D R26D R27D R28D R29D R30D R31D ];
attach variables [ apxNDD16 ] [ AX CX DX BX SP BP SI DI R8W R9W R10W R11W R12W R13W R14W R15W
                                R16W R17W R18W R19W R20W R21W R22W R23W R24W R25W R26W R27W R28W R29W R30W R31W ];
attach variables [ apxNDD8 ]  [ AL CL DL BL SPL BPL SIL DIL R8B R9B R10B R11B R12B R13B R14B R15B
                                R16B R17B R18B R19B R20B R21B R22B R23B R24B R25B R26B R27B R28B R29B R30B R31B ];

# Register-id tables extended by the fifth bit (more specific than the ia.sinc constructors).
Reg64:  apx_g64a is rexR4=1 & rexRprefix=0 & apx_g64a      { export apx_g64a; }
Reg64:  apx_g64b is rexR4=1 & rexRprefix=1 & apx_g64b      { export apx_g64b; }
Reg32:  apx_g32a is rexR4=1 & rexRprefix=0 & apx_g32a      { export apx_g32a; }
Reg32:  apx_g32b is rexR4=1 & rexRprefix=1 & apx_g32b      { export apx_g32b; }
Reg16:  apx_g16a is rexR4=1 & rexRprefix=0 & apx_g16a      { export apx_g16a; }
Reg16:  apx_g16b is rexR4=1 & rexRprefix=1 & apx_g16b      { export apx_g16b; }
Reg8:   apx_g8a  is rexR4=1 & rexprefix=1 & rexRprefix=0 & apx_g8a { export apx_g8a; }
Reg8:   apx_g8b  is rexR4=1 & rexprefix=1 & rexRprefix=1 & apx_g8b { export apx_g8b; }
Rmr64:  apx_r64a is rexB4=1 & rexBprefix=0 & apx_r64a      { export apx_r64a; }
Rmr64:  apx_r64b is rexB4=1 & rexBprefix=1 & apx_r64b      { export apx_r64b; }
Rmr32:  apx_r32a is rexB4=1 & rexBprefix=0 & apx_r32a      { export apx_r32a; }
Rmr32:  apx_r32b is rexB4=1 & rexBprefix=1 & apx_r32b      { export apx_r32b; }
Rmr16:  apx_r16a is rexB4=1 & rexBprefix=0 & apx_r16a      { export apx_r16a; }
Rmr16:  apx_r16b is rexB4=1 & rexBprefix=1 & apx_r16b      { export apx_r16b; }
Rmr8:   apx_r8a  is rexB4=1 & rexprefix=1 & rexBprefix=0 & apx_r8a { export apx_r8a; }
Rmr8:   apx_r8b  is rexB4=1 & rexprefix=1 & rexBprefix=1 & apx_r8b { export apx_r8b; }
CRmr8:  apx_r8a  is addrsize=2 & rexB4=1 & rexprefix=1 & rexBprefix=0 & apx_r8a { export apx_r8a; }
CRmr8:  apx_r8b  is addrsize=2 & rexB4=1 & rexprefix=1 & rexBprefix=1 & apx_r8b { export apx_r8b; }
CRmr16: apx_r16a is rexB4=1 & rexBprefix=0 & apx_r16a      { export apx_r16a; }
CRmr16: apx_r16b is rexB4=1 & rexBprefix=1 & apx_r16b      { export apx_r16b; }
CRmr32: apx_r32a is rexB4=1 & rexBprefix=0 & apx_r32a & apx_r64a { export apx_r64a; }
CRmr32: apx_r32b is rexB4=1 & rexBprefix=1 & apx_r32b & apx_r64b { export apx_r64b; }
Base64: apx_r64a is rexB4=1 & rexBprefix=0 & apx_r64a      { export apx_r64a; }
Base64: apx_r64b is rexB4=1 & rexBprefix=1 & apx_r64b      { export apx_r64b; }
Index64: apx_g64a is rexX4=1 & rexXprefix=0 & apx_g64a     { export apx_g64a; }
Index64: apx_g64b is rexX4=1 & rexXprefix=1 & apx_g64b     { export apx_g64b; }
Base:   apx_r32a is rexB4=1 & rexBprefix=0 & apx_r32a      { export apx_r32a; }
Base:   apx_r32b is rexB4=1 & rexBprefix=1 & apx_r32b      { export apx_r32b; }
Index:  apx_g32a is rexX4=1 & rexXprefix=0 & apx_g32a      { export apx_g32a; }
Index:  apx_g32b is rexX4=1 & rexXprefix=1 & apx_g32b      { export apx_g32b; }

check_Reg32_dest: is rexR4=1 & rexRprefix=0 & apx_g32a & apx_g64a { apx_g64a = zext(apx_g32a); }
check_Reg32_dest: is rexR4=1 & rexRprefix=1 & apx_g32b & apx_g64b { apx_g64b = zext(apx_g32b); }
check_Rmr32_dest: is rexB4=1 & rexBprefix=0 & apx_r32a & apx_r64a { apx_r64a = zext(apx_r32a); }
check_Rmr32_dest: is rexB4=1 & rexBprefix=1 & apx_r32b & apx_r64b { apx_r64b = zext(apx_r32b); }

# REX2 prefix (3.1.2.1): D5 followed by M0 R4 X4 B4 W R3 X3 B3; it is the last prefix.
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & byte=0xd5; rex2_m0=0 & rex2_r4 & rex2_x4 & rex2_b4 & rex2_w=0 & rex2_r3 & rex2_x3 & rex2_b3; instruction
    [ instrPhase=1; rexprefix=1; rex2prefix=1; rexWprefix=0; rexRprefix=rex2_r3; rexXprefix=rex2_x3; rexBprefix=rex2_b3; rexR4=rex2_r4; rexX4=rex2_x4; rexB4=rex2_b4; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & byte=0xd5; rex2_m0=0 & rex2_r4 & rex2_x4 & rex2_b4 & rex2_w=1 & rex2_r3 & rex2_x3 & rex2_b3; instruction
    [ instrPhase=1; rexprefix=1; rex2prefix=1; opsize=2; rexWprefix=1; rexRprefix=rex2_r3; rexXprefix=rex2_x3; rexBprefix=rex2_b3; rexR4=rex2_r4; rexX4=rex2_x4; rexB4=rex2_b4; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & byte=0xd5; rex2_m0=1 & rex2_r4 & rex2_x4 & rex2_b4 & rex2_w=0 & rex2_r3 & rex2_x3 & rex2_b3; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=1; rexprefix=1; rex2prefix=1; rexWprefix=0; rexRprefix=rex2_r3; rexXprefix=rex2_x3; rexBprefix=rex2_b3; rexR4=rex2_r4; rexX4=rex2_x4; rexB4=rex2_b4; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & byte=0xd5; rex2_m0=1 & rex2_r4 & rex2_x4 & rex2_b4 & rex2_w=1 & rex2_r3 & rex2_x3 & rex2_b3; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=1; rexprefix=1; rex2prefix=1; opsize=2; rexWprefix=1; rexRprefix=rex2_r3; rexXprefix=rex2_x3; rexBprefix=rex2_b3; rexR4=rex2_r4; rexX4=rex2_x4; rexB4=rex2_b4; ] {}

# Extended EVEX prefix for the legacy instructions in map 4 (Figure 3.3): P0 = ~R3 ~X3 ~B3 ~R4 B4 100,
# P1 = W ~V3..~V0 ~X4 pp, P2 = 000 ND ~V4 NF 00 (CCMP/CTEST: 000 0 SC3 SC2 SC1 SC0, dfv in P1[6:3]).
# B4=0 with ~X4=1 is the only form the AVX-512 EVEX constructor in ia.sinc also accepts; these are
# narrower (map 4, zero L'L and z) and win there.
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=0; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w+1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=1; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w*2; prefix_66=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=2; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w+1; prefix_f3=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=3; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w+1; prefix_f2=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=0 & apx_pp=0; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=1;
      rexWprefix=apx_w; opsize=apx_w+1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=0 & apx_pp=1; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=1;
      rexWprefix=apx_w; opsize=apx_w*2; prefix_66=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=0 & apx_pp=2; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=1;
      rexWprefix=apx_w; opsize=apx_w+1; prefix_f3=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=0 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=0 & apx_pp=3; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=0; rexX4=1;
      rexWprefix=apx_w; opsize=apx_w+1; prefix_f2=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=1 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=0; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=1; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w+1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=1 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=1; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
    [ instrPhase=1; vexMode=3; vexMMMMM=4; rexprefix=1; rexRprefix=~apx_r3; rexXprefix=~apx_x3; rexBprefix=~apx_b3; rexR4=~apx_r4; rexB4=1; rexX4=0;
      rexWprefix=apx_w; opsize=apx_w*2; prefix_66=1; vexVVVV=~apx_vvvv; evexVp=~apx_v4; apxND=apx_nd; apxNF=apx_nf; apxSCC=apx_scc; apxDFV=apx_vvvv; ] {}
:^instruction is $(LONGMODE_ON) & instrPhase=0 & vexMode=0 & rexprefix=0 & mandover & byte=0x62; apx_r3 & apx_x3 & apx_b3 & apx_r4 & apx_b4=1 & apx_mmm=4;
                 apx_w & apx_vvvv & apx_u=1 & apx_pp=2; apx_zll=0 & apx_nd & apx_v4 & apx_nf & apx_scc; instruction
