macro Xor(a, b) {
	local tmpA = a;
	local tmpB = b;
	setPreFlagsAnd(tmpB);
	local result = tmpA ^ tmpB;
	setPostFlags(result);
	a = result;
}

# XOR Rwn, Rwm
:xor rwn, rwm is ExtCountDec & op=0x50 & rwn & rwm {
