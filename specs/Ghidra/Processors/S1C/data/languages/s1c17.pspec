  </context_data>
  <default_symbols>
    <symbol name="TTBR" address="ram:0xffff80"/>
    <symbol name="IDIR" address="ram:0xffff84"/>
    <symbol name="DBRAM" address="ram:0xffff90"/>
  </default_symbols>
</processor_spec>
