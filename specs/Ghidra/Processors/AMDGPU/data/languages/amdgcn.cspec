<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="8"/>
    <integer_size value="4"/>
    <long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="lds"/>
  </global>
  <stackpointer register="s32" space="private"/>
  <returnaddress>
    <register name="s30_31"/>
  </returnaddress>
  <default_proto>
    <prototype name="amdgpu_kernel" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="8"><register name="s0_1"/></pentry>
        <pentry minsize="1" maxsize="8"><register name="s2_3"/></pentry>
        <pentry minsize="1" maxsize="8"><register name="s4_5"/></pentry>
        <pentry minsize="1" maxsize="8"><register name="s6_7"/></pentry>
        <pentry minsize="1" maxsize="8"><register name="s8_9"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="v0"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="v1"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="v2"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="v0"/></pentry>
      </output>
    </prototype>
  </default_proto>
  <prototype name="amdgpu_func" extrapop="0" stackshift="0">
    <input>
      <pentry minsize="1" maxsize="4"><register name="v0"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v1"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v2"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v3"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v4"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v5"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v6"/></pentry>
      <pentry minsize="1" maxsize="4"><register name="v7"/></pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="4"><register name="v0"/></pentry>
    </output>
    <unaffected>
      <register name="s30_31"/>
      <register name="s32"/>
      <register name="s33"/>
    </unaffected>
  </prototype>
</compiler_spec>
