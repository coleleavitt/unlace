# Sleigh specification for the EFI Byte Code (EBC), 32-bit natural size (sizeof(VOID *) = 4).
# Registers are 64 bits wide in both variants; only the natural size (pointers, natural indexes,
# MOVn/PUSHn/POPn) differs.  The instruction set is generated by tools/gen_ebc.py into EBC32.sinc.

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=4  default;
define space register type=register_space size=1;

define register offset=0x00 size=8 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x00 size=4 [ SP32 ];
define register offset=0x40 size=8 [ IP FLAGS ];

@include "EBC32.sinc"
