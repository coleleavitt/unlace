	export tmpa;
}
MSAOFF8: off(msa_rs) is msa_rs & msa_mi10 [ off = msa_mi10 * 8; ] {
	tmp:$(REGSIZE) = msa_rs + off;
	tmpa:$(ADDRSIZE) = 0;
	ValCast(tmpa, tmp);
	export tmpa;
}

