# Jump targets are relative to the bytecode (after any Wide/ExtraWide prefix).
JF0: tgt is u8_1 [ tgt = inst_start + u8_1; ] { export *:4 tgt; }
JF1: tgt is u16_1 [ tgt = inst_start + 1 + u16_1; ] { export *:4 tgt; }
JF2: tgt is u32_1 [ tgt = inst_start + 1 + u32_1; ] { export *:4 tgt; }
JB0: tgt is u8_1 [ tgt = inst_start - u8_1; ] { export *:4 tgt; }
JB1: tgt is u16_1 [ tgt = inst_start + 1 - u16_1; ] { export *:4 tgt; }
JB2: tgt is u32_1 [ tgt = inst_start + 1 - u32_1; ] { export *:4 tgt; }

