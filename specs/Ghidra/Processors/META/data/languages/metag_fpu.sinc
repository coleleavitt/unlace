# META FPU (FX unit) instructions, written from the binutils metag opcode table and the
# FPU operand layouts of its disassembler. FX.0..FX.15 are single-precision registers; a
# double (D) or a pair of singles (L) uses the even/odd pair FXD.n.


# FPU execution conditions (binutils enum fcond_code, first names), read from the flags FCMP
# sets: Z = equal, N = less than, V = unordered.
FCC: "" is cc=0 { }
FCC: "FEQ" is cc=1 { if (!(ZF)) goto inst_next; }
FCC: "UNE" is cc=2 { if (!(!ZF)) goto inst_next; }
FCC: "FLO" is cc=3 { if (!(NF)) goto inst_next; }
FCC: "UHS" is cc=4 { if (!(!NF)) goto inst_next; }
FCC: "MI" is cc=5 { if (!(NF)) goto inst_next; }
FCC: "PL" is cc=6 { if (!(!NF)) goto inst_next; }
FCC: "UVS" is cc=7 { if (!(VF)) goto inst_next; }
FCC: "FVC" is cc=8 { if (!(!VF)) goto inst_next; }
FCC: "UHI" is cc=9 { if (!(!NF && !ZF)) goto inst_next; }
FCC: "FLE" is cc=10 { if (!(NF || ZF)) goto inst_next; }
FCC: "FGE" is cc=11 { if (!(!NF && !VF)) goto inst_next; }
FCC: "ULT" is cc=12 { if (!(NF || VF)) goto inst_next; }
FCC: "FGT" is cc=13 { if (!(!NF && !ZF && !VF)) goto inst_next; }
FCC: "ULE" is cc=14 { if (!(NF || ZF || VF)) goto inst_next; }
FCC: "NV" is cc=15 { goto inst_next; }
FD19: "FX.0" is fx_19=0 { export FXD.0; }
