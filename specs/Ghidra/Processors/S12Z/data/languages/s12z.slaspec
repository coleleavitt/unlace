# ---- Round 6: multiply/divide family, OPR shifts and rotates, bit fields, CLB ----
OPX1: OPV1 is OPV1 { export OPV1; }
OPX2: OPV2 is OPV2 { export OPV2; }
OPX3: OPV3 is OPV3 { export OPV3; }
OPX4: OPV4 is OPV4 { export OPV4; }
SCN0: "#"^c is opr4=7 & oprlo [ c = oprlo << 1; ] { export *[const]:1 c; }
SCN1: "#"^c is opr4=7 & oprlo [ c = (oprlo << 1) | 1; ] { export *[const]:1 c; }
define token bftok(8) bfw = (5,7) bfo = (0,4);
MRAs: "D2" is pb53=0 { local v:8 = sext(D2); export v; }
