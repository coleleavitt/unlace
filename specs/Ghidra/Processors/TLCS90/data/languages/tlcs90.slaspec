# Toshiba TLCS-90 (TMP90C840, TMP90C841, TMP90C844, TMP90C845, TMP90CM40 ...)
# Written for this repository from the Toshiba TLCS-90 series data book instruction
# tables; MAME's tlcs90 core (BSD-3-Clause) was read for flag behaviour only.
# Little-endian, 16-bit address space. Flags are kept as separate one-byte registers
# and packed into F only where software can see F (PUSH/POP AF, EX AF,AF', RETI).

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=2  default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ F A C B E D L H ];
define register offset=0x00 size=2 [ AF BC DE HL ];
define register offset=0x10 size=1 [ F_ A_ C_ B_ E_ D_ L_ H_ ];
define register offset=0x10 size=2 [ AF_ BC_ DE_ HL_ ];
define register offset=0x20 size=2 [ IX IY SP PC ];
define register offset=0x30 size=1 [ fS fZ fI fH fX fV fN fC ];

define token op0 (8)
  b0     = (0,7)
  b0_hi4 = (4,7)
  b0_hi5 = (3,7)
  b0_hi6 = (2,7)
  b0_r8  = (0,2)
  b0_r16 = (0,2)
  b0_qq  = (0,2)
  b0_ixs = (0,1)
  b0_bit = (0,2)
  b0_cc  = (0,3)
  b0_alu = (0,2)
;
define token op1 (8)
  b1     = (0,7)
  b1_hi4 = (4,7)
  b1_hi5 = (3,7)
  b1_hi6 = (2,7)
  b1_r8  = (0,2)
  b1_r16 = (0,2)
  b1_ixs = (0,1)
  b1_bit = (0,2)
  b1_cc  = (0,3)
  b1_alu = (0,2)
;
define token d8 (8)
  n8    = (0,7)
  simm8 = (0,7) signed
  sgn8  = (7,7)
;
define token d16 (16)
  n16    = (0,15)
  simm16 = (0,15) signed
;

attach variables [ b0_r8 b1_r8 ] [ B C D E H L A _ ];
attach variables [ b0_r16 b1_r16 ] [ BC DE HL _ IX IY SP _ ];
attach variables [ b0_qq ] [ BC DE HL _ IX IY _ _ ];
attach variables [ b0_ixs b1_ixs ] [ IX IY SP _ ];

define pcodeop halt;
define pcodeop softwareInterrupt;
define pcodeop decimalAdjust;
define pcodeop decimalAdjustCarry;
define pcodeop divideByZero;

macro packF() {
  F = (fS << 7) | (fZ << 6) | (fI << 5) | (fH << 4) | (fX << 3) | (fV << 2) | (fN << 1) | fC;
}
macro unpackF() {
  fS = (F >> 7) & 1; fZ = (F >> 6) & 1; fI = (F >> 5) & 1; fH = (F >> 4) & 1;
  fX = (F >> 3) & 1; fV = (F >> 2) & 1; fN = (F >> 1) & 1; fC = F & 1;
}
macro push16(v) { SP = SP - 2; *:2 SP = v; }
macro pop16(v) { v = *:2 SP; SP = SP + 2; }
macro parity8(r) {
  local t:1 = r ^ (r >> 4);
  t = t ^ (t >> 2);
  t = t ^ (t >> 1);
  fV = (t & 1) == 0;
}
macro szp8(r) { fS = r s< 0; fZ = r == 0; parity8(r); }

macro add8(a, b) {
  local r:1 = a + b;
  fH = ((a & 0xf) + (b & 0xf)) > 0xf; fV = scarry(a, b); fC = carry(a, b); fX = fC; fN = 0;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro adc8(a, b) {
  local c:1 = fC;
  local t:1 = a + b;
  local r:1 = t + c;
  fH = ((a & 0xf) + (b & 0xf) + c) > 0xf;
  fV = scarry(a, b) ^^ scarry(t, c); fC = carry(a, b) || carry(t, c); fX = fC; fN = 0;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro sub8(a, b) {
  local r:1 = a - b;
  fH = (a & 0xf) < (b & 0xf); fV = sborrow(a, b); fC = a < b; fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro sbc8(a, b) {
  local c:1 = fC;
  local t:1 = a - b;
  local r:1 = t - c;
  fH = (a & 0xf) < ((b & 0xf) + c);
  fV = sborrow(a, b) ^^ sborrow(t, c); fC = (a < b) || (t < c); fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro cp8(a, b) {
  local r:1 = a - b;
  fH = (a & 0xf) < (b & 0xf); fV = sborrow(a, b); fC = a < b; fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0;
}
macro and8(a, b) { a = a & b; szp8(a); fH = 1; fN = 0; fC = 0; fX = 0; }
macro xor8(a, b) { a = a ^ b; szp8(a); fH = 0; fN = 0; fC = 0; fX = 0; }
macro or8(a, b)  { a = a | b; szp8(a); fH = 0; fN = 0; fC = 0; fX = 0; }

macro add16(a, b) {
  local r:2 = a + b;
  fH = ((a & 0xfff) + (b & 0xfff)) > 0xfff; fV = scarry(a, b); fC = carry(a, b); fX = fC; fN = 0;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro add16r(a, b) {
  fH = ((a & 0xfff) + (b & 0xfff)) > 0xfff; fC = carry(a, b); fX = fC; fN = 0;
  a = a + b;
}
macro adc16(a, b) {
  local c:2 = zext(fC);
  local t:2 = a + b;
  local r:2 = t + c;
  fH = ((a & 0xfff) + (b & 0xfff) + c) > 0xfff;
  fV = scarry(a, b) ^^ scarry(t, c); fC = carry(a, b) || carry(t, c); fX = fC; fN = 0;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro sub16(a, b) {
  local r:2 = a - b;
  fH = (a & 0xfff) < (b & 0xfff); fV = sborrow(a, b); fC = a < b; fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro sbc16(a, b) {
  local c:2 = zext(fC);
  local t:2 = a - b;
  local r:2 = t - c;
  fH = (a & 0xfff) < ((b & 0xfff) + c);
  fV = sborrow(a, b) ^^ sborrow(t, c); fC = (a < b) || (t < c); fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0; a = r;
}
macro cp16(a, b) {
  local r:2 = a - b;
  fH = (a & 0xfff) < (b & 0xfff); fV = sborrow(a, b); fC = a < b; fX = fC; fN = 1;
  fS = r s< 0; fZ = r == 0;
}
macro and16(a, b) { a = a & b; fS = a s< 0; fZ = a == 0; fH = 1; fV = 0; fN = 0; fC = 0; fX = 0; }
macro xor16(a, b) { a = a ^ b; fS = a s< 0; fZ = a == 0; fH = 0; fV = 0; fN = 0; fC = 0; fX = 0; }
macro or16(a, b)  { a = a | b; fS = a s< 0; fZ = a == 0; fH = 0; fV = 0; fN = 0; fC = 0; fX = 0; }

macro inc8(a) {
  local r:1 = a + 1;
  fH = (a & 0xf) == 0xf; fV = a == 0x7f; fN = 0; fS = r s< 0; fZ = r == 0; fX = fZ; a = r;
}
macro dec8(a) {
  local r:1 = a - 1;
  fH = (a & 0xf) == 0; fV = a == 0x80; fN = 1; fS = r s< 0; fZ = r == 0; fX = fZ; a = r;
}
macro incw(a) {
  local r:2 = a + 1;
  fH = (a & 0xfff) == 0xfff; fV = a == 0x7fff; fN = 0; fS = r s< 0; fZ = r == 0; fX = fZ; a = r;
}
macro decw(a) {
  local r:2 = a - 1;
  fH = (a & 0xfff) == 0; fV = a == 0x8000; fN = 1; fS = r s< 0; fZ = r == 0; fX = fZ; a = r;
}

macro rlc8(a) { fC = a >> 7; a = (a << 1) | (a >> 7); }
macro rrc8(a) { fC = a & 1; a = (a >> 1) | (a << 7); }
macro rl8(a)  { local c:1 = fC; fC = a >> 7; a = (a << 1) | c; }
macro rr8(a)  { local c:1 = fC; fC = a & 1; a = (a >> 1) | (c << 7); }
macro sla8(a) { fC = a >> 7; a = a << 1; }
macro sra8(a) { fC = a & 1; a = a s>> 1; }
macro sll8(a) { fC = a >> 7; a = a << 1; }
macro srl8(a) { fC = a & 1; a = a >> 1; }

macro bitTest(v, n) {
  local m:1 = v & (1 << n);
  fZ = m == 0; fS = (m & 0x80) != 0; fV = fZ; fH = 1; fN = 0; fX = 0;
}

Cc0: "F" is b0_cc=0 { export 0:1; }
Cc0: "LT" is b0_cc=1 { local t:1 = fS ^^ fV; export t; }
Cc0: "LE" is b0_cc=2 { local t:1 = fZ || (fS ^^ fV); export t; }
Cc0: "ULE" is b0_cc=3 { local t:1 = fC || fZ; export t; }
Cc0: "OV" is b0_cc=4 { local t:1 = fV; export t; }
Cc0: "MI" is b0_cc=5 { local t:1 = fS; export t; }
Cc0: "Z" is b0_cc=6 { local t:1 = fZ; export t; }
Cc0: "C" is b0_cc=7 { local t:1 = fC; export t; }
Cc0: "T" is b0_cc=8 { export 1:1; }
Cc0: "GE" is b0_cc=9 { local t:1 = !(fS ^^ fV); export t; }
Cc0: "GT" is b0_cc=10 { local t:1 = !(fZ || (fS ^^ fV)); export t; }
Cc0: "UGT" is b0_cc=11 { local t:1 = !(fC || fZ); export t; }
Cc0: "NOV" is b0_cc=12 { local t:1 = !fV; export t; }
Cc0: "PL" is b0_cc=13 { local t:1 = !fS; export t; }
Cc0: "NZ" is b0_cc=14 { local t:1 = !fZ; export t; }
Cc0: "NC" is b0_cc=15 { local t:1 = !fC; export t; }
Cc1: "F" is b1_cc=0 { export 0:1; }
Cc1: "LT" is b1_cc=1 { local t:1 = fS ^^ fV; export t; }
Cc1: "LE" is b1_cc=2 { local t:1 = fZ || (fS ^^ fV); export t; }
Cc1: "ULE" is b1_cc=3 { local t:1 = fC || fZ; export t; }
Cc1: "OV" is b1_cc=4 { local t:1 = fV; export t; }
Cc1: "MI" is b1_cc=5 { local t:1 = fS; export t; }
Cc1: "Z" is b1_cc=6 { local t:1 = fZ; export t; }
Cc1: "C" is b1_cc=7 { local t:1 = fC; export t; }
Cc1: "T" is b1_cc=8 { export 1:1; }
Cc1: "GE" is b1_cc=9 { local t:1 = !(fS ^^ fV); export t; }
Cc1: "GT" is b1_cc=10 { local t:1 = !(fZ || (fS ^^ fV)); export t; }
Cc1: "UGT" is b1_cc=11 { local t:1 = !(fC || fZ); export t; }
Cc1: "NOV" is b1_cc=12 { local t:1 = !fV; export t; }
Cc1: "PL" is b1_cc=13 { local t:1 = !fS; export t; }
Cc1: "NZ" is b1_cc=14 { local t:1 = !fZ; export t; }
Cc1: "NC" is b1_cc=15 { local t:1 = !fC; export t; }

Disp: "+"^simm8 is simm8 & sgn8=0 { export *[const]:2 simm8; }
Disp: "-"^neg is simm8 & sgn8=1 [ neg = -simm8; ] { export *[const]:2 simm8; }
Rel8: addr is simm8 [ addr = (inst_next + simm8) & 0xffff; ] { export *:2 addr; }
Rel16: addr is simm16 [ addr = (inst_next + simm16) & 0xffff; ] { export *:2 addr; }
Abs16: n16 is n16 { export *:2 n16; }
Dir: "("^addr^")" is n8 [ addr = 0xff00 + n8; ] { export *[const]:2 addr; }

# source memory operands: prefix E0-E7 / F0-F3, the operation byte follows
SrcGG: "("^b0_r16^")" is b0_hi5=0x1c & b0_r16 { export b0_r16; }
SrcMN: "("^n16^")" is b0=0xe3 ; n16 { export *[const]:2 n16; }
SrcIX: "("^b0_ixs^Disp^")" is b0_hi6=0x3c & b0_ixs ; Disp { local ea:2 = b0_ixs + Disp; export ea; }
SrcHA: "(HL+A)" is b0=0xf3 { local ea:2 = HL + zext(A); export ea; }
SrcD: Dir is b0=0xe7 ; Dir { export Dir; }

# destination memory operands: prefix E8-EF / F4-F7
DstGG: "("^b0_r16^")" is b0_hi5=0x1d & b0_r16 { export b0_r16; }
DstMN: "("^n16^")" is b0=0xeb ; n16 { export *[const]:2 n16; }
DstIX: "("^b0_ixs^Disp^")" is b0_hi6=0x3d & b0_ixs ; Disp { local ea:2 = b0_ixs + Disp; export ea; }
DstHA: "(HL+A)" is b0=0xf7 { local ea:2 = HL + zext(A); export ea; }
DstD: Dir is b0=0xef ; Dir { export Dir; }

# computed jump/call targets and LDA operands (no parentheses)
JpGG: b0_r16 is b0_hi5=0x1d & b0_r16 { export b0_r16; }
JpIX: b0_ixs^Disp is b0_hi6=0x3d & b0_ixs ; Disp { local ea:2 = b0_ixs + Disp; export ea; }
JpHA: "HL+A" is b0=0xf7 { local ea:2 = HL + zext(A); export ea; }

# register operand group F8-FE
G8: b0_r8 is b0_hi5=0x1f & b0_r8 { export b0_r8; }
G16: b0_r16 is b0_hi5=0x1f & b0_r16 { export b0_r16; }


:NOP is b0=0x00 { }
:HALT is b0=0x01 { halt(); }
:DI is b0=0x02 { fI = 0; }
:EI is b0=0x03 { fI = 1; }
:INCX Dir is b0=0x07 ; Dir { if (fX == 0) goto inst_next; local v:1 = *:1 Dir; inc8(v); *:1 Dir = v; }
:DECX Dir is b0=0x0f ; Dir { if (fX == 0) goto inst_next; local v:1 = *:1 Dir; dec8(v); *:1 Dir = v; }
:EX "DE","HL" is b0=0x08 { local t:2 = DE; DE = HL; HL = t; }
:EX "AF","AF'" is b0=0x09 { packF(); local t:2 = AF; AF = AF_; AF_ = t; unpackF(); }
:EXX is b0=0x0a {
  local t:2 = BC; BC = BC_; BC_ = t;
  t = DE; DE = DE_; DE_ = t;
  t = HL; HL = HL_; HL_ = t;
}
:DAA "A" is b0=0x0b {
  packF();
  local c:1 = decimalAdjustCarry(A, F);
  A = decimalAdjust(A, F);
  szp8(A); fC = c; fX = c;
}
:RCF is b0=0x0c { fC = 0; fX = 0; fH = 0; fN = 0; }
:SCF is b0=0x0d { fC = 1; fX = 1; fH = 0; fN = 0; }
:CCF is b0=0x0e { fH = fC; fC = !fC; fX = fC; fN = 0; }
:CPL "A" is b0=0x10 { A = ~A; fH = 1; fN = 1; }
:NEG "A" is b0=0x11 { local z:1 = 0; sub8(z, A); A = z; }
:MUL "HL",n8 is b0=0x12 ; n8 { HL = zext(L) * n8; }
:DIV "HL",n8 is b0=0x13 ; n8 {
  local d:2 = n8;
  if (d == 0) goto <dz>;
  local q:2 = HL / d;
  local r:2 = HL % d;
  fV = q > 0xff;
  L = q:1; H = r:1;
  goto inst_next;
<dz>
  fV = 1;
  HL = divideByZero(HL);
}
:ADD b0_ixs,n16 is b0_hi6=0x05 & b0_ixs ; n16 { add16(b0_ixs, n16); }
:LDAR "HL",Rel16 is b0=0x17 ; Rel16 { HL = &Rel16; }
:DJNZ Rel8 is b0=0x18 ; Rel8 { B = B - 1; if (B != 0) goto Rel8; }
:DJNZ "BC",Rel8 is b0=0x19 ; Rel8 { BC = BC - 1; if (BC != 0) goto Rel8; }
:JP Abs16 is b0=0x1a ; Abs16 { goto Abs16; }
:JRL Rel16 is b0=0x1b ; Rel16 { goto Rel16; }
:CALL Abs16 is b0=0x1c ; Abs16 { push16(&:2 inst_next); call Abs16; }
:CALR Rel16 is b0=0x1d ; Rel16 { push16(&:2 inst_next); call Rel16; }
:RET is b0=0x1e { local r:2 = 0; pop16(r); return [r]; }
:RETI is b0=0x1f { local r:2 = 0; pop16(AF); unpackF(); pop16(r); return [r]; }
:LD "A",b0_r8 is b0_hi5=0x04 & b0_r8 { A = b0_r8; }
:LD "A",Dir is b0=0x27 ; Dir { A = *:1 Dir; }
:LD b0_r8,"A" is b0_hi5=0x05 & b0_r8 { b0_r8 = A; }
:LD Dir,"A" is b0=0x2f ; Dir { *:1 Dir = A; }
:LD b0_r8,n8 is b0_hi5=0x06 & b0_r8 ; n8 { b0_r8 = n8; }
:LD Dir,n8 is b0=0x37 ; Dir ; n8 { *:1 Dir = n8; }
:LD b0_r16,n16 is b0_hi5=0x07 & b0_r16 ; n16 { b0_r16 = n16; }
:LDW Dir,n16 is b0=0x3f ; Dir ; n16 { *:2 Dir = n16; }
:LD "HL",b0_r16 is b0_hi5=0x08 & b0_r16 { HL = b0_r16; }
:LD "HL",Dir is b0=0x47 ; Dir { HL = *:2 Dir; }
:LD b0_r16,"HL" is b0_hi5=0x09 & b0_r16 { b0_r16 = HL; }
:LD Dir,"HL" is b0=0x4f ; Dir { *:2 Dir = HL; }
:PUSH b0_qq is b0_hi5=0x0a & b0_qq { push16(b0_qq); }
:PUSH "AF" is b0=0x56 { packF(); push16(AF); }
:POP b0_qq is b0_hi5=0x0b & b0_qq { pop16(b0_qq); }
:POP "AF" is b0=0x5e { pop16(AF); unpackF(); }
:INC b0_r8 is b0_hi5=0x10 & b0_r8 { inc8(b0_r8); }
:INC Dir is b0=0x87 ; Dir { local v:1 = *:1 Dir; inc8(v); *:1 Dir = v; }
:DEC b0_r8 is b0_hi5=0x11 & b0_r8 { dec8(b0_r8); }
:DEC Dir is b0=0x8f ; Dir { local v:1 = *:1 Dir; dec8(v); *:1 Dir = v; }
:INC b0_r16 is b0_hi5=0x12 & b0_r16 { b0_r16 = b0_r16 + 1; fX = b0_r16 == 0; }
:INCW Dir is b0=0x97 ; Dir { local v:2 = *:2 Dir; incw(v); *:2 Dir = v; }
:DEC b0_r16 is b0_hi5=0x13 & b0_r16 { b0_r16 = b0_r16 - 1; fX = b0_r16 == 0; }
:DECW Dir is b0=0x9f ; Dir { local v:2 = *:2 Dir; decw(v); *:2 Dir = v; }
:JR Rel8 is b0=0xc8 ; Rel8 { goto Rel8; }
:JR Cc0,Rel8 is b0_hi4=0xc & Cc0 ; Rel8 { if (Cc0) goto Rel8; }
:SWI is b0=0xff { softwareInterrupt(&:2 inst_next); }

:ADD "A",Dir is b0=0x60 ; Dir { local v:1 = *:1 Dir; add8(A, v); }
:ADD "A",n8 is b0=0x68 ; n8 { local v:1 = n8; add8(A, v); }
:ADD "HL",Dir is b0=0x70 ; Dir { local v:2 = *:2 Dir; add16(HL, v); }
:ADD "HL",n16 is b0=0x78 ; n16 { local v:2 = n16; add16(HL, v); }
:ADD "A",SrcGG is SrcGG ; b1=0x60 { local v:1 = *:1 SrcGG; add8(A, v); }
:ADD "A",SrcMN is SrcMN ; b1=0x60 { local v:1 = *:1 SrcMN; add8(A, v); }
:ADD "A",SrcIX is SrcIX ; b1=0x60 { local v:1 = *:1 SrcIX; add8(A, v); }
:ADD "A",SrcHA is SrcHA ; b1=0x60 { local v:1 = *:1 SrcHA; add8(A, v); }
:ADD "HL",SrcGG is SrcGG ; b1=0x70 { local v:2 = *:2 SrcGG; add16(HL, v); }
:ADD "HL",SrcMN is SrcMN ; b1=0x70 { local v:2 = *:2 SrcMN; add16(HL, v); }
:ADD "HL",SrcIX is SrcIX ; b1=0x70 { local v:2 = *:2 SrcIX; add16(HL, v); }
:ADD "HL",SrcHA is SrcHA ; b1=0x70 { local v:2 = *:2 SrcHA; add16(HL, v); }
:ADD DstGG,n8 is DstGG ; b1=0x68 ; n8 { local v:1 = *:1 DstGG; local w:1 = n8; add8(v, w); *:1 DstGG = v; }
:ADD DstMN,n8 is DstMN ; b1=0x68 ; n8 { local v:1 = *:1 DstMN; local w:1 = n8; add8(v, w); *:1 DstMN = v; }
:ADD DstIX,n8 is DstIX ; b1=0x68 ; n8 { local v:1 = *:1 DstIX; local w:1 = n8; add8(v, w); *:1 DstIX = v; }
:ADD DstHA,n8 is DstHA ; b1=0x68 ; n8 { local v:1 = *:1 DstHA; local w:1 = n8; add8(v, w); *:1 DstHA = v; }
:ADD DstD,n8 is DstD ; b1=0x68 ; n8 { local v:1 = *:1 DstD; local w:1 = n8; add8(v, w); *:1 DstD = v; }
:ADD "A",G8 is G8 ; b1=0x60 { add8(A, G8); }
:ADD G8,n8 is G8 ; b1=0x68 ; n8 { local w:1 = n8; add8(G8, w); }
:ADD "HL",G16 is G16 ; b1=0x70 { add16r(HL, G16); }
