:CTEST^apxScc apxDfv rm8,Reg8 is $(APX_MAP4) & apxND=0 & apxScc & apxDfv & apxDfvOF & apxDfvSF & apxDfvZF & apxDfvCF & byte=0x84; rm8 & Reg8 ... { local a:1 = rm8; local b:1 = Reg8; local sc:1 = apxScc; if (sc == 0) goto <dflt>; local d = a & b; logicalflags(); resultflags(d); goto inst_next; <dflt> OF = apxDfvOF; SF = apxDfvSF; ZF = apxDfvZF; CF = apxDfvCF; PF = apxDfvCF; AF = 0; }
