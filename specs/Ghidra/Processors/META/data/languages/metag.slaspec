}
:FFB RD19, RS14 is maj=7 & sbit=0 & cbit=0 & ibit=0 & f0_8=0x04 & f9_13=0 & RD19 & RS14 { RD19 = ffb(RS14); }
:NORM RD19, RS14 is maj=7 & sbit=0 & cbit=0 & ibit=0 & f0_8=0x08 & f9_13=0 & RD19 & RS14 { RD19 = norm(RS14); }
:ABS RD19, RS14 is maj=7 & sbit=0 & cbit=0 & ibit=0 & f0_8=0x28 & f9_13=0 & RD19 & RS14 {
  a:4 = RS14; r:4 = a; if (a s>= 0) goto <d>; r = -a; <d> RD19 = r;
}

# Byte, word and swap operations (major 10, minor 10); bit 0 picks D0 or D1.
BD19: d0_19 is b0=0 & d0_19 { export d0_19; }
BD19: d1_19 is b0=1 & d1_19 { export d1_19; }
BS14: d0_14 is b0=0 & d0_14 { export d0_14; }
BS14: d1_14 is b0=1 & d1_14 { export d1_14; }
:XSDB BD19, BS14  is maj=10 & minor=10 & f1_13=0x00 & BD19 & BS14 { s:4 = BS14; BD19 = sext(s:1); }
:XSDSB BD19, BS14 is maj=10 & minor=10 & f1_13=0x04 & BD19 & BS14 { s:4 = BS14; r:4 = sext(s:1); logflags(r); BD19 = r; }
:XSDW BD19, BS14  is maj=10 & minor=10 & f1_13=0x01 & BD19 & BS14 { s:4 = BS14; BD19 = sext(s:2); }
:XSDSW BD19, BS14 is maj=10 & minor=10 & f1_13=0x05 & BD19 & BS14 { s:4 = BS14; r:4 = sext(s:2); logflags(r); BD19 = r; }
:RTDW BD19, BS14  is maj=10 & minor=10 & f1_13=0x03 & BD19 & BS14 { s:4 = BS14; BD19 = (s << 16) | (s >> 16); }
:RTDSW BD19, BS14 is maj=10 & minor=10 & f1_13=0x07 & BD19 & BS14 { s:4 = BS14; r:4 = (s << 16) | (s >> 16); logflags(r); BD19 = r; }
:BEXD BD19, BS14  is maj=10 & minor=10 & f1_13=0x02 & BD19 & BS14 {
  s:4 = BS14; BD19 = (s << 24) | ((s & 0xff00) << 8) | ((s >> 8) & 0xff00) | (s >> 24);
}
:BEXSD BD19, BS14 is maj=10 & minor=10 & f1_13=0x06 & BD19 & BS14 {
  s:4 = BS14; r:4 = (s << 24) | ((s & 0xff00) << 8) | ((s >> 8) & 0xff00) | (s >> 24); logflags(r); BD19 = r;
}

# Flow: B cc (pc + 4 * imm19), CALLR (link register, pc-relative), JUMP/CALL (register + imm16).
:NOP is maj=10 & minor=0 & low24=0xfffffe { }
:B REL is maj=10 & minor=0 & cc=0 & REL { goto REL; }
:B^CC REL is maj=10 & minor=0 & cc!=0 & CC & REL { if (CC) goto REL; }
:CALLR SRc, REL is maj=10 & minor=11 & SRc & REL { SRc = inst_next; call REL; }
:JUMP SJ19, "#"imm16 is maj=10 & minor=12 & b2=0 & SJ19 & imm16 { t:4 = SJ19 + imm16; goto [t]; }
:CALL SJ19, "#"imm16 is maj=10 & minor=12 & b2=1 & SJ19 & imm16 { t:4 = SJ19 + imm16; D1RtP = inst_next; call [t]; }

# Unit-to-unit moves (major 10, minor 3): destination unit 5-8 / register 14-18, source unit
# 10-13 / register 19-23. MOV PC,D1RtP is the return.
:RTI is maj=10 & minor=3 & low24=0xffffff { rti(); return [PCX]; }
:RTH is maj=10 & minor=3 & low24=0x7fffff { rth(); return [PCX]; }
:MOV "PC", "D1RtP" is maj=10 & minor=3 & b0=0 & b9=0 & cc=0 & u5=5 & r14=0 & u10=2 & r19=4 {
  return [D1RtP];
}
:MOV^CC "PC", "D1RtP" is maj=10 & minor=3 & b0=0 & b9=0 & cc!=0 & CC & u5=5 & r14=0 & u10=2 & r19=4 {
  if (!CC) goto inst_next;
  return [D1RtP];
}
:MOV "PC", U10r19 is maj=10 & minor=3 & b0=0 & b9=0 & cc=0 & u5=5 & r14=0 & U10r19 {
  t:4 = U10r19;
  goto [t];
}
:MOV^CC "PC", U10r19 is maj=10 & minor=3 & b0=0 & b9=0 & cc!=0 & CC & u5=5 & r14=0 & U10r19 {
  if (!CC) goto inst_next;
  t:4 = U10r19;
  goto [t];
}
:MOV^CC U5r14, U10r19 is maj=10 & minor=3 & b0=0 & b9=0 & CC & U5r14 & U10r19 {
  if (!CC) goto inst_next;
  U5r14 = U10r19;
}
:SWAP^CC U5r14, U10r19 is maj=10 & minor=3 & b0=0 & b9=1 & CC & U5r14 & U10r19 {
  if (!CC) goto inst_next;
  t:4 = U5r14; U5r14 = U10r19; U10r19 = t;
}
:KICK^CC U10r19, U5r14 is maj=10 & minor=3 & b0=1 & b9=0 & f9_13=0 & CC & U10r19 & U5r14 {
  if (!CC) goto inst_next;
  kick(U10r19, U5r14);
}

# Control-unit immediates (major 10, minor 9): bit 2 selects TT instead of CT, bit 0 MOVT.
CT19: ct_19 is b2=0 & ct_19 { export ct_19; }
CT19: tt_19 is b2=1 & tt_19 { export tt_19; }
:MOV CT19, I16A is maj=10 & minor=9 & CT19 & I16A { CT19 = I16A; }

:SWITCH "#"low24 is maj=10 & minor=15 & low24 { switch_trap(low24:4); }
:LOCK0 is maj=10 & minor=8 & low24=0 { lock(0:1); }
:LOCK1 is maj=10 & minor=8 & low24=1 { lock(1:1); }
:LOCK2 is maj=10 & minor=8 & low24=3 { lock(2:1); }

# GET and SET (majors 12 and 11): bits 24 and 26 give the size, bit 25 an immediate offset.
EA1: "["SB"]" is ibit=1 & gsimm6=0 & SB { export *[ram]:1 SB; }
EA1: "["SB"++]" is ibit=1 & b7=1 & b0=1 & gsimm6=1 & SB { a:4 = SB; SB = SB + 1; export *[ram]:1 a; }
EA1: "[++"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6=1 & SB { SB = SB + 1; export *[ram]:1 SB; }
EA1: "["SB"--]" is ibit=1 & b7=1 & b0=1 & gsimm6u=0x3f & SB { a:4 = SB; SB = SB - 1; export *[ram]:1 a; }
EA1: "[--"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6u=0x3f & SB { SB = SB - 1; export *[ram]:1 SB; }
EA1: "["SB"+#"off"++]" is ibit=1 & b7=1 & b0=1 & SB & gsimm6 [ off = gsimm6 * 1; ] { a:4 = SB; SB = SB + off; export *[ram]:1 a; }
EA1: "["SB"++#"off"]" is ibit=1 & b7=1 & b0=0 & SB & gsimm6 [ off = gsimm6 * 1; ] { SB = SB + off; export *[ram]:1 SB; }
EA1: "["SB"+#"off"]" is ibit=1 & b7=0 & SB & gsimm6 [ off = gsimm6 * 1; ] { a:4 = SB + off; export *[ram]:1 a; }
EA1: "["SB"+"SBo9"++]" is ibit=0 & b7=1 & b0=1 & SB & SBo9 { a:4 = SB; SB = SB + SBo9; export *[ram]:1 a; }
EA1: "["SB"++"SBo9"]" is ibit=0 & b7=1 & b0=0 & SB & SBo9 { SB = SB + SBo9; export *[ram]:1 SB; }
EA1: "["SB"+"SBo9"]" is ibit=0 & b7=0 & SB & SBo9 { a:4 = SB + SBo9; export *[ram]:1 a; }
EX1: "["SBx"]" is eximm12=0 & SBx { export *[ram]:1 SBx; }
EX1: "["SBx"+#"off"]" is SBx & eximm12 [ off = eximm12 * 1; ] { a:4 = SBx + off; export *[ram]:1 a; }
:GETB U1r19, EA1 is maj=12 & (minor=0 | minor=2) & U1r19 & EA1 { U1r19 = zext(EA1); }
:SETB EA1, U1r19 is maj=11 & (minor=0 | minor=2) & U1r19 & EA1 { v:4 = U1r19; EA1 = v:1; }
:GETB SR19, EX1 is maj=10 & minor=7 & exsz=0 & SR19 & EX1 { SR19 = zext(EX1); }
:SETB EX1, SR19 is maj=10 & minor=5 & exsz=0 & SR19 & EX1 { v:4 = SR19; EX1 = v:1; }
EA2: "["SB"]" is ibit=1 & gsimm6=0 & SB { export *[ram]:2 SB; }
EA2: "["SB"++]" is ibit=1 & b7=1 & b0=1 & gsimm6=1 & SB { a:4 = SB; SB = SB + 2; export *[ram]:2 a; }
EA2: "[++"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6=1 & SB { SB = SB + 2; export *[ram]:2 SB; }
EA2: "["SB"--]" is ibit=1 & b7=1 & b0=1 & gsimm6u=0x3f & SB { a:4 = SB; SB = SB - 2; export *[ram]:2 a; }
EA2: "[--"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6u=0x3f & SB { SB = SB - 2; export *[ram]:2 SB; }
EA2: "["SB"+#"off"++]" is ibit=1 & b7=1 & b0=1 & SB & gsimm6 [ off = gsimm6 * 2; ] { a:4 = SB; SB = SB + off; export *[ram]:2 a; }
EA2: "["SB"++#"off"]" is ibit=1 & b7=1 & b0=0 & SB & gsimm6 [ off = gsimm6 * 2; ] { SB = SB + off; export *[ram]:2 SB; }
EA2: "["SB"+#"off"]" is ibit=1 & b7=0 & SB & gsimm6 [ off = gsimm6 * 2; ] { a:4 = SB + off; export *[ram]:2 a; }
EA2: "["SB"+"SBo9"++]" is ibit=0 & b7=1 & b0=1 & SB & SBo9 { a:4 = SB; SB = SB + SBo9; export *[ram]:2 a; }
EA2: "["SB"++"SBo9"]" is ibit=0 & b7=1 & b0=0 & SB & SBo9 { SB = SB + SBo9; export *[ram]:2 SB; }
EA2: "["SB"+"SBo9"]" is ibit=0 & b7=0 & SB & SBo9 { a:4 = SB + SBo9; export *[ram]:2 a; }
EX2: "["SBx"]" is eximm12=0 & SBx { export *[ram]:2 SBx; }
EX2: "["SBx"+#"off"]" is SBx & eximm12 [ off = eximm12 * 2; ] { a:4 = SBx + off; export *[ram]:2 a; }
:GETW U1r19, EA2 is maj=12 & (minor=1 | minor=3) & U1r19 & EA2 { U1r19 = zext(EA2); }
:SETW EA2, U1r19 is maj=11 & (minor=1 | minor=3) & U1r19 & EA2 { v:4 = U1r19; EA2 = v:2; }
:GETW SR19, EX2 is maj=10 & minor=7 & exsz=1 & SR19 & EX2 { SR19 = zext(EX2); }
:SETW EX2, SR19 is maj=10 & minor=5 & exsz=1 & SR19 & EX2 { v:4 = SR19; EX2 = v:2; }
EA4: "["SB"]" is ibit=1 & gsimm6=0 & SB { export *[ram]:4 SB; }
EA4: "["SB"++]" is ibit=1 & b7=1 & b0=1 & gsimm6=1 & SB { a:4 = SB; SB = SB + 4; export *[ram]:4 a; }
EA4: "[++"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6=1 & SB { SB = SB + 4; export *[ram]:4 SB; }
EA4: "["SB"--]" is ibit=1 & b7=1 & b0=1 & gsimm6u=0x3f & SB { a:4 = SB; SB = SB - 4; export *[ram]:4 a; }
EA4: "[--"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6u=0x3f & SB { SB = SB - 4; export *[ram]:4 SB; }
EA4: "["SB"+#"off"++]" is ibit=1 & b7=1 & b0=1 & SB & gsimm6 [ off = gsimm6 * 4; ] { a:4 = SB; SB = SB + off; export *[ram]:4 a; }
EA4: "["SB"++#"off"]" is ibit=1 & b7=1 & b0=0 & SB & gsimm6 [ off = gsimm6 * 4; ] { SB = SB + off; export *[ram]:4 SB; }
EA4: "["SB"+#"off"]" is ibit=1 & b7=0 & SB & gsimm6 [ off = gsimm6 * 4; ] { a:4 = SB + off; export *[ram]:4 a; }
EA4: "["SB"+"SBo9"++]" is ibit=0 & b7=1 & b0=1 & SB & SBo9 { a:4 = SB; SB = SB + SBo9; export *[ram]:4 a; }
EA4: "["SB"++"SBo9"]" is ibit=0 & b7=1 & b0=0 & SB & SBo9 { SB = SB + SBo9; export *[ram]:4 SB; }
EA4: "["SB"+"SBo9"]" is ibit=0 & b7=0 & SB & SBo9 { a:4 = SB + SBo9; export *[ram]:4 a; }
EX4: "["SBx"]" is eximm12=0 & SBx { export *[ram]:4 SBx; }
EX4: "["SBx"+#"off"]" is SBx & eximm12 [ off = eximm12 * 4; ] { a:4 = SBx + off; export *[ram]:4 a; }
:GETD U1r19, EA4 is maj=12 & (minor=4 | minor=6) & U1r19 & EA4 { U1r19 = EA4; }
:SETD EA4, U1r19 is maj=11 & (minor=4 | minor=6) & U1r19 & EA4 { v:4 = U1r19; EA4 = v; }
:GETD SR19, EX4 is maj=10 & minor=7 & exsz=2 & SR19 & EX4 { SR19 = EX4; }
:SETD EX4, SR19 is maj=10 & minor=5 & exsz=2 & SR19 & EX4 { v:4 = SR19; EX4 = v; }
EA8: "["SB"]" is ibit=1 & gsimm6=0 & SB { export *[ram]:8 SB; }
EA8: "["SB"++]" is ibit=1 & b7=1 & b0=1 & gsimm6=1 & SB { a:4 = SB; SB = SB + 8; export *[ram]:8 a; }
EA8: "[++"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6=1 & SB { SB = SB + 8; export *[ram]:8 SB; }
EA8: "["SB"--]" is ibit=1 & b7=1 & b0=1 & gsimm6u=0x3f & SB { a:4 = SB; SB = SB - 8; export *[ram]:8 a; }
EA8: "[--"SB"]" is ibit=1 & b7=1 & b0=0 & gsimm6u=0x3f & SB { SB = SB - 8; export *[ram]:8 SB; }
EA8: "["SB"+#"off"++]" is ibit=1 & b7=1 & b0=1 & SB & gsimm6 [ off = gsimm6 * 8; ] { a:4 = SB; SB = SB + off; export *[ram]:8 a; }
EA8: "["SB"++#"off"]" is ibit=1 & b7=1 & b0=0 & SB & gsimm6 [ off = gsimm6 * 8; ] { SB = SB + off; export *[ram]:8 SB; }
EA8: "["SB"+#"off"]" is ibit=1 & b7=0 & SB & gsimm6 [ off = gsimm6 * 8; ] { a:4 = SB + off; export *[ram]:8 a; }
EA8: "["SB"+"SBo9"++]" is ibit=0 & b7=1 & b0=1 & SB & SBo9 { a:4 = SB; SB = SB + SBo9; export *[ram]:8 a; }
EA8: "["SB"++"SBo9"]" is ibit=0 & b7=1 & b0=0 & SB & SBo9 { SB = SB + SBo9; export *[ram]:8 SB; }
EA8: "["SB"+"SBo9"]" is ibit=0 & b7=0 & SB & SBo9 { a:4 = SB + SBo9; export *[ram]:8 a; }
EX8: "["SBx"]" is eximm12=0 & SBx { export *[ram]:8 SBx; }
EX8: "["SBx"+#"off"]" is SBx & eximm12 [ off = eximm12 * 8; ] { a:4 = SBx + off; export *[ram]:8 a; }
:GETL U1r19, P1r19, EA8 is maj=12 & (minor=5 | minor=7) & U1r19 & P1r19 & EA8 { v:8 = EA8; U1r19 = v:4; P1r19 = v(4); }
:SETL EA8, U1r19, P1r19 is maj=11 & (minor=5 | minor=7) & U1r19 & P1r19 & EA8 { v:8 = (zext(P1r19) << 32) | zext(U1r19); EA8 = v; }
:GETL SR19, SP19, EX8 is maj=10 & minor=7 & exsz=3 & SR19 & SP19 & EX8 { v:8 = EX8; SR19 = v:4; SP19 = v(4); }
:SETL EX8, SR19, SP19 is maj=10 & minor=5 & exsz=3 & SR19 & SP19 & EX8 { v:8 = (zext(SP19) << 32) | zext(SR19); EX8 = v; }

# MGET/MSET (major 12/11, minor 8 = 32-bit, 9 = 64-bit pairs): the first register in bits
# 19-23, bits 7-13 add the next seven registers, the base is post-incremented.
MGD1: is rmb1=0 { }
MGD1: ","^ma1_1 is rmb1=1 & su3=0 & SB & ma1_1 & ma0_1 { ma1_1 = *:4 SB; SB = SB + 4; }
MGD1: ","^md0_1 is rmb1=1 & su3=1 & SB & md0_1 & md1_1 { md0_1 = *:4 SB; SB = SB + 4; }
MGD1: ","^md1_1 is rmb1=1 & su3=2 & SB & md1_1 & md0_1 { md1_1 = *:4 SB; SB = SB + 4; }
MGD1: ","^ma0_1 is rmb1=1 & su3=3 & SB & ma0_1 & ma1_1 { ma0_1 = *:4 SB; SB = SB + 4; }
MSD1: is rmb1=0 { }
MSD1: ","^ma1_1 is rmb1=1 & su3=0 & SB & ma1_1 & ma0_1 { *:4 SB = ma1_1; SB = SB + 4; }
MSD1: ","^md0_1 is rmb1=1 & su3=1 & SB & md0_1 & md1_1 { *:4 SB = md0_1; SB = SB + 4; }
MSD1: ","^md1_1 is rmb1=1 & su3=2 & SB & md1_1 & md0_1 { *:4 SB = md1_1; SB = SB + 4; }
MSD1: ","^ma0_1 is rmb1=1 & su3=3 & SB & ma0_1 & ma1_1 { *:4 SB = ma0_1; SB = SB + 4; }
MGL1: is rmb1=0 { }
MGL1: ","^ma1_1 is rmb1=1 & su3=0 & SB & ma1_1 & ma0_1 { ma1_1 = *:4 SB; ma0_1 = *:4 (SB + 4); SB = SB + 8; }
MGL1: ","^md0_1 is rmb1=1 & su3=1 & SB & md0_1 & md1_1 { md0_1 = *:4 SB; md1_1 = *:4 (SB + 4); SB = SB + 8; }
MGL1: ","^md1_1 is rmb1=1 & su3=2 & SB & md1_1 & md0_1 { md1_1 = *:4 SB; md0_1 = *:4 (SB + 4); SB = SB + 8; }
MGL1: ","^ma0_1 is rmb1=1 & su3=3 & SB & ma0_1 & ma1_1 { ma0_1 = *:4 SB; ma1_1 = *:4 (SB + 4); SB = SB + 8; }
MSL1: is rmb1=0 { }
MSL1: ","^ma1_1 is rmb1=1 & su3=0 & SB & ma1_1 & ma0_1 { *:4 SB = ma1_1; *:4 (SB + 4) = ma0_1; SB = SB + 8; }
MSL1: ","^md0_1 is rmb1=1 & su3=1 & SB & md0_1 & md1_1 { *:4 SB = md0_1; *:4 (SB + 4) = md1_1; SB = SB + 8; }
MSL1: ","^md1_1 is rmb1=1 & su3=2 & SB & md1_1 & md0_1 { *:4 SB = md1_1; *:4 (SB + 4) = md0_1; SB = SB + 8; }
MSL1: ","^ma0_1 is rmb1=1 & su3=3 & SB & ma0_1 & ma1_1 { *:4 SB = ma0_1; *:4 (SB + 4) = ma1_1; SB = SB + 8; }
MGD2: is rmb2=0 { }
MGD2: ","^ma1_2 is rmb2=1 & su3=0 & SB & ma1_2 & ma0_2 { ma1_2 = *:4 SB; SB = SB + 4; }
MGD2: ","^md0_2 is rmb2=1 & su3=1 & SB & md0_2 & md1_2 { md0_2 = *:4 SB; SB = SB + 4; }
MGD2: ","^md1_2 is rmb2=1 & su3=2 & SB & md1_2 & md0_2 { md1_2 = *:4 SB; SB = SB + 4; }
MGD2: ","^ma0_2 is rmb2=1 & su3=3 & SB & ma0_2 & ma1_2 { ma0_2 = *:4 SB; SB = SB + 4; }
MSD2: is rmb2=0 { }
MSD2: ","^ma1_2 is rmb2=1 & su3=0 & SB & ma1_2 & ma0_2 { *:4 SB = ma1_2; SB = SB + 4; }
MSD2: ","^md0_2 is rmb2=1 & su3=1 & SB & md0_2 & md1_2 { *:4 SB = md0_2; SB = SB + 4; }
MSD2: ","^md1_2 is rmb2=1 & su3=2 & SB & md1_2 & md0_2 { *:4 SB = md1_2; SB = SB + 4; }
MSD2: ","^ma0_2 is rmb2=1 & su3=3 & SB & ma0_2 & ma1_2 { *:4 SB = ma0_2; SB = SB + 4; }
MGL2: is rmb2=0 { }
MGL2: ","^ma1_2 is rmb2=1 & su3=0 & SB & ma1_2 & ma0_2 { ma1_2 = *:4 SB; ma0_2 = *:4 (SB + 4); SB = SB + 8; }
MGL2: ","^md0_2 is rmb2=1 & su3=1 & SB & md0_2 & md1_2 { md0_2 = *:4 SB; md1_2 = *:4 (SB + 4); SB = SB + 8; }
MGL2: ","^md1_2 is rmb2=1 & su3=2 & SB & md1_2 & md0_2 { md1_2 = *:4 SB; md0_2 = *:4 (SB + 4); SB = SB + 8; }
MGL2: ","^ma0_2 is rmb2=1 & su3=3 & SB & ma0_2 & ma1_2 { ma0_2 = *:4 SB; ma1_2 = *:4 (SB + 4); SB = SB + 8; }
MSL2: is rmb2=0 { }
MSL2: ","^ma1_2 is rmb2=1 & su3=0 & SB & ma1_2 & ma0_2 { *:4 SB = ma1_2; *:4 (SB + 4) = ma0_2; SB = SB + 8; }
MSL2: ","^md0_2 is rmb2=1 & su3=1 & SB & md0_2 & md1_2 { *:4 SB = md0_2; *:4 (SB + 4) = md1_2; SB = SB + 8; }
MSL2: ","^md1_2 is rmb2=1 & su3=2 & SB & md1_2 & md0_2 { *:4 SB = md1_2; *:4 (SB + 4) = md0_2; SB = SB + 8; }
MSL2: ","^ma0_2 is rmb2=1 & su3=3 & SB & ma0_2 & ma1_2 { *:4 SB = ma0_2; *:4 (SB + 4) = ma1_2; SB = SB + 8; }
MGD3: is rmb3=0 { }
MGD3: ","^ma1_3 is rmb3=1 & su3=0 & SB & ma1_3 & ma0_3 { ma1_3 = *:4 SB; SB = SB + 4; }
MGD3: ","^md0_3 is rmb3=1 & su3=1 & SB & md0_3 & md1_3 { md0_3 = *:4 SB; SB = SB + 4; }
MGD3: ","^md1_3 is rmb3=1 & su3=2 & SB & md1_3 & md0_3 { md1_3 = *:4 SB; SB = SB + 4; }
MGD3: ","^ma0_3 is rmb3=1 & su3=3 & SB & ma0_3 & ma1_3 { ma0_3 = *:4 SB; SB = SB + 4; }
MSD3: is rmb3=0 { }
MSD3: ","^ma1_3 is rmb3=1 & su3=0 & SB & ma1_3 & ma0_3 { *:4 SB = ma1_3; SB = SB + 4; }
MSD3: ","^md0_3 is rmb3=1 & su3=1 & SB & md0_3 & md1_3 { *:4 SB = md0_3; SB = SB + 4; }
MSD3: ","^md1_3 is rmb3=1 & su3=2 & SB & md1_3 & md0_3 { *:4 SB = md1_3; SB = SB + 4; }
