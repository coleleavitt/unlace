	local mr13:1 = ma13 ^ mk;
	local mr14:1 = ma14 ^ mk;
	local mr15:1 = ma15 ^ mk;
	msa_wd = zext(mr0) | (zext(mr1) << 8) | (zext(mr2) << 16) | (zext(mr3) << 24) | (zext(mr4) << 32) | (zext(mr5) << 40) | (zext(mr6) << 48) | (zext(mr7) << 56) | (zext(mr8) << 64) | (zext(mr9) << 72) | (zext(mr10) << 80) | (zext(mr11) << 88) | (zext(mr12) << 96) | (zext(mr13) << 104) | (zext(mr14) << 112) | (zext(mr15) << 120);
}
