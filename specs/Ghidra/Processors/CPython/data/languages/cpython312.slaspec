ARGV: argv is arg [ argv = (hiarg << 8) | arg; ] { export *[const]:4 argv; }
FAST: argf is hiarg=0 & argf { export argf; }
FAST: argv is arg [ argv = (hiarg << 8) | arg; ] { a:4 = argv * 8; export *[fastx]:8 a; }
:^instruction is op=144 & arg ; instruction [ hiarg = (hiarg << 8) | arg; ] { build instruction; }

:NOP is op=9 {
  
}
:RESUME ARGV is op=151 & ARGV {
  
}
:CACHE is op=0 {
  
}
:POP_TOP is op=1 {
  SP = SP + 8;
}
:PUSH_NULL is op=2 {
  push(0:8);
}
:END_FOR is op=4 {
  SP = SP + 16;
}
:END_SEND is op=5 {
  v:8 = 0; pop(v); *[pystack]:8 SP = v;
}
:COPY ARGV is op=120 & ARGV {
  v:8 = *[pystack]:8 (SP + (ARGV - 1) * 8); push(v);
}
:SWAP ARGV is op=99 & ARGV {
  a:8 = *[pystack]:8 SP; b:8 = *[pystack]:8 (SP + (ARGV - 1) * 8); *[pystack]:8 SP = b; *[pystack]:8 (SP + (ARGV - 1) * 8) = a;
}
:UNARY_NEGATIVE is op=11 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_neg(v);
}
:UNARY_NOT is op=12 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_not(v);
}
:UNARY_INVERT is op=15 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_invert(v);
}
:GET_ITER is op=68 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_iter(v);
}
:GET_LEN is op=30 {
  v:8 = *[pystack]:8 SP; r:8 = py_len(v); push(r);
}
:GET_YIELD_FROM_ITER is op=69 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_yield_from_iter(v);
}
:GET_AWAITABLE ARGV is op=131 & ARGV {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_awaitable(v);
}
:GET_AITER is op=50 {
  v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_aiter(v);
}
:BINARY_OP "add" is op=122 & arg=0 & hiarg=0 {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_add(a, b); push(r);
}
:BINARY_OP "and" is op=122 & arg=1 & hiarg=0 {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_and(a, b); push(r);
}
:BINARY_OP "floor_divide" is op=122 & arg=2 & hiarg=0 {
