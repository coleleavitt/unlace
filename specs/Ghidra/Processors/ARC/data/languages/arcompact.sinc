# ARCompact (ARC600 / ARC700): the encodings that differ from ARCv2, included by arcv2.sinc
# under ARCOMPACT inside its `with : phase=1` block.

# major 0x0e: a six-bit high register h = h[2:0] (bits 0-2) : h[5:3]... (bits 5-7 the low three)
sH6: shl0 is sh6hi=0 & shl0 { export shl0; }
sH6: shl1 is sh6hi=1 & shl1 { export shl1; }
sH6: shl2 is sh6hi=2 & shl2 { export shl2; }
sH6: shl3 is sh6hi=3 & shl3 { export shl3; }
sH6: shl4 is sh6hi=4 & shl4 { export shl4; }
sH6: shl5 is sh6hi=5 & shl5 { export shl5; }
sH6: shl6 is sh6hi=6 & shl6 { export shl6; }
sH6: shl7 is sh6hi=7 & shl7 { export shl7; }
sH6: limm is sh6hi=7 & shlo=6 ; limm { export limm; }
sH6: "pcl" is sh6hi=7 & shlo=7 { local t:4 = inst_start & 0xfffffffc; export t; }

sH6dst: shl0 is sh6hi=0 & shl0 { export shl0; }
sH6dst: shl1 is sh6hi=1 & shl1 { export shl1; }
sH6dst: shl2 is sh6hi=2 & shl2 { export shl2; }
sH6dst: shl3 is sh6hi=3 & shl3 { export shl3; }
sH6dst: shl4 is sh6hi=4 & shl4 { export shl4; }
sH6dst: shl5 is sh6hi=5 & shl5 { export shl5; }
sH6dst: shl6 is sh6hi=6 & shl6 { export shl6; }
sH6dst: shl7 is sh6hi=7 & shl7 { export shl7; }

:add_s sb, sb2, sH6 is maj=0x0e ... & sh6op=0 ... & sb ... & sb2 ... & sH6 ... { sb = sb + sH6; }
:mov_s sb, sH6 is maj=0x0e ... & sh6op=1 ... & sb ... & sH6 ... { sb = sH6; }
:cmp_s sb, sH6 is maj=0x0e ... & sh6op=2 ... & sb ... & sH6 ... { local x:4 = sb; local y:4 = sH6; local r:4 = x - y; flagsSub(x, y); flagsZN(r); }
:mov_s sH6dst, sb is maj=0x0e & sh6op=3 & sH6dst & sb { sH6dst = sb; }

# ARCompact condition codes 0x10-0x1f name extension conditions (configured per core).
define pcodeop extension_condition;
cc: "" is Q=0x10 { local t:1 = extension_condition(16:1); export t; }
cc: "" is Q=0x11 { local t:1 = extension_condition(17:1); export t; }
cc: "" is Q=0x12 { local t:1 = extension_condition(18:1); export t; }
cc: "" is Q=0x13 { local t:1 = extension_condition(19:1); export t; }
cc: "" is Q=0x14 { local t:1 = extension_condition(20:1); export t; }
cc: "" is Q=0x15 { local t:1 = extension_condition(21:1); export t; }
cc: "" is Q=0x16 { local t:1 = extension_condition(22:1); export t; }
cc: "" is Q=0x17 { local t:1 = extension_condition(23:1); export t; }
cc: "" is Q=0x18 { local t:1 = extension_condition(24:1); export t; }
cc: "" is Q=0x19 { local t:1 = extension_condition(25:1); export t; }
cc: "" is Q=0x1a { local t:1 = extension_condition(26:1); export t; }
cc: "" is Q=0x1b { local t:1 = extension_condition(27:1); export t; }
cc: "" is Q=0x1c { local t:1 = extension_condition(28:1); export t; }
cc: "" is Q=0x1d { local t:1 = extension_condition(29:1); export t; }
cc: "" is Q=0x1e { local t:1 = extension_condition(30:1); export t; }
cc: "" is Q=0x1f { local t:1 = extension_condition(31:1); export t; }

# ---- major 0x05 (ARC600 / ARC700 extension ALU) ----
define pcodeop divaw_step;
define pcodeop dsp_op;
define pcodeop dsp_flags;
define pcodeop round16;

:mul64^docc srcB, src2 is (maj=5 & sub=0x04 ; F=0) ... & docc ... & srcB ... & src2 ... { local p:8 = sext(srcB) * sext(src2); r57 = p:4; local mid:6 = p(2); r58 = mid:4; r59 = p(4); }
:mulu64^docc srcB, src2 is (maj=5 & sub=0x05 ; F=0) ... & docc ... & srcB ... & src2 ... { local p:8 = zext(srcB) * zext(src2); r57 = p:4; local mid:6 = p(2); r58 = mid:4; r59 = p(4); }
:divaw^docc dst, srcB, src2 is (maj=5 & sub=0x08 ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { dst = divaw_step(srcB, src2); }
:divaw^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x08 ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { dst = divaw_step(srcB, src2); local r:4 = dst; flagsZN(r); }
:adds^docc dst, srcB, src2 is (maj=5 & sub=0x06 ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) + sext(src2); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:adds^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x06 ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) + sext(src2); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:subs^docc dst, srcB, src2 is (maj=5 & sub=0x07 ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) - sext(src2); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:subs^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x07 ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) - sext(src2); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:adcs^docc dst, srcB, src2 is (maj=5 & sub=0x26 ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) + sext(src2) + zext(C); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:adcs^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x26 ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) + sext(src2) + zext(C); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:sbcs^docc dst, srcB, src2 is (maj=5 & sub=0x27 ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) - sext(src2) - zext(C); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:sbcs^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x27 ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local s:8 = sext(srcB) - sext(src2) - zext(C); local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:asls^docc dst, srcB, src2 is (maj=5 & sub=0x0a ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local x:8 = sext(srcB); local n:4 = src2; local k:8 = sext(n); local s:8 = x << (k & 63); if (k s>= 0) goto <s_dir>; s = x s>> ((0 - k) & 63); <s_dir> local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:asls^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x0a ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local x:8 = sext(srcB); local n:4 = src2; local k:8 = sext(n); local s:8 = x << (k & 63); if (k s>= 0) goto <s_dir>; s = x s>> ((0 - k) & 63); <s_dir> local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:asrs^docc dst, srcB, src2 is (maj=5 & sub=0x0b ; F=0) ... & docc ... & dst ... & srcB ... & src2 ... { local x:8 = sext(srcB); local n:4 = src2; local k:8 = sext(n); local s:8 = x s>> (k & 63); if (k s>= 0) goto <s_dir>; s = x << ((0 - k) & 63); <s_dir> local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> dst = r; }
:asrs^docc^".f" dst, srcB, src2 is (maj=5 & sub=0x0b ; F=1) ... & docc ... & dst ... & srcB ... & src2 ... { local x:8 = sext(srcB); local n:4 = src2; local k:8 = sext(n); local s:8 = x s>> (k & 63); if (k s>= 0) goto <s_dir>; s = x << ((0 - k) & 63); <s_dir> local r:4 = s:4; local hi:1 = s s> 0x7fffffff; local lo:1 = s s< -0x80000000; if (!hi) goto <s_hi>; r = 0x7fffffff; <s_hi> if (!lo) goto <s_lo>; r = 0x80000000; <s_lo> C = 0; V = hi || lo; flagsZN(r); dst = r; }
:sat16 dstB, src2 is (maj=5 & sub=0x2f ; F=0 & areg=0x02) ... & dstB ... & src2 ... { local x:4 = src2; local s:4 = x; local r:4 = s; local hi:1 = s s> 0x7fff; local lo:1 = s s< -0x8000; if (!hi) goto <s_hi>; r = 0x7fff; <s_hi> if (!lo) goto <s_lo>; r = 0xffff8000; <s_lo> dstB = r; }
:sat16.f dstB, src2 is (maj=5 & sub=0x2f ; F=1 & areg=0x02) ... & dstB ... & src2 ... { local x:4 = src2; local s:4 = x; local r:4 = s; local hi:1 = s s> 0x7fff; local lo:1 = s s< -0x8000; if (!hi) goto <s_hi>; r = 0x7fff; <s_hi> if (!lo) goto <s_lo>; r = 0xffff8000; <s_lo> V = hi || lo; flagsZN(r); dstB = r; }
:rnd16 dstB, src2 is (maj=5 & sub=0x2f ; F=0 & areg=0x03) ... & dstB ... & src2 ... { dstB = round16(src2); }
:rnd16.f dstB, src2 is (maj=5 & sub=0x2f ; F=1 & areg=0x03) ... & dstB ... & src2 ... { dstB = round16(src2); local r:4 = dstB; flagsZN(r); }
:abssw dstB, src2 is (maj=5 & sub=0x2f ; F=0 & areg=0x04) ... & dstB ... & src2 ... { local x:4 = src2; local h:2 = x:2; local v:4 = sext(h); local av:4 = v; if (v s>= 0) goto <s_abs>; av = 0 - v; <s_abs> local s:4 = av; local r:4 = s; local hi:1 = s s> 0x7fff; local lo:1 = s s< -0x8000; if (!hi) goto <s_hi>; r = 0x7fff; <s_hi> if (!lo) goto <s_lo>; r = 0xffff8000; <s_lo> dstB = r; }
:abssw.f dstB, src2 is (maj=5 & sub=0x2f ; F=1 & areg=0x04) ... & dstB ... & src2 ... { local x:4 = src2; local h:2 = x:2; local v:4 = sext(h); local av:4 = v; if (v s>= 0) goto <s_abs>; av = 0 - v; <s_abs> local s:4 = av; local r:4 = s; local hi:1 = s s> 0x7fff; local lo:1 = s s< -0x8000; if (!hi) goto <s_hi>; r = 0x7fff; <s_hi> if (!lo) goto <s_lo>; r = 0xffff8000; <s_lo> V = hi || lo; flagsZN(r); dstB = r; }
