<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <integer_size value="2"/>
  </data_organization>
  <global>
    <range space="prog"/>
    <range space="drom"/>
    <range space="dram"/>
  </global>
  <stackpointer register="SP" space="hstk" growth="positive"/>
  <default_proto>
    <prototype name="__asm" extrapop="-2" stackshift="-2" strategy="register">
      <input>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="A"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
