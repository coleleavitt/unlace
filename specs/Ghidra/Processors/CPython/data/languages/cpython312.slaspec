:COMPARE_OP "lt" is op=107 & arghi=0 & hiarg=0 {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_lt(a, b); push(r);
}
:COMPARE_OP "lt=" is op=107 & arghi=1 & hiarg=0 {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_le(a, b); push(r);
}
:COMPARE_OP "==" is op=107 & arghi=2 & hiarg=0 {
