<?xml version="1.0" encoding="UTF-8"?>

<!-- A Z80-style register convention: the first argument in HL (L for a byte), the
     rest on the stack, result in HL (L/A for a byte). Native-mode return addresses
     are 16-bit. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="4"/>
    <integer_size value="2"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="io"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__z380" extrapop="2" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="IX"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
