:cprcr rx, "<"^a25_21^", "^b11_0^">" is a31_26=0x3f & rx & a25_21; b15_12=2 & b11_0 { local c:1 = a25_21; local n:2 = b11_0; rx = coprocessor(2:1, c, n); }
:cpwcr rx, "<"^a25_21^", "^b11_0^">" is a31_26=0x3f & rx & a25_21; b15_12=3 & b11_0 { local c:1 = a25_21; local n:2 = b11_0; coprocessor(3:1, c, n, rx); }
:cprc "<"^a25_21^", "^b11_0^">" is a31_26=0x3f & a25_21 & a20_16=0; b15_12=4 & b11_0 { local c:1 = a25_21; local n:2 = b11_0; C = coprocessor(4:1, c, n); }
:cpop "<"^a25_21^", "^cpv20^">" is (a31_26=0x3f & a25_21; b15=1) & cpv20 { local c:1 = a25_21; coprocessor(5:1, c, cpv20); }

