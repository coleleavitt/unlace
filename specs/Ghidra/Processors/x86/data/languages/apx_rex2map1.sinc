:CMPXCHG^lockx m32,Reg32 is vexMode=3 & vexMMMMM=1 & lockx & unlock & opsize=1 & byte=0xb1; m32 & Reg32 ... & check_EAX_dest ...
{
    build lockx;
    #this instruction writes to either EAX or Rmr32
	#in 64-bit mode, a 32-bit register that is written to 
	#(and only the register that is written to) 
	#must be zero-extended to 64 bits
    local dest = m32;
    subflags(EAX,dest); 
    local diff = EAX-dest; 
    resultflags(diff);
    if (ZF) goto <equal>;
    EAX = dest;
    build check_EAX_dest;
    goto <inst_end>;
<equal>
    m32 = Reg32;
<inst_end>
    build unlock;
}
