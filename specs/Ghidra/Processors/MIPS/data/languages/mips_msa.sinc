MSAOFF1: off(msa_rs) is msa_rs & msa_mi10 [ off = msa_mi10 * 1; ] {
	tmp:$(REGSIZE) = msa_rs + off;
	tmpa:$(ADDRSIZE) = 0;
	ValCast(tmpa, tmp);
	export tmpa;
}
MSAOFF2: off(msa_rs) is msa_rs & msa_mi10 [ off = msa_mi10 * 2; ] {
	tmp:$(REGSIZE) = msa_rs + off;
