# Condition codes (binutils enum cond_code): C is set by a borrow on subtract (CS = LO).
CC: ""   is cc=0  { export 1:1; }
CC: "EQ" is cc=1  { c:1 = ZF; export c; }
CC: "NE" is cc=2  { c:1 = !ZF; export c; }
CC: "CS" is cc=3  { c:1 = CF; export c; }
CC: "CC" is cc=4  { c:1 = !CF; export c; }
CC: "MI" is cc=5  { c:1 = NF; export c; }
CC: "PL" is cc=6  { c:1 = !NF; export c; }
CC: "VS" is cc=7  { c:1 = VF; export c; }
CC: "VC" is cc=8  { c:1 = !VF; export c; }
CC: "HI" is cc=9  { c:1 = !CF && !ZF; export c; }
CC: "LS" is cc=10 { c:1 = CF || ZF; export c; }
CC: "GE" is cc=11 { c:1 = NF == VF; export c; }
CC: "LT" is cc=12 { c:1 = NF != VF; export c; }
CC: "GT" is cc=13 { c:1 = !ZF && (NF == VF); export c; }
CC: "LE" is cc=14 { c:1 = ZF || (NF != VF); export c; }
CC: "NV" is cc=15 { export 0:1; }

macro addflags(a, b, r) {
  CF = carry(a, b);
  VF = scarry(a, b);
  ZF = r == 0;
  NF = r s< 0;
}
macro subflags(a, b, r) {
  CF = a < b;
  VF = sborrow(a, b);
  ZF = r == 0;
  NF = r s< 0;
}
macro logflags(r) {
  ZF = r == 0;
  NF = r s< 0;
}

define pcodeop switch_trap;
define pcodeop lock;
define pcodeop rti;
define pcodeop rth;
define pcodeop ffb;
define pcodeop norm;
define pcodeop nmin;
define pcodeop kick;
define pcodeop defr;
define pcodeop dcache;
define pcodeop icache;
define pcodeop cacher;
define pcodeop cachew;
define pcodeop lnkget;
define pcodeop lnkset;

# Register operands in the unit an ALU instruction works on: D0/D1 from bit 24, or A0/A1
# for the address-unit major opcode 8.

RD19: d0_19 is maj!=8 & ubit=0 & d0_19 { export d0_19; }
RD19: d1_19 is maj!=8 & ubit=1 & d1_19 { export d1_19; }
RD19: a0_19 is maj=8 & ubit=0 & a0_19 { export a0_19; }
RD19: a1_19 is maj=8 & ubit=1 & a1_19 { export a1_19; }
RS14: d0_14 is maj!=8 & ubit=0 & d0_14 { export d0_14; }
RS14: d1_14 is maj!=8 & ubit=1 & d1_14 { export d1_14; }
RS14: a0_14 is maj=8 & ubit=0 & a0_14 { export a0_14; }
RS14: a1_14 is maj=8 & ubit=1 & a1_14 { export a1_14; }
RS9: d0_9 is maj!=8 & ubit=0 & d0_9 { export d0_9; }
RS9: d1_9 is maj!=8 & ubit=1 & d1_9 { export d1_9; }
RS9: a0_9 is maj=8 & ubit=0 & a0_9 { export a0_9; }
RS9: a1_9 is maj=8 & ubit=1 & a1_9 { export a1_9; }

# Source 2 with the O2R bit: bits 12-13 pick another unit, bits 9-11 the register (lookup_o2r).
RS9o: RS9 is b0=0 & RS9 { export RS9; }
RS9o: a1_o is b0=1 & maj!=8 & ubit=0 & r9u=0 & a1_o { export a1_o; }
RS9o: d1_o is b0=1 & maj!=8 & ubit=0 & r9u=1 & d1_o { export d1_o; }
RS9o: RD   is b0=1 & maj!=8 & ubit=0 & r9u=2 & RD   { export RD; }
RS9o: a0_o is b0=1 & maj!=8 & ubit=0 & r9u=3 & a0_o { export a0_o; }
RS9o: a1_o is b0=1 & maj!=8 & ubit=1 & r9u=0 & a1_o { export a1_o; }
RS9o: d0_o is b0=1 & maj!=8 & ubit=1 & r9u=1 & d0_o { export d0_o; }
RS9o: RD   is b0=1 & maj!=8 & ubit=1 & r9u=2 & RD   { export RD; }
RS9o: a0_o is b0=1 & maj!=8 & ubit=1 & r9u=3 & a0_o { export a0_o; }
RS9o: a1_o is b0=1 & maj=8 & ubit=0 & r9u=0 & a1_o { export a1_o; }
RS9o: d0_o is b0=1 & maj=8 & ubit=0 & r9u=1 & d0_o { export d0_o; }
RS9o: RD   is b0=1 & maj=8 & ubit=0 & r9u=2 & RD   { export RD; }
RS9o: d1_o is b0=1 & maj=8 & ubit=0 & r9u=3 & d1_o { export d1_o; }
RS9o: d1_o is b0=1 & maj=8 & ubit=1 & r9u=0 & d1_o { export d1_o; }
RS9o: d0_o is b0=1 & maj=8 & ubit=1 & r9u=1 & d0_o { export d0_o; }
RS9o: RD   is b0=1 & maj=8 & ubit=1 & r9u=2 & RD   { export RD; }
RS9o: a0_o is b0=1 & maj=8 & ubit=1 & r9u=3 & a0_o { export a0_o; }

# A register in any unit, the unit taken from a 4-bit field.

U5r19: ct_19 is u5=0 & ct_19 { export ct_19; }
U5r19: d0_19 is u5=1 & d0_19 { export d0_19; }
U5r19: d1_19 is u5=2 & d1_19 { export d1_19; }
U5r19: a0_19 is u5=3 & a0_19 { export a0_19; }
U5r19: a1_19 is u5=4 & a1_19 { export a1_19; }
U5r19: pc_19 is u5=5 & pc_19 { export pc_19; }
U5r19: tr_19 is u5=7 & tr_19 { export tr_19; }
U5r19: tt_19 is u5=8 & tt_19 { export tt_19; }
U5r19: fx_19 is u5=9 & fx_19 { export fx_19; }
U5r14: ct_14 is u5=0 & ct_14 { export ct_14; }
U5r14: d0_14 is u5=1 & d0_14 { export d0_14; }
U5r14: d1_14 is u5=2 & d1_14 { export d1_14; }
U5r14: a0_14 is u5=3 & a0_14 { export a0_14; }
U5r14: a1_14 is u5=4 & a1_14 { export a1_14; }
U5r14: pc_14 is u5=5 & pc_14 { export pc_14; }
U5r14: tr_14 is u5=7 & tr_14 { export tr_14; }
U5r14: tt_14 is u5=8 & tt_14 { export tt_14; }
U5r14: fx_14 is u5=9 & fx_14 { export fx_14; }
U10r19: ct_19 is u10=0 & ct_19 { export ct_19; }
U10r19: d0_19 is u10=1 & d0_19 { export d0_19; }
U10r19: d1_19 is u10=2 & d1_19 { export d1_19; }
U10r19: a0_19 is u10=3 & a0_19 { export a0_19; }
U10r19: a1_19 is u10=4 & a1_19 { export a1_19; }
U10r19: pc_19 is u10=5 & pc_19 { export pc_19; }
U10r19: tr_19 is u10=7 & tr_19 { export tr_19; }
U10r19: tt_19 is u10=8 & tt_19 { export tt_19; }
U10r19: fx_19 is u10=9 & fx_19 { export fx_19; }
U1r19: ct_19 is u1=0 & ct_19 { export ct_19; }
U1r19: d0_19 is u1=1 & d0_19 { export d0_19; }
U1r19: d1_19 is u1=2 & d1_19 { export d1_19; }
U1r19: a0_19 is u1=3 & a0_19 { export a0_19; }
U1r19: a1_19 is u1=4 & a1_19 { export a1_19; }
U1r19: pc_19 is u1=5 & pc_19 { export pc_19; }
U1r19: tr_19 is u1=7 & tr_19 { export tr_19; }
U1r19: tt_19 is u1=8 & tt_19 { export tt_19; }
U1r19: fx_19 is u1=9 & fx_19 { export fx_19; }

# The pair of a 64-bit transfer: D0.n with D1.n, A0.n with A1.n (get_pair_unit).
P1r19: d1_19 is u1=1 & d1_19 { export d1_19; }
P1r19: d0_19 is u1=2 & d0_19 { export d0_19; }
P1r19: a1_19 is u1=3 & a1_19 { export a1_19; }
P1r19: a0_19 is u1=4 & a0_19 { export a0_19; }

# Short (2-bit) unit fields: 0 = A1, 1 = D0, 2 = D1, 3 = A0 (short_unit).

SB: a1_14 is su5=0 & a1_14 { export a1_14; }
SBx: a1_x is su5=0 & a1_x { export a1_x; }
SR19: a1_19 is su3=0 & a1_19 { export a1_19; }
SP19: a0_19 is su3=0 & a0_19 { export a0_19; }
SRc: a1_c is su3=0 & a1_c { export a1_c; }
SJ19: a1_19 is f0_1=0 & a1_19 { export a1_19; }
SBo9: a1_9 is su5=0 & a1_9 { export a1_9; }
SB: d0_14 is su5=1 & d0_14 { export d0_14; }
SBx: d0_x is su5=1 & d0_x { export d0_x; }
SR19: d0_19 is su3=1 & d0_19 { export d0_19; }
SP19: d1_19 is su3=1 & d1_19 { export d1_19; }
SRc: d0_c is su3=1 & d0_c { export d0_c; }
SJ19: d0_19 is f0_1=1 & d0_19 { export d0_19; }
SBo9: d0_9 is su5=1 & d0_9 { export d0_9; }
SB: d1_14 is su5=2 & d1_14 { export d1_14; }
SBx: d1_x is su5=2 & d1_x { export d1_x; }
SR19: d1_19 is su3=2 & d1_19 { export d1_19; }
SP19: d0_19 is su3=2 & d0_19 { export d0_19; }
SRc: d1_c is su3=2 & d1_c { export d1_c; }
SJ19: d1_19 is f0_1=2 & d1_19 { export d1_19; }
SBo9: d1_9 is su5=2 & d1_9 { export d1_9; }
SB: a0_14 is su5=3 & a0_14 { export a0_14; }
SBx: a0_x is su5=3 & a0_x { export a0_x; }
SR19: a0_19 is su3=3 & a0_19 { export a0_19; }
SP19: a1_19 is su3=3 & a1_19 { export a1_19; }
SRc: a0_c is su3=3 & a0_c { export a0_c; }
SJ19: a0_19 is f0_1=3 & a0_19 { export a0_19; }
SBo9: a0_9 is su5=3 & a0_9 { export a0_9; }

# 16-bit immediates: bit 1 sign-extends, bit 0 (T) places the value in the top half.
I16A: "#"simm16 is b0=0 & b1=1 & simm16 { export *[const]:4 simm16; }
I16A: "#"imm16  is b0=0 & b1=0 & imm16  { export *[const]:4 imm16; }
I16A: "#"tv     is b0=1 & b1=0 & imm16 [ tv = imm16 << 16; ] { export *[const]:4 tv; }
# Logic and compare immediates: bit 2 (M) fills the other half with ones (MB, MT).
I16L: I16A      is b2=0 & I16A { export I16A; }
I16L: "#"tv     is b2=1 & b0=0 & b1=0 & imm16 [ tv = imm16 | 0xffff0000; ] { export *[const]:4 tv; }
I16L: "#"tv     is b2=1 & b0=1 & b1=0 & imm16 [ tv = (imm16 << 16) | 0xffff; ] { export *[const]:4 tv; }
I8: "#"imm8 is imm8 { export *[const]:4 imm8; }
REL: dest is boff19 [ dest = inst_start + boff19 * 4; ] { export *:4 dest; }


# ALU: ADD, SUB, AND, OR, XOR (major 0-4; bit 27 sets the flags) and the address-unit ADD/SUB (major 8; bit 27 selects SUB).
:ADD RD19, RS14, RS9o is maj=0 & sbit=0 & cbit=0 & ibit=0 & b2=0 & f3_8=0 & RD19 & RS14 & RS9o {
  a:4 = RS14; b:4 = RS9o; r:4 = a + b; 
  RD19 = r;
}
:MOV RD19, RS9o is maj=0 & sbit=0 & cbit=0 & ibit=0 & b2=1 & f3_8=0 & RD19 & RS9o {
  b:4 = RS9o; r:4 = b; 
  RD19 = r;
}
:MOV RD19, I16A is maj=0 & sbit=0 & cbit=0 & ibit=1 & b2=1 & RD19 & I16A {
  b:4 = I16A; r:4 = b; 
  RD19 = r;
}
:ADD RD19, I16A is maj=0 & sbit=0 & cbit=0 & ibit=1 & b2=0 & RD19 & I16A {
  a:4 = RD19; b:4 = I16A; r:4 = a + b; 
  RD19 = r;
}
:ADD^CC U5r19, RS14, RS9o is maj=0 & sbit=0 & cbit=1 & ibit=0 & CC & U5r19 & RS14 & RS9o {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = RS9o; r:4 = a + b; 
  U5r19 = r;
}
:ADD U1r19, RS14, I8 is maj=0 & sbit=0 & cbit=1 & ibit=1 & b5=1 & b0=0 & U1r19 & RS14 & I8 {
  a:4 = RS14; b:4 = I8; r:4 = a + b; 
  U1r19 = r;
}
:ADD^CC RD19, RS14, I8 is maj=0 & sbit=0 & cbit=1 & ibit=1 & b5=0 & b0=0 & CC & RD19 & RS14 & I8 {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = I8; r:4 = a + b; 
  RD19 = r;
}
:ADDS RD19, RS14, RS9o is maj=0 & sbit=1 & cbit=0 & ibit=0 & b2=0 & f3_8=0 & RD19 & RS14 & RS9o {
  a:4 = RS14; b:4 = RS9o; r:4 = a + b; addflags(a, b, r);
  RD19 = r;
}
:MOVS RD19, RS9o is maj=0 & sbit=1 & cbit=0 & ibit=0 & b2=1 & f3_8=0 & RD19 & RS9o {
  b:4 = RS9o; r:4 = b; logflags(r);
  RD19 = r;
}
:MOVS RD19, I16A is maj=0 & sbit=1 & cbit=0 & ibit=1 & b2=1 & RD19 & I16A {
  b:4 = I16A; r:4 = b; logflags(r);
  RD19 = r;
}
:ADDS RD19, I16A is maj=0 & sbit=1 & cbit=0 & ibit=1 & b2=0 & RD19 & I16A {
  a:4 = RD19; b:4 = I16A; r:4 = a + b; addflags(a, b, r);
  RD19 = r;
}
:ADDS^CC U5r19, RS14, RS9o is maj=0 & sbit=1 & cbit=1 & ibit=0 & CC & U5r19 & RS14 & RS9o {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = RS9o; r:4 = a + b; addflags(a, b, r);
  U5r19 = r;
}
:ADDS U1r19, RS14, I8 is maj=0 & sbit=1 & cbit=1 & ibit=1 & b5=1 & b0=0 & U1r19 & RS14 & I8 {
  a:4 = RS14; b:4 = I8; r:4 = a + b; addflags(a, b, r);
  U1r19 = r;
}
:ADDS^CC RD19, RS14, I8 is maj=0 & sbit=1 & cbit=1 & ibit=1 & b5=0 & b0=0 & CC & RD19 & RS14 & I8 {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = I8; r:4 = a + b; addflags(a, b, r);
  RD19 = r;
}
:SUB RD19, RS14, RS9o is maj=1 & sbit=0 & cbit=0 & ibit=0 & b2=0 & f3_8=0 & RD19 & RS14 & RS9o {
  a:4 = RS14; b:4 = RS9o; r:4 = a - b; 
  RD19 = r;
}
:NEG RD19, RS9o is maj=1 & sbit=0 & cbit=0 & ibit=0 & b2=1 & f3_8=0 & RD19 & RS9o {
  b:4 = RS9o; r:4 = -b; 
  RD19 = r;
}
:NEG RD19, I16A is maj=1 & sbit=0 & cbit=0 & ibit=1 & b2=1 & RD19 & I16A {
  b:4 = I16A; r:4 = -b; 
  RD19 = r;
}
:SUB RD19, I16A is maj=1 & sbit=0 & cbit=0 & ibit=1 & b2=0 & RD19 & I16A {
  a:4 = RD19; b:4 = I16A; r:4 = a - b; 
  RD19 = r;
}
:SUB^CC U5r19, RS14, RS9o is maj=1 & sbit=0 & cbit=1 & ibit=0 & CC & U5r19 & RS14 & RS9o {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = RS9o; r:4 = a - b; 
  U5r19 = r;
}
:SUB U1r19, RS14, I8 is maj=1 & sbit=0 & cbit=1 & ibit=1 & b5=1 & b0=0 & U1r19 & RS14 & I8 {
  a:4 = RS14; b:4 = I8; r:4 = a - b; 
  U1r19 = r;
}
:SUB^CC RD19, RS14, I8 is maj=1 & sbit=0 & cbit=1 & ibit=1 & b5=0 & b0=0 & CC & RD19 & RS14 & I8 {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = I8; r:4 = a - b; 
  RD19 = r;
}
:SUBS RD19, RS14, RS9o is maj=1 & sbit=1 & cbit=0 & ibit=0 & b2=0 & f3_8=0 & RD19 & RS14 & RS9o {
  a:4 = RS14; b:4 = RS9o; r:4 = a - b; subflags(a, b, r);
  RD19 = r;
}
:NEGS RD19, RS9o is maj=1 & sbit=1 & cbit=0 & ibit=0 & b2=1 & f3_8=0 & RD19 & RS9o {
  b:4 = RS9o; r:4 = -b; subflags(0:4, b, r);
  RD19 = r;
}
:NEGS RD19, I16A is maj=1 & sbit=1 & cbit=0 & ibit=1 & b2=1 & RD19 & I16A {
  b:4 = I16A; r:4 = -b; subflags(0:4, b, r);
  RD19 = r;
}
:SUBS RD19, I16A is maj=1 & sbit=1 & cbit=0 & ibit=1 & b2=0 & RD19 & I16A {
  a:4 = RD19; b:4 = I16A; r:4 = a - b; subflags(a, b, r);
  RD19 = r;
}
:SUBS^CC U5r19, RS14, RS9o is maj=1 & sbit=1 & cbit=1 & ibit=0 & CC & U5r19 & RS14 & RS9o {
  if (!CC) goto inst_next;
  a:4 = RS14; b:4 = RS9o; r:4 = a - b; subflags(a, b, r);
  U5r19 = r;
}
