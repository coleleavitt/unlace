:^CS^"rcr" DR, SV^FCZ is CS & fb21=0 & fb22=0 & fb23=1 & fb24=0 & fb25=0 & fb26=0 & fb27=0 & DR & SV & FCZ & RT { build CS; local vd:4 = DR; local vs:4 = SV; local cm:4 = zext(C) * 0xffffffff; local sh:4 = vs & 31; res = (vd >> sh) | (cm & ~(0xffffffff >> sh)); local cb:4 = (vd >> ((sh - 1) & 31)) & 1; cf = ((zext(sh != 0) * cb) | (zext(sh == 0) * (vd & 1))) != 0; zf = res == 0; DR = res; build FCZ; build RT; }
