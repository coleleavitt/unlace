popdst: "L2" is pp_grp=3 & pp_reg=6 { L2 = MVTMP; }
popdst: "L3" is pp_grp=3 & pp_reg=7 { L3 = MVTMP; }
popdst: "A0.X" is pp_grp=4 & pp_reg=0 { A0.X = MVTMP:1; }
popdst: "A0.W" is pp_grp=4 & pp_reg=1 { A0.W = MVTMP; }
popdst: "A1.X" is pp_grp=4 & pp_reg=2 { A1.X = MVTMP:1; }
popdst: "A1.W" is pp_grp=4 & pp_reg=3 { A1.W = MVTMP; }
popdst: "ASTAT" is pp_grp=4 & pp_reg=6 { unpackASTAT(MVTMP); }
popdst: "RETS" is pp_grp=4 & pp_reg=7 { RETS = MVTMP; }
popdst: "LC0" is pp_grp=6 & pp_reg=0 { LC0 = MVTMP; }
popdst: "LT0" is pp_grp=6 & pp_reg=1 { LT0 = MVTMP; }
popdst: "LB0" is pp_grp=6 & pp_reg=2 { LB0 = MVTMP; }
popdst: "LC1" is pp_grp=6 & pp_reg=3 { LC1 = MVTMP; }
popdst: "LT1" is pp_grp=6 & pp_reg=4 { LT1 = MVTMP; }
popdst: "LB1" is pp_grp=6 & pp_reg=5 { LB1 = MVTMP; }
popdst: "CYCLES" is pp_grp=6 & pp_reg=6 { CYCLES = MVTMP; }
popdst: "CYCLES2" is pp_grp=6 & pp_reg=7 { CYCLES2 = MVTMP; }
popdst: "USP" is pp_grp=7 & pp_reg=0 { USP = MVTMP; }
popdst: "SEQSTAT" is pp_grp=7 & pp_reg=1 { SEQSTAT = MVTMP; }
popdst: "SYSCFG" is pp_grp=7 & pp_reg=2 { SYSCFG = MVTMP; }
popdst: "RETI" is pp_grp=7 & pp_reg=3 { RETI = MVTMP; }
popdst: "RETX" is pp_grp=7 & pp_reg=4 { RETX = MVTMP; }
popdst: "RETN" is pp_grp=7 & pp_reg=5 { RETN = MVTMP; }
popdst: "RETE" is pp_grp=7 & pp_reg=6 { RETE = MVTMP; }
popdst: "EMUDAT" is pp_grp=7 & pp_reg=7 { EMUDAT = MVTMP; }

ins16: "[--SP] = "^pushsrc is op9=0x002 & pp_W=1 & pushsrc { push(pushsrc); }
ins16: popdst^" = [SP++]" is op9=0x002 & pp_W=0 & popdst { pop(MVTMP); build popdst; }

# ---------------------------------------------------------------- PushPopMultiple
pushD: "R7:"0 is pm_dr=0 { SP = SP - 4; *:4 SP = R0; SP = SP - 4; *:4 SP = R1; SP = SP - 4; *:4 SP = R2; SP = SP - 4; *:4 SP = R3; SP = SP - 4; *:4 SP = R4; SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"0 is pm_dr=0 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; R4 = *:4 SP; SP = SP + 4; R3 = *:4 SP; SP = SP + 4; R2 = *:4 SP; SP = SP + 4; R1 = *:4 SP; SP = SP + 4; R0 = *:4 SP; SP = SP + 4; }
pushD: "R7:"1 is pm_dr=1 { SP = SP - 4; *:4 SP = R1; SP = SP - 4; *:4 SP = R2; SP = SP - 4; *:4 SP = R3; SP = SP - 4; *:4 SP = R4; SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"1 is pm_dr=1 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; R4 = *:4 SP; SP = SP + 4; R3 = *:4 SP; SP = SP + 4; R2 = *:4 SP; SP = SP + 4; R1 = *:4 SP; SP = SP + 4; }
pushD: "R7:"2 is pm_dr=2 { SP = SP - 4; *:4 SP = R2; SP = SP - 4; *:4 SP = R3; SP = SP - 4; *:4 SP = R4; SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"2 is pm_dr=2 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; R4 = *:4 SP; SP = SP + 4; R3 = *:4 SP; SP = SP + 4; R2 = *:4 SP; SP = SP + 4; }
pushD: "R7:"3 is pm_dr=3 { SP = SP - 4; *:4 SP = R3; SP = SP - 4; *:4 SP = R4; SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"3 is pm_dr=3 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; R4 = *:4 SP; SP = SP + 4; R3 = *:4 SP; SP = SP + 4; }
pushD: "R7:"4 is pm_dr=4 { SP = SP - 4; *:4 SP = R4; SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"4 is pm_dr=4 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; R4 = *:4 SP; SP = SP + 4; }
pushD: "R7:"5 is pm_dr=5 { SP = SP - 4; *:4 SP = R5; SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"5 is pm_dr=5 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; R5 = *:4 SP; SP = SP + 4; }
pushD: "R7:"6 is pm_dr=6 { SP = SP - 4; *:4 SP = R6; SP = SP - 4; *:4 SP = R7; }
popD: "R7:"6 is pm_dr=6 { R7 = *:4 SP; SP = SP + 4; R6 = *:4 SP; SP = SP + 4; }
pushD: "R7:"7 is pm_dr=7 { SP = SP - 4; *:4 SP = R7; }
popD: "R7:"7 is pm_dr=7 { R7 = *:4 SP; SP = SP + 4; }
pushP: "P5:"0 is pm_pr=0 { SP = SP - 4; *:4 SP = P0; SP = SP - 4; *:4 SP = P1; SP = SP - 4; *:4 SP = P2; SP = SP - 4; *:4 SP = P3; SP = SP - 4; *:4 SP = P4; SP = SP - 4; *:4 SP = P5; }
popP: "P5:"0 is pm_pr=0 { P5 = *:4 SP; SP = SP + 4; P4 = *:4 SP; SP = SP + 4; P3 = *:4 SP; SP = SP + 4; P2 = *:4 SP; SP = SP + 4; P1 = *:4 SP; SP = SP + 4; P0 = *:4 SP; SP = SP + 4; }
pushP: "P5:"1 is pm_pr=1 { SP = SP - 4; *:4 SP = P1; SP = SP - 4; *:4 SP = P2; SP = SP - 4; *:4 SP = P3; SP = SP - 4; *:4 SP = P4; SP = SP - 4; *:4 SP = P5; }
popP: "P5:"1 is pm_pr=1 { P5 = *:4 SP; SP = SP + 4; P4 = *:4 SP; SP = SP + 4; P3 = *:4 SP; SP = SP + 4; P2 = *:4 SP; SP = SP + 4; P1 = *:4 SP; SP = SP + 4; }
pushP: "P5:"2 is pm_pr=2 { SP = SP - 4; *:4 SP = P2; SP = SP - 4; *:4 SP = P3; SP = SP - 4; *:4 SP = P4; SP = SP - 4; *:4 SP = P5; }
popP: "P5:"2 is pm_pr=2 { P5 = *:4 SP; SP = SP + 4; P4 = *:4 SP; SP = SP + 4; P3 = *:4 SP; SP = SP + 4; P2 = *:4 SP; SP = SP + 4; }
pushP: "P5:"3 is pm_pr=3 { SP = SP - 4; *:4 SP = P3; SP = SP - 4; *:4 SP = P4; SP = SP - 4; *:4 SP = P5; }
popP: "P5:"3 is pm_pr=3 { P5 = *:4 SP; SP = SP + 4; P4 = *:4 SP; SP = SP + 4; P3 = *:4 SP; SP = SP + 4; }
pushP: "P5:"4 is pm_pr=4 { SP = SP - 4; *:4 SP = P4; SP = SP - 4; *:4 SP = P5; }
popP: "P5:"4 is pm_pr=4 { P5 = *:4 SP; SP = SP + 4; P4 = *:4 SP; SP = SP + 4; }
pushP: "P5:"5 is pm_pr=5 { SP = SP - 4; *:4 SP = P5; }
popP: "P5:"5 is pm_pr=5 { P5 = *:4 SP; SP = SP + 4; }

ins16: "[--SP] = ("^pushD^", "^pushP^")" is op7=0x002 & pm_W=1 & pm_d=1 & pm_p=1 & pushD & pushP { build pushD; build pushP; }
ins16: "[--SP] = ("^pushD^")" is op7=0x002 & pm_W=1 & pm_d=1 & pm_p=0 & pm_pr=0 & pushD { build pushD; }
ins16: "[--SP] = ("^pushP^")" is op7=0x002 & pm_W=1 & pm_d=0 & pm_p=1 & pm_dr=0 & pushP { build pushP; }
ins16: "("^popD^", "^popP^") = [SP++]" is op7=0x002 & pm_W=0 & pm_d=1 & pm_p=1 & popD & popP { build popP; build popD; }
ins16: "("^popD^") = [SP++]" is op7=0x002 & pm_W=0 & pm_d=1 & pm_p=0 & pm_pr=0 & popD { build popD; }
ins16: "("^popP^") = [SP++]" is op7=0x002 & pm_W=0 & pm_d=0 & pm_p=1 & pm_dr=0 & popP { build popP; }

# ---------------------------------------------------------------- ccMV
cmdst: dB is cm_d=0 & dB { export dB; }
cmdst: pB is cm_d=1 & pB { export pB; }
cmsrc: dA is cm_s=0 & dA { export dA; }
cmsrc: pA is cm_s=1 & pA { export pA; }
ins16: "IF CC "^cmdst^" = "^cmsrc is op7=0x003 & cm_T=1 & cmdst & cmsrc { if (CC == 0) goto inst_next; cmdst = cmsrc; }
ins16: "IF !CC "^cmdst^" = "^cmsrc is op7=0x003 & cm_T=0 & cmdst & cmsrc { if (CC != 0) goto inst_next; cmdst = cmsrc; }

# ---------------------------------------------------------------- CCflag
cfx: dA is cf_G=0 & dA { export dA; }
cfx: pA is cf_G=1 & pA { export pA; }
cfy: dB is cf_G=0 & cf_I=0 & dB { export dB; }
cfy: pB is cf_G=1 & cf_I=0 & pB { export pB; }
cfy: cf_ys is cf_I=1 & cf_ys { export *[const]:4 cf_ys; }
cfyu: dB is cf_G=0 & cf_I=0 & dB { export dB; }
cfyu: pB is cf_G=1 & cf_I=0 & pB { export pB; }
cfyu: cf_yu is cf_I=1 & cf_yu { export *[const]:4 cf_yu; }
ins16: "CC = "^cfx^" == "^cfy is op5=0x01 & cf_opc=0 & cfx & cfy { CC = cfx == cfy; }
ins16: "CC = "^cfx^" < "^cfy is op5=0x01 & cf_opc=1 & cfx & cfy { CC = cfx s< cfy; }
ins16: "CC = "^cfx^" <= "^cfy is op5=0x01 & cf_opc=2 & cfx & cfy { CC = cfx s<= cfy; }
ins16: "CC = "^cfx^" < "^cfyu^" (IU)" is op5=0x01 & cf_opc=3 & cfx & cfyu { CC = cfx < cfyu; }
ins16: "CC = "^cfx^" <= "^cfyu^" (IU)" is op5=0x01 & cf_opc=4 & cfx & cfyu { CC = cfx <= cfyu; }
ins16: "CC = A0 == A1" is op5=0x01 & cf_opc=5 & cf_I=0 & cf_G=0 & b0_2=0 & b3_5=0 { local a:8 = sext(A0:5); local b:8 = sext(A1:5); CC = a == b; }
ins16: "CC = A0 < A1" is op5=0x01 & cf_opc=6 & cf_I=0 & cf_G=0 & b0_2=0 & b3_5=0 { local a:8 = sext(A0:5); local b:8 = sext(A1:5); CC = a s< b; }
ins16: "CC = A0 <= A1" is op5=0x01 & cf_opc=7 & cf_I=0 & cf_G=0 & b0_2=0 & b3_5=0 { local a:8 = sext(A0:5); local b:8 = sext(A1:5); CC = a s<= b; }

# ---------------------------------------------------------------- CC2dreg / CC2stat
ins16: dA^" = CC" is op11=0x010 & c2_op=0 & dA { dA = zext(CC); }
ins16: "CC = "^dA is op11=0x010 & c2_op=1 & dA { CC = dA != 0; }
ins16: "CC = !CC" is op11=0x010 & c2_op=3 & b0_2=0 { CC = !CC; }

stbit: "AZ" is cs_cbit=0 { export AZ; }
stbit: "AN" is cs_cbit=1 { export AN; }
stbit: "AC0_COPY" is cs_cbit=2 { export AC0_COPY; }
stbit: "V_COPY" is cs_cbit=3 { export V_COPY; }
stbit: "AQ" is cs_cbit=6 { export AQ; }
stbit: "RND_MOD" is cs_cbit=8 { export RND_MOD; }
stbit: "AC0" is cs_cbit=12 { export AC0; }
stbit: "AC1" is cs_cbit=13 { export AC1; }
stbit: "AV0" is cs_cbit=16 { export AV0; }
stbit: "AV0S" is cs_cbit=17 { export AV0S; }
stbit: "AV1" is cs_cbit=18 { export AV1; }
stbit: "AV1S" is cs_cbit=19 { export AV1S; }
stbit: "V" is cs_cbit=24 { export V; }
stbit: "VS" is cs_cbit=25 { export VS; }
ins16: "CC = "^stbit is op8=0x03 & cs_D=0 & cs_op=0 & stbit { CC = stbit; }
ins16: "CC |= "^stbit is op8=0x03 & cs_D=0 & cs_op=1 & stbit { CC = CC | stbit; }
ins16: "CC &= "^stbit is op8=0x03 & cs_D=0 & cs_op=2 & stbit { CC = CC & stbit; }
ins16: "CC ^= "^stbit is op8=0x03 & cs_D=0 & cs_op=3 & stbit { CC = CC ^ stbit; }
ins16: stbit^" = CC" is op8=0x03 & cs_D=1 & cs_op=0 & stbit { stbit = CC; }
ins16: stbit^" |= CC" is op8=0x03 & cs_D=1 & cs_op=1 & stbit { stbit = stbit | CC; }
ins16: stbit^" &= CC" is op8=0x03 & cs_D=1 & cs_op=2 & stbit { stbit = stbit & CC; }
ins16: stbit^" ^= CC" is op8=0x03 & cs_D=1 & cs_op=3 & stbit { stbit = stbit ^ CC; }

# ---------------------------------------------------------------- branches
brtgt: reloc is br_off [ reloc = inst_start + (br_off << 1); ] { export *:4 reloc; }
ujtgt: reloc is uj_off [ reloc = inst_start + (uj_off << 1); ] { export *:4 reloc; }
bphint: "" is br_B=0 { }
bphint: " (BP)" is br_B=1 { }
ins16: "IF CC JUMP "^brtgt^bphint is op4=0x1 & br_T=1 & brtgt & bphint { if (CC) goto brtgt; }
ins16: "IF !CC JUMP "^brtgt^bphint is op4=0x1 & br_T=0 & brtgt & bphint { if (!CC) goto brtgt; }
ins16: "JUMP.S "^ujtgt is op4=0x2 & ujtgt { goto ujtgt; }

# ---------------------------------------------------------------- REGMV
mvsrc: "R0" is rm_gs=0 & rm_src=0 { export R0; }
mvsrc: "R1" is rm_gs=0 & rm_src=1 { export R1; }
mvsrc: "R2" is rm_gs=0 & rm_src=2 { export R2; }
