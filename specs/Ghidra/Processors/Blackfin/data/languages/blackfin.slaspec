mg1: xdAH is xm_h11=1 & xdAH { export xdAH; }
mmv: "" is d_mmod & d_MM { local v:1 = d_mmod | (d_MM << 4); export v; }
macopt: "" is d_P=0 & d_mmod=0 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M)" is d_P=0 & d_mmod=0 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (S2RND)" is d_P=0 & d_mmod=1 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, S2RND)" is d_P=0 & d_mmod=1 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (T)" is d_P=0 & d_mmod=2 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, T)" is d_P=0 & d_mmod=2 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (W32)" is d_P=0 & d_mmod=3 & d_w1=0 & xm_w0=0 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, W32)" is d_P=0 & d_mmod=3 & d_w1=0 & xm_w0=0 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (FU)" is d_P=0 & d_mmod=4 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, FU)" is d_P=0 & d_mmod=4 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (TFU)" is d_P=0 & d_mmod=6 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, TFU)" is d_P=0 & d_mmod=6 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (IS)" is d_P=0 & d_mmod=8 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, IS)" is d_P=0 & d_mmod=8 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (ISS2)" is d_P=0 & d_mmod=9 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, ISS2)" is d_P=0 & d_mmod=9 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (IH)" is d_P=0 & d_mmod=11 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, IH)" is d_P=0 & d_mmod=11 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (IU)" is d_P=0 & d_mmod=12 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, IU)" is d_P=0 & d_mmod=12 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: "" is d_P=1 & d_mmod=0 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M)" is d_P=1 & d_mmod=0 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (S2RND)" is d_P=1 & d_mmod=1 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, S2RND)" is d_P=1 & d_mmod=1 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (W32)" is d_P=1 & d_mmod=3 & d_w1=0 & xm_w0=0 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, W32)" is d_P=1 & d_mmod=3 & d_w1=0 & xm_w0=0 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (FU)" is d_P=1 & d_mmod=4 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, FU)" is d_P=1 & d_mmod=4 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (IS)" is d_P=1 & d_mmod=8 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, IS)" is d_P=1 & d_mmod=8 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (ISS2)" is d_P=1 & d_mmod=9 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, ISS2)" is d_P=1 & d_mmod=9 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
macopt: " (IU)" is d_P=1 & d_mmod=12 & (d_MM=0 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) { }
macopt: " (M, IU)" is d_P=1 & d_mmod=12 & d_MM=1 & xm_w0=0 & xm_op0=3 { }
mulopt: "" is d_P=0 & d_mmod=0 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M)" is d_P=0 & d_mmod=0 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (S2RND)" is d_P=0 & d_mmod=1 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, S2RND)" is d_P=0 & d_mmod=1 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (T)" is d_P=0 & d_mmod=2 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, T)" is d_P=0 & d_mmod=2 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (FU)" is d_P=0 & d_mmod=4 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, FU)" is d_P=0 & d_mmod=4 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (TFU)" is d_P=0 & d_mmod=6 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, TFU)" is d_P=0 & d_mmod=6 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (IS)" is d_P=0 & d_mmod=8 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, IS)" is d_P=0 & d_mmod=8 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (ISS2)" is d_P=0 & d_mmod=9 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, ISS2)" is d_P=0 & d_mmod=9 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (IH)" is d_P=0 & d_mmod=11 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, IH)" is d_P=0 & d_mmod=11 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (IU)" is d_P=0 & d_mmod=12 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, IU)" is d_P=0 & d_mmod=12 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: "" is d_P=1 & d_mmod=0 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M)" is d_P=1 & d_mmod=0 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (S2RND)" is d_P=1 & d_mmod=1 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, S2RND)" is d_P=1 & d_mmod=1 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (FU)" is d_P=1 & d_mmod=4 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, FU)" is d_P=1 & d_mmod=4 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (IS)" is d_P=1 & d_mmod=8 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, IS)" is d_P=1 & d_mmod=8 & d_MM=1 & (d_w1=0 | xm_w0=0) { }
mulopt: " (ISS2)" is d_P=1 & d_mmod=9 & (d_MM=0 | (d_w1=1 & xm_w0=1)) { }
mulopt: " (M, ISS2)" is d_P=1 & d_mmod=9 & d_MM=1 & (d_w1=0 | xm_w0=0) { }

macsep: "" is (d_w1=0 & d_op1=3) | (xm_w0=0 & xm_op0=3) { }
macsep: ", " is (d_w1=1 | d_op1=0 | d_op1=1 | d_op1=2) & (xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) & d_MM=0 { }
macsep: " (M), " is (d_w1=1 | d_op1=0 | d_op1=1 | d_op1=2) & (xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) & d_MM=1 { }

mac0f: "A0 = "^mh0^" * "^mh1 is xm_op0=0 & mh0 & mh1 & mmv { A0 = dsp_mac(mh0, mh1, mmv); }
mac0f: "A0 += "^mh0^" * "^mh1 is xm_op0=1 & mh0 & mh1 & mmv { A0 = A0 + dsp_mac(mh0, mh1, mmv); }
mac0f: "A0 -= "^mh0^" * "^mh1 is xm_op0=2 & mh0 & mh1 & mmv { A0 = A0 - dsp_mac(mh0, mh1, mmv); }
mac1f: "A1 = "^mg0^" * "^mg1 is d_op1=0 & mg0 & mg1 & mmv { A1 = dsp_mac(mg0, mg1, mmv); }
mac1f: "A1 += "^mg0^" * "^mg1 is d_op1=1 & mg0 & mg1 & mmv { A1 = A1 + dsp_mac(mg0, mg1, mmv); }
mac1f: "A1 -= "^mg0^" * "^mg1 is d_op1=2 & mg0 & mg1 & mmv { A1 = A1 - dsp_mac(mg0, mg1, mmv); }

mac0p: "" is xm_w0=0 & xm_op0=3 { }
mac0p: mac0f is xm_w0=0 & mac0f { build mac0f; }
mac0p: xdCL^" = A0" is xm_w0=1 & xm_op0=3 & d_P=0 & xdCL & mmv { xdCL = dsp_acc_extract(A0, mmv); }
mac0p: xdC^" = A0" is xm_w0=1 & xm_op0=3 & d_P=1 & xdC & mmv { xdC = dsp_acc_extract32(A0, mmv); }
mac0p: xdCL^" = ("^mac0f^")" is xm_w0=1 & d_P=0 & xdCL & mac0f & mmv { build mac0f; xdCL = dsp_acc_extract(A0, mmv); }
mac0p: xdC^" = ("^mac0f^")" is xm_w0=1 & d_P=1 & xdC & mac0f & mmv { build mac0f; xdC = dsp_acc_extract32(A0, mmv); }
mac1p: "" is d_w1=0 & d_op1=3 { }
mac1p: mac1f is d_w1=0 & mac1f { build mac1f; }
mac1p: xdCH^" = A1" is d_w1=1 & d_op1=3 & d_P=0 & xdCH & mmv { xdCH = dsp_acc_extract(A1, mmv); }
mac1p: xdCp^" = A1" is d_w1=1 & d_op1=3 & d_P=1 & xdCp & mmv { xdCp = dsp_acc_extract32(A1, mmv); }
mac1p: xdCH^" = ("^mac1f^")" is d_w1=1 & d_P=0 & xdCH & mac1f & mmv { build mac1f; xdCH = dsp_acc_extract(A1, mmv); }
mac1p: xdCp^" = ("^mac1f^")" is d_w1=1 & d_P=1 & xdCp & mac1f & mmv { build mac1f; xdCp = dsp_acc_extract32(A1, mmv); }
dsp32: mac1p^macsep^mac0p^macopt is e_op4=0xc & d_code2=0 & (d_w1=1 | d_op1=0 | d_op1=1 | d_op1=2 | xm_w0=1 | xm_op0=0 | xm_op0=1 | xm_op0=2) & (d_MM=0 | d_op1=0 | d_op1=1 | d_op1=2) & mac1p & macsep & mac0p & macopt { build mac1p; build mac0p; }

mul0: "" is xm_w0=0 { }
mul0: xdCL^" = "^mh0^" * "^mh1 is xm_w0=1 & d_P=0 & xdCL & mh0 & mh1 & mmv { xdCL = dsp_mult16(mh0, mh1, mmv); }
mul0: xdC^" = "^mh0^" * "^mh1 is xm_w0=1 & d_P=1 & xdC & mh0 & mh1 & mmv { xdC = dsp_mult32(mh0, mh1, mmv); }
mul1: "" is d_w1=0 { }
mul1: xdCH^" = "^mg0^" * "^mg1 is d_w1=1 & d_P=0 & xdCH & mg0 & mg1 & mmv { xdCH = dsp_mult16(mg0, mg1, mmv); }
mul1: xdCp^" = "^mg0^" * "^mg1 is d_w1=1 & d_P=1 & xdCp & mg0 & mg1 & mmv { xdCp = dsp_mult32(mg0, mg1, mmv); }
mulsep: "" is d_w1=0 | xm_w0=0 { }
mulsep: ", " is d_w1=1 & xm_w0=1 & d_MM=0 { }
mulsep: " (M), " is d_w1=1 & xm_w0=1 & d_MM=1 { }
dsp32: mul1^mulsep^mul0^mulopt is e_op4=0xc & d_code2=1 & (d_w1=1 | xm_w0=1) & mul1 & mulsep & mul0 & mulopt { build mul1; build mul0; }

# ---------------------------------------------------------------- dsp32alu
d0h: xdDL is d_HL=0 & xdDL { export xdDL; }
d0h: xdDH is d_HL=1 & xdDH { export xdDH; }
as0: xdBL is xa_aop=0 & xdBL { export xdBL; }
as0: xdBL is xa_aop=1 & xdBL { export xdBL; }
as0: xdBH is xa_aop=2 & xdBH { export xdBH; }
as0: xdBH is xa_aop=3 & xdBH { export xdBH; }
as1: xdAL is xa_aop=0 & xdAL { export xdAL; }
as1: xdAH is xa_aop=1 & xdAH { export xdAH; }
as1: xdAL is xa_aop=2 & xdAL { export xdAL; }
as1: xdAH is xa_aop=3 & xdAH { export xdAH; }
amod: " (NS)" is xa_s=0 { }
amod: " (S)" is xa_s=1 { }

dsp32: xdD^" = "^xdB^" + "^xdA^" (NS)" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=4 & xa_aop=0 & xa_s=0 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; xdD = a + b; addflags(a, b, xdD); }
dsp32: xdD^" = "^xdB^" + "^xdA^" (S)" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=4 & xa_aop=0 & xa_s=1 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; local r:4 = 0; sat32(a, b, r); xdD = r; nzflags(r); }
dsp32: xdD^" = "^xdB^" - "^xdA^" (NS)" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=4 & xa_aop=1 & xa_s=0 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; xdD = a - b; subflags(a, b, xdD); }
dsp32: xdD^" = "^xdB^" - "^xdA^" (S)" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=4 & xa_aop=1 & xa_s=1 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; local r:4 = 0; satsub32(a, b, r); xdD = r; nzflags(r); }
dsp32: xdC^" = "^xdB^" + "^xdA^", "^xdD^" = "^xdB2^" - "^xdA2^amod is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=4 & xa_aop=2 & xdC & xdD & xdB & xdA & xdB2 & xdA2 & amod { local a:4 = xdB; local b:4 = xdA; xdC = a + b; xdD = a - b; }
dsp32: xdD^" = MAX ("^xdB^", "^xdA^")" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=7 & xa_aop=0 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; local c:1 = b s> a; xdD = (zext(c) * b) + (zext(c == 0) * a); nzflags(xdD); }
dsp32: xdD^" = MIN ("^xdB^", "^xdA^")" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=7 & xa_aop=1 & xdD & xdB & xdA { local a:4 = xdB; local b:4 = xdA; local c:1 = b s< a; xdD = (zext(c) * b) + (zext(c == 0) * a); nzflags(xdD); }
dsp32: xdD^" = ABS "^xdB is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=7 & xa_aop=2 & xdD & xdB { local a:4 = xdB; local c:1 = a s< 0; xdD = (zext(c) * (-a)) + (zext(c == 0) * a); nzflags(xdD); }
dsp32: xdD^" = -"^xdB^amod is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=7 & xa_aop=3 & d_HL=0 & xdD & xdB & amod { local a:4 = xdB; xdD = -a; nzflags(xdD); }
dsp32: d0h^" = "^as0^" + "^as1^amod is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=2 & d0h & as0 & as1 & amod { d0h = as0 + as1; }
dsp32: d0h^" = "^as0^" - "^as1^amod is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=3 & d0h & as0 & as1 & amod { d0h = as0 - as1; }
dsp32: "A0 = "^xdB is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=0 & xa_s=1 & xdB { A0 = sext(xdB); }
dsp32: "A1 = "^xdB is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=2 & xa_s=1 & xdB { A1 = sext(xdB); }
dsp32: "A0.L = "^xdBL is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=0 & xa_s=0 & d_HL=0 & xdBL { A0.W = (A0.W & 0xffff0000) | zext(xdBL); }
dsp32: "A0.H = "^xdBH is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=0 & xa_s=0 & d_HL=1 & xdBH { A0.W = (A0.W & 0xffff) | (zext(xdBH) << 16); }
dsp32: "A1.L = "^xdBL is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=2 & xa_s=0 & d_HL=0 & xdBL { A1.W = (A1.W & 0xffff0000) | zext(xdBL); }
dsp32: "A1.H = "^xdBH is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=2 & xa_s=0 & d_HL=1 & xdBH { A1.W = (A1.W & 0xffff) | (zext(xdBH) << 16); }
dsp32: "A0.X = "^xdBL is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=1 & xa_s=0 & xdBL { A0.X = xdBL:1; }
dsp32: "A1.X = "^xdBL is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=9 & xa_aop=3 & xa_s=0 & xdBL { A1.X = xdBL:1; }
dsp32: "A0 = 0" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=8 & xa_aop=0 & xa_s=0 { A0 = 0; }
dsp32: "A1 = 0" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=8 & xa_aop=1 & xa_s=0 { A1 = 0; }
dsp32: "A1 = A0 = 0" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=8 & xa_aop=2 & xa_s=0 { A0 = 0; A1 = 0; }
dsp32: "A0 = A1" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=8 & xa_aop=3 & xa_s=0 { A0 = A1; }
dsp32: "A1 = A0" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=8 & xa_aop=3 & xa_s=1 { A1 = A0; }
dsp32: xdDL^" = A0.X" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=10 & xa_aop=0 & xdDL { xdDL = sext(A0.X); }
dsp32: xdDL^" = A1.X" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=10 & xa_aop=1 & xdDL { xdDL = sext(A1.X); }
dsp32: "A0 += A1" is e_op4=0xc & d_code2=2 & d_b6_8=0 & d_opc=11 & xa_aop=2 & xa_s=0 { A0 = A0 + A1; }
