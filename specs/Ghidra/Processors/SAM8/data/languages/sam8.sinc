:RR Rd_b1 is op=0xe0; Rd_b1 & Rpost_b1 {
	local d:1 = Rd_b1;
	local r:1 = (d >> 1) | (d << 7);
	C = d & 1;
	V = ((d ^ r) & 0x80) != 0;
	zs(r);
	Rd_b1 = r;
	build Rpost_b1;
}
:RR IRd_b1 is op=0xe1; IRd_b1 {
	local d:1 = IRd_b1;
	local r:1 = (d >> 1) | (d << 7);
	C = d & 1;
	V = ((d ^ r) & 0x80) != 0;
	zs(r);
	IRd_b1 = r;
}

# ---- loads ----
:LD Wr_ophi, "#"^b1 is oplo=0xc & Wr_ophi; b1 { Wr_ophi = b1; }
:LD Wr_ophi, Rd_b1 is oplo=0x8 & Wr_ophi; Rd_b1 { Wr_ophi = Rd_b1; }
:LD Rd_b1, Wr_ophi is oplo=0x9 & Wr_ophi; Rd_b1 & Rpost_b1 { Rd_b1 = Wr_ophi; build Rpost_b1; }
:LD Wr_b1hi, Ir_b1lo is op=0xc7; Wr_b1hi & Ir_b1lo { Wr_b1hi = Ir_b1lo; }
:LD Ir_b1hi, Wr_b1lo is op=0xd7; Ir_b1hi & Wr_b1lo { Ir_b1hi = Wr_b1lo; }
:LD Rd_b2, Rd_b1 is op=0xe4; Rd_b1; Rd_b2 & Rpost_b2 { Rd_b2 = Rd_b1; build Rpost_b2; }
:LD Rd_b2, IRd_b1 is op=0xe5; IRd_b1; Rd_b2 & Rpost_b2 { Rd_b2 = IRd_b1; build Rpost_b2; }
:LD Rd_b1, "#"^b2 is op=0xe6; Rd_b1 & Rpost_b1; b2 { Rd_b1 = b2; build Rpost_b1; }
:LD IRd_b1, "#"^b2 is op=0xd6; IRd_b1; b2 { IRd_b1 = b2; }
:LD IRd_b2, Rd_b1 is op=0xf5; Rd_b1; IRd_b2 { IRd_b2 = Rd_b1; }
:LD Wr_b1hi, "#"^b2^"["^Wr_b1lo^"]" is op=0x87; Wr_b1hi & Wr_b1lo; b2 { local a:1 = b2 + Wr_b1lo; Wr_b1hi = *[rf]:1 a; }
:LD "#"^b2^"["^Wr_b1lo^"]", Wr_b1hi is op=0x97; Wr_b1hi & Wr_b1lo; b2 { local a:1 = b2 + Wr_b1lo; *[rf]:1 a = Wr_b1hi; }

# working register pair for LDC/LDE: bit 0 of the nibble selects program (0) or data (1) memory
@ifdef SAM88RCRI
Wrrp_a28: wa is b1pe & b1los & b1pi [ wa = 0xc0 | (b1los << 3) | (b1pi << 1); ] { export *[rf]:2 wa; }
Wrrp: b1pe is b1pe & b1los & b1pi & Wrrp_a28 { export Wrrp_a28; }
@else
Wrrp_a29: wa is rp0v=1 & b1los=0 & b1pi & b1pe [ wa = (rp0 << 3) | (b1pi << 1); ] { export *[rf]:2 wa; }
Wrrp: b1pe is rp0v=1 & b1los=0 & b1pi & b1pe & Wrrp_a29 { export Wrrp_a29; }
Wrrp_a30: wa is rp1v=1 & b1los=1 & b1pi & b1pe [ wa = (rp1 << 3) | (b1pi << 1); ] { export *[rf]:2 wa; }
Wrrp: b1pe is rp1v=1 & b1los=1 & b1pi & b1pe & Wrrp_a30 { export Wrrp_a30; }
Wrrp: b1pe is rp0v=0 & b1los=0 & b1pi & b1pe { local a:1 = (RP0 & 0xf8) | (b1pi << 1); export *[rf]:2 a; }
Wrrp: b1pe is rp1v=0 & b1los=1 & b1pi & b1pe { local a:1 = (RP1 & 0xf8) | (b1pi << 1); export *[rf]:2 a; }
@endif
# long (16-bit) offset or address of LDC/LDE, low byte first
xl: val is b2; b3 [ val = (b3 << 8) | b2; ] { export *[const]:2 val; }

:LDC Wr_b1hi, "@"^Wrrp is op=0xc3; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[code]:1 a; }
:LDC "@"^Wrrp, Wr_b1hi is op=0xd3; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp; *[code]:1 a = Wr_b1hi; }
:LDC Wr_b1hi, "#"^b2s^"["^Wrrp^"]" is op=0xe7; Wr_b1hi & b1lo0=0 & Wrrp; b2s { local a:2 = Wrrp + b2s; Wr_b1hi = *[code]:1 a; }
:LDC "#"^b2s^"["^Wrrp^"]", Wr_b1hi is op=0xf7; Wr_b1hi & b1lo0=0 & Wrrp; b2s { local a:2 = Wrrp + b2s; *[code]:1 a = Wr_b1hi; }
:LDC Wr_b1hi, "#"^xl^"["^Wrrp^"]" is op=0xa7; Wr_b1hi & b1lo0=0 & Wrrp; xl { local a:2 = Wrrp + xl; Wr_b1hi = *[code]:1 a; }
:LDC "#"^xl^"["^Wrrp^"]", Wr_b1hi is op=0xb7; Wr_b1hi & b1lo0=0 & Wrrp; xl { local a:2 = Wrrp + xl; *[code]:1 a = Wr_b1hi; }
:LDC Wr_b1hi, xl is op=0xa7; Wr_b1hi & b1lo=0; xl { local a:2 = xl; Wr_b1hi = *[code]:1 a; }
:LDC xl, Wr_b1hi is op=0xb7; Wr_b1hi & b1lo=0; xl { local a:2 = xl; *[code]:1 a = Wr_b1hi; }
:LDCD Wr_b1hi, "@"^Wrrp is op=0xe2; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[code]:1 a; Wrrp = a - 1; }
:LDCI Wr_b1hi, "@"^Wrrp is op=0xe3; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[code]:1 a; Wrrp = a + 1; }
@ifndef SAM88RCRI
:LDCPD "@"^Wrrp, Wr_b1hi is op=0xf2; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp - 1; Wrrp = a; *[code]:1 a = Wr_b1hi; }
:LDCPI "@"^Wrrp, Wr_b1hi is op=0xf3; Wr_b1hi & b1lo0=0 & Wrrp { local a:2 = Wrrp + 1; Wrrp = a; *[code]:1 a = Wr_b1hi; }
@endif

:LDE Wr_b1hi, "@"^Wrrp is op=0xc3; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[data]:1 a; }
:LDE "@"^Wrrp, Wr_b1hi is op=0xd3; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp; *[data]:1 a = Wr_b1hi; }
:LDE Wr_b1hi, "#"^b2s^"["^Wrrp^"]" is op=0xe7; Wr_b1hi & b1lo0=1 & Wrrp; b2s { local a:2 = Wrrp + b2s; Wr_b1hi = *[data]:1 a; }
:LDE "#"^b2s^"["^Wrrp^"]", Wr_b1hi is op=0xf7; Wr_b1hi & b1lo0=1 & Wrrp; b2s { local a:2 = Wrrp + b2s; *[data]:1 a = Wr_b1hi; }
:LDE Wr_b1hi, "#"^xl^"["^Wrrp^"]" is op=0xa7; Wr_b1hi & b1lo0=1 & Wrrp; xl { local a:2 = Wrrp + xl; Wr_b1hi = *[data]:1 a; }
:LDE "#"^xl^"["^Wrrp^"]", Wr_b1hi is op=0xb7; Wr_b1hi & b1lo0=1 & Wrrp; xl { local a:2 = Wrrp + xl; *[data]:1 a = Wr_b1hi; }
:LDE Wr_b1hi, xl is op=0xa7; Wr_b1hi & b1lo=1; xl { local a:2 = xl; Wr_b1hi = *[data]:1 a; }
:LDE xl, Wr_b1hi is op=0xb7; Wr_b1hi & b1lo=1; xl { local a:2 = xl; *[data]:1 a = Wr_b1hi; }
:LDED Wr_b1hi, "@"^Wrrp is op=0xe2; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[data]:1 a; Wrrp = a - 1; }
:LDEI Wr_b1hi, "@"^Wrrp is op=0xe3; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp; Wr_b1hi = *[data]:1 a; Wrrp = a + 1; }
@ifndef SAM88RCRI
:LDEPD "@"^Wrrp, Wr_b1hi is op=0xf2; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp - 1; Wrrp = a; *[data]:1 a = Wr_b1hi; }
:LDEPI "@"^Wrrp, Wr_b1hi is op=0xf3; Wr_b1hi & b1lo0=1 & Wrrp { local a:2 = Wrrp + 1; Wrrp = a; *[data]:1 a = Wr_b1hi; }
@endif

# ---- stack ----
:POP Rd_b1 is op=0x50; Rd_b1 & Rpost_b1 { local v:1 = 0; pop8(v); Rd_b1 = v; build Rpost_b1; }
:POP IRd_b1 is op=0x51; IRd_b1 { local v:1 = 0; pop8(v); IRd_b1 = v; }
:PUSH Rd_b1 is op=0x70; Rd_b1 { local v:1 = Rd_b1; push8(v); }
:PUSH IRd_b1 is op=0x71; IRd_b1 { local v:1 = IRd_b1; push8(v); }

# ---- program control ----
:JR cc, rel_b1 is oplo=0xb & cc; rel_b1 { if (cc) goto rel_b1; }
:JR rel_b1 is ophi=0x8 & oplo=0xb; rel_b1 { goto rel_b1; }
:JP cc, dabs is oplo=0xd & cc; dabs { if (cc) goto dabs; }
:JP dabs is ophi=0x8 & oplo=0xd; dabs { goto dabs; }
:JP "@"^RRd_b1 is op=0x30; RRd_b1 { local t:2 = RRd_b1; goto [t]; }
:CALL dabs is op=0xf6; dabs { local ra:2 = inst_next; push16(ra); call dabs; }
:CALL "@"^RRd_b1 is op=0xf4; RRd_b1 { local t:2 = RRd_b1; local ra:2 = inst_next; push16(ra); call [t]; }
:RET is op=0xaf { local t:2 = 0; pop16(t); return [t]; }
:IRET is op=0xbf { pop8(FLAGS); unpackflags(); local t:2 = 0; pop16(t); enableInterrupts(); return [t]; }

# ---- CPU control ----
:DI is op=0x8f { disableInterrupts(); }
:EI is op=0x9f { enableInterrupts(); }
:RCF is op=0xcf { C = 0; }
:SCF is op=0xdf { C = 1; }
:CCF is op=0xef { C = !C; }
:NOP is op=0xff { }
:IDLE is op=0x6f { idle(); }
:STOP is op=0x7f { stop(); }

@ifndef SAM88RCRI
:DA Rd_b1 is op=0x40; Rd_b1 & Rpost_b1 {
	local d:1 = Rd_b1;
	local lo:1 = (H != 0) || ((d & 0xf) > 9);
	local hi:1 = (C != 0) || (d > 0x99);
	local adj:1 = (lo * 6) + (hi * 0x60);
	local sadj:1 = (H * 6) + (C * 0x60);
	local r:1 = ((D == 0) * (d + adj)) + ((D != 0) * (d - sadj));
	C = ((D == 0) && hi) || ((D != 0) && (C != 0));
	zs(r);
	Rd_b1 = r;
	build Rpost_b1;
}
:DA IRd_b1 is op=0x41; IRd_b1 {
	local d:1 = IRd_b1;
	local lo:1 = (H != 0) || ((d & 0xf) > 9);
	local hi:1 = (C != 0) || (d > 0x99);
	local adj:1 = (lo * 6) + (hi * 0x60);
	local sadj:1 = (H * 6) + (C * 0x60);
	local r:1 = ((D == 0) * (d + adj)) + ((D != 0) * (d - sadj));
	C = ((D == 0) && hi) || ((D != 0) && (C != 0));
	zs(r);
	IRd_b1 = r;
}
:SWAP Rd_b1 is op=0xf0; Rd_b1 & Rpost_b1 {
	local d:1 = Rd_b1;
	local r:1 = (d << 4) | (d >> 4);
	zs(r);
	Rd_b1 = r;
	build Rpost_b1;
}
:SWAP IRd_b1 is op=0xf1; IRd_b1 {
	local d:1 = IRd_b1;
	local r:1 = (d << 4) | (d >> 4);
	zs(r);
	IRd_b1 = r;
}
:DECW RRd_b1 is op=0x80; RRd_b1 {
	local d:2 = RRd_b1;
	local r:2 = d - 1;
	V = sborrow(d, 1);
	zs(r);
	RRd_b1 = r;
}
:DECW IRRd_b1 is op=0x81; IRRd_b1 {
	local d:2 = IRRd_b1;
	local r:2 = d - 1;
	V = sborrow(d, 1);
	zs(r);
	IRRd_b1 = r;
}
:INCW RRd_b1 is op=0xa0; RRd_b1 {
	local d:2 = RRd_b1;
	local r:2 = d + 1;
	V = scarry(d, 1);
	zs(r);
	RRd_b1 = r;
}
:INCW IRRd_b1 is op=0xa1; IRRd_b1 {
	local d:2 = IRRd_b1;
	local r:2 = d + 1;
	V = scarry(d, 1);
	zs(r);
	IRRd_b1 = r;
}

:DJNZ Wr_ophi, rel_b1 is oplo=0xa & Wr_ophi; rel_b1 { Wr_ophi = Wr_ophi - 1; if (Wr_ophi != 0) goto rel_b1; }
:CPIJE Wr_b1lo, Ir_b1hi, rel_b2 is op=0xc2; Wr_b1hi & Wr_b1lo & Ir_b1hi; rel_b2 {
	local v:1 = Ir_b1hi;
	Wr_b1hi = Wr_b1hi + 1;
	if (Wr_b1lo == v) goto rel_b2;
}
:CPIJNE Wr_b1lo, Ir_b1hi, rel_b2 is op=0xd2; Wr_b1hi & Wr_b1lo & Ir_b1hi; rel_b2 {
	local v:1 = Ir_b1hi;
	Wr_b1hi = Wr_b1hi + 1;
	if (Wr_b1lo != v) goto rel_b2;
}
:LDW RRd_b2, RRd_b1 is op=0xc4; RRd_b1; RRd_b2 { RRd_b2 = RRd_b1; }
:LDW RRd_b2, IRRd_b1 is op=0xc5; IRRd_b1; RRd_b2 { RRd_b2 = IRRd_b1; }
:LDW RRd_b1, "#"^w16 is op=0xc6; RRd_b1; w16 { RRd_b1 = w16; }
:PUSHUD IRd_b1, Rd_b2 is op=0x82; Rd_b1 & IRd_b1; Rd_b2 { local v:1 = Rd_b2; Rd_b1 = Rd_b1 - 1; local p:1 = Rd_b1; *[rf]:1 p = v; }
:PUSHUI IRd_b1, Rd_b2 is op=0x83; Rd_b1 & IRd_b1; Rd_b2 { local v:1 = Rd_b2; Rd_b1 = Rd_b1 + 1; local p:1 = Rd_b1; *[rf]:1 p = v; }
:POPUD Rd_b2, IRd_b1 is op=0x92; Rd_b1 & IRd_b1; Rd_b2 & Rpost_b2 { Rd_b2 = IRd_b1; Rd_b1 = Rd_b1 - 1; build Rpost_b2; }
:POPUI Rd_b2, IRd_b1 is op=0x93; Rd_b1 & IRd_b1; Rd_b2 & Rpost_b2 { Rd_b2 = IRd_b1; Rd_b1 = Rd_b1 + 1; build Rpost_b2; }

:MULT RRd_b2, Rd_b1 is op=0x84; Rd_b1; RRd_b2 {
	local s:1 = Rd_b1;
	local p:2 = (RRd_b2 >> 8) * zext(s);
	C = p > 0xff;
	Z = (p == 0);
	S = (p s< 0);
	V = 0;
	RRd_b2 = p;
}
:MULT RRd_b2, IRd_b1 is op=0x85; IRd_b1; RRd_b2 {
	local s:1 = IRd_b1;
	local p:2 = (RRd_b2 >> 8) * zext(s);
	C = p > 0xff;
	Z = (p == 0);
	S = (p s< 0);
	V = 0;
	RRd_b2 = p;
}
:MULT RRd_b2, "#"^b1 is op=0x86; b1; RRd_b2 {
	local s:1 = b1;
	local p:2 = (RRd_b2 >> 8) * zext(s);
	C = p > 0xff;
	Z = (p == 0);
	S = (p s< 0);
	V = 0;
	RRd_b2 = p;
}
:DIV RRd_b2, Rd_b1 is op=0x94; Rd_b1; RRd_b2 {
	local s:1 = Rd_b1;
	local n:2 = RRd_b2;
	V = (s == 0);
	Z = V;
	C = 0;
	S = 0;
	if (s == 0) goto <done>;
	local q:2 = n / zext(s);
	local rm:2 = n % zext(s);
	V = q > 0xff;
	C = V && (q < 0x200);
	Z = (q == 0);
	S = (q & 0x80) != 0;
	RRd_b2 = (rm << 8) | (q & 0xff);
<done>
}
:DIV RRd_b2, IRd_b1 is op=0x95; IRd_b1; RRd_b2 {
	local s:1 = IRd_b1;
	local n:2 = RRd_b2;
	V = (s == 0);
	Z = V;
	C = 0;
	S = 0;
	if (s == 0) goto <done>;
	local q:2 = n / zext(s);
	local rm:2 = n % zext(s);
	V = q > 0xff;
	C = V && (q < 0x200);
	Z = (q == 0);
	S = (q & 0x80) != 0;
	RRd_b2 = (rm << 8) | (q & 0xff);
<done>
}
:DIV RRd_b2, "#"^b1 is op=0x96; b1; RRd_b2 {
	local s:1 = b1;
	local n:2 = RRd_b2;
	V = (s == 0);
	Z = V;
	C = 0;
	S = 0;
	if (s == 0) goto <done>;
	local q:2 = n / zext(s);
	local rm:2 = n % zext(s);
	V = q > 0xff;
	C = V && (q < 0x200);
	Z = (q == 0);
	S = (q & 0x80) != 0;
	RRd_b2 = (rm << 8) | (q & 0xff);
<done>
}

:BOR Wr_b1hi, Rd_b2^"."^b1bit is op=0x07; Wr_b1hi & b1bit & b1dir=0; Rd_b2 {
	local bit:1 = (Rd_b2 >> b1bit) & 1;
	local r:1 = (Wr_b1hi & 1) | bit;
	Wr_b1hi = (Wr_b1hi & 0xfe) | r;
	Z = (r == 0);
	S = 0;
}
:BOR Rd_b2^"."^b1bit, Wr_b1hi is op=0x07; Wr_b1hi & b1bit & b1dir=1; Rd_b2 & Rpost_b2 {
	local d:1 = Rd_b2;
	local r:1 = ((d >> b1bit) & 1) | (Wr_b1hi & 1);
	Rd_b2 = (d & ~(1 << b1bit)) | (r << b1bit);
	Z = (r == 0);
	S = 0;
	build Rpost_b2;
}
:BXOR Wr_b1hi, Rd_b2^"."^b1bit is op=0x27; Wr_b1hi & b1bit & b1dir=0; Rd_b2 {
	local bit:1 = (Rd_b2 >> b1bit) & 1;
	local r:1 = (Wr_b1hi & 1) ^ bit;
	Wr_b1hi = (Wr_b1hi & 0xfe) | r;
	Z = (r == 0);
	S = 0;
}
:BXOR Rd_b2^"."^b1bit, Wr_b1hi is op=0x27; Wr_b1hi & b1bit & b1dir=1; Rd_b2 & Rpost_b2 {
	local d:1 = Rd_b2;
	local r:1 = ((d >> b1bit) & 1) ^ (Wr_b1hi & 1);
	Rd_b2 = (d & ~(1 << b1bit)) | (r << b1bit);
	Z = (r == 0);
	S = 0;
	build Rpost_b2;
}
:BAND Wr_b1hi, Rd_b2^"."^b1bit is op=0x67; Wr_b1hi & b1bit & b1dir=0; Rd_b2 {
	local bit:1 = (Rd_b2 >> b1bit) & 1;
	local r:1 = (Wr_b1hi & 1) & bit;
	Wr_b1hi = (Wr_b1hi & 0xfe) | r;
	Z = (r == 0);
	S = 0;
}
:BAND Rd_b2^"."^b1bit, Wr_b1hi is op=0x67; Wr_b1hi & b1bit & b1dir=1; Rd_b2 & Rpost_b2 {
	local d:1 = Rd_b2;
	local r:1 = ((d >> b1bit) & 1) & (Wr_b1hi & 1);
	Rd_b2 = (d & ~(1 << b1bit)) | (r << b1bit);
	Z = (r == 0);
	S = 0;
	build Rpost_b2;
}
:BCP Wr_b1hi, Rd_b2^"."^b1bit is op=0x17; Wr_b1hi & b1bit & b1dir=0; Rd_b2 {
	local bit:1 = (Rd_b2 >> b1bit) & 1;
	Z = (Wr_b1hi & 1) == bit;
	S = 0;
}
:LDB Wr_b1hi, Rd_b2^"."^b1bit is op=0x47; Wr_b1hi & b1bit & b1dir=0; Rd_b2 {
	Wr_b1hi = (Wr_b1hi & 0xfe) | ((Rd_b2 >> b1bit) & 1);
}
:LDB Rd_b2^"."^b1bit, Wr_b1hi is op=0x47; Wr_b1hi & b1bit & b1dir=1; Rd_b2 & Rpost_b2 {
	Rd_b2 = (Rd_b2 & ~(1 << b1bit)) | ((Wr_b1hi & 1) << b1bit);
	build Rpost_b2;
}
:BTJRF rel_b2, Wr_b1hi^"."^b1bit is op=0x37; Wr_b1hi & b1bit & b1dir=0; rel_b2 {
	if (((Wr_b1hi >> b1bit) & 1) == 0) goto rel_b2;
}
:BTJRT rel_b2, Wr_b1hi^"."^b1bit is op=0x37; Wr_b1hi & b1bit & b1dir=1; rel_b2 {
	if (((Wr_b1hi >> b1bit) & 1) != 0) goto rel_b2;
}
:BITC Wr_b1hi^"."^b1bit is op=0x57; Wr_b1hi & b1bit & b1dir=0 {
	local r:1 = Wr_b1hi ^ (1 << b1bit);
	Wr_b1hi = r;
	Z = ((r >> b1bit) & 1) == 0;
	S = 0;
}
:BITR Wr_b1hi^"."^b1bit is op=0x77; Wr_b1hi & b1bit & b1dir=0 { Wr_b1hi = Wr_b1hi & ~(1 << b1bit); }
:BITS Wr_b1hi^"."^b1bit is op=0x77; Wr_b1hi & b1bit & b1dir=1 { Wr_b1hi = Wr_b1hi | (1 << b1bit); }

:CALL "#"^b1 is op=0xd4; b1 { local t:2 = *[code]:2 b1:2; local ra:2 = inst_next; push16(ra); call [t]; }
:SRP "#"^b1 is op=0x31; b1 & b1lo2=0 [ rp0v = 1; rp1v = 1; rp0 = (b1 >> 3) & 0x1e; rp1 = ((b1 >> 3) & 0x1e) | 1;
		globalset(inst_next, rp0v); globalset(inst_next, rp1v); globalset(inst_next, rp0); globalset(inst_next, rp1); ] {
	RP0 = b1 & 0xf0;
	RP1 = (b1 & 0xf0) | 8;
}
:SRP0 "#"^b1 is op=0x31; b1 & b1lo2=2 [ rp0v = 1; rp0 = b1 >> 3; globalset(inst_next, rp0v); globalset(inst_next, rp0); ] {
	RP0 = b1 & 0xf8;
}
:SRP1 "#"^b1 is op=0x31; b1 & b1lo2=1 [ rp1v = 1; rp1 = b1 >> 3; globalset(inst_next, rp1v); globalset(inst_next, rp1); ] {
	RP1 = b1 & 0xf8;
}
:NEXT is op=0x0f { local t:2 = *[code]:2 IP; IP = IP + 2; goto [t]; }
:ENTER is op=0x1f { push16(IP); IP = inst_next; local t:2 = *[code]:2 IP; IP = IP + 2; goto [t]; }
:EXIT is op=0x2f { pop16(IP); local t:2 = *[code]:2 IP; IP = IP + 2; goto [t]; }
:WFI is op=0x3f { waitForInterrupt(); }
:SB0 is op=0x4f [ bank = 0; globalset(inst_next, bank); ] { FLAGS = FLAGS & 0xfe; }
:SB1 is op=0x5f [ bank = 1; globalset(inst_next, bank); ] { FLAGS = FLAGS | 1; }
@endif
