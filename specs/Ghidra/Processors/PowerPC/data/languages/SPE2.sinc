spe2ddd: val is BH_BITS & BIT_0 [ val = BH_BITS | (BIT_0 << 2); ] { export *[const]:1 val; }
spe2hh: val is BITS_13_15 [ val = BITS_13_15 & 3; ] { export *[const]:1 val; }

spe2ra0: A is A & BITS_16_20=0 { tmp:$(REGISTER_SIZE) = 0; export tmp; }
spe2ra0: A is A { export A; }

spe2ea1: EVUIMM^"("^RA^")" is RA & A & EVUIMM { tmp:$(REGISTER_SIZE) = RA + EVUIMM; export tmp; }
spe2ea1: EVUIMM^"("^RA^")" is RA & A=0 & EVUIMM { tmp:$(REGISTER_SIZE) = EVUIMM; export tmp; }
spe2ea2: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 2; ] { tmp:$(REGISTER_SIZE) = RA + val; export tmp; }
spe2ea2: val^"("^RA^")" is RA & A=0 & EVUIMM [ val = EVUIMM * 2; ] { tmp:$(REGISTER_SIZE) = val; export tmp; }
spe2ea4: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 4; ] { tmp:$(REGISTER_SIZE) = RA + val; export tmp; }
spe2ea4: val^"("^RA^")" is RA & A=0 & EVUIMM [ val = EVUIMM * 4; ] { tmp:$(REGISTER_SIZE) = val; export tmp; }
spe2ea8: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 8; ] { tmp:$(REGISTER_SIZE) = RA + val; export tmp; }
spe2ea8: val^"("^RA^")" is RA & A=0 & EVUIMM [ val = EVUIMM * 8; ] { tmp:$(REGISTER_SIZE) = val; export tmp; }
spe2eau1: EVUIMM^"("^RA^")" is RA & A & EVUIMM { tmp:$(REGISTER_SIZE) = RA + EVUIMM; export tmp; }
spe2eau2: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 2; ] { tmp:$(REGISTER_SIZE) = RA + zext(val:4); export tmp; }
spe2eau4: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 4; ] { tmp:$(REGISTER_SIZE) = RA + zext(val:4); export tmp; }
spe2eau8: val^"("^RA^")" is RA & A & EVUIMM [ val = EVUIMM * 8; ] { tmp:$(REGISTER_SIZE) = RA + zext(val:4); export tmp; }

