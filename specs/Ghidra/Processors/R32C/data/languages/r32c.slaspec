# Renesas R32C/100 Series CPU (R32C/111, /116, /117, /118, /142, /145, ...).
# Written for unlace (#98) from the Renesas R32C/100 Series Software Manual (REJ09B0267-0100):
# chapter 1 (registers, flags), chapter 2 (addressing) and the chapter 4 instruction codes.
# Decoding runs in three phases: phase 0 takes an optional indirect / Bank1 prefix byte, phase 1
# matches the opcode bytes and stores its operand fields (gen codes, size, quick values) in
# context, phase 2 decodes the operands and lifts the instruction.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [ R2R0 R3R1 R6R4 R7R5 A0 A1 A2 A3 ];
define register offset=0x00 size=2 [ R0 R2 R1 R3 R4 R6 R5 R7 ];
define register offset=0x00 size=1 [ R0L R0H R2L R2H R1L R1H R3L R3H ];
define register offset=0x20 size=4 [ R2R0b1 R3R1b1 R6R4b1 R7R5b1 A0b1 A1b1 A2b1 A3b1 ];
define register offset=0x20 size=2 [ R0b1 R2b1 R1b1 R3b1 R4b1 R6b1 R5b1 R7b1 ];
define register offset=0x20 size=1 [ R0Lb1 R0Hb1 R2Lb1 R2Hb1 R1Lb1 R1Hb1 R3Lb1 R3Hb1 ];
define register offset=0x40 size=4 [ SP ISP FB SB INTB SVP SVF PC VCT FLG ];
define register offset=0x70 size=1 [ flC flD flZ flS flB flO flI flU ];
define register offset=0x78 size=1 [ IPL ];
define register offset=0x100 size=4 [ DSA0 DDA0 DCT0 _ DSR0 DDR0 DCR0 DMD0 DSA1 DDA1 DCT1 _ DSR1 DDR1 DCR1 DMD1 DSA2 DDA2 DCT2 _ DSR2 DDR2 DCR2 DMD2 DSA3 DDA3 DCT3 _ DSR3 DDR3 DCR3 DMD3 ];
define register offset=0x80 size=8 [ ctxreg ];

define context ctxreg
  phase = (0,1)
  pfx   = (2,3)
  iid   = (4,12)
  dgc   = (13,17)
  sgc   = (18,22)
  osz   = (23,24)
  isz   = (25,26)
  qv    = (27,30)
  bitn  = (31,33)
  ccnd  = (34,37)
  wraw  = (38,39)
  indS  = (40,40)
  indD  = (41,41)
;

define token tdr(8) dr = (0,4);
define token ob1(8) ob1v = (0,7) ob1b0 = (0,0) ob1b1 = (1,1) ob1b2 = (2,2) ob1b3 = (3,3) ob1b4 = (4,4) ob1b5 = (5,5) ob1b6 = (6,6) ob1b7 = (7,7);
define token ob2(8) ob2v = (0,7) ob2b0 = (0,0) ob2b1 = (1,1) ob2b2 = (2,2) ob2b3 = (3,3) ob2b4 = (4,4) ob2b5 = (5,5) ob2b6 = (6,6) ob2b7 = (7,7);
define token ob3(8) ob3v = (0,7) ob3b0 = (0,0) ob3b1 = (1,1) ob3b2 = (2,2) ob3b3 = (3,3) ob3b4 = (4,4) ob3b5 = (5,5) ob3b6 = (6,6) ob3b7 = (7,7);
define token ob4(8) ob4v = (0,7) ob4b0 = (0,0) ob4b1 = (1,1) ob4b2 = (2,2) ob4b3 = (3,3) ob4b4 = (4,4) ob4b5 = (5,5) ob4b6 = (6,6) ob4b7 = (7,7);
define token ob5(8) ob5v = (0,7) ob5b0 = (0,0) ob5b1 = (1,1) ob5b2 = (2,2) ob5b3 = (3,3) ob5b4 = (4,4) ob5b5 = (5,5) ob5b6 = (6,6) ob5b7 = (7,7);
define token ob6(8) ob6v = (0,7) ob6b0 = (0,0) ob6b1 = (1,1) ob6b2 = (2,2) ob6b3 = (3,3) ob6b4 = (4,4) ob6b5 = (5,5) ob6b6 = (6,6) ob6b7 = (7,7);
define token ob7(8) ob7v = (0,7) ob7b0 = (0,0) ob7b1 = (1,1) ob7b2 = (2,2) ob7b3 = (3,3) ob7b4 = (4,4) ob7b5 = (5,5) ob7b6 = (6,6) ob7b7 = (7,7);
define token tk8(8) i8 = (0,7) d8 = (0,7) signed;
define token tk16(16) i16 = (0,15) d16 = (0,15) signed;
define token tk24(24) i24 = (0,23) d24 = (0,23) signed;
define token tk32(32) i32 = (0,31);
define token tj8(8) j8 = (0,7) js8 = (0,7) signed;
define token tj16(16) j16 = (0,15) js16 = (0,15) signed;
define token tj24(24) j24 = (0,23) js24 = (0,23) signed;
define token tj32(32) j32 = (0,31);
define token tc8(8) ccv = (0,3) cchi = (4,7);
attach variables dr [ DSA0 DDA0 DCT0 VCT DSR0 DDR0 DCR0 DMD0 DSA1 DDA1 DCT1 _ DSR1 DDR1 DCR1 DMD1 DSA2 DDA2 DCT2 _ DSR2 DDR2 DCR2 DMD2 DSA3 DDA3 DCT3 _ DSR3 DDR3 DCR3 DMD3 ];
attach names ccv [ "LTU" "LEU" "NE" "PZ" "NO" "GT" "GE" _ "GEU" "GTU" "EQ" "N" "O" "LE" "LT" _ ];

CCn: "LTU" is ccnd=0 { c:1 = !flC; export c; }
CCn: "LEU" is ccnd=1 { c:1 = !(flC && !flZ); export c; }
CCn: "NE" is ccnd=2 { c:1 = !flZ; export c; }
CCn: "PZ" is ccnd=3 { c:1 = !flS; export c; }
CCn: "NO" is ccnd=4 { c:1 = !flO; export c; }
CCn: "GT" is ccnd=5 { c:1 = !((flS != flO) || flZ); export c; }
CCn: "GE" is ccnd=6 { c:1 = flS == flO; export c; }
CCn: "GEU" is ccnd=8 { c:1 = flC; export c; }
CCn: "GTU" is ccnd=9 { c:1 = flC && !flZ; export c; }
CCn: "EQ" is ccnd=10 { c:1 = flZ; export c; }
CCn: "N" is ccnd=11 { c:1 = flS; export c; }
CCn: "O" is ccnd=12 { c:1 = flO; export c; }
CCn: "LE" is ccnd=13 { c:1 = (flS != flO) || flZ; export c; }
CCn: "LT" is ccnd=14 { c:1 = flS != flO; export c; }
define pcodeop software_interrupt;
define pcodeop wait;
define pcodeop stop;
define pcodeop decimal_add;
define pcodeop decimal_sub;
define pcodeop string_op;
define pcodeop round_float;
define pcodeop fixed_multiply;
define pcodeop dmac_register;
define pcodeop brk;
define pcodeop undefined_instruction;
define pcodeop context_switch;
define pcodeop immex_float;

macro packFLG(v) { v = (FLG & 0xffff8f00) | (zext(IPL) << 12) | (zext(flU) << 7) | (zext(flI) << 6) | (zext(flO) << 5) | (zext(flB) << 4) | (zext(flS) << 3) | (zext(flZ) << 2) | (zext(flD) << 1) | zext(flC); FLG = v; }
macro unpackFLG(v) { FLG = v; IPL = v[12,3]; flU = v[7,1]; flI = v[6,1]; flO = v[5,1]; flB = v[4,1]; flS = v[3,1]; flZ = v[2,1]; flD = v[1,1]; flC = v[0,1]; }
macro resSZ(r) { flZ = (r == 0); flS = (r s< 0); }
macro push4(v) { SP = SP - 4; *:4 SP = v; }
macro pop4(v) { v = *:4 SP; SP = SP + 4; }

GenD0: "R0L" is dgc=0 & indD=0 { export R0L; }
GenD0: "R0Lb1" is dgc=0 & indD=1 { export R0Lb1; }
GenD0: "R0H" is dgc=1 & indD=0 { export R0H; }
GenD0: "R0Hb1" is dgc=1 & indD=1 { export R0Hb1; }
GenD0: "R2L" is dgc=2 & indD=0 { export R2L; }
GenD0: "R2Lb1" is dgc=2 & indD=1 { export R2Lb1; }
GenD0: "R2H" is dgc=3 & indD=0 { export R2H; }
GenD0: "R2Hb1" is dgc=3 & indD=1 { export R2Hb1; }
GenD0: "R1L" is dgc=4 & indD=0 { export R1L; }
GenD0: "R1Lb1" is dgc=4 & indD=1 { export R1Lb1; }
GenD0: "R1H" is dgc=5 & indD=0 { export R1H; }
GenD0: "R1Hb1" is dgc=5 & indD=1 { export R1Hb1; }
GenD0: "R3L" is dgc=6 & indD=0 { export R3L; }
GenD0: "R3Lb1" is dgc=6 & indD=1 { export R3Lb1; }
GenD0: "R3H" is dgc=7 & indD=0 { export R3H; }
GenD0: "R3Hb1" is dgc=7 & indD=1 { export R3Hb1; }
GenD0: d8^"[FB]" is dgc=9 & indD=0 & d8 { a:4 = FB + d8; export *:1 a; }
GenD0: "["^d8^"[FB]"^"]" is dgc=9 & indD=1 & d8 { a:4 = FB + d8; p:4 = *:4 a; export *:1 p; }
GenD0: d16^"[FB]" is dgc=10 & indD=0 & d16 { a:4 = FB + d16; export *:1 a; }
GenD0: "["^d16^"[FB]"^"]" is dgc=10 & indD=1 & d16 { a:4 = FB + d16; p:4 = *:4 a; export *:1 p; }
GenD0: d24 is dgc=11 & indD=0 & d24 { a:4 = sext(d24:3); export *:1 a; }
GenD0: "["^d24^"]" is dgc=11 & indD=1 & d24 { a:4 = sext(d24:3); p:4 = *:4 a; export *:1 p; }
GenD0: d16 is dgc=13 & indD=0 & d16 { a:4 = sext(d16:2); export *:1 a; }
GenD0: "["^d16^"]" is dgc=13 & indD=1 & d16 { a:4 = sext(d16:2); p:4 = *:4 a; export *:1 p; }
