<!--

kuna_atomics (option atomics, docs/spec/02-lift-and-flow.md): a locked x86-64 read-modify-write
lifts to one __sync builtin instead of LOCK(); load; update; store; UNLOCK();.
Fixed forms: xadd, add, dec, or, xchg (always locked), cmpxchg at 4, 8 and 1
bytes, an inc of a RIP-relative global, and two cmpxchg retry loops whose
compare-exchange must stay inside the loop. Declined: an HLE xacquire hint, a
locked neg, an unlocked add and a locked or of 0 (a fence) keep their p-code.

Source (clang 22 -O2 -fcf-protection=none -fno-asynchronous-unwind-tables -c,
linked by ld.lld -static -e 0 with image base and -Ttext 0x100000; the
.text bytes verbatim below):

  int counter;
  int fetch_add(int *p, int d) { return __atomic_fetch_add(p, d, __ATOMIC_SEQ_CST); }
  void add_only(int *p, int d) { __atomic_fetch_add(p, d, __ATOMIC_SEQ_CST); }
  int release(int *p) { return __atomic_sub_fetch(p, 1, __ATOMIC_ACQ_REL) == 0; }
  void or_only(unsigned *p, unsigned v) { __atomic_fetch_or(p, v, __ATOMIC_SEQ_CST); }
  int xchg(int *p, int v) { return __atomic_exchange_n(p, v, __ATOMIC_SEQ_CST); }
  int cas_val(int *p, int e, int n) { return __sync_val_compare_and_swap(p, e, n); }
  int cas_bool(long *p, long e, long n) { return __atomic_compare_exchange_n(p, &e, n, 0, 5, 5); }
  unsigned char cas8(unsigned char *p, unsigned char e, unsigned char n) { return __sync_val_compare_and_swap(p, e, n); }
  int fetch_and(int *p, int v) { return __atomic_fetch_and(p, v, __ATOMIC_SEQ_CST); }
  void inc_global(void) { __atomic_fetch_add(&counter, 1, __ATOMIC_RELAXED); }
  int store_max(int *p, int d) { int o = *p; while (!__atomic_compare_exchange_n(p, &o, o > d ? o : d, 1, 5, 5)) {} return o; }

and, assembled with clang -c:

  hle_add:    .byte 0xf2, 0xf0, 0x01, 0x37   (xacquire lock add %esi,(%rdi))
              ret
  neg_locked: lock negl (%rdi); ret
  plain_add:  addl %esi,(%rdi); ret
  fence:      lock orq $0,(%rsp); ret   (the identity update stays LOCK(); UNLOCK();)
-->
