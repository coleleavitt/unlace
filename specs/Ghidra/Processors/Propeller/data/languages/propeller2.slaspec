:^CS^"add" DR, SV^FCZ is CS & fb21=0 & fb22=0 & fb23=0 & fb24=1 & fb25=0 & fb26=0 & fb27=0 & DR & SV & FCZ & RT { build CS; local vd:4 = DR; local vs:4 = SV; res = vd + vs; cf = carry(vd, vs); zf = res == 0; DR = res; build FCZ; build RT; }
