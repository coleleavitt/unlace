# CPython 3.12 bytecode (one code object's co_code), written for unlace from the CPython
# 3.12 dis/opcode module tables (opcode numbers, inline cache counts, jump encodings), the
# documentation of the dis module and Python/bytecodes.c (PSF licence; no text copied).
# Each instruction is an opcode byte and an argument byte; EXTENDED_ARG prefixes widen the
# argument. The inline CACHE words after an instruction decode as CACHE no-ops (an
# instruction with nine cache words would pass the 16-byte instruction limit). The value
# stack lives in the pystack space (SP addresses the top entry and a push moves it down by
# 8); fast locals are the registers fast0..fast255; objects, names, attributes, calls and
# operators are user-ops on 8-byte object references.

define endian=little;
define alignment=2;

define space ram     type=ram_space      size=4 default;
define space pystack type=ram_space      size=4;
define space fastx   type=ram_space      size=4;
define space register type=register_space size=4;

define register offset=0x0000 size=4 [ PC SP ];
define register offset=0x0010 size=8 [ RV KWNAMES ];
define register offset=0x0100 size=8 [ fast0 fast1 fast2 fast3 fast4 fast5 fast6 fast7 fast8 fast9 fast10 fast11 fast12 fast13 fast14 fast15 fast16 fast17 fast18 fast19 fast20 fast21 fast22 fast23 fast24 fast25 fast26 fast27 fast28 fast29 fast30 fast31 fast32 fast33 fast34 fast35 fast36 fast37 fast38 fast39 fast40 fast41 fast42 fast43 fast44 fast45 fast46 fast47 fast48 fast49 fast50 fast51 fast52 fast53 fast54 fast55 fast56 fast57 fast58 fast59 fast60 fast61 fast62 fast63 fast64 fast65 fast66 fast67 fast68 fast69 fast70 fast71 fast72 fast73 fast74 fast75 fast76 fast77 fast78 fast79 fast80 fast81 fast82 fast83 fast84 fast85 fast86 fast87 fast88 fast89 fast90 fast91 fast92 fast93 fast94 fast95 fast96 fast97 fast98 fast99 fast100 fast101 fast102 fast103 fast104 fast105 fast106 fast107 fast108 fast109 fast110 fast111 fast112 fast113 fast114 fast115 fast116 fast117 fast118 fast119 fast120 fast121 fast122 fast123 fast124 fast125 fast126 fast127 fast128 fast129 fast130 fast131 fast132 fast133 fast134 fast135 fast136 fast137 fast138 fast139 fast140 fast141 fast142 fast143 fast144 fast145 fast146 fast147 fast148 fast149 fast150 fast151 fast152 fast153 fast154 fast155 fast156 fast157 fast158 fast159 fast160 fast161 fast162 fast163 fast164 fast165 fast166 fast167 fast168 fast169 fast170 fast171 fast172 fast173 fast174 fast175 fast176 fast177 fast178 fast179 fast180 fast181 fast182 fast183 fast184 fast185 fast186 fast187 fast188 fast189 fast190 fast191 fast192 fast193 fast194 fast195 fast196 fast197 fast198 fast199 fast200 fast201 fast202 fast203 fast204 fast205 fast206 fast207 fast208 fast209 fast210 fast211 fast212 fast213 fast214 fast215 fast216 fast217 fast218 fast219 fast220 fast221 fast222 fast223 fast224 fast225 fast226 fast227 fast228 fast229 fast230 fast231 fast232 fast233 fast234 fast235 fast236 fast237 fast238 fast239 fast240 fast241 fast242 fast243 fast244 fast245 fast246 fast247 fast248 fast249 fast250 fast251 fast252 fast253 fast254 fast255 ];
define register offset=0x1000 size=4 [ contextreg ];

define context contextreg
  hiarg = (0,23)
;

define token instr(16)
  op   = (0,7)
  arg  = (8,15)
  argb0 = (8,8)
  argb1 = (9,9)
  argb2 = (10,10)
  argb3 = (11,11)
  arghi = (12,15)
  argf = (8,15)
;
define token cache1(16)
  cw1 = (0,15)
;
define token cache2(16)
  cw2 = (0,15)
;
define token cache3(16)
  cw3 = (0,15)
;
define token cache4(16)
  cw4 = (0,15)
;
define token cache5(16)
  cw5 = (0,15)
;
define token cache6(16)
  cw6 = (0,15)
;
define token cache7(16)
  cw7 = (0,15)
;
define token cache8(16)
  cw8 = (0,15)
;
define token cache9(16)
  cw9 = (0,15)
;
attach variables [ argf ] [ fast0 fast1 fast2 fast3 fast4 fast5 fast6 fast7 fast8 fast9 fast10 fast11 fast12 fast13 fast14 fast15 fast16 fast17 fast18 fast19 fast20 fast21 fast22 fast23 fast24 fast25 fast26 fast27 fast28 fast29 fast30 fast31 fast32 fast33 fast34 fast35 fast36 fast37 fast38 fast39 fast40 fast41 fast42 fast43 fast44 fast45 fast46 fast47 fast48 fast49 fast50 fast51 fast52 fast53 fast54 fast55 fast56 fast57 fast58 fast59 fast60 fast61 fast62 fast63 fast64 fast65 fast66 fast67 fast68 fast69 fast70 fast71 fast72 fast73 fast74 fast75 fast76 fast77 fast78 fast79 fast80 fast81 fast82 fast83 fast84 fast85 fast86 fast87 fast88 fast89 fast90 fast91 fast92 fast93 fast94 fast95 fast96 fast97 fast98 fast99 fast100 fast101 fast102 fast103 fast104 fast105 fast106 fast107 fast108 fast109 fast110 fast111 fast112 fast113 fast114 fast115 fast116 fast117 fast118 fast119 fast120 fast121 fast122 fast123 fast124 fast125 fast126 fast127 fast128 fast129 fast130 fast131 fast132 fast133 fast134 fast135 fast136 fast137 fast138 fast139 fast140 fast141 fast142 fast143 fast144 fast145 fast146 fast147 fast148 fast149 fast150 fast151 fast152 fast153 fast154 fast155 fast156 fast157 fast158 fast159 fast160 fast161 fast162 fast163 fast164 fast165 fast166 fast167 fast168 fast169 fast170 fast171 fast172 fast173 fast174 fast175 fast176 fast177 fast178 fast179 fast180 fast181 fast182 fast183 fast184 fast185 fast186 fast187 fast188 fast189 fast190 fast191 fast192 fast193 fast194 fast195 fast196 fast197 fast198 fast199 fast200 fast201 fast202 fast203 fast204 fast205 fast206 fast207 fast208 fast209 fast210 fast211 fast212 fast213 fast214 fast215 fast216 fast217 fast218 fast219 fast220 fast221 fast222 fast223 fast224 fast225 fast226 fast227 fast228 fast229 fast230 fast231 fast232 fast233 fast234 fast235 fast236 fast237 fast238 fast239 fast240 fast241 fast242 fast243 fast244 fast245 fast246 fast247 fast248 fast249 fast250 fast251 fast252 fast253 fast254 fast255 ];

macro push(v) {
  SP = SP - 8;
  *[pystack]:8 SP = v;
}
macro pop(v) {
  v = *[pystack]:8 SP;
  SP = SP + 8;
}

