:d ra, rb is op8=0xb6 & ra & rb {
  local a:4 = ra; local b:4 = rb;
  local sum:8 = (sext(a) << 1) | zext(mq >> 31);
  local same:1 = (a s< 0) == (b s< 0);
  sum = sum - (sext(b) * zext(same)) + (sext(b) * zext(!same));
  ra = sum:4;
  local s32:1 = ((sum >> 32) & 1) != 0;
  local q:1 = s32 == (b s< 0);
  mq = (mq << 1) | zext(q);
  CY = q;
  OV = s32 == (sum:4 s< 0);
}
:sr ra, rb is op8=0xb8 & ra & rb { local r:4 = ra >> (rb & 63); ra = r; logf(r); }
:sl ra, rb is op8=0xba & ra & rb { local r:4 = ra << (rb & 63); ra = r; logf(r); }
:mftb ra, rb is op8=0xbc & ra & rb { local m:4 = 0x80000000 >> (rb & 31); ra = (ra & ~m) | (m * zext(TB)); }
:tgte ra, rb is op8=0xbd & ra & rb { if (ra < rb) goto inst_next; program_trap(); }
:tlt ra, rb is op8=0xbe & ra & rb { if (ra >= rb) goto inst_next; program_trap(); }
:mttb ra, rb is op8=0xbf & ra & rb { TB = (ra & (0x80000000 >> (rb & 31))) != 0; }
:abs ra, rb is op8=0xe0 & ra & rb { local v:4 = rb; local r:4 = v; if (v s>= 0) goto <pos>; r = -v; <pos> ra = r; OV = v == 0x80000000; CY = 0; logf(r); }
:a ra, rb is op8=0xe1 & ra & rb { local a:4 = ra; local b:4 = rb; addf(a, b, 0:1); ra = a + b; }
:s ra, rb is op8=0xe2 & ra & rb { local a:4 = ra; local b:4 = rb; subf(a, b); ra = a - b; }
:o ra, rb is op8=0xe3 & ra & rb { local r:4 = ra | rb; ra = r; logf(r); }
:twoc ra, rb is op8=0xe4 & ra & rb { local b:4 = rb; local z:4 = 0; subf(z, b); ra = -b; }
:n ra, rb is op8=0xe5 & ra & rb { local r:4 = ra & rb; ra = r; logf(r); }
:m ra, rb is op8=0xe6 & ra & rb {
  local sum:8 = sext(ra); local b:8 = sext(rb); local k:4 = mq & 3;
  local nc:1 = CY != 0;
  local add1:1 = (nc && k == 1) || (!nc && k == 0);
  local sub2:1 = nc && k == 2;
  local sub1:1 = (nc && k == 3) || (!nc && k == 2);
  local add2:1 = !nc && k == 1;
  sum = sum + b * zext(add1) + (b * 2) * zext(add2) - (b * 2) * zext(sub2) - b * zext(sub1);
  CY = (mq & 2) == 0;
  mq = (sum:4 << 30) | (mq >> 2);
  local sh:8 = sum s>> 2; ra = sh:4;
}
:x ra, rb is op8=0xe7 & ra & rb { local r:4 = ra ^ rb; ra = r; logf(r); }
:br rb is op8=0xe8 & ra=8 & rb & rb=15 { return [r15]; }
:br rb is op8=0xe8 & ra=8 & rb { local t:4 = rb & ~1; goto [t]; }
:bnbr^cb rb is op8=0xe8 & ra7=1 & cb & rb { local t:4 = rb & ~1; if (cb) goto inst_next; goto [t]; }
:brx rb is op8=0xe9 & ra=8 & rb & rb=15 { local t:4 = r15; delayslot(1); return [t]; }
:brx rb is op8=0xe9 & ra=8 & rb { local t:4 = rb & ~1; delayslot(1); goto [t]; }
:bnbrx^cb rb is op8=0xe9 & ra7=1 & cb & rb { local t:4 = rb & ~1; local c:1 = cb; delayslot(1); if (c) goto inst_next; goto [t]; }
:lhs ra, "0("^rb^")" is op8=0xeb & ra & rb { ra = zext(*:2 rb); }
:balr ra, rb is op8=0xec & ra & rb { local t:4 = rb & ~1; ra = inst_next; call [t]; }
:balrx ra, rb is op8=0xed & ra & rb { local t:4 = rb & ~1; ra = inst_next + 4; delayslot(1); call [t]; }
:bbr^cb rb is op8=0xee & ra7=1 & cb & rb { local t:4 = rb & ~1; if (!cb) goto inst_next; goto [t]; }
:bbrx^cb rb is op8=0xef & ra7=1 & cb & rb { local t:4 = rb & ~1; local c:1 = cb; delayslot(1); if (!c) goto inst_next; goto [t]; }
:wait is op8=0xf0 { wait_state(); }
:ae ra, rb is op8=0xf1 & ra & rb { local a:4 = ra; local b:4 = rb; local c:1 = CY; addf(a, b, c); ra = a + b + zext(c); }
:se ra, rb is op8=0xf2 & ra & rb { local a:4 = ra; local b:4 = ~rb; local c:1 = CY; addf(a, b, c); ra = a + b + zext(c); }
:ca16 ra, rb is op8=0xf3 & ra & rb { ra = (rb & 0xffff0000) | zext(ra:2 + rb:2); }
:onec ra, rb is op8=0xf4 & ra & rb { local r:4 = ~rb; ra = r; logf(r); }
:clz ra, rb is op8=0xf5 & ra & rb { local h:2 = rb:2; ra = lzcount(h); }
:mc03 ra, rb is op8=0xf9 & ra & rb { ra = (ra & 0x00ffffff) | ((rb & 0xff) << 24); }
:mc13 ra, rb is op8=0xfa & ra & rb { ra = (ra & 0xff00ffff) | ((rb & 0xff) << 16); }
:mc23 ra, rb is op8=0xfb & ra & rb { ra = (ra & 0xffff00ff) | ((rb & 0xff) << 8); }
:mc33 ra, rb is op8=0xfc & ra & rb { ra = (ra & 0xffffff00) | (rb & 0xff); }
:mc30 ra, rb is op8=0xfd & ra & rb { ra = (ra & 0xffffff00) | (rb >> 24); }
:mc31 ra, rb is op8=0xfe & ra & rb { ra = (ra & 0xffffff00) | ((rb >> 16) & 0xff); }
:mc32 ra, rb is op8=0xff & ra & rb { ra = (ra & 0xffffff00) | ((rb >> 8) & 0xff); }
