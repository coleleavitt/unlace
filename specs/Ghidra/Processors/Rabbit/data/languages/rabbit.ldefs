  <language processor="Rabbit3000"
            endian="little"
            size="16"
            variant="default"
            version="1.0"
            slafile="rabbit3000.sla"
            processorspec="rabbit.pspec"
            id="Rabbit3000:LE:16:default">
    <description>Rabbit 3000A (Rabbit 2000 set plus the 3000A system, block-copy and multiply-accumulate instructions)</description>
    <compiler name="default" spec="rabbit.cspec" id="default"/>
  </language>
