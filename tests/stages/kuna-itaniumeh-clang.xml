<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Kuna: option itaniumeh on clang code. clang starts a call-site range at the
    call's argument set-up, so the range's first instruction is not the call;
    the edge goes on the first covered call all the same (#1, f_loop's catch
    inside its loop). The catch header lists the pad's caught types in handler
    order (#2), and a pad with a catch clause and a cleanup still names the
    type (#1). f_dtor's cleanup pad runs the destructor (#3).

    Fixture: `decompiler/crates/unlace-cli/tests/fixtures/itaniumeh/eh3_x86_64_clang.so`
    (clang 22 -O2 -fPIC -shared, source eh3.cc beside it).
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/unlace-cli/tests/fixtures/itaniumeh/eh3_x86_64_clang.so</com>
  <com>option itaniumeh on</com>
  <com>read symbols</com>
  <com>load function f_loop</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function f_multi</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function f_dtor</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="itaniumeh-clang #1: a range that starts before the call still gives the call its edge" min="1" max="1">^      \} catch \(int\) \{$</stringmatch>
<stringmatch name="itaniumeh-clang #2: four clauses print in handler order" min="1" max="1">\} catch \(Derived \| Base \| int \| \.\.\.\) \{</stringmatch>
<stringmatch name="itaniumeh-clang #3: the cleanup pad runs the destructor" min="1" max="1">Guard::~Guard\(</stringmatch>
</decompilertest>
