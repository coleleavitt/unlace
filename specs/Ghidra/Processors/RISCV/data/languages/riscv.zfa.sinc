		sv9 = sg10;
	<sgbox2>
	local sg11:1 = sv4 f< sv9;
	local sg12:8 = zext(sg11);
	rd = sg12;
}

:fleq.d rd,frs1,frs2 is rd & frs1 & frs2 & op0006=0x53 & funct3=0x4 & funct7=0x51
{
	local sg1:1 = frs1 f<= frs2;
	local sg2:8 = zext(sg1);
	rd = sg2;
}

:fltq.d rd,frs1,frs2 is rd & frs1 & frs2 & op0006=0x53 & funct3=0x5 & funct7=0x51
