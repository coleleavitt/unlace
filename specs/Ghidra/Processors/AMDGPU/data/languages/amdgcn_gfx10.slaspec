:s_load_dwordx16 sm_data^"x16", sm_base, SMOFF is e6=0x3d ... & smop=4 ... & sm_data ... & sm_base ... & sm_datax ... & c_s1 ... & c_s2 ... & c_s3 ... & c_s4 ... & c_s5 ... & c_s6 ... & c_s7 ... & c_s8 ... & c_s9 ... & c_s10 ... & c_s11 ... & c_s12 ... & c_s13 ... & c_s14 ... & c_s15 ... & SMOFF  [ cr_s1 = sm_datax + 1; cr_s2 = sm_datax + 2; cr_s3 = sm_datax + 3; cr_s4 = sm_datax + 4; cr_s5 = sm_datax + 5; cr_s6 = sm_datax + 6; cr_s7 = sm_datax + 7; cr_s8 = sm_datax + 8; cr_s9 = sm_datax + 9; cr_s10 = sm_datax + 10; cr_s11 = sm_datax + 11; cr_s12 = sm_datax + 12; cr_s13 = sm_datax + 13; cr_s14 = sm_datax + 14; cr_s15 = sm_datax + 15; ] { b:8 = sm_base; a:8 = b + SMOFF; sm_data = *:4 (a + 0); c_s1 = *:4 (a + 4); c_s2 = *:4 (a + 8); c_s3 = *:4 (a + 12); c_s4 = *:4 (a + 16); c_s5 = *:4 (a + 20); c_s6 = *:4 (a + 24); c_s7 = *:4 (a + 28); c_s8 = *:4 (a + 32); c_s9 = *:4 (a + 36); c_s10 = *:4 (a + 40); c_s11 = *:4 (a + 44); c_s12 = *:4 (a + 48); c_s13 = *:4 (a + 52); c_s14 = *:4 (a + 56); c_s15 = *:4 (a + 60); }
:s_buffer_load_dword sm_data, sm_base, SMOFF is e6=0x3d ... & smop=8 ... & sm_data ... & sm_base ... & SMOFF { b:8 = sm_base & 0xffffffffffff; a:8 = b + SMOFF; sm_data = *:4 (a + 0); }
:s_buffer_load_dwordx2 sm_data^"x2", sm_base, SMOFF is e6=0x3d ... & smop=9 ... & sm_data ... & sm_base ... & sm_datax ... & c_s1 ... & SMOFF  [ cr_s1 = sm_datax + 1; ] { b:8 = sm_base & 0xffffffffffff; a:8 = b + SMOFF; sm_data = *:4 (a + 0); c_s1 = *:4 (a + 4); }
