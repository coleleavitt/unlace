MRAs: "D6" is pb53=6 { local v:8 = sext(D6); export v; }
MRAs: "D7" is pb53=7 { local v:8 = sext(D7); export v; }
MRAu: "D2" is pb53=0 { local v:8 = zext(D2); export v; }
MRAu: "D3" is pb53=1 { local v:8 = zext(D3); export v; }
MRAu: "D4" is pb53=2 { local v:8 = zext(D4); export v; }
