<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <integer_size value="2"/>
    <short_size value="2"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="cru"/>
  </global>
  <stackpointer register="R10" space="ram" growth="negative"/>
  <default_proto>
    <prototype name="__bl" extrapop="0" stackshift="0">
      <input>

      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="R10"/>
        <register name="WP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
