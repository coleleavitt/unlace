# Seiko Epson S1C88 8-bit core (S1C88xxx; the Nintendo Pokemon mini CPU).
# Written for unlace (#98) from the Epson S1C88 Core CPU Manual (MF658-05); one constructor
# per row of the manual's instruction list by function (section 4.3.3). One flat 64 KB space (MODEL0/1 addressing): the bank and page
# registers are loaded and saved but do not extend addresses. Decimal and unpack
# arithmetic follow the flow context bits dmode/umode, which writes of SC with an
# immediate commit.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=2 default;
define space register type=register_space size=2;

define register offset=0x00 size=1 [ A B L H ];
define register offset=0x00 size=2 [ BA HL ];
define register offset=0x04 size=2 [ IX IY SP PC ];
define register offset=0x10 size=1 [ BR SC NB CB EP XP YP CC ];
define register offset=0x20 size=1 [ Z C V N D U I0 I1 ];
define register offset=0x30 size=4 [ contextreg ];

define context contextreg
  dmode = (0,0)
  umode = (1,1)
;

define token op0(8) o0 = (0,7);
define token op1(8) o1 = (0,7);
define token ta(8) ua = (0,7) sa = (0,7) signed ua_d = (4,4) ua_u = (5,5);
define token tb(8) ub = (0,7) sb = (0,7) signed;
define token tw(16) uw = (0,15) sw = (0,15) signed;

define pcodeop halt;
define pcodeop sleep;

macro packSC(v) { v = (I1 << 7) | (I0 << 6) | (U << 5) | (D << 4) | (N << 3) | (V << 2) | (C << 1) | Z; SC = v; }
macro unpackSC(v) { SC = v; I1 = (v >> 7) & 1; I0 = (v >> 6) & 1; U = (v >> 5) & 1; D = (v >> 4) & 1; N = (v >> 3) & 1; V = (v >> 2) & 1; C = (v >> 1) & 1; Z = v & 1; }
macro resZN(r) { Z = (r == 0); N = (r s< 0); }

# Decimal (D) and unpack (U) forms of the 8-bit add and subtract.
macro bcdAdd(a, b, cin, r) {
  lo:1 = (a & 0xf) + (b & 0xf) + cin;
  lc:1 = lo > 9;
  lo = (lo + lc * 6) & 0xf;
  hi:1 = (a >> 4) + (b >> 4) + lc;
  hc:1 = hi > 9;
  hi = (hi + hc * 6) & 0xf;
  r = (hi << 4) | lo;
  C = hc; Z = (r == 0); N = 0; V = 0;
}
macro bcdSub(a, b, cin, r) {
  bl:1 = (b & 0xf) + cin;
  lb:1 = (a & 0xf) < bl;
  lo:1 = ((a & 0xf) - bl - lb * 6) & 0xf;
  bh:1 = (b >> 4) + lb;
  hb:1 = (a >> 4) < bh;
  hi:1 = ((a >> 4) - bh - hb * 6) & 0xf;
  r = (hi << 4) | lo;
  C = hb; Z = (r == 0); N = 0; V = 0;
}
macro unpAdd(a, b, cin, r, dec) {
  t:1 = (a & 0xf) + (b & 0xf) + cin;
  c:1 = (dec & (t > 9)) | (!dec & (t > 15));
  r = (t + (dec & c) * 6) & 0xf;
  C = c; Z = (r == 0); N = 0; V = 0;
}
macro unpSub(a, b, cin, r, dec) {
  u:1 = (b & 0xf) + cin;
  c:1 = (a & 0xf) < u;
  r = ((a & 0xf) - u - (dec & c) * 6) & 0xf;
  C = c; Z = (r == 0); N = 0; V = 0;
}

MHL: "[HL]" is epsilon { export HL; }
MIX: "[IX]" is epsilon { export IX; }
MIY: "[IY]" is epsilon { export IY; }
MHL2: "[HL]" is epsilon { export HL; }
MIX2: "[IX]" is epsilon { export IX; }
MIY2: "[IY]" is epsilon { export IY; }
MIXl: "[IX+L]" is epsilon { a:2 = IX + sext(L); export a; }
MIYl: "[IY+L]" is epsilon { a:2 = IY + sext(L); export a; }
MIXd: "[IX+"^sa^"]" is sa { a:2 = IX + sa; export a; }
MIYd: "[IY+"^sa^"]" is sa { a:2 = IY + sa; export a; }
MSPd: "[SP+"^sa^"]" is sa { a:2 = SP + sa; export a; }
MBR: "[BR:"^ua^"]" is ua { a:2 = (zext(BR) << 8) | ua; export a; }
MAbs: "["^uw^"]" is uw { export *[const]:2 uw; }
Imm8: "#"^ua is ua { export *[const]:1 ua; }
Imm8B: "#"^ub is ub { export *[const]:1 ub; }
Imm16: "#"^uw is uw { export *[const]:2 uw; }
Vec: "["^ua^"]" is ua { export *[const]:2 ua; }
Rel8a: dest is sa [ dest = (inst_start + 1 + sa) & 0xffff; ] { export *:1 dest; }
Rel8b: dest is sa [ dest = (inst_start + 2 + sa) & 0xffff; ] { export *:1 dest; }
Rel16: dest is sw [ dest = (inst_start + 2 + sw) & 0xffff; ] { export *:1 dest; }

:ADD "A", "A" is dmode=0 & umode=0 & o0=0x00 { a:1 = A; b:1 = A; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", "A" is dmode=1 & umode=0 & o0=0x00 {  a:1 = A; b:1 = A; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", "A" is umode=1 & o0=0x00 {  a:1 = A; b:1 = A; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", "B" is dmode=0 & umode=0 & o0=0x01 { a:1 = A; b:1 = B; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", "B" is dmode=1 & umode=0 & o0=0x01 {  a:1 = A; b:1 = B; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", "B" is umode=1 & o0=0x01 {  a:1 = A; b:1 = B; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", Imm8 is dmode=0 & umode=0 & o0=0x02; Imm8 { a:1 = A; b:1 = Imm8; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", Imm8 is dmode=1 & umode=0 & o0=0x02; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", Imm8 is umode=1 & o0=0x02; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", MHL is dmode=0 & umode=0 & o0=0x03; MHL { a:1 = A; b:1 = *:1 MHL; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", MHL is dmode=1 & umode=0 & o0=0x03; MHL {  a:1 = A; b:1 = *:1 MHL; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", MHL is umode=1 & o0=0x03; MHL {  a:1 = A; b:1 = *:1 MHL; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", MBR is dmode=0 & umode=0 & o0=0x04; MBR { a:1 = A; b:1 = *:1 MBR; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", MBR is dmode=1 & umode=0 & o0=0x04; MBR {  a:1 = A; b:1 = *:1 MBR; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", MBR is umode=1 & o0=0x04; MBR {  a:1 = A; b:1 = *:1 MBR; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", MAbs is dmode=0 & umode=0 & o0=0x05; MAbs { a:1 = A; b:1 = *:1 MAbs; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", MAbs is dmode=1 & umode=0 & o0=0x05; MAbs {  a:1 = A; b:1 = *:1 MAbs; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", MAbs is umode=1 & o0=0x05; MAbs {  a:1 = A; b:1 = *:1 MAbs; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", MIX is dmode=0 & umode=0 & o0=0x06; MIX { a:1 = A; b:1 = *:1 MIX; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", MIX is dmode=1 & umode=0 & o0=0x06; MIX {  a:1 = A; b:1 = *:1 MIX; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", MIX is umode=1 & o0=0x06; MIX {  a:1 = A; b:1 = *:1 MIX; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADD "A", MIY is dmode=0 & umode=0 & o0=0x07; MIY { a:1 = A; b:1 = *:1 MIY; r:1 = a + b; C = carry(a, b); V = scarry(a, b); resZN(r); A = r; }
:ADD "A", MIY is dmode=1 & umode=0 & o0=0x07; MIY {  a:1 = A; b:1 = *:1 MIY; r:1 = 0; bcdAdd(a, b, 0, r); A = r; }
:ADD "A", MIY is umode=1 & o0=0x07; MIY {  a:1 = A; b:1 = *:1 MIY; r:1 = 0; unpAdd(a, b, 0, r, D); A = r; }
:ADC "A", "A" is dmode=0 & umode=0 & o0=0x08 { a:1 = A; b:1 = A; r:1 = a + b + zext(C); t:1 = a + b; C = carry(a, b) || carry(t, zext(C)); V = scarry(a, b) ^^ scarry(t, zext(C)); resZN(r); A = r; }
:ADC "A", "A" is dmode=1 & umode=0 & o0=0x08 {  a:1 = A; b:1 = A; r:1 = 0; bcdAdd(a, b, C, r); A = r; }
:ADC "A", "A" is umode=1 & o0=0x08 {  a:1 = A; b:1 = A; r:1 = 0; unpAdd(a, b, C, r, D); A = r; }
:ADC "A", "B" is dmode=0 & umode=0 & o0=0x09 { a:1 = A; b:1 = B; r:1 = a + b + zext(C); t:1 = a + b; C = carry(a, b) || carry(t, zext(C)); V = scarry(a, b) ^^ scarry(t, zext(C)); resZN(r); A = r; }
:ADC "A", "B" is dmode=1 & umode=0 & o0=0x09 {  a:1 = A; b:1 = B; r:1 = 0; bcdAdd(a, b, C, r); A = r; }
:ADC "A", "B" is umode=1 & o0=0x09 {  a:1 = A; b:1 = B; r:1 = 0; unpAdd(a, b, C, r, D); A = r; }
:ADC "A", Imm8 is dmode=0 & umode=0 & o0=0x0A; Imm8 { a:1 = A; b:1 = Imm8; r:1 = a + b + zext(C); t:1 = a + b; C = carry(a, b) || carry(t, zext(C)); V = scarry(a, b) ^^ scarry(t, zext(C)); resZN(r); A = r; }
:ADC "A", Imm8 is dmode=1 & umode=0 & o0=0x0A; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; bcdAdd(a, b, C, r); A = r; }
:ADC "A", Imm8 is umode=1 & o0=0x0A; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; unpAdd(a, b, C, r, D); A = r; }
