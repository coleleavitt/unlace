# SLEIGH specification for the C-SKY ABIv2 instruction set (CK801, CK802, CK803,
# CK804, CK805, CK807, CK810, CK860), the integer ISA.
#
# Written for unlace (issue #98). Encodings follow the GNU binutils C-SKY opcode
# table (opcodes/csky-opc.h, read for encoding facts only) and were checked
# against csky-elf-objdump; semantics follow the C-SKY V2 instruction set manual.
# Instructions are one or two 16-bit halfwords: a halfword whose top two bits are
# 11 starts a 32-bit instruction, stored high halfword first. Field names carry
# the bit numbers of the 32-bit form (bits 31-16 are the first halfword).

@ifdef CSKY_BE
define endian=big;
@else
define endian=little;
@endif
define alignment=2;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [
	r0  r1  r2  r3  r4  r5  r6  r7  r8  r9  r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
define register offset=0x100 size=4 [ pc hi lo epc fpc ];
define register offset=0x200 size=1 [ C ];
define register offset=0x300 size=4 [ contextreg ];
define register offset=0x400 size=16 [ vr0 vr1 vr2 vr3 vr4 vr5 vr6 vr7 vr8 vr9 vr10 vr11 vr12 vr13 vr14 vr15 ];
define register offset=0x400 size=8 [ fr0 _ fr1 _ fr2 _ fr3 _ fr4 _ fr5 _ fr6 _ fr7 _ fr8 _ fr9 _ fr10 _ fr11 _ fr12 _ fr13 _ fr14 _ fr15 _ fr16 fr17 fr18 fr19 fr20 fr21 fr22 fr23 fr24 fr25 fr26 fr27 fr28 fr29 fr30 fr31 ];
define register offset=0x600 size=4 [ fcr fesr fid ];

# 16-bit instruction
define token hw(16)
	h15_14 = (14,15)
	h15_10 = (10,15)
	h15_11 = (11,15)
	h15_12 = (12,15)
	h15_6  = (6,15)
	h15_5  = (5,15)
	h15_8  = (8,15)
	h15_2  = (2,15)
	h15_0  = (0,15)
	h9_6   = (6,9)
	h7_5   = (5,7)
	h1_0   = (0,1)
	h4_0   = (0,4)
	h7_0   = (0,7)
	h9_8   = (8,9)
	h10_8  = (8,10)
	h4_2   = (2,4)
	h5_2   = (2,5)
	h5     = (5,5)
	h4     = (4,4)
	h3_0   = (0,3)
	h9_0s  = (0,9) signed
	r2_4   = (2,4)
	r5_7   = (5,7)
	r8_10  = (8,10)
	r2_5   = (2,5)
	r6_9   = (6,9)
;

# first (high) halfword of a 32-bit instruction: bits 31-16
define token hwa(16)
	a31_26 = (10,15)
	a31_30 = (14,15)
	a25_21 = (5,9)
	a20_16 = (0,4)
	a25_16 = (0,9)
	a25_16s = (0,9) signed
	a25_18 = (2,9)
	a20_18 = (2,4)
	a17_16 = (0,1)
	a17_16s = (0,1) signed
	a24_21 = (5,8)
	rx     = (0,4)
	ry     = (5,9)
	rzh    = (5,9)
	crsel  = (5,9)
	crx    = (0,4)
	ry_p1 = (5,9)
	ry_p2 = (5,9)
	ry_p3 = (5,9)
	ry_p4 = (5,9)
	ry_p5 = (5,9)
	ry_p6 = (5,9)
	ry_p7 = (5,9)
	ry_p8 = (5,9)
	ry_p9 = (5,9)
	ry_p10 = (5,9)
	ry_p11 = (5,9)
	ry_p12 = (5,9)
	ry_p13 = (5,9)
	ry_p14 = (5,9)
	ry_p15 = (5,9)
	ry_p16 = (5,9)
	ry_p17 = (5,9)
	ry_p18 = (5,9)
	ry_p19 = (5,9)
	ry_p20 = (5,9)
	ry_p21 = (5,9)
	ry_p22 = (5,9)
	ry_p23 = (5,9)
	ry_p24 = (5,9)
	ry_p25 = (5,9)
	ry_p26 = (5,9)
	ry_p27 = (5,9)
	ry_p28 = (5,9)
	ry_p29 = (5,9)
	ry_p30 = (5,9)
	ry_p31 = (5,9)
	ry_same = (5,9)
;

# second (low) halfword of a 32-bit instruction: bits 15-0
define token hwb(16)
	b15_0  = (0,15)
	b15    = (15,15)
	b15_0s = (0,15) signed
	b15_12 = (12,15)
	b15_10 = (10,15)
	b15_5  = (5,15)
	b11_0  = (0,11)
	b9_5   = (5,9)
	b8_5   = (5,8)
	b4_0   = (0,4)
	b8_0   = (0,8)
	b3_0   = (0,3)
	b4     = (4,4)
	b7_5   = (5,7)
	b8     = (8,8)
	b11_10 = (10,11)
	rz     = (0,4)
	crz    = (0,4)
	rz_p1 = (0,4)
;

attach variables [ rx ry rzh rz ] [
	r0  r1  r2  r3  r4  r5  r6  r7  r8  r9  r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
attach variables [ r2_5 r6_9 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ r2_4 r5_7 r8_10 ] [ r0 r1 r2 r3 r4 r5 r6 r7 ];
attach variables [ ry_p1 ] [ r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 ];
attach variables [ ry_p2 ] [ r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 ];
attach variables [ ry_p3 ] [ r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 ];
attach variables [ ry_p4 ] [ r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 ];
attach variables [ ry_p5 ] [ r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 ];
attach variables [ ry_p6 ] [ r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 ];
attach variables [ ry_p7 ] [ r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 ];
attach variables [ ry_p8 ] [ r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 ];
attach variables [ ry_p9 ] [ r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 ];
attach variables [ ry_p10 ] [ r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 ];
attach variables [ ry_p11 ] [ r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 ];
attach variables [ ry_p12 ] [ r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 ];
attach variables [ ry_p13 ] [ r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 ];
attach variables [ ry_p14 ] [ r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 ];
attach variables [ ry_p15 ] [ r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 ];
attach variables [ ry_p16 ] [ r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ ry_p17 ] [ r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 ];
attach variables [ ry_p18 ] [ r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 ];
attach variables [ ry_p19 ] [ r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 ];
attach variables [ ry_p20 ] [ r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 ];
attach variables [ ry_p21 ] [ r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 ];
attach variables [ ry_p22 ] [ r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 ];
attach variables [ ry_p23 ] [ r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 ];
attach variables [ ry_p24 ] [ r24 r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 ];
attach variables [ ry_p25 ] [ r25 r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 ];
attach variables [ ry_p26 ] [ r26 r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 ];
attach variables [ ry_p27 ] [ r27 r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 ];
attach variables [ ry_p28 ] [ r28 r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 ];
attach variables [ ry_p29 ] [ r29 r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 ];
attach variables [ ry_p30 ] [ r30 r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 ];
attach variables [ ry_p31 ] [ r31 r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 ];
attach variables [ ry_same ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
attach variables [ rz_p1 ] [ r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r0 ];

define pcodeop breakpoint;
define pcodeop trap;
define pcodeop wait;
define pcodeop doze;
define pcodeop stop;
define pcodeop wait_event;
define pcodeop send_event;
define pcodeop sync;
define pcodeop barrier;
define pcodeop idly;
define pcodeop secure_world_call;
define pcodeop condition_execute;
define pcodeop read_cr;
define pcodeop write_cr;
define pcodeop psr_set;
define pcodeop psr_clear;
define pcodeop interrupt_nest_enable;
define pcodeop interrupt_nest_return;
define pcodeop interrupt_push;
define pcodeop interrupt_pop;
define pcodeop cache_op;
define pcodeop tlb_op;
define pcodeop prefetch;
define pcodeop exclusive_load;
define pcodeop exclusive_store;
define pcodeop coprocessor;
define pcodeop return_from_exception;
define pcodeop return_from_interrupt;
define pcodeop tstnbz;
define pcodeop mulall_s16_s;

macro bitrev(d, s) {
	local v:4 = s;
	v = ((v >> 1) & 0x55555555) | ((v & 0x55555555) << 1);
	v = ((v >> 2) & 0x33333333) | ((v & 0x33333333) << 2);
	v = ((v >> 4) & 0x0f0f0f0f) | ((v & 0x0f0f0f0f) << 4);
	v = ((v >> 8) & 0x00ff00ff) | ((v & 0x00ff00ff) << 8);
	d = (v >> 16) | (v << 16);
}

macro byterev(d, s) {
	local v:4 = s;
	d = (v << 24) | ((v & 0xff00) << 8) | ((v >> 8) & 0xff00) | (v >> 24);
}

macro byterevh(d, s) {
	local v:4 = s;
	d = ((v & 0x00ff00ff) << 8) | ((v >> 8) & 0x00ff00ff);
}

################################################################
# Operands
################################################################

imm8_16: h7_0 is h7_0 { export *[const]:4 h7_0; }
oimm8_16: v is h7_0 [ v = h7_0 + 1; ] { export *[const]:4 v; }
oimm3_16: v is h4_2 [ v = h4_2 + 1; ] { export *[const]:4 v; }
imm5_16: h4_0 is h4_0 { export *[const]:4 h4_0; }
oimm5_16: v is h4_0 [ v = h4_0 + 1; ] { export *[const]:4 v; }
spimm7: v is h4_0 & h9_8 [ v = ((h9_8 << 5) | h4_0) << 2; ] { export *[const]:4 v; }
spimm8: v is h7_0 [ v = h7_0 << 2; ] { export *[const]:4 v; }

br10: dest is h9_0s [ dest = inst_start + (h9_0s << 1); ] { export *:4 dest; }

lrw16: "[pc, "^v^"]" is h4_0 & h9_8 [ v = ((h9_8 << 5) | h4_0) << 2; ] { local a:4 = (inst_start + v) & 0xfffffffc; export *:4 a; }
elrw16: "[pc, "^v^"]" is h4_0 & h9_8 [ v = (0x80 + ((~((h9_8 << 5) | h4_0)) & 0x7f)) << 2; ] { local a:4 = (inst_start + v) & 0xfffffffc; export *:4 a; }

mem16b: "("^r8_10^", "^h4_0^")" is r8_10 & h4_0 { local a:4 = r8_10 + h4_0; export a; }
mem16h: "("^r8_10^", "^v^")" is r8_10 & h4_0 [ v = h4_0 << 1; ] { local a:4 = r8_10 + v; export a; }
mem16w: "("^r8_10^", "^v^")" is r8_10 & h4_0 [ v = h4_0 << 2; ] { local a:4 = r8_10 + v; export a; }
mem16sp: "(r14, "^v^")" is h4_0 & h10_8 [ v = ((h10_8 << 5) | h4_0) << 2; ] { local a:4 = r14 + v; export a; }

imm12: b11_0 is b11_0 { export *[const]:4 b11_0; }
oimm12: v is b11_0 [ v = b11_0 + 1; ] { export *[const]:4 v; }
imm16: b15_0 is b15_0 { export *[const]:4 b15_0; }
oimm16: v is b15_0 [ v = b15_0 + 1; ] { export *[const]:4 v; }
imm5y: a25_21 is a25_21 { export *[const]:4 a25_21; }
oimm5y: v is a25_21 [ v = a25_21 + 1; ] { export *[const]:4 v; }

mem32b: "("^rx^", "^b11_0^")" is rx; b11_0 { local a:4 = rx + b11_0; export a; }
mem32h: "("^rx^", "^v^")" is rx; b11_0 [ v = b11_0 << 1; ] { local a:4 = rx + v; export a; }
mem32w: "("^rx^", "^v^")" is rx; b11_0 [ v = b11_0 << 2; ] { local a:4 = rx + v; export a; }

shamt: "<< 0" is b9_5=1 { export 0:4; }
shamt: "<< 1" is b9_5=2 { export 1:4; }
shamt: "<< 2" is b9_5=4 { export 2:4; }
shamt: "<< 3" is b9_5=8 { export 3:4; }
shamt: "<<" is b9_5 { export 0:4; }
memr: "("^rx^", "^ry^" "^shamt^")" is rx & ry; shamt { local a:4 = rx + (ry << shamt); export a; }

br16: dest is b15_0s [ dest = inst_start + (b15_0s << 1); ] { export *:4 dest; }
br26: dest is a25_16s; b15_0 [ dest = inst_start + (((a25_16s << 16) | b15_0) << 1); ] { export *:4 dest; }
pcrel18: dest is a17_16s; b15_0 [ dest = inst_start + (((a17_16s << 16) | b15_0) << 1); ] { export *[const]:4 dest; }
imm18: v is a17_16; b15_0 [ v = (a17_16 << 16) | b15_0; ] { export *[const]:4 v; }
oimm18: v is a17_16; b15_0 [ v = ((a17_16 << 16) | b15_0) + 1; ] { export *[const]:4 v; }
lrw32: v is b15_0 [ v = (inst_start + (b15_0 << 2)) & 0xfffffffc; ] { export *:4 v; }

################################################################
# 16-bit instructions
################################################################

:bkpt is h15_0=0 { breakpoint(); }
:lrw r5_7, elrw16 is h15_10=0x00 & r5_7 & elrw16 { r5_7 = elrw16; }
:br br10 is h15_10=0x01 & br10 { goto br10; }
:bt br10 is h15_10=0x02 & br10 { if (C) goto br10; }
:bf br10 is h15_10=0x03 & br10 { if (!C) goto br10; }
:lrw r5_7, lrw16 is h15_10=0x04 & r5_7 & lrw16 { r5_7 = lrw16; }

:addi "r14, r14, "^spimm7 is h15_10=0x05 & h7_5=0 & spimm7 { r14 = r14 + spimm7; }
:subi "r14, r14, "^spimm7 is h15_10=0x05 & h7_5=1 & spimm7 { r14 = r14 - spimm7; }
:nie is h15_0=0x1460 { interrupt_nest_enable(); }
:nir is h15_0=0x1461 { local t:4 = interrupt_nest_return(); return [t]; }
:ipush is h15_0=0x1462 { interrupt_push(); }
:ipop is h15_0=0x1463 { interrupt_pop(); }

push16list:  is h3_0=0 & h4=0 {  }
push16list: "r15" is h3_0=0 & h4=1 { r14 = r14 - 4; *:4 (r14 + 0) = r15; }
push16list: "r4" is h3_0=1 & h4=0 { r14 = r14 - 4; *:4 (r14 + 0) = r4; }
push16list: "r4, r15" is h3_0=1 & h4=1 { r14 = r14 - 8; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r15; }
push16list: "r4-r5" is h3_0=2 & h4=0 { r14 = r14 - 8; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; }
push16list: "r4-r5, r15" is h3_0=2 & h4=1 { r14 = r14 - 12; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r15; }
push16list: "r4-r6" is h3_0=3 & h4=0 { r14 = r14 - 12; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; }
push16list: "r4-r6, r15" is h3_0=3 & h4=1 { r14 = r14 - 16; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; *:4 (r14 + 12) = r15; }
push16list: "r4-r7" is h3_0=4 & h4=0 { r14 = r14 - 16; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; *:4 (r14 + 12) = r7; }
push16list: "r4-r7, r15" is h3_0=4 & h4=1 { r14 = r14 - 20; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; *:4 (r14 + 12) = r7; *:4 (r14 + 16) = r15; }
push16list: "r4-r8" is h3_0=5 & h4=0 { r14 = r14 - 20; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; *:4 (r14 + 12) = r7; *:4 (r14 + 16) = r8; }
push16list: "r4-r8, r15" is h3_0=5 & h4=1 { r14 = r14 - 24; *:4 (r14 + 0) = r4; *:4 (r14 + 4) = r5; *:4 (r14 + 8) = r6; *:4 (r14 + 12) = r7; *:4 (r14 + 16) = r8; *:4 (r14 + 20) = r15; }
