
EABr1: earB is eamode=0xa & eaw=0 & earB { export earB; }
EABm1: "@"^ear is eamode=0xd & eaw=0 & ear & rpg { local a:$(ASZ); mkaddr(a, rpg, ear); export *:1 a; }
EABm1: "@-"^ear is eamode=0xb & eaw=0 & ear & rpg { ear = ear - 1; local a:$(ASZ); mkaddr(a, rpg, ear); export *:1 a; }
EABm1: "@"^ear^"+" is eamode=0xc & eaw=0 & ear & rpg { local a:$(ASZ); mkaddr(a, rpg, ear); ear = ear + 1; export *:1 a; }
EABm2: "@("^simm8^","^ear^")" is eamode=0xe & eaw=0 & ear & rpg; simm8 { local o:2 = ear + simm8; local a:$(ASZ); mkaddr(a, rpg, o); export *:1 a; }
EABm3: "@("^imm16^","^ear^")" is eamode=0xf & eaw=0 & ear & rpg; imm16 { local o:2 = ear + imm16; local a:$(ASZ); mkaddr(a, rpg, o); export *:1 a; }
EABm2: "@"^imm8^":8" is ealo=0x05; imm8 { local o:2 = (zext(BR) << 8) | imm8; local a:$(ASZ); mkaddr(a, 0:1, o); export *:1 a; }
EABm3: "@"^imm16^":16" is ealo=0x15; imm16 { local a:$(ASZ); mkaddr(a, DP, imm16:2); export *:1 a; }
IMMB2: "#"^imm8 is ealo=0x04; imm8 { export *[const]:1 imm8; }

EAWr1: earW is eamode=0xa & eaw=1 & earW { export earW; }
EAWm1: "@"^ear is eamode=0xd & eaw=1 & ear & rpg { local a:$(ASZ); mkaddr(a, rpg, ear); export *:2 a; }
EAWm1: "@-"^ear is eamode=0xb & eaw=1 & ear & rpg { ear = ear - 2; local a:$(ASZ); mkaddr(a, rpg, ear); export *:2 a; }
EAWm1: "@"^ear^"+" is eamode=0xc & eaw=1 & ear & rpg { local a:$(ASZ); mkaddr(a, rpg, ear); ear = ear + 2; export *:2 a; }
EAWm2: "@("^simm8^","^ear^")" is eamode=0xe & eaw=1 & ear & rpg; simm8 { local o:2 = ear + simm8; local a:$(ASZ); mkaddr(a, rpg, o); export *:2 a; }
EAWm3: "@("^imm16^","^ear^")" is eamode=0xf & eaw=1 & ear & rpg; imm16 { local o:2 = ear + imm16; local a:$(ASZ); mkaddr(a, rpg, o); export *:2 a; }
EAWm2: "@"^imm8^":8" is ealo=0x0d; imm8 { local o:2 = (zext(BR) << 8) | imm8; local a:$(ASZ); mkaddr(a, 0:1, o); export *:2 a; }
EAWm3: "@"^imm16^":16" is ealo=0x1d; imm16 { local a:$(ASZ); mkaddr(a, DP, imm16:2); export *:2 a; }
IMMW3: "#"^imm16 is ealo=0x0c; imm16 { export *[const]:2 imm16; }

EAB1: EABm1 is EABm1 { export EABm1; }
EAB2: EABm2 is EABm2 { export EABm2; }
EAB3: EABm3 is EABm3 { export EABm3; }
EAB1: EABr1 is EABr1 { export EABr1; }
SRCB1: EAB1 is EAB1 { export EAB1; }
SRCB2: EAB2 is EAB2 { export EAB2; }
SRCB3: EAB3 is EAB3 { export EAB3; }
SRCB2: IMMB2 is IMMB2 { export IMMB2; }
EAW1: EAWm1 is EAWm1 { export EAWm1; }
EAW2: EAWm2 is EAWm2 { export EAWm2; }
EAW3: EAWm3 is EAWm3 { export EAWm3; }
EAW1: EAWr1 is EAWr1 { export EAWr1; }
SRCW1: EAW1 is EAW1 { export EAW1; }
SRCW2: EAW2 is EAW2 { export EAW2; }
SRCW3: EAW3 is EAW3 { export EAW3; }
SRCW3: IMMW3 is IMMW3 { export IMMW3; }
:ADD.B SRCB1, gRB is (eamode=0xa | eamode=0xb | eamode=0xc | eamode=0xd) & eaw=0 & SRCB1; g5=0x04 & gRB { local src:1 = SRCB1; addflags(gRB, src); gRB = gRB + src; setNZ(gRB); }
:ADD.B SRCB2, gRB is (eamode=0xe & eaw=0) ... & SRCB2; g5=0x04 & gRB { local src:1 = SRCB2; addflags(gRB, src); gRB = gRB + src; setNZ(gRB); }
