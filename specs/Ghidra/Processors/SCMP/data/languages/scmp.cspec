<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <integer_size value="1"/>
    <short_size value="1"/>
    <long_size value="2"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="P2" space="ram" growth="negative"/>
  <default_proto>
    <prototype name="__asmscmp" extrapop="0" stackshift="0">
      <input>

      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="AC"/>
        </pentry>
      </output>
      <unaffected>
        <register name="P2"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
