# 111011: ori
:ori rzh, rx, imm16 is a31_26=0x3b & rzh & rx; imm16 { rzh = rx | imm16; }

# 111110: 3E3R1 / 3E3R3 multiply and divide extensions
:mul.u32 rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x400 & rz & rz_p1 { local p:8 = zext(rx) * zext(ry); rz = p:4; rz_p1 = p(4); }
:mul.s32 rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x410 & rz & rz_p1 { local p:8 = sext(rx) * sext(ry); rz = p:4; rz_p1 = p(4); }
:mula.u32 rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x404 & rz & rz_p1 { local acc:8 = (zext(rz_p1) << 32) | zext(rz); acc = acc + zext(rx) * zext(ry); rz = acc:4; rz_p1 = acc(4); }
:mula.s32 rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x414 & rz & rz_p1 { local acc:8 = (zext(rz_p1) << 32) | zext(rz); acc = acc + sext(rx) * sext(ry); rz = acc:4; rz_p1 = acc(4); }
:mula.32.l rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x422 & rz { rz = rz + rx * ry; }
:mulall.s16.s rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x40d & rz { rz = mulall_s16_s(rz, rx, ry); }
:divul rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x713 & rz { local q:4 = rx / ry; rz = q; }
:divsl rz, rx, ry is a31_26=0x3e & rx & ry; b15_5=0x717 & rz { local q:4 = rx s/ ry; rz = q; }

# 111111: coprocessor
cpv20: v is a20_16; b15_0 [ v = (a20_16 << 15) | (b15_0 & 0x7fff); ] { export *[const]:4 v; }
:cprgr rx, "<"^a25_21^", "^b11_0^">" is a31_26=0x3f & rx & a25_21; b15_12=0 & b11_0 { local c:1 = a25_21; local n:2 = b11_0; rx = coprocessor(0:1, c, n); }
