<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>
  <default_symbols>
    <symbol name="FIRQ" address="FFF6" entry="true" type="code_ptr"/>
    <symbol name="IRQ" address="FFF8" entry="true" type="code_ptr"/>
    <symbol name="NMI" address="FFFC" entry="true" type="code_ptr"/>
    <symbol name="RESET" address="FFFE" entry="true" type="code_ptr"/>
  </default_symbols>
</processor_spec>
