DP9: is dpr4=1 & sel9=0 & off9 { a:3 = zext(DPR0) + off9; export a; }
DP9: is dpr4=1 & sel9=1 & off9 { a:3 = zext(DPR1) + off9; export a; }
DP9: is dpr4=1 & sel9=2 & off9 { a:3 = zext(DPR2) + off9; export a; }
