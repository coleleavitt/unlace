# SLEIGH specification for the NEC uPD7810 / uPD7811 / uPD78C10 / uPD78C11 / uPD78C14
# 8-bit microcontrollers (Casio PV-2000 and PB-1000 peripherals, Epoch Super Cassette
# Vision, many printers, synthesizers and arcade boards).
#
# Written for unlace from the NEC uPD7810/7811 user's manual instruction set. The
# per-opcode table (prefix bytes 48, 4C, 4D, 60, 64, 70, 74) was generated from the
# MAME project's upd7810 disassembler tables and semantics checked against its core,
# read for reference only.
#
# Skip instructions (the PSW SK flag) are modelled as a conditional branch over the
# next instruction (inst_next2). The on-chip special function registers live in the
# separate 'sfr' space so a port read is a memory read the decompiler does not fold.

define endian=little;
define alignment=1;

define space RAM      type=ram_space      size=2 default;
define space sfr      type=ram_space      size=1;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ VA BC DE HL EA SP PC ];
define register offset=0x00 size=1 [ A V C B E D L H EAL EAH ];
define register offset=0x10 size=2 [ VA2 BC2 DE2 HL2 EA2 ];
define register offset=0x20 size=1 [ Z HC CY ];

define token opbyte (8)
  op    = (0,7)
  op6hi = (6,7)
  op3hi = (5,7)
  op5hi = (3,7)
  op7hi = (1,7)
  jr6   = (0,5) signed
  calt5 = (0,4)
  calf3 = (0,2)
  jre1  = (0,0)
;

define token opbyte2 (8)
  op2 = (0,7)
;

define token data8 (8)
  imm8 = (0,7)
  wa   = (0,7)
  d8   = (0,7)
;

define token data16 (16)
  imm16 = (0,15)
;

define pcodeop enableInterrupts;
define pcodeop disableInterrupts;
define pcodeop halt;
define pcodeop stop;
define pcodeop testInterrupt;
define pcodeop testClearInterrupt;

macro packPSW(p) {
  p = (Z << 6) | (HC << 4) | CY;
}

macro unpackPSW(p) {
  Z = (p & 0x40) != 0;
  HC = (p & 0x10) != 0;
  CY = (p & 0x01) != 0;
}

JW: imm16 is imm16 { export *:2 imm16; }
JR6: dest is jr6 [ dest = inst_next + jr6; ] { export *:2 dest; }
JRE: dest is jre1; d8 [ dest = inst_next + (jre1 << 8) + d8 - (jre1 << 9); ] { export *:2 dest; }
CALTT: tab is calt5 [ tab = 0x80 + 2 * calt5; ] { export *[const]:2 tab; }
CALFT: dest is calf3; d8 [ dest = 0x800 + (calf3 << 8) + d8; ] { export *:2 dest; }

:SLRC "A" is op=0x48; op2=0x01 { CY = (A & 1) != 0; A = A >> 1; if (CY != 0) goto inst_next2; }
:SLRC "B" is op=0x48; op2=0x02 { CY = (B & 1) != 0; B = B >> 1; if (CY != 0) goto inst_next2; }
:SLRC "C" is op=0x48; op2=0x03 { CY = (C & 1) != 0; C = C >> 1; if (CY != 0) goto inst_next2; }
:SLLC "A" is op=0x48; op2=0x05 { CY = (A & 0x80) != 0; A = A << 1; if (CY != 0) goto inst_next2; }
:SLLC "B" is op=0x48; op2=0x06 { CY = (B & 0x80) != 0; B = B << 1; if (CY != 0) goto inst_next2; }
:SLLC "C" is op=0x48; op2=0x07 { CY = (C & 0x80) != 0; C = C << 1; if (CY != 0) goto inst_next2; }
:SK "NV" is op=0x48; op2=0x08 {  }
:SK "CY" is op=0x48; op2=0x0A { if (CY != 0) goto inst_next2; }
:SK "HC" is op=0x48; op2=0x0B { if (HC != 0) goto inst_next2; }
:SK "Z" is op=0x48; op2=0x0C { if (Z != 0) goto inst_next2; }
:SKN "NV" is op=0x48; op2=0x18 { if (1:1) goto inst_next2; }
:SKN "CY" is op=0x48; op2=0x1A { if (CY == 0) goto inst_next2; }
:SKN "HC" is op=0x48; op2=0x1B { if (HC == 0) goto inst_next2; }
:SKN "Z" is op=0x48; op2=0x1C { if (Z == 0) goto inst_next2; }
:SLR "A" is op=0x48; op2=0x21 { CY = (A & 1) != 0; A = A >> 1; }
:SLR "B" is op=0x48; op2=0x22 { CY = (B & 1) != 0; B = B >> 1; }
:SLR "C" is op=0x48; op2=0x23 { CY = (C & 1) != 0; C = C >> 1; }
:SLL "A" is op=0x48; op2=0x25 { CY = (A & 0x80) != 0; A = A << 1; }
:SLL "B" is op=0x48; op2=0x26 { CY = (B & 0x80) != 0; B = B << 1; }
:SLL "C" is op=0x48; op2=0x27 { CY = (C & 0x80) != 0; C = C << 1; }
:JEA  is op=0x48; op2=0x28 { goto [EA]; }
:CALB  is op=0x48; op2=0x29 { SP = SP - 2; *:2 SP = inst_next; call [BC]; }
:CLC  is op=0x48; op2=0x2A { CY = 0; }
:STC  is op=0x48; op2=0x2B { CY = 1; }
:MUL "A" is op=0x48; op2=0x2D { EA = zext(A) * zext(A); }
:MUL "B" is op=0x48; op2=0x2E { EA = zext(A) * zext(B); }
:MUL "C" is op=0x48; op2=0x2F { EA = zext(A) * zext(C); }
:RLR "A" is op=0x48; op2=0x31 { local c:1 = CY; CY = (A & 1) != 0; A = (A >> 1) | (c << 7); }
:RLR "B" is op=0x48; op2=0x32 { local c:1 = CY; CY = (B & 1) != 0; B = (B >> 1) | (c << 7); }
:RLR "C" is op=0x48; op2=0x33 { local c:1 = CY; CY = (C & 1) != 0; C = (C >> 1) | (c << 7); }
:RLL "A" is op=0x48; op2=0x35 { local c:1 = CY; CY = (A & 0x80) != 0; A = (A << 1) | c; }
:RLL "B" is op=0x48; op2=0x36 { local c:1 = CY; CY = (B & 0x80) != 0; B = (B << 1) | c; }
:RLL "C" is op=0x48; op2=0x37 { local c:1 = CY; CY = (C & 0x80) != 0; C = (C << 1) | c; }
:RLD  is op=0x48; op2=0x38 { local m:1 = *:1 HL; local t:1 = (m << 4) | (A & 0x0f); A = (A & 0xf0) | (m >> 4); *:1 HL = t; }
:RRD  is op=0x48; op2=0x39 { local m:1 = *:1 HL; local t:1 = (A << 4) | (m >> 4); A = (A & 0xf0) | (m & 0x0f); *:1 HL = t; }
:NEGA  is op=0x48; op2=0x3A { A = -A; }
:HLT  is op=0x48; op2=0x3B { halt(); }
:DIV "A" is op=0x48; op2=0x3D { local d:2 = zext(A); if (d == 0) goto <z>; local q:2 = EA / d; local rm:2 = EA % d; EA = q; A = rm:1; goto <done>; <z> A = EAL; EA = 0xffff; <done> }
:DIV "B" is op=0x48; op2=0x3E { local d:2 = zext(B); if (d == 0) goto <z>; local q:2 = EA / d; local rm:2 = EA % d; EA = q; B = rm:1; goto <done>; <z> B = EAL; EA = 0xffff; <done> }
:DIV "C" is op=0x48; op2=0x3F { local d:2 = zext(C); if (d == 0) goto <z>; local q:2 = EA / d; local rm:2 = EA % d; EA = q; C = rm:1; goto <done>; <z> C = EAL; EA = 0xffff; <done> }
:SKIT "NMI" is op=0x48; op2=0x40 { local f:1 = testClearInterrupt(0:1); if (f != 0) goto inst_next2; }
:SKIT "FT0" is op=0x48; op2=0x41 { local f:1 = testClearInterrupt(1:1); if (f != 0) goto inst_next2; }
:SKIT "FT1" is op=0x48; op2=0x42 { local f:1 = testClearInterrupt(2:1); if (f != 0) goto inst_next2; }
:SKIT "F1" is op=0x48; op2=0x43 { local f:1 = testClearInterrupt(3:1); if (f != 0) goto inst_next2; }
:SKIT "F2" is op=0x48; op2=0x44 { local f:1 = testClearInterrupt(4:1); if (f != 0) goto inst_next2; }
:SKIT "FE0" is op=0x48; op2=0x45 { local f:1 = testClearInterrupt(5:1); if (f != 0) goto inst_next2; }
:SKIT "FE1" is op=0x48; op2=0x46 { local f:1 = testClearInterrupt(6:1); if (f != 0) goto inst_next2; }
:SKIT "FEIN" is op=0x48; op2=0x47 { local f:1 = testClearInterrupt(7:1); if (f != 0) goto inst_next2; }
:SKIT "FAD" is op=0x48; op2=0x48 { local f:1 = testClearInterrupt(8:1); if (f != 0) goto inst_next2; }
:SKIT "FSR" is op=0x48; op2=0x49 { local f:1 = testClearInterrupt(9:1); if (f != 0) goto inst_next2; }
:SKIT "FST" is op=0x48; op2=0x4A { local f:1 = testClearInterrupt(10:1); if (f != 0) goto inst_next2; }
:SKIT "ER" is op=0x48; op2=0x4B { local f:1 = testClearInterrupt(11:1); if (f != 0) goto inst_next2; }
:SKIT "OV" is op=0x48; op2=0x4C { local f:1 = testClearInterrupt(12:1); if (f != 0) goto inst_next2; }
:SKIT "AN4" is op=0x48; op2=0x50 { local f:1 = testClearInterrupt(16:1); if (f != 0) goto inst_next2; }
:SKIT "AN5" is op=0x48; op2=0x51 { local f:1 = testClearInterrupt(17:1); if (f != 0) goto inst_next2; }
:SKIT "AN6" is op=0x48; op2=0x52 { local f:1 = testClearInterrupt(18:1); if (f != 0) goto inst_next2; }
:SKIT "AN7" is op=0x48; op2=0x53 { local f:1 = testClearInterrupt(19:1); if (f != 0) goto inst_next2; }
:SKIT "SB" is op=0x48; op2=0x54 { local f:1 = testClearInterrupt(20:1); if (f != 0) goto inst_next2; }
:SKNIT "NMI" is op=0x48; op2=0x60 { local f:1 = testInterrupt(0:1); if (f == 0) goto inst_next2; }
:SKNIT "FT0" is op=0x48; op2=0x61 { local f:1 = testInterrupt(1:1); if (f == 0) goto inst_next2; }
:SKNIT "FT1" is op=0x48; op2=0x62 { local f:1 = testInterrupt(2:1); if (f == 0) goto inst_next2; }
:SKNIT "F1" is op=0x48; op2=0x63 { local f:1 = testInterrupt(3:1); if (f == 0) goto inst_next2; }
:SKNIT "F2" is op=0x48; op2=0x64 { local f:1 = testInterrupt(4:1); if (f == 0) goto inst_next2; }
:SKNIT "FE0" is op=0x48; op2=0x65 { local f:1 = testInterrupt(5:1); if (f == 0) goto inst_next2; }
:SKNIT "FE1" is op=0x48; op2=0x66 { local f:1 = testInterrupt(6:1); if (f == 0) goto inst_next2; }
:SKNIT "FEIN" is op=0x48; op2=0x67 { local f:1 = testInterrupt(7:1); if (f == 0) goto inst_next2; }
:SKNIT "FAD" is op=0x48; op2=0x68 { local f:1 = testInterrupt(8:1); if (f == 0) goto inst_next2; }
:SKNIT "FSR" is op=0x48; op2=0x69 { local f:1 = testInterrupt(9:1); if (f == 0) goto inst_next2; }
:SKNIT "FST" is op=0x48; op2=0x6A { local f:1 = testInterrupt(10:1); if (f == 0) goto inst_next2; }
:SKNIT "ER" is op=0x48; op2=0x6B { local f:1 = testInterrupt(11:1); if (f == 0) goto inst_next2; }
:SKNIT "OV" is op=0x48; op2=0x6C { local f:1 = testInterrupt(12:1); if (f == 0) goto inst_next2; }
:SKNIT "AN4" is op=0x48; op2=0x70 { local f:1 = testInterrupt(16:1); if (f == 0) goto inst_next2; }
:SKNIT "AN5" is op=0x48; op2=0x71 { local f:1 = testInterrupt(17:1); if (f == 0) goto inst_next2; }
:SKNIT "AN6" is op=0x48; op2=0x72 { local f:1 = testInterrupt(18:1); if (f == 0) goto inst_next2; }
:SKNIT "AN7" is op=0x48; op2=0x73 { local f:1 = testInterrupt(19:1); if (f == 0) goto inst_next2; }
:SKNIT "SB" is op=0x48; op2=0x74 { local f:1 = testInterrupt(20:1); if (f == 0) goto inst_next2; }
:LDEAX "(DE)" is op=0x48; op2=0x82 { EA = *:2 DE; }
:LDEAX "(HL)" is op=0x48; op2=0x83 { EA = *:2 HL; }
:LDEAX "(DE++)" is op=0x48; op2=0x84 { local ma:2 = DE; EA = *:2 ma; DE = DE + 2; }
:LDEAX "(HL++)" is op=0x48; op2=0x85 { local ma:2 = HL; EA = *:2 ma; HL = HL + 2; }
:LDEAX "(DE+"^imm8^")" is op=0x48; op2=0x8B; imm8 { local ma:2 = DE + imm8; EA = *:2 ma; }
:LDEAX "(HL+A)" is op=0x48; op2=0x8C { local ma:2 = HL + zext(A); EA = *:2 ma; }
:LDEAX "(HL+B)" is op=0x48; op2=0x8D { local ma:2 = HL + zext(B); EA = *:2 ma; }
:LDEAX "(HL+EA)" is op=0x48; op2=0x8E { local ma:2 = HL + EA; EA = *:2 ma; }
:LDEAX "(HL+"^imm8^")" is op=0x48; op2=0x8F; imm8 { local ma:2 = HL + imm8; EA = *:2 ma; }
:STEAX "(DE)" is op=0x48; op2=0x92 { *:2 DE = EA; }
:STEAX "(HL)" is op=0x48; op2=0x93 { *:2 HL = EA; }
:STEAX "(DE++)" is op=0x48; op2=0x94 { local ma:2 = DE; *:2 ma = EA; DE = DE + 2; }
:STEAX "(HL++)" is op=0x48; op2=0x95 { local ma:2 = HL; *:2 ma = EA; HL = HL + 2; }
:STEAX "(DE+"^imm8^")" is op=0x48; op2=0x9B; imm8 { local ma:2 = DE + imm8; *:2 ma = EA; }
:STEAX "(HL+A)" is op=0x48; op2=0x9C { local ma:2 = HL + zext(A); *:2 ma = EA; }
:STEAX "(HL+B)" is op=0x48; op2=0x9D { local ma:2 = HL + zext(B); *:2 ma = EA; }
:STEAX "(HL+EA)" is op=0x48; op2=0x9E { local ma:2 = HL + EA; *:2 ma = EA; }
:STEAX "(HL+"^imm8^")" is op=0x48; op2=0x9F; imm8 { local ma:2 = HL + imm8; *:2 ma = EA; }
:DSLR "EA" is op=0x48; op2=0xA0 { CY = (EA & 1) != 0; EA = EA >> 1; }
:DSLL "EA" is op=0x48; op2=0xA4 { CY = (EA & 0x8000) != 0; EA = EA << 1; }
:TABLE  is op=0x48; op2=0xA8 { local t:2 = inst_next + zext(A) + 1; C = *:1 t; local t1:2 = t + 1; B = *:1 t1; }
:DRLR "EA" is op=0x48; op2=0xB0 { local c:2 = zext(CY); CY = (EA & 1) != 0; EA = (EA >> 1) | (c << 15); }
:DRLL "EA" is op=0x48; op2=0xB4 { local c:2 = zext(CY); CY = (EA & 0x8000) != 0; EA = (EA << 1) | c; }
:STOP  is op=0x48; op2=0xBB { stop(); }
:DMOV "EA,ECNT" is op=0x48; op2=0xC0 { EA = *[sfr]:2 64:1; }
:DMOV "EA,ECPT" is op=0x48; op2=0xC1 { EA = *[sfr]:2 66:1; }
:DMOV "ETM0,EA" is op=0x48; op2=0xD2 { *[sfr]:2 68:1 = EA; }
:DMOV "ETM1,EA" is op=0x48; op2=0xD3 { *[sfr]:2 70:1 = EA; }
:ANA "V,A" is op=0x60; op2=0x08 { local x:1 = V; local y:1 = A; local r:1 = x & y; Z = r == 0; V = r; }
:ANA "A,A" is op=0x60; op2=0x09 { local x:1 = A; local y:1 = A; local r:1 = x & y; Z = r == 0; A = r; }
:ANA "B,A" is op=0x60; op2=0x0A { local x:1 = B; local y:1 = A; local r:1 = x & y; Z = r == 0; B = r; }
:ANA "C,A" is op=0x60; op2=0x0B { local x:1 = C; local y:1 = A; local r:1 = x & y; Z = r == 0; C = r; }
:ANA "D,A" is op=0x60; op2=0x0C { local x:1 = D; local y:1 = A; local r:1 = x & y; Z = r == 0; D = r; }
:ANA "E,A" is op=0x60; op2=0x0D { local x:1 = E; local y:1 = A; local r:1 = x & y; Z = r == 0; E = r; }
:ANA "H,A" is op=0x60; op2=0x0E { local x:1 = H; local y:1 = A; local r:1 = x & y; Z = r == 0; H = r; }
:ANA "L,A" is op=0x60; op2=0x0F { local x:1 = L; local y:1 = A; local r:1 = x & y; Z = r == 0; L = r; }
:XRA "V,A" is op=0x60; op2=0x10 { local x:1 = V; local y:1 = A; local r:1 = x ^ y; Z = r == 0; V = r; }
:XRA "A,A" is op=0x60; op2=0x11 { local x:1 = A; local y:1 = A; local r:1 = x ^ y; Z = r == 0; A = r; }
:XRA "B,A" is op=0x60; op2=0x12 { local x:1 = B; local y:1 = A; local r:1 = x ^ y; Z = r == 0; B = r; }
:XRA "C,A" is op=0x60; op2=0x13 { local x:1 = C; local y:1 = A; local r:1 = x ^ y; Z = r == 0; C = r; }
:XRA "D,A" is op=0x60; op2=0x14 { local x:1 = D; local y:1 = A; local r:1 = x ^ y; Z = r == 0; D = r; }
:XRA "E,A" is op=0x60; op2=0x15 { local x:1 = E; local y:1 = A; local r:1 = x ^ y; Z = r == 0; E = r; }
:XRA "H,A" is op=0x60; op2=0x16 { local x:1 = H; local y:1 = A; local r:1 = x ^ y; Z = r == 0; H = r; }
:XRA "L,A" is op=0x60; op2=0x17 { local x:1 = L; local y:1 = A; local r:1 = x ^ y; Z = r == 0; L = r; }
:ORA "V,A" is op=0x60; op2=0x18 { local x:1 = V; local y:1 = A; local r:1 = x | y; Z = r == 0; V = r; }
:ORA "A,A" is op=0x60; op2=0x19 { local x:1 = A; local y:1 = A; local r:1 = x | y; Z = r == 0; A = r; }
:ORA "B,A" is op=0x60; op2=0x1A { local x:1 = B; local y:1 = A; local r:1 = x | y; Z = r == 0; B = r; }
:ORA "C,A" is op=0x60; op2=0x1B { local x:1 = C; local y:1 = A; local r:1 = x | y; Z = r == 0; C = r; }
:ORA "D,A" is op=0x60; op2=0x1C { local x:1 = D; local y:1 = A; local r:1 = x | y; Z = r == 0; D = r; }
:ORA "E,A" is op=0x60; op2=0x1D { local x:1 = E; local y:1 = A; local r:1 = x | y; Z = r == 0; E = r; }
:ORA "H,A" is op=0x60; op2=0x1E { local x:1 = H; local y:1 = A; local r:1 = x | y; Z = r == 0; H = r; }
:ORA "L,A" is op=0x60; op2=0x1F { local x:1 = L; local y:1 = A; local r:1 = x | y; Z = r == 0; L = r; }
:ADDNC "V,A" is op=0x60; op2=0x20 { local x:1 = V; local y:1 = A; local c:1 = 0; local r9:2 = zext(x) + zext(y) + zext(c); local r:1 = r9:1; CY = r9 > 0xff; HC = ((x & 0xf) + (y & 0xf) + zext(c)) > 0xf; Z = r == 0; V = r; if (CY == 0) goto inst_next2; }
:ADDNC "A,A" is op=0x60; op2=0x21 { local x:1 = A; local y:1 = A; local c:1 = 0; local r9:2 = zext(x) + zext(y) + zext(c); local r:1 = r9:1; CY = r9 > 0xff; HC = ((x & 0xf) + (y & 0xf) + zext(c)) > 0xf; Z = r == 0; A = r; if (CY == 0) goto inst_next2; }
:ADDNC "B,A" is op=0x60; op2=0x22 { local x:1 = B; local y:1 = A; local c:1 = 0; local r9:2 = zext(x) + zext(y) + zext(c); local r:1 = r9:1; CY = r9 > 0xff; HC = ((x & 0xf) + (y & 0xf) + zext(c)) > 0xf; Z = r == 0; B = r; if (CY == 0) goto inst_next2; }
:ADDNC "C,A" is op=0x60; op2=0x23 { local x:1 = C; local y:1 = A; local c:1 = 0; local r9:2 = zext(x) + zext(y) + zext(c); local r:1 = r9:1; CY = r9 > 0xff; HC = ((x & 0xf) + (y & 0xf) + zext(c)) > 0xf; Z = r == 0; C = r; if (CY == 0) goto inst_next2; }
:ADDNC "D,A" is op=0x60; op2=0x24 { local x:1 = D; local y:1 = A; local c:1 = 0; local r9:2 = zext(x) + zext(y) + zext(c); local r:1 = r9:1; CY = r9 > 0xff; HC = ((x & 0xf) + (y & 0xf) + zext(c)) > 0xf; Z = r == 0; D = r; if (CY == 0) goto inst_next2; }
