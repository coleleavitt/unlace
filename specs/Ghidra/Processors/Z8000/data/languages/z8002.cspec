<?xml version="1.0" encoding="UTF-8"?>

<!-- Zilog Z8000. CALL/CALR push a 2-byte return address and RET pops it; the stack pointer
     is R15. No single C ABI is documented; the default model passes word arguments in
     R7, R6, R5, R4 (long arguments in RR6, RR4) and returns a word in R7 (long in RR6). -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="R15" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2"><register name="R7"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R6"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R5"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R4"/></pentry>
        <pentry minsize="1" maxsize="500" align="2"><addr offset="2" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2"><register name="R7"/></pentry>
        <pentry minsize="3" maxsize="4"><register name="RR6"/></pentry>
      </output>
      <unaffected>
        <register name="R15"/>
        <register name="R8"/><register name="R9"/><register name="R10"/><register name="R11"/>
        <register name="R12"/><register name="R13"/>
      </unaffected>
      <killedbycall>
        <register name="C"/><register name="Z"/><register name="S"/><register name="V"/>
        <register name="D"/><register name="H"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
