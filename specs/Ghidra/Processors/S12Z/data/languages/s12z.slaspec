# NXP S12Z (MC9S12ZVL, MC9S12ZVC, MC9S12ZVM, S12ZVH) SLEIGH specification.
# Written for unlace from the NXP S12Z CPU Reference Manual (S12ZCPU RM) opcode
# tables. Clean-room: no GPL text and no community Ghidra/SLEIGH module was used.
# Big-endian, 24-bit linear address space. Data registers D2-D5 are 16 bits,
# D0-D1 8 bits, D6-D7 32 bits; X, Y and S are 24 bits.
# A register operand is a table per encoding field and register set (Wreg_op, D6D7_pblo, ...):
# one constructor covers the registers of one size, since a table's exports share a size.

define endian=big;
define alignment=1;

define space ram type=ram_space size=3 default;
define space register type=register_space size=4;

define register offset=0x00 size=2 [ D2 D3 D4 D5 ];
define register offset=0x08 size=1 [ D0 D1 ];
define register offset=0x10 size=4 [ D6 D7 ];
define register offset=0x20 size=3 [ X ];
define register offset=0x24 size=3 [ Y ];
define register offset=0x28 size=3 [ SP ];
define register offset=0x2c size=3 [ PC ];
define register offset=0x30 size=2 [ CCW ];
define register offset=0x30 size=1 [ CCH CCL ];
define register offset=0x40 size=1 [ fC fV fZ fN fI fH fX fU fS ];

define token opbyte(8)
  op = (0,7)
  op5 = (3,7)
  op4 = (4,7)
  rsel = (0,2)
  rhi = (2,2)
  rmid = (1,1)
  rW = (0,1)
  rBL = (0,0)
;
define token oprtok(8)
  opr = (0,7)
  opr2 = (6,7)
  opr6 = (0,5)
  oprr = (4,5)
  oprlo = (0,3)
  oprb5 = (5,5)
  oprb3 = (3,3)
  oprb2 = (2,2)
  oprb1 = (1,1)
  oprb0 = (0,0)
  oprd = (0,2)
  opr4 = (4,7)
  oprb4 = (4,4)
;
define token rel7tok(8)
  r7flag = (7,7)
  r7 = (0,6) signed
;
define token rel15tok(16)
  r15flag = (15,15)
  r15 = (0,14) signed
;
define token imm8tok(8) imm8 = (0,7) simm8 = (0,7) signed;
define token pbtok(8)
  pb = (0,7)
  pb7 = (7,7)
  pb6 = (6,6)
  pb64 = (4,6)
  pb42 = (2,4)
  pb53 = (3,5)
  pb54 = (4,5)
  pb3 = (3,3)
  pb2 = (2,2)
  pb32 = (2,3)
  pb10 = (0,1)
  pb20 = (0,2)
  pb73 = (3,7)
  pbhi = (4,7)
  pblo = (0,3)
  pb50 = (0,5)
  pb0 = (0,0)
  pbb0 = (0,0)
  pbb1 = (1,1)
  pbb2 = (2,2)
  pbb3 = (3,3)
  pbb4 = (4,4)
  pbb5 = (5,5)
;
define token p2tok(8) p2 = (0,7);
define token imm16tok(16) imm16 = (0,15) simm16 = (0,15) signed;
define token imm24tok(24) imm24 = (0,23) simm24 = (0,23) signed;
define token imm32tok(32) imm32 = (0,31) simm32 = (0,31) signed;


define pcodeop bgnd;
define pcodeop swi;
define pcodeop unsupported_opr;

macro nzflags(r) { fN = r s< 0; fZ = r == 0; }
macro addflags(a, b, r) {
  fH = ((a ^ b ^ r) & 0x10) != 0;
  fC = carry(a, b);
  fV = scarry(a, b);
  nzflags(r);
}
macro subflags(a, b, r) {
  fH = ((a ^ b ^ r) & 0x10) != 0;
  fC = a < b;
  fV = sborrow(a, b);
  nzflags(r);
}



define pcodeop stop;
define pcodeop wai;
define pcodeop sys;
define pcodeop trap;
define pcodeop rti;
define pcodeop saturate;
define pcodeop count_leading_bits;
define pcodeop fractional_multiply;
define pcodeop bitfield_extract;
define pcodeop bitfield_insert;

macro packccr() { CCL = zext(fC) | (zext(fV) << 1) | (zext(fZ) << 2) | (zext(fN) << 3) | (zext(fI) << 4) | (zext(fH) << 5) | (zext(fX) << 6) | (zext(fS) << 7); }
macro unpackccr() { fC = (CCL & 1) != 0; fV = (CCL & 2) != 0; fZ = (CCL & 4) != 0; fN = (CCL & 8) != 0; fI = (CCL & 0x10) != 0; fH = (CCL & 0x20) != 0; fX = (CCL & 0x40) != 0; fS = (CCL & 0x80) != 0; }

XYSP: X is oprr=0 & X { export X; }
XYSP: Y is oprr=1 & Y { export Y; }
XYSP: SP is oprr=2 & SP { export SP; }
XYSP: "PC" is oprr=3 { local p:3 = inst_start; export p; }
XY4: X is oprb4=0 & X { export X; }
XY4: Y is oprb4=1 & Y { export Y; }

ODn: D2 is oprd=0 & D2 { local v:3 = zext(D2); export v; }
ODn: D3 is oprd=1 & D3 { local v:3 = zext(D3); export v; }
ODn: D4 is oprd=2 & D4 { local v:3 = zext(D4); export v; }
ODn: D5 is oprd=3 & D5 { local v:3 = zext(D5); export v; }
ODn: D0 is oprd=4 & D0 { local v:3 = zext(D0); export v; }
ODn: D1 is oprd=5 & D1 { local v:3 = zext(D1); export v; }
ODn: D6 is oprd=6 & D6 { local v:3 = D6:3; export v; }
ODn: D7 is oprd=7 & D7 { local v:3 = D7:3; export v; }

# OPR postbyte, operand size 1: exports the effective address.
OPR1: oprlo, XYSP is opr2=1 & oprr!=3 & oprlo & XYSP { local ea:3 = XYSP + oprlo; export ea; }
OPR1: addr is opr2=0 & opr6; imm8 [ addr = (opr6 << 8) | imm8; ] { export *[const]:3 addr; }
OPR1: imm24 is opr=0xfa; imm24 { export *[const]:3 imm24; }
OPR1: [imm24] is opr=0xfe; imm24 { local ea:3 = *:3 imm24:3; export ea; }
OPR1: addr is opr2=3 & oprr=3 & oprb3=1 & oprb1=0 & oprb2 & oprb0; imm16 [ addr = (oprb2 << 17) | (oprb0 << 16) | imm16; ] { export *[const]:3 addr; }
OPR1: off, XYSP is opr2=3 & oprb3=0 & oprb2=0 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local ea:3 = XYSP + off; export ea; }
OPR1: [off, XYSP] is opr2=3 & oprb3=0 & oprb2=1 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local p:3 = XYSP + off; local ea:3 = *:3 p; export ea; }
OPR1: simm24, XYSP is opr2=3 & oprlo=2 & XYSP; simm24 { local ea:3 = XYSP + simm24; export ea; }
OPR1: [simm24, XYSP] is opr2=3 & oprlo=6 & XYSP; simm24 { local p:3 = XYSP + simm24; local ea:3 = *:3 p; export ea; }
OPR1: ODn, XYSP is opr2=2 & oprb3=1 & oprr!=3 & ODn & XYSP { local ea:3 = XYSP + ODn; export ea; }
OPR1: [ODn, XYSP] is opr2=3 & oprb5=0 & oprb3=1 & ODn & XYSP { local p:3 = XYSP + ODn; local ea:3 = *:3 p; export ea; }
OPR1: off, ODn is opr2=2 & oprb3=0 & oprr & ODn; imm16 [ off = (oprr << 16) | imm16; ] { local ea:3 = off + ODn; export ea; }
OPR1: imm24, ODn is opr2=3 & oprr=2 & oprb3=1 & ODn; imm24 { local ea:3 = imm24 + ODn; export ea; }
OPR1: "+"XY4 is opr2=3 & oprb5=1 & oprlo=3 & XY4 { XY4 = XY4 + 1; local ea:3 = XY4; export ea; }
OPR1: XY4"+" is opr2=3 & oprb5=1 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 + 1; export ea; }
OPR1: "-"XY4 is opr2=3 & oprb5=0 & oprlo=3 & XY4 { XY4 = XY4 - 1; local ea:3 = XY4; export ea; }
OPR1: XY4"-" is opr2=3 & oprb5=0 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 - 1; export ea; }
OPR1: "-SP" is opr=0xfb { SP = SP - 1; local ea:3 = SP; export ea; }
OPR1: "SP+" is opr=0xff { local ea:3 = SP; SP = SP + 1; export ea; }

OPV1: OPR1 is OPR1 { export *:1 OPR1; }
OPV1: "#-1" is opr=0x70 { local v:1 = -1; export v; }
OPV1: "#"oprlo is opr4=7 & oprlo { export *[const]:1 oprlo; }
OPV1: D2 is opr=0xb8 & D2 { local v:1 = D2:1; export v; }
OPV1: D3 is opr=0xb9 & D3 { local v:1 = D3:1; export v; }
OPV1: D4 is opr=0xba & D4 { local v:1 = D4:1; export v; }
OPV1: D5 is opr=0xbb & D5 { local v:1 = D5:1; export v; }
OPV1: D0 is opr=0xbc & D0 { local v:1 = D0; export v; }
OPV1: D1 is opr=0xbd & D1 { local v:1 = D1; export v; }
OPV1: D6 is opr=0xbe & D6 { local v:1 = D6:1; export v; }
OPV1: D7 is opr=0xbf & D7 { local v:1 = D7:1; export v; }
OPW1: OPR1 is OPR1 { export *:1 OPR1; }
OPW1: D0 is opr=0xbc & D0 { export D0; }
OPW1: D1 is opr=0xbd & D1 { export D1; }

# OPR postbyte, operand size 2: exports the effective address.
OPR2: oprlo, XYSP is opr2=1 & oprr!=3 & oprlo & XYSP { local ea:3 = XYSP + oprlo; export ea; }
OPR2: addr is opr2=0 & opr6; imm8 [ addr = (opr6 << 8) | imm8; ] { export *[const]:3 addr; }
OPR2: imm24 is opr=0xfa; imm24 { export *[const]:3 imm24; }
OPR2: [imm24] is opr=0xfe; imm24 { local ea:3 = *:3 imm24:3; export ea; }
OPR2: addr is opr2=3 & oprr=3 & oprb3=1 & oprb1=0 & oprb2 & oprb0; imm16 [ addr = (oprb2 << 17) | (oprb0 << 16) | imm16; ] { export *[const]:3 addr; }
OPR2: off, XYSP is opr2=3 & oprb3=0 & oprb2=0 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local ea:3 = XYSP + off; export ea; }
OPR2: [off, XYSP] is opr2=3 & oprb3=0 & oprb2=1 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local p:3 = XYSP + off; local ea:3 = *:3 p; export ea; }
OPR2: simm24, XYSP is opr2=3 & oprlo=2 & XYSP; simm24 { local ea:3 = XYSP + simm24; export ea; }
OPR2: [simm24, XYSP] is opr2=3 & oprlo=6 & XYSP; simm24 { local p:3 = XYSP + simm24; local ea:3 = *:3 p; export ea; }
OPR2: ODn, XYSP is opr2=2 & oprb3=1 & oprr!=3 & ODn & XYSP { local ea:3 = XYSP + ODn; export ea; }
OPR2: [ODn, XYSP] is opr2=3 & oprb5=0 & oprb3=1 & ODn & XYSP { local p:3 = XYSP + ODn; local ea:3 = *:3 p; export ea; }
OPR2: off, ODn is opr2=2 & oprb3=0 & oprr & ODn; imm16 [ off = (oprr << 16) | imm16; ] { local ea:3 = off + ODn; export ea; }
OPR2: imm24, ODn is opr2=3 & oprr=2 & oprb3=1 & ODn; imm24 { local ea:3 = imm24 + ODn; export ea; }
OPR2: "+"XY4 is opr2=3 & oprb5=1 & oprlo=3 & XY4 { XY4 = XY4 + 2; local ea:3 = XY4; export ea; }
OPR2: XY4"+" is opr2=3 & oprb5=1 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 + 2; export ea; }
OPR2: "-"XY4 is opr2=3 & oprb5=0 & oprlo=3 & XY4 { XY4 = XY4 - 2; local ea:3 = XY4; export ea; }
OPR2: XY4"-" is opr2=3 & oprb5=0 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 - 2; export ea; }
OPR2: "-SP" is opr=0xfb { SP = SP - 2; local ea:3 = SP; export ea; }
OPR2: "SP+" is opr=0xff { local ea:3 = SP; SP = SP + 2; export ea; }

OPV2: OPR2 is OPR2 { export *:2 OPR2; }
OPV2: "#-1" is opr=0x70 { local v:2 = -1; export v; }
OPV2: "#"oprlo is opr4=7 & oprlo { export *[const]:2 oprlo; }
OPV2: D2 is opr=0xb8 & D2 { local v:2 = D2; export v; }
OPV2: D3 is opr=0xb9 & D3 { local v:2 = D3; export v; }
OPV2: D4 is opr=0xba & D4 { local v:2 = D4; export v; }
OPV2: D5 is opr=0xbb & D5 { local v:2 = D5; export v; }
OPV2: D0 is opr=0xbc & D0 { local v:2 = zext(D0); export v; }
OPV2: D1 is opr=0xbd & D1 { local v:2 = zext(D1); export v; }
OPV2: D6 is opr=0xbe & D6 { local v:2 = D6:2; export v; }
OPV2: D7 is opr=0xbf & D7 { local v:2 = D7:2; export v; }
OPW2: OPR2 is OPR2 { export *:2 OPR2; }
OPW2: D2 is opr=0xb8 & D2 { export D2; }
OPW2: D3 is opr=0xb9 & D3 { export D3; }
OPW2: D4 is opr=0xba & D4 { export D4; }
OPW2: D5 is opr=0xbb & D5 { export D5; }

# OPR postbyte, operand size 3: exports the effective address.
OPR3: oprlo, XYSP is opr2=1 & oprr!=3 & oprlo & XYSP { local ea:3 = XYSP + oprlo; export ea; }
OPR3: addr is opr2=0 & opr6; imm8 [ addr = (opr6 << 8) | imm8; ] { export *[const]:3 addr; }
OPR3: imm24 is opr=0xfa; imm24 { export *[const]:3 imm24; }
OPR3: [imm24] is opr=0xfe; imm24 { local ea:3 = *:3 imm24:3; export ea; }
OPR3: addr is opr2=3 & oprr=3 & oprb3=1 & oprb1=0 & oprb2 & oprb0; imm16 [ addr = (oprb2 << 17) | (oprb0 << 16) | imm16; ] { export *[const]:3 addr; }
OPR3: off, XYSP is opr2=3 & oprb3=0 & oprb2=0 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local ea:3 = XYSP + off; export ea; }
OPR3: [off, XYSP] is opr2=3 & oprb3=0 & oprb2=1 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local p:3 = XYSP + off; local ea:3 = *:3 p; export ea; }
OPR3: simm24, XYSP is opr2=3 & oprlo=2 & XYSP; simm24 { local ea:3 = XYSP + simm24; export ea; }
OPR3: [simm24, XYSP] is opr2=3 & oprlo=6 & XYSP; simm24 { local p:3 = XYSP + simm24; local ea:3 = *:3 p; export ea; }
OPR3: ODn, XYSP is opr2=2 & oprb3=1 & oprr!=3 & ODn & XYSP { local ea:3 = XYSP + ODn; export ea; }
OPR3: [ODn, XYSP] is opr2=3 & oprb5=0 & oprb3=1 & ODn & XYSP { local p:3 = XYSP + ODn; local ea:3 = *:3 p; export ea; }
OPR3: off, ODn is opr2=2 & oprb3=0 & oprr & ODn; imm16 [ off = (oprr << 16) | imm16; ] { local ea:3 = off + ODn; export ea; }
OPR3: imm24, ODn is opr2=3 & oprr=2 & oprb3=1 & ODn; imm24 { local ea:3 = imm24 + ODn; export ea; }
OPR3: "+"XY4 is opr2=3 & oprb5=1 & oprlo=3 & XY4 { XY4 = XY4 + 3; local ea:3 = XY4; export ea; }
OPR3: XY4"+" is opr2=3 & oprb5=1 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 + 3; export ea; }
OPR3: "-"XY4 is opr2=3 & oprb5=0 & oprlo=3 & XY4 { XY4 = XY4 - 3; local ea:3 = XY4; export ea; }
OPR3: XY4"-" is opr2=3 & oprb5=0 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 - 3; export ea; }
OPR3: "-SP" is opr=0xfb { SP = SP - 3; local ea:3 = SP; export ea; }
OPR3: "SP+" is opr=0xff { local ea:3 = SP; SP = SP + 3; export ea; }

OPV3: OPR3 is OPR3 { export *:3 OPR3; }
OPV3: "#-1" is opr=0x70 { local v:3 = -1; export v; }
OPV3: "#"oprlo is opr4=7 & oprlo { export *[const]:3 oprlo; }
OPV3: D2 is opr=0xb8 & D2 { local v:3 = zext(D2); export v; }
OPV3: D3 is opr=0xb9 & D3 { local v:3 = zext(D3); export v; }
OPV3: D4 is opr=0xba & D4 { local v:3 = zext(D4); export v; }
OPV3: D5 is opr=0xbb & D5 { local v:3 = zext(D5); export v; }
OPV3: D0 is opr=0xbc & D0 { local v:3 = zext(D0); export v; }
OPV3: D1 is opr=0xbd & D1 { local v:3 = zext(D1); export v; }
OPV3: D6 is opr=0xbe & D6 { local v:3 = D6:3; export v; }
OPV3: D7 is opr=0xbf & D7 { local v:3 = D7:3; export v; }
OPW3: OPR3 is OPR3 { export *:3 OPR3; }

# OPR postbyte, operand size 4: exports the effective address.
OPR4: oprlo, XYSP is opr2=1 & oprr!=3 & oprlo & XYSP { local ea:3 = XYSP + oprlo; export ea; }
OPR4: addr is opr2=0 & opr6; imm8 [ addr = (opr6 << 8) | imm8; ] { export *[const]:3 addr; }
OPR4: imm24 is opr=0xfa; imm24 { export *[const]:3 imm24; }
OPR4: [imm24] is opr=0xfe; imm24 { local ea:3 = *:3 imm24:3; export ea; }
OPR4: addr is opr2=3 & oprr=3 & oprb3=1 & oprb1=0 & oprb2 & oprb0; imm16 [ addr = (oprb2 << 17) | (oprb0 << 16) | imm16; ] { export *[const]:3 addr; }
OPR4: off, XYSP is opr2=3 & oprb3=0 & oprb2=0 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local ea:3 = XYSP + off; export ea; }
OPR4: [off, XYSP] is opr2=3 & oprb3=0 & oprb2=1 & oprb1=0 & oprb0 & XYSP; imm8 [ off = imm8 - (oprb0 << 8); ] { local p:3 = XYSP + off; local ea:3 = *:3 p; export ea; }
OPR4: simm24, XYSP is opr2=3 & oprlo=2 & XYSP; simm24 { local ea:3 = XYSP + simm24; export ea; }
OPR4: [simm24, XYSP] is opr2=3 & oprlo=6 & XYSP; simm24 { local p:3 = XYSP + simm24; local ea:3 = *:3 p; export ea; }
OPR4: ODn, XYSP is opr2=2 & oprb3=1 & oprr!=3 & ODn & XYSP { local ea:3 = XYSP + ODn; export ea; }
OPR4: [ODn, XYSP] is opr2=3 & oprb5=0 & oprb3=1 & ODn & XYSP { local p:3 = XYSP + ODn; local ea:3 = *:3 p; export ea; }
OPR4: off, ODn is opr2=2 & oprb3=0 & oprr & ODn; imm16 [ off = (oprr << 16) | imm16; ] { local ea:3 = off + ODn; export ea; }
OPR4: imm24, ODn is opr2=3 & oprr=2 & oprb3=1 & ODn; imm24 { local ea:3 = imm24 + ODn; export ea; }
OPR4: "+"XY4 is opr2=3 & oprb5=1 & oprlo=3 & XY4 { XY4 = XY4 + 4; local ea:3 = XY4; export ea; }
OPR4: XY4"+" is opr2=3 & oprb5=1 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 + 4; export ea; }
OPR4: "-"XY4 is opr2=3 & oprb5=0 & oprlo=3 & XY4 { XY4 = XY4 - 4; local ea:3 = XY4; export ea; }
OPR4: XY4"-" is opr2=3 & oprb5=0 & oprlo=7 & XY4 { local ea:3 = XY4; XY4 = XY4 - 4; export ea; }
OPR4: "-SP" is opr=0xfb { SP = SP - 4; local ea:3 = SP; export ea; }
OPR4: "SP+" is opr=0xff { local ea:3 = SP; SP = SP + 4; export ea; }

OPV4: OPR4 is OPR4 { export *:4 OPR4; }
OPV4: "#-1" is opr=0x70 { local v:4 = -1; export v; }
OPV4: "#"oprlo is opr4=7 & oprlo { export *[const]:4 oprlo; }
OPV4: D2 is opr=0xb8 & D2 { local v:4 = zext(D2); export v; }
OPV4: D3 is opr=0xb9 & D3 { local v:4 = zext(D3); export v; }
OPV4: D4 is opr=0xba & D4 { local v:4 = zext(D4); export v; }
OPV4: D5 is opr=0xbb & D5 { local v:4 = zext(D5); export v; }
OPV4: D0 is opr=0xbc & D0 { local v:4 = zext(D0); export v; }
OPV4: D1 is opr=0xbd & D1 { local v:4 = zext(D1); export v; }
OPV4: D6 is opr=0xbe & D6 { local v:4 = D6; export v; }
OPV4: D7 is opr=0xbf & D7 { local v:4 = D7; export v; }
OPW4: OPR4 is OPR4 { export *:4 OPR4; }
OPW4: D6 is opr=0xbe & D6 { export D6; }
OPW4: D7 is opr=0xbf & D7 { export D7; }

rel: dest is r7flag=0 & r7 [ dest = inst_start + r7; ] { export *:3 dest; }
rel: dest is r15flag=1 & r15 [ dest = inst_start + r15; ] { export *:3 dest; }

# Register operand tables: one per encoding field and register set.
Wreg_pbhi: "D2" is pbhi=0 { export D2; }
Wreg_pbhi: "D3" is pbhi=1 { export D3; }
