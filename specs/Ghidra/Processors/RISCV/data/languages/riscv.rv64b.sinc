# RISC-V bit manipulation, RV64-only forms: the Zba unsigned-word forms, the Zbb
# word forms, the RV64 rev8 and zext.h encodings, and Zbkb packw. The forms common
# to RV32 and RV64 are in riscv.rv32b.sinc.

# Zba

:add.uw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x0 & funct7=0x04
{
	rd = rs2 + zext(rs1:4);
}

:zext.w rd,rs1 is rs1 & rd & op0006=0x3b & funct3=0x0 & funct7=0x04 & op2024=0
{
	rd = zext(rs1:4);
}

:sh1add.uw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x2 & funct7=0x10
{
	rd = rs2 + (zext(rs1:4) << 1);
}

:sh2add.uw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x4 & funct7=0x10
{
	rd = rs2 + (zext(rs1:4) << 2);
}

:sh3add.uw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x6 & funct7=0x10
{
	rd = rs2 + (zext(rs1:4) << 3);
}

:slli.uw rd,rs1,shamt6 is rs1 & shamt6 & rd & op0006=0x1b & funct3=0x1 & op2631=0x02
{
	rd = zext(rs1:4) << shamt6;
}

# Zbb

:clzw rd,rs1 is rs1 & rd & op0006=0x1b & funct3=0x1 & op2031=0x600
{
	local x:4 = rs1:4;
	rd = lzcount(x);
}

:ctzw rd,rs1 is rs1 & rd & op0006=0x1b & funct3=0x1 & op2031=0x601
{
	local x:4 = rs1:4;
	local below:4 = (x & -x) - 1;
	rd = popcount(below);
}

:cpopw rd,rs1 is rs1 & rd & op0006=0x1b & funct3=0x1 & op2031=0x602
{
	local x:4 = rs1:4;
	rd = popcount(x);
}

:rolw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x1 & funct7=0x30
{
	local x:4 = rs1:4;
	local sh:4 = rs2:4 & 0x1f;
	local r:4 = (x << sh) | (x >> (32 - sh));
	rd = sext(r);
}

:rorw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x5 & funct7=0x30
{
	local x:4 = rs1:4;
	local sh:4 = rs2:4 & 0x1f;
	local r:4 = (x >> sh) | (x << (32 - sh));
	rd = sext(r);
}

:roriw rd,rs1,shamt5 is rs1 & shamt5 & rd & op0006=0x1b & funct3=0x5 & funct7=0x30
{
	local x:4 = rs1:4;
	local r:4 = (x >> shamt5) | (x << (32 - shamt5));
	rd = sext(r);
}

:rev8 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x5 & op2031=0x6b8
{
	local x:8 = rs1;
	rd = (x << 56) | ((x & 0xff00) << 40) | ((x & 0xff0000) << 24) | ((x & 0xff000000) << 8)
		| ((x >> 8) & 0xff000000) | ((x >> 24) & 0xff0000) | ((x >> 40) & 0xff00) | (x >> 56);
}

:zext.h rd,rs1 is rs1 & rd & op0006=0x3b & funct3=0x4 & funct7=0x04 & op2024=0
{
	rd = zext(rs1:2);
}

# Zbkb

:packw rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x3b & funct3=0x4 & funct7=0x04
{
	local r:4 = (zext(rs2:2) << 16) | zext(rs1:2);
	rd = sext(r);
}
