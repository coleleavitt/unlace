  rmb3   = (9,9)
  rmb4   = (10,10)
  rmb5   = (11,11)
  rmb6   = (12,12)
  rmb7   = (13,13)
  crr    = (0,2)
  low24  = (0,23)
  f1_13  = (1,13)
