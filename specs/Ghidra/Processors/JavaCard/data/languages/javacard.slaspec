define register offset=0x0102 size=4 [ I1 I3 I5 I7 I9 I11 I13 I15 I17 I19 I21 I23 I25 I27 I29 I31 I33 I35 I37 I39 I41 I43 I45 I47 I49 I51 I53 I55 I57 I59 I61 I63 I65 I67 I69 I71 I73 I75 I77 I79 I81 I83 I85 I87 I89 I91 I93 I95 I97 I99 I101 I103 I105 I107 I109 I111 I113 I115 I117 I119 I121 I123 I125 I127 I129 I131 I133 I135 I137 I139 I141 I143 I145 I147 I149 I151 I153 I155 I157 I159 I161 I163 I165 I167 I169 I171 I173 I175 I177 I179 I181 I183 I185 I187 I189 I191 I193 I195 I197 I199 I201 I203 I205 I207 I209 I211 I213 I215 I217 I219 I221 I223 I225 I227 I229 I231 I233 I235 I237 I239 I241 I243 I245 I247 I249 I251 I253 ];

define token opc(8)
  op = (0,7)
;
define token b1(8)
  u8a = (0,7)
  s8a = (0,7) signed
  la = (0,7)
  ia = (0,7)
  mhi = (4,7)
  mlo = (0,3)
;
define token b2(8)
  u8b = (0,7)
  s8b = (0,7) signed
;
define token w1(16)
  u16a = (0,15)
  s16a = (0,15) signed
;
define token w2(16)
  u16b = (0,15)
  s16b = (0,15) signed
;
define token w3(16)
  s16c = (0,15) signed
;
define token d1(32)
