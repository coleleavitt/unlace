<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="4" stackshift="4">
      <input>
        <pentry maxsize="4" minsize="1">
          <register name="R2R0"/>
        </pentry>
        <pentry maxsize="500" minsize="1" align="4">
          <addr space="stack" offset="4"/>
        </pentry>
      </input>
      <output>
        <pentry maxsize="4" minsize="1">
          <register name="R2R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="FB"/>
        <register name="SB"/>
        <register name="ISP"/>
        <register name="INTB"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
