GenD0: "["^d16^"[SB]"^"]" is dgc=14 & indD=1 & d16 { a:4 = SB + d16; p:4 = *:4 a; export *:1 p; }
GenD0: d24^"[SB]" is dgc=15 & indD=0 & d24 { a:4 = SB + d24; export *:1 a; }
GenD0: "["^d24^"[SB]"^"]" is dgc=15 & indD=1 & d24 { a:4 = SB + d24; p:4 = *:4 a; export *:1 p; }
GenD0: "[A0]" is dgc=16 & indD=0 { a:4 = A0; export *:1 a; }
GenD0: "["^"[A0]"^"]" is dgc=16 & indD=1 { a:4 = A0; p:4 = *:4 a; export *:1 p; }
GenD0: d8^"[A0]" is dgc=17 & indD=0 & d8 { a:4 = A0 + d8; export *:1 a; }
GenD0: "["^d8^"[A0]"^"]" is dgc=17 & indD=1 & d8 { a:4 = A0 + d8; p:4 = *:4 a; export *:1 p; }
GenD0: d16^"[A0]" is dgc=18 & indD=0 & d16 { a:4 = A0 + d16; export *:1 a; }
