:andni rzh, rx, imm12 is a31_26=0x39 & rzh & rx; b15_12=3 & imm12 { rzh = rx & ~imm12; }
:xori rzh, rx, imm12 is a31_26=0x39 & rzh & rx; b15_12=4 & imm12 { rzh = rx ^ imm12; }

