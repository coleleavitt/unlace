  local amt:1 = xdBL:1; amt = (amt << 2) s>> 2; local a4:4 = sext(amt); local v:4 = xdA;
  if (a4 s< 0) goto <right>;
  xdD = v << a4; goto <done>;
  <right>
  xdD = v >> (-a4);
  <done>
  nzflags(xdD);
}
