# SMEM (bits 31-26 = 111101): the base is an SGPR pair (bits 0-5 times 2); the address adds the
# signed 21-bit offset and the SGPR in word 1 bits 25-31 unless that is null.
SMOFF: j_off21 is e6 ; j_off21 & j_soffhi=125 { export *[const]:8 j_off21; }
SMOFF: j_off21^"+"^j_soffhs is e6 ; j_off21 & j_soffhs { t:8 = zext(j_soffhs) + j_off21; export t; }
:s_load_dword sm_data, sm_base, SMOFF is e6=0x3d ... & smop=0 ... & sm_data ... & sm_base ... & SMOFF { b:8 = sm_base; a:8 = b + SMOFF; sm_data = *:4 (a + 0); }
