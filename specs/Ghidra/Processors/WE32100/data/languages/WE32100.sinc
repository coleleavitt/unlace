:INSFW sa,sb,sc,dmod is op=0xc8; sa; sb; sc; dmod; commit; wmask; fl_insf [ et = 5; ]
{
  local a:4 = sa;
  local b:4 = sb;
  local s:4 = sc;
  local d:4 = dmod;
  FA = a;
  FB = b;
  build wmask;
  local w:4 = (a & 0x1f) + 1;
  local o:4 = b & 0x1f;
  local m:4 = 0xffffffff >> (32 - w);
  local ro:4 = 32 - o;
  local fm:4 = ((m << o) | (m >> ro)) & WM;
  local ins:4 = (((s & m) << o) | ((s & m) >> ro)) & WM;
  DV = (d & ~fm) | ins;
  build commit;
  build fl_insf;
}
