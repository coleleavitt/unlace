:CTEST^apxScc apxDfv rm16,imm16 is $(APX_MAP4) & apxND=0 & $(APX_PP_V) & opsize=0 & apxScc & apxDfv & apxDfvOF & apxDfvSF & apxDfvZF & apxDfvCF & byte=0xf7; rm16 & (reg_opcode=0 | reg_opcode=1) ...; imm16 { local a:2 = rm16; local b:2 = imm16; local sc:1 = apxScc; if (sc == 0) goto <dflt>; local d = a & b; logicalflags(); resultflags(d); goto inst_next; <dflt> OF = apxDfvOF; SF = apxDfvSF; ZF = apxDfvZF; CF = apxDfvCF; PF = apxDfvCF; AF = 0; }
:CTEST^apxScc apxDfv rm32,Reg32 is $(APX_MAP4) & apxND=0 & $(APX_PP_V) & opsize=1 & apxScc & apxDfv & apxDfvOF & apxDfvSF & apxDfvZF & apxDfvCF & byte=0x85; rm32 & Reg32 ... { local a:4 = rm32; local b:4 = Reg32; local sc:1 = apxScc; if (sc == 0) goto <dflt>; local d = a & b; logicalflags(); resultflags(d); goto inst_next; <dflt> OF = apxDfvOF; SF = apxDfvSF; ZF = apxDfvZF; CF = apxDfvCF; PF = apxDfvCF; AF = 0; }
