# Sleigh specification for the EFI Byte Code (EBC), 64-bit natural size (sizeof(VOID *) = 8).
# See the "Unified Extensible Firmware Interface (UEFI) Specification" chapter "EFI Byte Code Virtual Machine".
# The instruction set is generated by tools/gen_ebc.py into EBC.sinc.

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=8  default;
define space register type=register_space size=1;

define register offset=0x00 size=8 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x40 size=8 [ IP FLAGS ];

@include "EBC.sinc"
