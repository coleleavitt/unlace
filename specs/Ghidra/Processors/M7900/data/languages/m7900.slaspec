DP7: is dpr4=1 & sel7=0 & off7 { a:3 = zext(DPR0) + off7; export a; }
DP7: is dpr4=1 & sel7=1 & off7 { a:3 = zext(DPR1) + off7; export a; }
DP7: is dpr4=1 & sel7=2 & off7 { a:3 = zext(DPR2) + off7; export a; }
