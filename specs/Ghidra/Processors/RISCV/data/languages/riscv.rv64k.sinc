# RISC-V scalar cryptography, RV64-only forms (Scalar Crypto 1.0.1): Zknh
# SHA-512 and Zkne/Zknd AES. The forms common to RV32 and RV64 are in
# riscv.rv32k.sinc. Encodings checked against LLVM's RISC-V assembler and
# disassembler.

define pcodeop aes64es;
define pcodeop aes64esm;
define pcodeop aes64ds;
define pcodeop aes64dsm;
define pcodeop aes64im;
define pcodeop aes64ks1i;
define pcodeop aes64ks2;

# Zknh SHA-512

:sha512sig0 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x106
{
	local x:8 = rs1;
	rd = ((x >> 1) | (x << 63)) ^ ((x >> 8) | (x << 56)) ^ (x >> 7);
}

:sha512sig1 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x107
{
	local x:8 = rs1;
	rd = ((x >> 19) | (x << 45)) ^ ((x >> 61) | (x << 3)) ^ (x >> 6);
}

:sha512sum0 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x104
{
	local x:8 = rs1;
	rd = ((x >> 28) | (x << 36)) ^ ((x >> 34) | (x << 30)) ^ ((x >> 39) | (x << 25));
}

:sha512sum1 rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x105
{
	local x:8 = rs1;
	rd = ((x >> 14) | (x << 50)) ^ ((x >> 18) | (x << 46)) ^ ((x >> 41) | (x << 23));
}

# Zkne / Zknd AES

:aes64es rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x0 & funct7=0x19
{
	rd = aes64es(rs1, rs2);
}

:aes64esm rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x0 & funct7=0x1b
{
	rd = aes64esm(rs1, rs2);
}

:aes64ds rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x0 & funct7=0x1d
{
	rd = aes64ds(rs1, rs2);
}

:aes64dsm rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x0 & funct7=0x1f
{
	rd = aes64dsm(rs1, rs2);
}

:aes64im rd,rs1 is rs1 & rd & op0006=0x13 & funct3=0x1 & op2031=0x300
{
	rd = aes64im(rs1);
}

:aes64ks1i rd,rs1,rcon is rs1 & rd & rcon & op0006=0x13 & funct3=0x1 & funct7=0x18 & op2424=1
{
	rd = aes64ks1i(rs1, rcon);
}

:aes64ks2 rd,rs1,rs2 is rs1 & rs2 & rd & op0006=0x33 & funct3=0x0 & funct7=0x3f
{
	rd = aes64ks2(rs1, rs2);
}
