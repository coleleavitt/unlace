# SLA specification file for the Xbox 360 Xenon: 64-bit PowerPC, big endian, AltiVec (VMX) plus VMX128.
# The Power ISA 2.07/3.0 vector additions and the 4xx multiply-accumulate instructions are left out:
# Xenon has neither, and their encodings overlap VMX128's.

@define ENDIAN "big"

@define REGISTER_SIZE "8"
@define BIT_64 "64"
@define EATRUNC "ea:4"
@define XENON "1"
@define NoLegacyIntegerMultiplyAccumulate "1"

@include "ppc_common.sinc"
@include "altivec.sinc"
@include "vmx128.sinc"
@include "g2.sinc"
