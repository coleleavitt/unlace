PERM: k is vmx_permh & vmx_uimm [ k = (vmx_permh << 5) | vmx_uimm; ] { export *[const]:1 k; }
RC128: "" is vmx_rc=0 { }
RC128: "." is vmx_rc=1 & VD128 { cr6 = vmx128_cr6(VD128); }

