:exts ra, rb is op8=0xb1 & ra & rb { local r:4 = sext(rb:2); ra = r; logf(r); }
:sf ra, rb is op8=0xb2 & ra & rb { local a:4 = rb; local b:4 = ra; subf(a, b); ra = a - b; }
:cl ra, rb is op8=0xb3 & ra & rb { local a:4 = ra; local b:4 = rb; LT = a < b; EQ = a == b; GT = a > b; }
:c ra, rb is op8=0xb4 & ra & rb { local a:4 = ra; local b:4 = rb; LT = a s< b; EQ = a == b; GT = a s> b; }
