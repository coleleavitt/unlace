<?xml version="1.0" encoding="UTF-8"?>

<!-- Hitachi H8/500 minimum mode. JSR/BSR push a 2-byte return address and RTS pops it.
     No public C ABI is assumed beyond a register-based default: arguments in R0-R3,
     a result in R0 (R0:R1 for a long). R7 is the stack pointer. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="R7" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R1"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R2"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="R3"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <register name="RR0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="R7"/>
        <register name="R6"/>
      </unaffected>
      <killedbycall>
        <register name="fN"/>
        <register name="fZ"/>
        <register name="fV"/>
        <register name="fC"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
