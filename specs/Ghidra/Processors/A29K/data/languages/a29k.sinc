define pcodeop trap;
define pcodeop halt;
define pcodeop invalidate;
define pcodeop coprocessorLoad;
define pcodeop coprocessorStore;

########################################################################################
# Register operands. Each exports a 4-byte location; R?T is the "twin" (next register),
# used with R? for double-precision and 64-bit operands (R? holds the high word).
########################################################################################

RA: ra_g is ra_l=0 & ra_g { export ra_g; }
RA: "gr0" is ra=0 { local p:4 = ipa & 0x3fc; export *[register]:4 p; }
RA: ra_n is ra_l=1 & ra_n { local a:4 = gr1 + ra_n * 4; export *[ram]:4 a; }
RB: rb_g is rb_l=0 & rb_g { export rb_g; }
RB: "gr0" is rb=0 { local p:4 = ipb & 0x3fc; export *[register]:4 p; }
RB: rb_n is rb_l=1 & rb_n { local a:4 = gr1 + rb_n * 4; export *[ram]:4 a; }
RC: rc_g is rc_l=0 & rc_g { export rc_g; }
RC: "gr0" is rc=0 { local p:4 = ipc & 0x3fc; export *[register]:4 p; }
RC: rc_n is rc_l=1 & rc_n { local a:4 = gr1 + rc_n * 4; export *[ram]:4 a; }

RAT: is ra_l=0 & ra_n { local p:4 = ((ra_n + 1) & 0x7f) * 4; export *[register]:4 p; }
RAT: is ra=0 { local p:4 = (ipa + 4) & 0x3fc; export *[register]:4 p; }
RAT: is ra_l=1 & ra_n { local a:4 = gr1 + ra_n * 4 + 4; export *[ram]:4 a; }
RBT: is rb_l=0 & rb_n { local p:4 = ((rb_n + 1) & 0x7f) * 4; export *[register]:4 p; }
RBT: is rb=0 { local p:4 = (ipb + 4) & 0x3fc; export *[register]:4 p; }
RBT: is rb_l=1 & rb_n { local a:4 = gr1 + rb_n * 4 + 4; export *[ram]:4 a; }
RCT: is rc_l=0 & rc_n { local p:4 = ((rc_n + 1) & 0x7f) * 4; export *[register]:4 p; }
RCT: is rc=0 { local p:4 = (ipc + 4) & 0x3fc; export *[register]:4 p; }
RCT: is rc_l=1 & rc_n { local a:4 = gr1 + rc_n * 4 + 4; export *[ram]:4 a; }

# 64-bit values of a register and its twin
DA: RA is RA & RAT { local v:8 = (zext(RA) << 32) | zext(RAT); export v; }
DB: RB is RB & RBT { local v:8 = (zext(RB) << 32) | zext(RBT); export v; }

# absolute register numbers (as written to IPA/IPB/IPC, bits 9-2)
NA: is ra_l=0 & ra { local n:4 = ra; export n; }
NA: is ra=0 { local n:4 = (ipa >> 2) & 0xff; export n; }
NA: is ra_l=1 & ra_n { local n:4 = 128 + (((gr1 >> 2) + ra_n) & 0x7f); export n; }
NB: is rb_l=0 & rb { local n:4 = rb; export n; }
NB: is rb=0 { local n:4 = (ipb >> 2) & 0xff; export n; }
NB: is rb_l=1 & rb_n { local n:4 = 128 + (((gr1 >> 2) + rb_n) & 0x7f); export n; }
NC: is rc_l=0 & rc { local n:4 = rc; export n; }
NC: is rc=0 { local n:4 = (ipc >> 2) & 0xff; export n; }
NC: is rc_l=1 & rc_n { local n:4 = 128 + (((gr1 >> 2) + rc_n) & 0x7f); export n; }

SRCB: RB is m=0 & RB { export RB; }
SRCB: i8dec is m=1 & i8dec { local v:4 = i8dec; export v; }

# 16-bit constants: bits 23-16 and 7-0
I16: val is ihi & i8 [ val = (ihi << 8) | i8; ] { local v:4 = val; export v; }
I16H: val is ihi & i8 [ val = ((ihi << 8) | i8) << 16; ] { local v:4 = val; export v; }
I16N: val is ihi & i8 [ val = 0xffff0000 | (ihi << 8) | i8; ] { local v:4 = val; export v; }
# constn displays the negative value, as GNU as writes it
I16ND: sval is ihi & i8 [ sval = (0xffff0000 | (ihi << 8) | i8) - 0x100000000; ] { local v:4 = sval; export v; }

# branch targets: bits 23-16 and 7-0 are bits 17-10 and 9-2 of a word offset (A=0, sign-extended,
# PC-relative) or of an absolute address (A=1)
TARGET: dest is m=0 & ihis & i8 [ dest = inst_start + ((ihis << 10) | (i8 << 2)); ] { export *[ram]:4 dest; }
TARGET: dest is m=1 & ihi & i8 [ dest = (ihi << 10) | (i8 << 2); ] { export *[ram]:4 dest; }

VN: vn is vn { local v:4 = vn; export v; }

########################################################################################
# Status macros. V, N, Z, C as section 8.2: arithmetic sets all four from the add,
# logical operations set N and Z.
########################################################################################

macro logicflags(r) {
	N = r s< 0;
	Z = r == 0;
}

# a + b + cin
macro addflags(a, b, cin, r) {
	C = carry(a, b) || carry(a + b, zext(cin));
	V = (((~(a ^ b)) & (a ^ r)) s< 0);
	N = r s< 0;
	Z = r == 0;
}

# a + ~b + cin (subtract)
macro subflags(a, b, cin, r) {
	local nb:4 = ~b;
	C = carry(a, nb) || carry(a + nb, zext(cin));
	V = ((((a ^ b)) & (a ^ r)) s< 0);
	N = r s< 0;
	Z = r == 0;
}

# Out of Range trap (vector 2): instructions that can trap end with
#   local oor:1 = <condition>; if (!oor) goto <nooor>; trap(2:4); <nooor>
# (not a macro with "goto inst_next", which would leave a branch's delay slot). The result is
# written before the trap is taken.

# byte and half-word selection by BP and the byte order (Am29050 manual 3.4.5)
@if ENDIAN == "big"
macro byteShift(sh) { sh = (3 - (BPr & 3)) * 8; }
macro halfShift(sh) { sh = (1 - ((BPr >> 1) & 1)) * 16; }
@define BPHW "3"
@else
macro byteShift(sh) { sh = (BPr & 3) * 8; }
macro halfShift(sh) { sh = ((BPr >> 1) & 1) * 16; }
@define BPHW "0"
@endif

macro true32(cond, dst) {
	dst = zext(cond) << 31;
}

########################################################################################
# Integer arithmetic
########################################################################################

:add RC,RA,SRCB is (op=0x14 | op=0x15) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a + b; addflags(a, b, 0:1, r); RC = r; }
:adds RC,RA,SRCB is (op=0x10 | op=0x11) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a + b; addflags(a, b, 0:1, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:addu RC,RA,SRCB is (op=0x12 | op=0x13) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a + b; addflags(a, b, 0:1, r); RC = r; local oor:1 = C; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:addc RC,RA,SRCB is (op=0x1c | op=0x1d) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a + b + zext(cin); addflags(a, b, cin, r); RC = r; }
:addcs RC,RA,SRCB is (op=0x18 | op=0x19) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a + b + zext(cin); addflags(a, b, cin, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:addcu RC,RA,SRCB is (op=0x1a | op=0x1b) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a + b + zext(cin); addflags(a, b, cin, r); RC = r; local oor:1 = C; if (!oor) goto <nooor>; trap(2:4); <nooor> }

:sub RC,RA,SRCB is (op=0x24 | op=0x25) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a - b; subflags(a, b, 1:1, r); RC = r; }
:subs RC,RA,SRCB is (op=0x20 | op=0x21) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a - b; subflags(a, b, 1:1, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subu RC,RA,SRCB is (op=0x22 | op=0x23) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = a - b; subflags(a, b, 1:1, r); RC = r; local oor:1 = !C; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subc RC,RA,SRCB is (op=0x2c | op=0x2d) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a - b - 1 + zext(cin); subflags(a, b, cin, r); RC = r; }
:subcs RC,RA,SRCB is (op=0x28 | op=0x29) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a - b - 1 + zext(cin); subflags(a, b, cin, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subcu RC,RA,SRCB is (op=0x2a | op=0x2b) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = a - b - 1 + zext(cin); subflags(a, b, cin, r); RC = r; local oor:1 = !C; if (!oor) goto <nooor>; trap(2:4); <nooor> }

:subr RC,RA,SRCB is (op=0x34 | op=0x35) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = b - a; subflags(b, a, 1:1, r); RC = r; }
:subrs RC,RA,SRCB is (op=0x30 | op=0x31) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = b - a; subflags(b, a, 1:1, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subru RC,RA,SRCB is (op=0x32 | op=0x33) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local r = b - a; subflags(b, a, 1:1, r); RC = r; local oor:1 = !C; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subrc RC,RA,SRCB is (op=0x3c | op=0x3d) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = b - a - 1 + zext(cin); subflags(b, a, cin, r); RC = r; }
:subrcs RC,RA,SRCB is (op=0x38 | op=0x39) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = b - a - 1 + zext(cin); subflags(b, a, cin, r); RC = r; local oor:1 = V; if (!oor) goto <nooor>; trap(2:4); <nooor> }
:subrcu RC,RA,SRCB is (op=0x3a | op=0x3b) & RC & RA & SRCB
{ local a = RA; local b = SRCB; local cin = C; local r = b - a - 1 + zext(cin); subflags(b, a, cin, r); RC = r; local oor:1 = !C; if (!oor) goto <nooor>; trap(2:4); <nooor> }

# multiply steps (Am29000 compatibility): Q is the multiplier, shifted right one bit per step
:mul RC,RA,SRCB is (op=0x64 | op=0x65) & RC & RA & SRCB
{
	local qb:1 = (q & 1) != 0; local a:4 = RA * zext(qb);
	local b:4 = SRCB;
	local s:4 = a + b;
	C = carry(a, b);
	V = (((~(a ^ b)) & (a ^ s)) s< 0);
	N = s s< 0;
	local sgn:4 = zext(N != V);
	local t:8 = (zext(s) << 32) | zext(q);
	t = (t >> 1) | (zext(sgn) << 63);
	RC = t(4);
	q = t:4;
	local hi:4 = t(4); Z = hi == 0;
}
:mull RC,RA,SRCB is (op=0x66 | op=0x67) & RC & RA & SRCB
{
	local qb:1 = (q & 1) != 0; local a:4 = RA * zext(qb);
	local b:4 = SRCB;
	local s:4 = b - a;
	C = carry(b, ~a) || carry(b + ~a, 1);
	V = ((((b ^ a)) & (b ^ s)) s< 0);
	N = s s< 0;
	local sgn:4 = zext(N != V);
	local t:8 = (zext(s) << 32) | zext(q);
	t = (t >> 1) | (zext(sgn) << 63);
	RC = t(4);
	q = t:4;
	local hi:4 = t(4); Z = hi == 0;
}
:mulu RC,RA,SRCB is (op=0x74 | op=0x75) & RC & RA & SRCB
{
	local qb:1 = (q & 1) != 0; local a:4 = RA * zext(qb);
	local b:4 = SRCB;
	local s:4 = a + b;
	C = carry(a, b);
	V = (((~(a ^ b)) & (a ^ s)) s< 0);
	N = s s< 0;
	local t:8 = (zext(s) << 32) | zext(q);
	t = (t >> 1) | (zext(C) << 63);
	RC = t(4);
	q = t:4;
	local hi:4 = t(4); Z = hi == 0;
}

# divide steps (unsigned non-restoring division): Q holds the dividend's low word and
# collects the quotient bits
:div0 RC,SRCB is (op=0x68 | op=0x69) & RC & SRCB
{
	local b:4 = SRCB;
	DF = 1;
	N = b s< 0;
	V = 0;
	C = 0;
	local t:8 = ((zext(b) << 32) | zext(q)) << 1;
	RC = t(4);
	q = t:4;
	local hi:4 = t(4); Z = hi == 0;
}
macro divstep(a, b, s) {
	# DF=1: a - b (a + ~b + 1); DF=0: a + b
	local bb:4 = b ^ (0 - zext(DF));
	local cout:1 = carry(a, bb) || carry(a + bb, zext(DF));
	s = a + bb + zext(DF);
	V = (((~(a ^ bb)) & (a ^ s)) s< 0);
	C = cout;
	DF = !(cout ^ DF ^ N);
	N = s s< 0;
}
:div RC,RA,SRCB is (op=0x6a | op=0x6b) & RC & RA & SRCB
{
	local a:4 = RA;
	local b:4 = SRCB;
	local s:4 = 0;
	divstep(a, b, s);
	local t:8 = (((zext(s) << 32) | zext(q)) << 1) | zext(DF);
	RC = t(4);
	q = t:4;
	local hi:4 = t(4); Z = hi == 0;
}
:divl RC,RA,SRCB is (op=0x6c | op=0x6d) & RC & RA & SRCB
{
	local a:4 = RA;
	local b:4 = SRCB;
	local s:4 = 0;
	divstep(a, b, s);
	RC = s;
	q = (q << 1) | zext(DF);
	Z = s == 0;
}
:divrem RC,RA,SRCB is (op=0x6e | op=0x6f) & RC & RA & SRCB
{
	local a:4 = RA;
	local b:4 = SRCB;
	local r:4 = a;
	if (DF == 1) goto <done>;
	r = a + b;
	C = carry(a, b);
	V = (((~(a ^ b)) & (a ^ r)) s< 0);
	<done>
	N = r s< 0;
	Z = r == 0;
	RC = r;
}

# Am29050 integer multiply and divide (Am29000: traps to an emulation routine with the same
# effect). A zero divisor raises Out of Range. The overflow traps controlled by INTE.MO/DO are
# not modelled (they would put a trap test after every multiply in the decompiled code); Q is
# undefined after a multiply and left unchanged here.
:multiply RC,RA,RB is op=0xe0 & RC & RA & RB
{
	local p:8 = sext(RA) * sext(RB);
	RC = p:4;
}
:multiplu RC,RA,RB is op=0xe2 & RC & RA & RB
{
	local p:8 = zext(RA) * zext(RB);
	RC = p:4;
}
:multm RC,RA,RB is op=0xde & RC & RA & RB
{ local p:8 = sext(RA) * sext(RB); RC = p(4); }
:multmu RC,RA,RB is op=0xdf & RC & RA & RB
{ local p:8 = zext(RA) * zext(RB); RC = p(4); }
:divide RC,RA,RB is op=0xe1 & RC & RA & RB
{
	local n:8 = (zext(q) << 32) | zext(RA);
	local d:8 = sext(RB);
	local dz:1 = d == 0;
	local dd:8 = d + zext(dz);
	local quo:8 = n s/ dd;
	local rem:8 = n s% dd;
	RC = quo:4;
	q = rem:4;
	local oor:1 = dz; if (!oor) goto <nooor>; trap(2:4); <nooor>
}
:dividu RC,RA,RB is op=0xe3 & RC & RA & RB
{
	local n:8 = (zext(q) << 32) | zext(RA);
	local d:8 = zext(RB);
	local dz:1 = d == 0;
	local dd:8 = d + zext(dz);
	local quo:8 = n / dd;
	local rem:8 = n % dd;
	RC = quo:4;
	q = rem:4;
	local oor:1 = dz; if (!oor) goto <nooor>; trap(2:4); <nooor>
}

########################################################################################
# Compare and assert: TRUE is bit 31
########################################################################################

CC: "lt"  is (op7=0x20 | op7=0x28) & RA & SRCB { local c:1 = RA s< SRCB; export c; }
CC: "ltu" is (op7=0x21 | op7=0x29) & RA & SRCB { local c:1 = RA < SRCB; export c; }
CC: "le"  is (op7=0x22 | op7=0x2a) & RA & SRCB { local c:1 = RA s<= SRCB; export c; }
CC: "leu" is (op7=0x23 | op7=0x2b) & RA & SRCB { local c:1 = RA <= SRCB; export c; }
CC: "gt"  is (op7=0x24 | op7=0x2c) & RA & SRCB { local c:1 = RA s> SRCB; export c; }
CC: "gtu" is (op7=0x25 | op7=0x2d) & RA & SRCB { local c:1 = RA > SRCB; export c; }
CC: "ge"  is (op7=0x26 | op7=0x2e) & RA & SRCB { local c:1 = RA s>= SRCB; export c; }
CC: "geu" is (op7=0x27 | op7=0x2f) & RA & SRCB { local c:1 = RA >= SRCB; export c; }
CC: "eq"  is (op7=0x30 | op7=0x38) & RA & SRCB { local c:1 = RA == SRCB; export c; }
CC: "neq" is (op7=0x31 | op7=0x39) & RA & SRCB { local c:1 = RA != SRCB; export c; }

:cp^CC RC,RA,SRCB is (op7=0x20 | op7=0x21 | op7=0x22 | op7=0x23 | op7=0x24 | op7=0x25 | op7=0x26 |
	op7=0x27 | op7=0x30 | op7=0x31) & CC & RC & RA & SRCB
{ local r:4 = 0; true32(CC, r); RC = r; }

# "aseq 0x40,gr1,gr1" is the canonical no-op
:nop is op=0x70 & vn=0x40 & ra=1 & rb=1 { }

# Vectors 64 and 65 of asgeu/asleu are the stack-cache spill and fill traps of AMD's calling
# convention (V_SPILL, V_FILL). They move local registers between the register file and the
# stack words that this module already uses for the local registers, so they have no effect
# in this model.
:as^CC VN,RA,SRCB is op7=0x2f & (vn=64 | vn=65) & CC & VN & RA & SRCB { }
:as^CC VN,RA,SRCB is op7=0x2b & (vn=64 | vn=65) & CC & VN & RA & SRCB { }
:as^CC VN,RA,SRCB is (op7=0x28 | op7=0x29 | op7=0x2a | op7=0x2b | op7=0x2c | op7=0x2d | op7=0x2e |
	op7=0x2f | op7=0x38 | op7=0x39) & CC & VN & RA & SRCB
{
	if (CC) goto <ok>;
	trap(VN);
	<ok>
}

:cpbyte RC,RA,SRCB is (op=0x2e | op=0x2f) & RC & RA & SRCB
{
	local a:4 = RA;
	local b:4 = SRCB;
	local x:4 = a ^ b;
	local hit:1 = (x[0,8] == 0) || (x[8,8] == 0) || (x[16,8] == 0) || (x[24,8] == 0);
	local r:4 = 0;
	true32(hit, r);
	RC = r;
}

########################################################################################
# Logical and shift
########################################################################################

:and RC,RA,SRCB is (op=0x90 | op=0x91) & RC & RA & SRCB { local r = RA & SRCB; logicflags(r); RC = r; }
:andn RC,RA,SRCB is (op=0x9c | op=0x9d) & RC & RA & SRCB { local r = RA & ~SRCB; logicflags(r); RC = r; }
:nand RC,RA,SRCB is (op=0x9a | op=0x9b) & RC & RA & SRCB { local r = ~(RA & SRCB); logicflags(r); RC = r; }
:nor RC,RA,SRCB is (op=0x98 | op=0x99) & RC & RA & SRCB { local r = ~(RA | SRCB); logicflags(r); RC = r; }
:or RC,RA,SRCB is (op=0x92 | op=0x93) & RC & RA & SRCB { local r = RA | SRCB; logicflags(r); RC = r; }
:orn RC,RA,SRCB is (op=0xaa | op=0xab) & RC & RA & SRCB { local r = RA | ~SRCB; logicflags(r); RC = r; }
:xnor RC,RA,SRCB is (op=0x96 | op=0x97) & RC & RA & SRCB { local r = ~(RA ^ SRCB); logicflags(r); RC = r; }
:xor RC,RA,SRCB is (op=0x94 | op=0x95) & RC & RA & SRCB { local r = RA ^ SRCB; logicflags(r); RC = r; }

:sll RC,RA,SRCB is (op=0x80 | op=0x81) & RC & RA & SRCB { RC = RA << (SRCB & 31); }
:srl RC,RA,SRCB is (op=0x82 | op=0x83) & RC & RA & SRCB { RC = RA >> (SRCB & 31); }
:sra RC,RA,SRCB is (op=0x86 | op=0x87) & RC & RA & SRCB { RC = RA s>> (SRCB & 31); }

:clz RC,SRCB is (op=0x08 | op=0x09) & RC & SRCB { RC = lzcount(SRCB); }

# funnel shift: high word of (SRCA:SRCB) << FC
:extract RC,RA,SRCB is (op=0x7a | op=0x7b) & RC & RA & SRCB
{
	local t:8 = ((zext(RA) << 32) | zext(SRCB)) << (FCr & 31);
	RC = t(4);
}

########################################################################################
# Byte and half-word operations (byte selected by BP and the byte order)
########################################################################################

:exbyte RC,RA,SRCB is (op=0x0a | op=0x0b) & RC & RA & SRCB
{ local sh:4 = 0; byteShift(sh); RC = (SRCB & 0xffffff00) | ((RA >> sh) & 0xff); }
:exhw RC,RA,SRCB is (op=0x7c | op=0x7d) & RC & RA & SRCB
{ local sh:4 = 0; halfShift(sh); RC = (SRCB & 0xffff0000) | ((RA >> sh) & 0xffff); }
:exhws RC,RA is op=0x7e & RC & RA
{ local sh:4 = 0; halfShift(sh); local t:4 = RA >> sh; local h:2 = t:2; RC = sext(h); }
:inbyte RC,RA,SRCB is (op=0x0c | op=0x0d) & RC & RA & SRCB
{ local sh:4 = 0; byteShift(sh); RC = (RA & ~(0xff << sh)) | ((SRCB & 0xff) << sh); }
:inhw RC,RA,SRCB is (op=0x78 | op=0x79) & RC & RA & SRCB
{ local sh:4 = 0; halfShift(sh); RC = (RA & ~(0xffff << sh)) | ((SRCB & 0xffff) << sh); }

########################################################################################
# Constants and special registers
########################################################################################

:const RA,I16 is op=0x03 & RA & I16 { RA = I16; }
:consth RA,I16H is op=0x02 & RA & I16H { RA = (RA & 0xffff) | I16H; }
:consthz RA,I16H is op=0x05 & RA & I16H { RA = I16H; }
:constn RA,I16ND is op=0x01 & RA & I16ND & I16N { RA = I16N; }

ALUVAL: is epsilon
{
	local v:4 = (zext(DF) << 11) | (zext(V) << 10) | (zext(N) << 9) | (zext(Z) << 8) | (zext(C) << 7) |
		((BPr & 3) << 5) | (FCr & 31);
	export v;
}
macro setALU(v) {
	DF = ((v >> 11) & 1) != 0;
	V = ((v >> 10) & 1) != 0;
	N = ((v >> 9) & 1) != 0;
	Z = ((v >> 8) & 1) != 0;
	C = ((v >> 7) & 1) != 0;
	BPr = (v >> 5) & 3;
	FCr = v & 31;
}

:mfsr RC,sa is op=0xc6 & RC & sa & b7_0 { RC = sa; }
:mfsr RC,sa is op=0xc6 & RC & sa & sa=132 & ALUVAL { RC = ALUVAL; }
:mfsr RC,sa is op=0xc6 & RC & sa & sa=133 { RC = BPr & 3; }
:mfsr RC,sa is op=0xc6 & RC & sa & sa=134 { RC = FCr & 31; }
:mfsr RC,sa is op=0xc6 & RC & sa & sa=135 { RC = CRr & 0xff; }
# the CR field also appears as bits 23-16 of the Channel Control Register (6)
:mfsr RC,sa is op=0xc6 & RC & sa & sa=6 { RC = (chc & 0xff00ffff) | ((CRr & 0xff) << 16); }

:mtsr sa,RB is op=0xce & sa & RB { sa = RB; }
:mtsr sa,RB is op=0xce & sa & sa=132 & RB { local v:4 = RB; setALU(v); }
:mtsr sa,RB is op=0xce & sa & sa=133 & RB { BPr = RB & 3; }
:mtsr sa,RB is op=0xce & sa & sa=134 & RB { FCr = RB & 31; }
:mtsr sa,RB is op=0xce & sa & sa=135 & RB { CRr = RB & 0xff; }
:mtsr sa,RB is op=0xce & sa & sa=6 & RB { local v:4 = RB; chc = v; CRr = (v >> 16) & 0xff; }

:mtsrim sa,I16 is op=0x04 & sa & I16 { sa = I16; }
:mtsrim sa,I16 is op=0x04 & sa & sa=132 & I16 { local v:4 = I16; setALU(v); }
:mtsrim sa,I16 is op=0x04 & sa & sa=133 & I16 { BPr = I16 & 3; }
:mtsrim sa,I16 is op=0x04 & sa & sa=134 & I16 { FCr = I16 & 31; }
:mtsrim sa,I16 is op=0x04 & sa & sa=135 & I16 { CRr = I16 & 0xff; }
:mtsrim sa,I16 is op=0x04 & sa & sa=6 & I16 { local v:4 = I16; chc = v; CRr = 0; }

:setip RC,RA,RB is op=0x9e & RC & RA & RB & NA & NB & NC
{ ipa = NA << 2; ipb = NB << 2; ipc = NC << 2; }

:mftlb RC,RA is op=0xb6 & RC & RA { local p:4 = 0x3000 + (RA & 0x7f) * 4; RC = *[register]:4 p; }
:mttlb RA,RB is op=0xbe & RA & RB { local p:4 = 0x3000 + (RA & 0x7f) * 4; *[register]:4 p = RB; }

########################################################################################
# Branches (one delay slot)
########################################################################################

:jmp TARGET is (op=0xa0 | op=0xa1) & TARGET { delayslot(1); goto TARGET; }
:jmpf RA,TARGET is (op=0xa4 | op=0xa5) & RA & TARGET
{ local c:1 = (RA & 0x80000000) == 0; delayslot(1); if (c) goto TARGET; }
:jmpt RA,TARGET is (op=0xac | op=0xad) & RA & TARGET
{ local c:1 = (RA & 0x80000000) != 0; delayslot(1); if (c) goto TARGET; }
:jmpfdec RA,TARGET is (op=0xb4 | op=0xb5) & RA & TARGET
{ local c:1 = (RA & 0x80000000) == 0; RA = RA - 1; delayslot(1); if (c) goto TARGET; }

:jmpi RB is op=0xc0 & RB { local t:4 = RB; delayslot(1); goto [t]; }
# jmpi lr0: return (lr0 holds the address the caller's call wrote)
:jmpi RB is op=0xc0 & RB & rb=0x80 { local t:4 = RB; delayslot(1); return [t]; }
:jmpfi RA,RB is op=0xc4 & RA & RB
{ local c:1 = (RA & 0x80000000) == 0; local t:4 = RB; delayslot(1); if (!c) goto <skip>; goto [t]; <skip> }
:jmpti RA,RB is op=0xcc & RA & RB
{ local c:1 = (RA & 0x80000000) != 0; local t:4 = RB; delayslot(1); if (!c) goto <skip>; goto [t]; <skip> }
# jmpfi/jmpti on lr0 are conditional returns
:jmpfi RA,RB is op=0xc4 & RA & RB & rb=0x80
{ local c:1 = (RA & 0x80000000) == 0; local t:4 = RB; delayslot(1); if (!c) goto <skip>; return [t]; <skip> }
:jmpti RA,RB is op=0xcc & RA & RB & rb=0x80
{ local c:1 = (RA & 0x80000000) != 0; local t:4 = RB; delayslot(1); if (!c) goto <skip>; return [t]; <skip> }

:call RA,TARGET is (op=0xa8 | op=0xa9) & RA & TARGET
{ RA = inst_start + 8; delayslot(1); call TARGET; }
:calli RA,RB is op=0xc8 & RA & RB
{ local t:4 = RB; RA = inst_start + 8; delayslot(1); call [t]; }

########################################################################################
# Loads and stores. CNTL bits: AS (22, input/output space), PA (21), SB (20), UA (19),
# OPT (18-16): 000 word, 001 byte, 010 half-word (hardware byte/half-word accesses, DW=1: SB
# sign-extends a loaded byte or half-word and sets BP to the complement of the byte order).
# CE=1 transfers to/from the coprocessor.
########################################################################################

ADDR: SRCB is SRCB { export SRCB; }

macro setbp() { BPr = $(BPHW); }

LDV: is cev=0 & as=0 & opt=1 & sb=0 & ADDR { local v:4 = zext(*[ram]:1 ADDR); export v; }
LDV: is cev=0 & as=0 & opt=1 & sb=1 & ADDR { local v:4 = sext(*[ram]:1 ADDR); setbp(); export v; }
LDV: is cev=0 & as=0 & opt=2 & sb=0 & ADDR { local v:4 = zext(*[ram]:2 ADDR); export v; }
LDV: is cev=0 & as=0 & opt=2 & sb=1 & ADDR { local v:4 = sext(*[ram]:2 ADDR); setbp(); export v; }
LDV: is cev=0 & as=0 & sb=0 & ADDR { local v:4 = *[ram]:4 ADDR; export v; }
LDV: is cev=0 & as=0 & sb=1 & ADDR { local v:4 = *[ram]:4 ADDR; setbp(); export v; }
LDV: is cev=0 & as=1 & opt=1 & sb=0 & ADDR { local v:4 = zext(*[io]:1 ADDR); export v; }
LDV: is cev=0 & as=1 & opt=1 & sb=1 & ADDR { local v:4 = sext(*[io]:1 ADDR); setbp(); export v; }
LDV: is cev=0 & as=1 & opt=2 & sb=0 & ADDR { local v:4 = zext(*[io]:2 ADDR); export v; }
LDV: is cev=0 & as=1 & opt=2 & sb=1 & ADDR { local v:4 = sext(*[io]:2 ADDR); setbp(); export v; }
LDV: is cev=0 & as=1 & sb=0 & ADDR { local v:4 = *[io]:4 ADDR; export v; }
LDV: is cev=0 & as=1 & sb=1 & ADDR { local v:4 = *[io]:4 ADDR; setbp(); export v; }
LDV: is cev=1 & cntl & ADDR { local c:4 = cntl; local v:4 = coprocessorLoad(c, ADDR); export v; }

CNTL: cntl is cntl { }

:load ce,CNTL,RA,ADDR is (op=0x16 | op=0x17) & ce & CNTL & RA & ADDR & LDV { RA = LDV; }
:loadl ce,CNTL,RA,ADDR is (op=0x06 | op=0x07) & ce & CNTL & RA & ADDR & LDV { RA = LDV; }
:loadset ce,CNTL,RA,ADDR is (op=0x26 | op=0x27) & ce & cev=0 & CNTL & RA & ADDR & as=0
{ local a:4 = ADDR; RA = *[ram]:4 a; *[ram]:4 a = 0xffffffff; }
:loadset ce,CNTL,RA,ADDR is (op=0x26 | op=0x27) & ce & cev=0 & CNTL & RA & ADDR & as=1
{ local a:4 = ADDR; RA = *[io]:4 a; *[io]:4 a = 0xffffffff; }
:loadset ce,CNTL,RA,ADDR is (op=0x26 | op=0x27) & ce & cev=1 & CNTL & RA & ADDR & cntl
{ local c:4 = cntl; RA = coprocessorLoad(c, ADDR); }

STV: is cev=0 & as=0 & opt=1 & ADDR & RA { *[ram]:1 ADDR = RA:1; }
STV: is cev=0 & as=0 & opt=2 & ADDR & RA { *[ram]:2 ADDR = RA:2; }
STV: is cev=0 & as=0 & ADDR & RA { *[ram]:4 ADDR = RA; }
STV: is cev=0 & as=1 & opt=1 & ADDR & RA { *[io]:1 ADDR = RA:1; }
STV: is cev=0 & as=1 & opt=2 & ADDR & RA { *[io]:2 ADDR = RA:2; }
STV: is cev=0 & as=1 & ADDR & RA { *[io]:4 ADDR = RA; }
STV: is cev=1 & cntl & ADDR & RA { local c:4 = cntl; coprocessorStore(c, ADDR, RA); }
STBP: is cev=0 & sb=1 { setbp(); }
STBP: is epsilon { }

:store ce,CNTL,RA,ADDR is (op=0x1e | op=0x1f) & ce & CNTL & RA & ADDR & STV & STBP { build STV; build STBP; }
:storel ce,CNTL,RA,ADDR is (op=0x0e | op=0x0f) & ce & CNTL & RA & ADDR & STV & STBP { build STV; build STBP; }

# load/store multiple: CR + 1 words between consecutive registers and consecutive words
# (local registers: consecutive stack words; global registers: consecutive register numbers).
# The first 8 transfers are written out so that the usual short sequences (doubles, small
# structures, CR set just before by mtsrim) decompile as plain register moves.
MREG: is ra=0 { local p:4 = ipa & 0x3fc; export p; }

:loadm ce,CNTL,RA,ADDR is (op=0x36 | op=0x37) & ce & cev=0 & CNTL & RA & ADDR & as=0 & ra_l=1 & ra_n
{
	local a:4 = ADDR; local n:4 = CRr & 0xff;
	*[ram]:4 (gr1 + (ra_n + 0) * 4) = *[ram]:4 (a + 0);
	if (n < 1) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 1) * 4) = *[ram]:4 (a + 4);
	if (n < 2) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 2) * 4) = *[ram]:4 (a + 8);
	if (n < 3) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 3) * 4) = *[ram]:4 (a + 12);
	if (n < 4) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 4) * 4) = *[ram]:4 (a + 16);
	if (n < 5) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 5) * 4) = *[ram]:4 (a + 20);
	if (n < 6) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 6) * 4) = *[ram]:4 (a + 24);
	if (n < 7) goto <done>;
	*[ram]:4 (gr1 + (ra_n + 7) * 4) = *[ram]:4 (a + 28);
	if (n < 8) goto <done>;
	local r:4 = gr1 + (ra_n + 8) * 4;
	local mp:4 = a + 32; local k:4 = n - 7;
	<loop>
	*[ram]:4 r = *[ram]:4 mp;
	r = r + 4; mp = mp + 4; k = k - 1;
	if (k != 0) goto <loop>;
	<done>
	CRr = 0;
}

:loadm ce,CNTL,RA,ADDR is (op=0x36 | op=0x37) & ce & cev=0 & CNTL & RA & ADDR & as=0 & ra_l=0 & ra_n
{
	local a:4 = ADDR; local n:4 = CRr & 0xff;
	*[register]:4 (((ra_n + 0) & 0x7f:4) * 4) = *[ram]:4 (a + 0);
	if (n < 1) goto <done>;
	*[register]:4 (((ra_n + 1) & 0x7f:4) * 4) = *[ram]:4 (a + 4);
	if (n < 2) goto <done>;
	*[register]:4 (((ra_n + 2) & 0x7f:4) * 4) = *[ram]:4 (a + 8);
	if (n < 3) goto <done>;
	*[register]:4 (((ra_n + 3) & 0x7f:4) * 4) = *[ram]:4 (a + 12);
	if (n < 4) goto <done>;
	*[register]:4 (((ra_n + 4) & 0x7f:4) * 4) = *[ram]:4 (a + 16);
	if (n < 5) goto <done>;
	*[register]:4 (((ra_n + 5) & 0x7f:4) * 4) = *[ram]:4 (a + 20);
	if (n < 6) goto <done>;
	*[register]:4 (((ra_n + 6) & 0x7f:4) * 4) = *[ram]:4 (a + 24);
	if (n < 7) goto <done>;
	*[register]:4 (((ra_n + 7) & 0x7f:4) * 4) = *[ram]:4 (a + 28);
	if (n < 8) goto <done>;
	local r:4 = ((ra_n + 8) & 0x7f) * 4;
	local mp:4 = a + 32; local k:4 = n - 7;
	<loop>
	*[register]:4 r = *[ram]:4 mp;
	r = (r + 4) & 0x1fc; mp = mp + 4; k = k - 1;
	if (k != 0) goto <loop>;
	<done>
	CRr = 0;
}

:loadm ce,CNTL,RA,ADDR is (op=0x36 | op=0x37) & ce & cev=0 & CNTL & RA & ADDR & as=0 & MREG
{
	local src:4 = ADDR; local p:4 = MREG; local n:4 = (CRr & 0xff) + 1;
	<loop>
	*[register]:4 p = *[ram]:4 src;
	src = src + 4; p = (p + 4) & 0x3fc; n = n - 1;
	if (n != 0) goto <loop>;
	CRr = 0;
}

