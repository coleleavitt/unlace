MTA: "off, "^MTR^", "^MTS is mt_offen=0 & mt_idxen=0 & mt_off ; MTR & MTS { a:8 = (MTR & 0xffffffffffff) + zext(MTS) + mt_off; export a; }
MTA: MTV1^", "^MTR^", "^MTS is mt_offen=1 & mt_idxen=0 & mt_off ; MTV1 & MTR & MTS { a:8 = (MTR & 0xffffffffffff) + zext(MTS) + zext(MTV1) + mt_off; export a; }
MTA: MTV1^", "^MTR^", "^MTS is mt_offen=0 & mt_idxen=1 & mt_off ; MTV1 & MTR & MTS { st:8 = (MTR >> 48) & 0x3fff; a:8 = (MTR & 0xffffffffffff) + zext(MTS) + zext(MTV1) * st + mt_off; export a; }
MTA: MTV2^", "^MTR^", "^MTS is mt_offen=1 & mt_idxen=1 & mt_off ; MTV2 & MTR & MTS { st:8 = (MTR >> 48) & 0x3fff; i:4 = MTV2:4; v:4 = MTV2(4); a:8 = (MTR & 0xffffffffffff) + zext(MTS) + zext(i) * st + zext(v) + mt_off; export a; }
