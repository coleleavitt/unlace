<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="rst"/>
  </global>
  <stackpointer register="WP" space="wst" growth="positive"/>
  <returnaddress>
    <varnode space="rst" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="default" extrapop="unknown" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <unaffected>
        <register name="RP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
