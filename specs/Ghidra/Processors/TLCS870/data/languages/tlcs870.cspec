<?xml version="1.0" encoding="UTF-8"?>

<!-- Toshiba TLCS-870. CALL pushes a 2-byte return address (little-endian) and RET pops it.
     No public C ABI is modelled; the default is register based: byte arguments in A, then C, E, L,
     word arguments in WA/BC/DE/HL, a byte result in A and a word result in WA. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="1"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <long_double_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="BC"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="DE"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="2">
          <register name="WA"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="IX"/>
        <register name="IY"/>
        <register name="RBS"/>
      </unaffected>
      <killedbycall>
        <register name="JF"/>
        <register name="ZF"/>
        <register name="CF"/>
        <register name="HF"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
