# 110110 / 110111: immediate-offset load/store
:ld.b rzh, mem32b is (a31_26=0x36 & rzh; b15_12=0) & mem32b { rzh = zext(*:1 mem32b); }
:ld.h rzh, mem32h is (a31_26=0x36 & rzh; b15_12=1) & mem32h { rzh = zext(*:2 mem32h); }
:ld.w rzh, mem32w is (a31_26=0x36 & rzh; b15_12=2) & mem32w { rzh = *:4 mem32w; }
:ld.d rzh, mem32w is (a31_26=0x36 & rzh & ry_p1; b15_12=3) & mem32w { local a:4 = mem32w; rzh = *:4 a; ry_p1 = *:4 (a + 4); }
:ld.bs rzh, mem32b is (a31_26=0x36 & rzh; b15_12=4) & mem32b { rzh = sext(*:1 mem32b); }
:ld.hs rzh, mem32h is (a31_26=0x36 & rzh; b15_12=5) & mem32h { rzh = sext(*:2 mem32h); }
:pldr mem32w is (a31_26=0x36 & a25_21=0; b15_12=6) & mem32w { prefetch(mem32w); }
:ldex.w rzh, mem32w is (a31_26=0x36 & rzh; b15_12=7) & mem32w { rzh = *:4 mem32w; exclusive_load(mem32w); }
:st.b rzh, mem32b is (a31_26=0x37 & rzh; b15_12=0) & mem32b { *:1 mem32b = rzh:1; }
:st.h rzh, mem32h is (a31_26=0x37 & rzh; b15_12=1) & mem32h { *:2 mem32h = rzh:2; }
:st.w rzh, mem32w is (a31_26=0x37 & rzh; b15_12=2) & mem32w { *:4 mem32w = rzh; }
:st.d rzh, mem32w is (a31_26=0x37 & rzh & ry_p1; b15_12=3) & mem32w { local a:4 = mem32w; *:4 a = rzh; *:4 (a + 4) = ry_p1; }
:pldw mem32w is (a31_26=0x37 & a25_21=0; b15_12=6) & mem32w { prefetch(mem32w); }
:stex.w rzh, mem32w is (a31_26=0x37 & rzh; b15_12=7) & mem32w { rzh = exclusive_store(mem32w, rzh); }

