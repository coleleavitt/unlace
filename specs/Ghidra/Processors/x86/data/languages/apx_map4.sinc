:CFCMOV^cc m16,Reg16 is $(APX_MAP4) & $(APX_PP_V) & opsize=0 & apxND=0 & apxNF=1 & row=4 & cc; m16 & Reg16 ... { if (!cc) goto inst_next; m16 = Reg16; }
:CMOV^cc apxNDD16,Reg16,rm16 is $(APX_MAP4) & $(APX_PP_V) & opsize=0 & apxND=1 & apxNF=0 & apxNDD16 & apxNDD64 & row=4 & cc; rm16 & Reg16 ... { local t:2 = rm16; local v:2 = Reg16; if (!cc) goto <z>; v = t; <z> apxNDD64 = zext(v); }
:CFCMOV^cc apxNDD16,Reg16,rm16 is $(APX_MAP4) & $(APX_PP_V) & opsize=0 & apxND=1 & apxNF=1 & apxNDD16 & apxNDD64 & row=4 & cc; rm16 & Reg16 ... { local v:2 = Reg16; if (!cc) goto <z>; v = rm16; <z> apxNDD64 = zext(v); }
