:s_dcache_inv is e6=0x3d & smop=32 ; j_off21 { }
:s_memtime sm_data_sp is e6=0x3d & smop=36 & sm_data_sp ; j_off21 { sm_data_sp = memtime(); }
:s_memrealtime sm_data_sp is e6=0x3d & smop=37 & sm_data_sp ; j_off21 { sm_data_sp = memrealtime(); }


# FLAT (bits 31-26 = 110111): bits 14-15 pick flat (0), scratch (1) or global (2). A global
# access adds the signed 13-bit offset to a VGPR pair, or with an SGPR pair base (word 1
# bits 16-22, 0x7f = off) to a 32-bit VGPR offset. Scratch addresses the private space.
FADDR: "["^jvp0^"+"^flofu^"]" is flseg=0 & flofu ; jvp0 { a:8 = jvp0 + flofu; export a; }
GADDR: "["^jvp0^"+"^floff^"]" is flseg=2 & floff ; js16x=0x7d & jvp0 { a:8 = jvp0 + floff; export a; }
GADDR: "["^js16sp^"+"^jv0^"+"^floff^"]" is flseg=2 & floff ; js16sp & jv0 { a:8 = js16sp + zext(jv0) + floff; export a; }
PADDR: "["^jv0^"+"^floff^"]" is flseg=1 & floff ; js16x=0x7d & jv0 { a:4 = jv0 + floff; export a; }
PADDR: "["^js16^"+"^floff^"]" is flseg=1 & floff ; js16 { a:4 = js16 + floff; export a; }
:flat_load_ubyte jv24, FADDR is (e6=0x37 & flop=8 & flseg=0 ; jv24) & FADDR { jv24 = zext(*[ram]:1 (FADDR + 0)); }
:flat_load_sbyte jv24, FADDR is (e6=0x37 & flop=9 & flseg=0 ; jv24) & FADDR { jv24 = sext(*[ram]:1 (FADDR + 0)); }
:flat_load_ushort jv24, FADDR is (e6=0x37 & flop=10 & flseg=0 ; jv24) & FADDR { jv24 = zext(*[ram]:2 (FADDR + 0)); }
:flat_load_sshort jv24, FADDR is (e6=0x37 & flop=11 & flseg=0 ; jv24) & FADDR { jv24 = sext(*[ram]:2 (FADDR + 0)); }
