<?xml version="1.0" encoding="UTF-8"?>
<!-- Softune C small/medium code model: CALL/RET (2-byte return address); __far for CALLP/RETP functions -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="3"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="2"/>
      <entry size="8" alignment="2"/>
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__near" extrapop="2" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="AL"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <register name="A"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="SPB"/>
        <register name="DTB"/>
        <register name="ADB"/>
        <register name="DPR"/>
        <register name="USB"/>
        <register name="SSB"/>
        <register name="RP"/>
        <register name="ILM"/>
        <register name="RW3"/>
      </unaffected>
      <killedbycall>
        <register name="A"/>
        <register name="RL0"/>
        <register name="C"/>
        <register name="V"/>
        <register name="Z"/>
        <register name="N"/>
        <register name="T"/>
      </killedbycall>
    </prototype>
  </default_proto>
    <prototype name="__far" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="AL"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <register name="A"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="SPB"/>
        <register name="DTB"/>
        <register name="ADB"/>
        <register name="DPR"/>
        <register name="USB"/>
        <register name="SSB"/>
        <register name="RP"/>
        <register name="ILM"/>
        <register name="RW3"/>
      </unaffected>
      <killedbycall>
        <register name="A"/>
        <register name="RL0"/>
        <register name="C"/>
        <register name="V"/>
        <register name="Z"/>
        <register name="N"/>
        <register name="T"/>
      </killedbycall>
    </prototype>
</compiler_spec>
