# Netronome NFP-6xxx flow processor microengine (ME version 2.8), 8-context mode.
# Written for unlace from the GNU binutils NFP disassembler (opcodes/nfp-dis.c and
# include/opcode/nfp.h, binutils 2.45), read for field layouts only; no text is copied.
# An instruction is one little-endian 64-bit word (44 bits used); the program counter
# counts instructions, so a branch target n is byte address 8 * n. Operands name
# context-relative GPRs (banks A and B), transfer registers ($xfer: separate read and
# write files), next-neighbour registers, local memory through the LM_ADDR indices, or
# 8-bit immediates.

define endian=little;
define alignment=8;

define space ram      type=ram_space      size=4 default;
define space lmem     type=ram_space      size=4;
define space register type=register_space size=4;

