j8cnd: is j8c=0 { }
j8cnd: "cs" is j8c=1 & j8s=1 { if ((FLAGS & 1) != 0) goto <take>; goto inst_next; <take> }
j8cnd: "cc" is j8c=1 & j8s=0 { if ((FLAGS & 1) == 0) goto <take>; goto inst_next; <take> }
j8dest: t is j8o [ t = inst_next + (j8o * 2); ] { export *[ram]:4 t; }
:JMP8^j8cnd j8dest is opc=0x2 & j8cnd & j8dest { build j8cnd; goto j8dest; }

:RET is opc=0x4 {
	local ap778_8:8 = R0; local ap778_:4 = ap778_8:4; local ra_:8 = *:8 ap778_;
	R0 = R0 + 8;
	local tmp779_:8 = ra_; local dest:4 = tmp779_:4;
	return [dest];
}
:BREAK brk is opc=0x0 & brk { ebc_break(brk:1); }
:LOADSP dr1,r2 is opc=0x29 & dr1 & r2 { dr1 = r2; }
:STORESP r1,dr2 is opc=0x2a & r1 & dr2 { r1 = dr2; }

