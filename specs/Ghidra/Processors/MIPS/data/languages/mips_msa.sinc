# MIPS SIMD Architecture (MSA), generated by tools/gen_mips_msa.py from LLVM's
# MipsMSAInstrFormats.td and MipsMSAInstrInfo.td. Do not edit by hand.

# The 128-bit vector registers. FR=1 aliasing with the FPRs is not modelled: f0-f31 are
# separate registers.
define register offset=0x5000 size=16 [ w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 ];
define register offset=0x5200 size=4 [ MSAIR MSACSR MSAAccess MSASave MSAModify MSARequest MSAMap MSAUnmap ];
attach variables [ msa_wd msa_ws msa_wt ] [ w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 ];
attach variables [ msa_rd msa_rs msa_rt ] [ zero at v0 v1 a0 a1 a2 a3 t0 t1 t2 t3 t4 t5 t6 t7 s0 s1 s2 s3 s4 s5 s6 s7 t8 t9 k0 k1 gp sp s8 ra ];
attach variables [ msa_cs msa_cd ] [ MSAIR MSACSR MSAAccess MSASave MSAModify MSARequest MSAMap MSAUnmap _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ];

