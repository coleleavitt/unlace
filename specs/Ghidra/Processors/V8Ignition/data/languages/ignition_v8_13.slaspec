:^instruction is op=0 ; instruction [ scale = 1; ] { build instruction; }
:^instruction is op=1 ; instruction [ scale = 2; ] { build instruction; }

:Ldar r8_1 is scale=0 & op=11 ; r8_1 {
  ACC = r8_1;
}
:Ldar.Wide s16_1 is scale=1 & op=11 ; s16_1 {
  ACC = *[frame]:8 (s16_1 * 8:4);
}
:Ldar.ExtraWide s32_1 is scale=2 & op=11 ; s32_1 {
  ACC = *[frame]:8 (s32_1 * 8:4);
}
:LdaZero is scale=0 & op=12 {
  ACC = 0;
}
:LdaSmi "["^s8_1^"]" is scale=0 & op=13 ; s8_1 {
  ACC = s8_1;
}
:LdaSmi.Wide "["^s16_1^"]" is scale=1 & op=13 ; s16_1 {
  ACC = s16_1;
}
:LdaSmi.ExtraWide "["^s32_1^"]" is scale=2 & op=13 ; s32_1 {
  ACC = s32_1;
}
:LdaUndefined is scale=0 & op=14 {
  ACC = js_undefined();
}
:LdaNull is scale=0 & op=15 {
  ACC = js_null();
}
:LdaTheHole is scale=0 & op=16 {
  ACC = js_thehole();
}
:LdaTrue is scale=0 & op=17 {
  ACC = js_true();
}
:LdaFalse is scale=0 & op=18 {
  ACC = js_false();
}
:LdaConstant "["^u8_1^"]" is scale=0 & op=19 ; u8_1 {
  ACC = js_const(u8_1:4);
}
:LdaConstant.Wide "["^u16_1^"]" is scale=1 & op=19 ; u16_1 {
  ACC = js_const(u16_1:4);
}
:LdaConstant.ExtraWide "["^u32_1^"]" is scale=2 & op=19 ; u32_1 {
  ACC = js_const(u32_1:4);
}
:LdaContextSlot r8_1, "["^u8_2^"]", u8_3 is scale=0 & op=20 ; r8_1 ; u8_2 ; u8_3 {
  ACC = js_context_slot_at(r8_1, u8_2:4, u8_3:4);
}
:LdaContextSlot.Wide s16_1, "["^u16_2^"]", u16_3 is scale=1 & op=20 ; s16_1 ; u16_2 ; u16_3 {
  ACC = js_context_slot_at(*[frame]:8 (s16_1 * 8:4), u16_2:4, u16_3:4);
}
:LdaContextSlot.ExtraWide s32_1, "["^u32_2^"]", u32_3 is scale=2 & op=20 ; s32_1 ; u32_2 ; u32_3 {
  ACC = js_context_slot_at(*[frame]:8 (s32_1 * 8:4), u32_2:4, u32_3:4);
}
:LdaScriptContextSlot r8_1, "["^u8_2^"]", u8_3 is scale=0 & op=21 ; r8_1 ; u8_2 ; u8_3 {
  ACC = js_context_slot_at(r8_1, u8_2:4, u8_3:4);
}
:LdaScriptContextSlot.Wide s16_1, "["^u16_2^"]", u16_3 is scale=1 & op=21 ; s16_1 ; u16_2 ; u16_3 {
  ACC = js_context_slot_at(*[frame]:8 (s16_1 * 8:4), u16_2:4, u16_3:4);
}
:LdaScriptContextSlot.ExtraWide s32_1, "["^u32_2^"]", u32_3 is scale=2 & op=21 ; s32_1 ; u32_2 ; u32_3 {
