# MULTOS Executable Language (MEL), the MULTOS smart-card virtual machine. Written for unlace
# from the MULTOS Developer's Reference Manual (MAO-DOC-TEC-006 v1.58): the instruction
# descriptions and the Instruction Map (opcode, tag, operand bytes, compact forms); no text is
# copied. An instruction byte is the 5-bit opcode in bits 3-7 and the 3-bit tag in bits 0-2,
# followed by its operand bytes (big endian). For memory operands the tag names the segment
# register: 1 SB, 2 ST, 3 DB, 4 LB, 5 DT, 6 PB, 7 PT; tag 0 works on the top of the stack.
# The stack grows upward: DT (dynamic top) is the stack pointer and a push stores at DT.
# CEN/CDIS switch the compact encoding of the DB/LB/PB/PT forms on and off (decode context).

define endian=big;
define alignment=1;

define space ram      type=ram_space      size=2 default;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ CP SB ST DB LB DT PB PT ];
define register offset=0x20 size=1 [ CF ZF NF VF ];
define register offset=0x30 size=2 [ SW ];
define register offset=0x32 size=1 [ LA ];
define register offset=0x40 size=4 [ contextreg ];

define context contextreg
  cm    = (0,0)
  cmoff = (1,1) noflow
;

define token ins(8)
  opc = (3,7)
  tag = (0,2)
;
define token t1(8)
  b1 = (0,7)
  s1 = (0,7) signed
  cn = (6,7)
  bn = (0,7)
  co6 = (0,5)
  cs6 = (0,5) signed
;
define token t2(8)
  b2 = (0,7)
  s2 = (0,7) signed
;
define token t3(8)
  b3 = (0,7)
;
define token w1(16)
  u16a = (0,15)
  s16a = (0,15) signed
;
define token w2(16)
  u16b = (0,15)
  s16b = (0,15) signed
;

define pcodeop mel_set_sw;
define pcodeop mel_set_la;
define pcodeop mel_exit;
define pcodeop mel_primitive;
define pcodeop mel_block;
define pcodeop mel_cmp_block;
define pcodeop mel_reserved;

REL: dest is s1 [ dest = inst_next + s1; ] { export *:2 dest; }
CPW: u16a is u16a { export *:2 u16a; }

:NOP is opc=0 & tag=0 { }
:SETSW b1, b2 is opc=0 & tag=1 ; b1 ; b2 { SW = (b1 << 8) | b2; mel_set_sw(SW); }
:SETLA b1 is opc=0 & tag=2 ; b1 { LA = b1; mel_set_la(LA); }
:SETSWLA b1, b2, b3 is opc=0 & tag=3 ; b1 ; b2 ; b3 { SW = (b1 << 8) | b2; LA = b3; mel_set_sw(SW); mel_set_la(LA); }
:EXIT is opc=0 & tag=4 { mel_exit(); return [CP]; }
:EXITSW b1, b2 is opc=0 & tag=5 ; b1 ; b2 { SW = (b1 << 8) | b2; mel_set_sw(SW); mel_exit(); return [CP]; }
:EXITLA b1 is opc=0 & tag=6 ; b1 { LA = b1; mel_set_la(LA); mel_exit(); return [CP]; }
:EXITSWLA b1, b2, b3 is opc=0 & tag=7 ; b1 ; b2 ; b3 { SW = (b1 << 8) | b2; LA = b3; mel_set_sw(SW); mel_set_la(LA); mel_exit(); return [CP]; }
:CEN is opc=1 & tag=0 ; bn=0 & b1 [ cm = 1; globalset(inst_next, cm); ] { }
:CDIS is opc=1 & tag=0 ; bn=1 & b1 [ cm = 0; globalset(inst_next, cm); ] { }
:BEQ REL is opc=1 & tag=1 ; REL { if (ZF) goto REL; }
:BLT REL is opc=1 & tag=2 ; REL { if (CF) goto REL; }
:BLE REL is opc=1 & tag=3 ; REL { if (CF || ZF) goto REL; }
:BGT REL is opc=1 & tag=4 ; REL { if (!(CF || ZF)) goto REL; }
:BGE REL is opc=1 & tag=5 ; REL { if (!CF) goto REL; }
:BNE REL is opc=1 & tag=6 ; REL { if (!ZF) goto REL; }
:BRA REL is opc=1 & tag=7 ; REL { goto REL; }
:JMP is opc=2 & tag=0 { DT = DT - 2; t:2 = *:2 DT; goto [t]; }
:JEQ CPW is opc=2 & tag=1 ; CPW { if (ZF) goto CPW; }
:JLT CPW is opc=2 & tag=2 ; CPW { if (CF) goto CPW; }
:JLE CPW is opc=2 & tag=3 ; CPW { if (CF || ZF) goto CPW; }
:JGT CPW is opc=2 & tag=4 ; CPW { if (!(CF || ZF)) goto CPW; }
:JGE CPW is opc=2 & tag=5 ; CPW { if (!CF) goto CPW; }
:JNE CPW is opc=2 & tag=6 ; CPW { if (!ZF) goto CPW; }
:JMP CPW is opc=2 & tag=7 ; CPW { goto CPW; }
:CALL is opc=3 & tag=0 { DT = DT - 2; t:2 = *:2 DT; call [t]; }
:CEQ CPW is opc=3 & tag=1 ; CPW { if (!(ZF)) goto inst_next; call CPW; }
:CLT CPW is opc=3 & tag=2 ; CPW { if (!(CF)) goto inst_next; call CPW; }
:CLE CPW is opc=3 & tag=3 ; CPW { if (!(CF || ZF)) goto inst_next; call CPW; }
:CGT CPW is opc=3 & tag=4 ; CPW { if (!(!(CF || ZF))) goto inst_next; call CPW; }
:CGE CPW is opc=3 & tag=5 ; CPW { if (!(!CF)) goto inst_next; call CPW; }
:CNE CPW is opc=3 & tag=6 ; CPW { if (!(!ZF)) goto inst_next; call CPW; }
:CALL CPW is opc=3 & tag=7 ; CPW { call CPW; }
:PUSHZ b1 is opc=4 & tag=0 ; b1 { n:2 = b1; mel_block(0:1, DT, n); DT = DT + n; }
:PUSHB b1 is opc=4 & tag=1 ; b1 { *:1 DT = b1:1; DT = DT + 1; }
:PUSHW u16a is opc=4 & tag=2 ; u16a { *:2 DT = u16a:2; DT = DT + 2; }
:COMPACT_OFF is opc=4 & tag=3 [ cmoff = 1; globalset(inst_next, cmoff); ] { }
:POPN b1 is opc=4 & tag=4 ; b1 { n:2 = b1; DT = DT - n; }
:POPB is opc=4 & tag=5 { DT = DT - 1; }
:POPW is opc=4 & tag=6 { DT = DT - 2; }
:BITTEST b1 is opc=4 & tag=7 ; b1 { mel_reserved(); }
:PRIM b1 is opc=5 & tag=0 ; b1 { s:1 = 0; p:1 = b1; DT = mel_primitive(s, p, DT); }
:PRIM b1, b2 is opc=5 & tag=1 ; b1 ; b2 { s:1 = 1; p:1 = b1; a:1 = b2; DT = mel_primitive(s, p, DT, a); }
:PRIM b1, b2, b3 is opc=5 & tag=2 ; b1 ; b2 ; b3 { s:1 = 2; p:1 = b1; a:1 = b2; b:1 = b3; DT = mel_primitive(s, p, DT, a, b); }
:PRIM b1, b2, u16b is opc=5 & tag=3 ; b1 ; b2 ; u16b { s:1 = 3; p:1 = b1; a:1 = b2; bc:2 = u16b; DT = mel_primitive(s, p, DT, a, bc); }
:RET is opc=5 & tag=4 { return [CP]; }
:RET b1 is opc=5 & tag=5 ; b1 { return [CP]; }
:RET ", "^b1 is opc=5 & tag=6 ; b1 { return [CP]; }
:RET b1, b2 is opc=5 & tag=7 ; b1 ; b2 { return [CP]; }
:LOAD ", "^b1 is opc=7 & tag=0 ; bn=1 & b1 { v:1 = *:1 (DT - 1); *:1 DT = v; DT = DT + 1; }
:LOAD ", "^b1 is opc=7 & tag=0 ; bn=2 & b1 { v:2 = *:2 (DT - 2); *:2 DT = v; DT = DT + 2; }
:LOAD ", "^b1 is opc=7 & tag=0 ; bn=4 & b1 { v:4 = *:4 (DT - 4); *:4 DT = v; DT = DT + 4; }
:LOAD ", "^b1 is opc=7 & tag=0 ; b1 { n:2 = b1; mel_block(7:1, DT, n); }
:LOAD "SB["^s16a^"]", b1 is opc=7 & tag=1 ; bn=1 & b1 ; s16a { a:2 = SB + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "SB["^s16a^"]", b1 is opc=7 & tag=1 ; bn=2 & b1 ; s16a { a:2 = SB + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "SB["^s16a^"]", b1 is opc=7 & tag=1 ; bn=4 & b1 ; s16a { a:2 = SB + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "SB["^s16a^"]", b1 is opc=7 & tag=1 ; b1 ; s16a { n:2 = b1; a:2 = SB + s16a; mel_block(7:1, a, n); }
:LOAD "ST["^s16a^"]", b1 is opc=7 & tag=2 ; bn=1 & b1 ; s16a { a:2 = ST + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "ST["^s16a^"]", b1 is opc=7 & tag=2 ; bn=2 & b1 ; s16a { a:2 = ST + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "ST["^s16a^"]", b1 is opc=7 & tag=2 ; bn=4 & b1 ; s16a { a:2 = ST + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "ST["^s16a^"]", b1 is opc=7 & tag=2 ; b1 ; s16a { n:2 = b1; a:2 = ST + s16a; mel_block(7:1, a, n); }
:LOAD "DB["^s16a^"]", b1 is opc=7 & tag=3 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = DB + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "DB["^s16a^"]", b1 is opc=7 & tag=3 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = DB + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "DB["^s16a^"]", b1 is opc=7 & tag=3 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = DB + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "DB["^s16a^"]", b1 is opc=7 & tag=3 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = DB + s16a; mel_block(7:1, a, n); }
:LOAD "DB["^co6^"]", "1" is opc=7 & tag=3 & cm=1 & cmoff=0 ; cn=0 & co6 { a:2 = DB + co6; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "DB["^co6^"]", "2" is opc=7 & tag=3 & cm=1 & cmoff=0 ; cn=1 & co6 { a:2 = DB + co6; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "DB["^co6^"]", "4" is opc=7 & tag=3 & cm=1 & cmoff=0 ; cn=2 & co6 { a:2 = DB + co6; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "DB[c]", "8" is opc=7 & tag=3 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(7:1, DB, 8:2); }
:LOAD "LB["^s16a^"]", b1 is opc=7 & tag=4 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = LB + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "LB["^s16a^"]", b1 is opc=7 & tag=4 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = LB + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "LB["^s16a^"]", b1 is opc=7 & tag=4 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = LB + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "LB["^s16a^"]", b1 is opc=7 & tag=4 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = LB + s16a; mel_block(7:1, a, n); }
:LOAD "LB["^cs6^"]", "1" is opc=7 & tag=4 & cm=1 & cmoff=0 ; cn=0 & cs6 { a:2 = LB + cs6; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "LB["^cs6^"]", "2" is opc=7 & tag=4 & cm=1 & cmoff=0 ; cn=1 & cs6 { a:2 = LB + cs6; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "LB["^cs6^"]", "4" is opc=7 & tag=4 & cm=1 & cmoff=0 ; cn=2 & cs6 { a:2 = LB + cs6; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "LB[c]", "8" is opc=7 & tag=4 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(7:1, LB, 8:2); }
:LOAD "DT["^s16a^"]", b1 is opc=7 & tag=5 ; bn=1 & b1 ; s16a { a:2 = DT + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "DT["^s16a^"]", b1 is opc=7 & tag=5 ; bn=2 & b1 ; s16a { a:2 = DT + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "DT["^s16a^"]", b1 is opc=7 & tag=5 ; bn=4 & b1 ; s16a { a:2 = DT + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "DT["^s16a^"]", b1 is opc=7 & tag=5 ; b1 ; s16a { n:2 = b1; a:2 = DT + s16a; mel_block(7:1, a, n); }
:LOAD "PB["^s16a^"]", b1 is opc=7 & tag=6 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = PB + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "PB["^s16a^"]", b1 is opc=7 & tag=6 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = PB + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "PB["^s16a^"]", b1 is opc=7 & tag=6 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = PB + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "PB["^s16a^"]", b1 is opc=7 & tag=6 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = PB + s16a; mel_block(7:1, a, n); }
:LOAD "PB["^co6^"]", "1" is opc=7 & tag=6 & cm=1 & cmoff=0 ; cn=0 & co6 { a:2 = PB + co6; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "PB["^co6^"]", "2" is opc=7 & tag=6 & cm=1 & cmoff=0 ; cn=1 & co6 { a:2 = PB + co6; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "PB["^co6^"]", "4" is opc=7 & tag=6 & cm=1 & cmoff=0 ; cn=2 & co6 { a:2 = PB + co6; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "PB[c]", "8" is opc=7 & tag=6 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(7:1, PB, 8:2); }
:LOAD "PT["^s16a^"]", b1 is opc=7 & tag=7 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = PT + s16a; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "PT["^s16a^"]", b1 is opc=7 & tag=7 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = PT + s16a; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "PT["^s16a^"]", b1 is opc=7 & tag=7 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = PT + s16a; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "PT["^s16a^"]", b1 is opc=7 & tag=7 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = PT + s16a; mel_block(7:1, a, n); }
:LOAD "PT["^po^"]", "1" is opc=7 & tag=7 & cm=1 & cmoff=0 ; cn=0 & co6 [ po = co6 - 64; ] { a:2 = PT + po; v:1 = *:1 a; *:1 DT = v; DT = DT + 1; }
:LOAD "PT["^po^"]", "2" is opc=7 & tag=7 & cm=1 & cmoff=0 ; cn=1 & co6 [ po = co6 - 64; ] { a:2 = PT + po; v:2 = *:2 a; *:2 DT = v; DT = DT + 2; }
:LOAD "PT["^po^"]", "4" is opc=7 & tag=7 & cm=1 & cmoff=0 ; cn=2 & co6 [ po = co6 - 64; ] { a:2 = PT + po; v:4 = *:4 a; *:4 DT = v; DT = DT + 4; }
:LOAD "PT[c]", "8" is opc=7 & tag=7 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(7:1, PT, 8:2); }
:STORE ", "^b1 is opc=8 & tag=0 ; bn=1 & b1 { DT = DT - 1; v:1 = *:1 DT; *:1 (DT - 1) = v; }
:STORE ", "^b1 is opc=8 & tag=0 ; bn=2 & b1 { DT = DT - 2; v:2 = *:2 DT; *:2 (DT - 2) = v; }
:STORE ", "^b1 is opc=8 & tag=0 ; bn=4 & b1 { DT = DT - 4; v:4 = *:4 DT; *:4 (DT - 4) = v; }
:STORE ", "^b1 is opc=8 & tag=0 ; b1 { n:2 = b1; mel_block(8:1, DT, n); }
:STORE "SB["^s16a^"]", b1 is opc=8 & tag=1 ; bn=1 & b1 ; s16a { a:2 = SB + s16a; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "SB["^s16a^"]", b1 is opc=8 & tag=1 ; bn=2 & b1 ; s16a { a:2 = SB + s16a; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "SB["^s16a^"]", b1 is opc=8 & tag=1 ; bn=4 & b1 ; s16a { a:2 = SB + s16a; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "SB["^s16a^"]", b1 is opc=8 & tag=1 ; b1 ; s16a { n:2 = b1; a:2 = SB + s16a; mel_block(8:1, a, n); }
:STORE "ST["^s16a^"]", b1 is opc=8 & tag=2 ; bn=1 & b1 ; s16a { a:2 = ST + s16a; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "ST["^s16a^"]", b1 is opc=8 & tag=2 ; bn=2 & b1 ; s16a { a:2 = ST + s16a; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "ST["^s16a^"]", b1 is opc=8 & tag=2 ; bn=4 & b1 ; s16a { a:2 = ST + s16a; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "ST["^s16a^"]", b1 is opc=8 & tag=2 ; b1 ; s16a { n:2 = b1; a:2 = ST + s16a; mel_block(8:1, a, n); }
:STORE "DB["^s16a^"]", b1 is opc=8 & tag=3 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = DB + s16a; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "DB["^s16a^"]", b1 is opc=8 & tag=3 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = DB + s16a; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "DB["^s16a^"]", b1 is opc=8 & tag=3 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = DB + s16a; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "DB["^s16a^"]", b1 is opc=8 & tag=3 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = DB + s16a; mel_block(8:1, a, n); }
:STORE "DB["^co6^"]", "1" is opc=8 & tag=3 & cm=1 & cmoff=0 ; cn=0 & co6 { a:2 = DB + co6; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "DB["^co6^"]", "2" is opc=8 & tag=3 & cm=1 & cmoff=0 ; cn=1 & co6 { a:2 = DB + co6; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "DB["^co6^"]", "4" is opc=8 & tag=3 & cm=1 & cmoff=0 ; cn=2 & co6 { a:2 = DB + co6; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "DB[c]", "8" is opc=8 & tag=3 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(8:1, DB, 8:2); }
:STORE "LB["^s16a^"]", b1 is opc=8 & tag=4 & (cm=0 | cmoff=1) ; bn=1 & b1 ; s16a { a:2 = LB + s16a; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "LB["^s16a^"]", b1 is opc=8 & tag=4 & (cm=0 | cmoff=1) ; bn=2 & b1 ; s16a { a:2 = LB + s16a; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "LB["^s16a^"]", b1 is opc=8 & tag=4 & (cm=0 | cmoff=1) ; bn=4 & b1 ; s16a { a:2 = LB + s16a; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "LB["^s16a^"]", b1 is opc=8 & tag=4 & (cm=0 | cmoff=1) ; b1 ; s16a { n:2 = b1; a:2 = LB + s16a; mel_block(8:1, a, n); }
:STORE "LB["^cs6^"]", "1" is opc=8 & tag=4 & cm=1 & cmoff=0 ; cn=0 & cs6 { a:2 = LB + cs6; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
:STORE "LB["^cs6^"]", "2" is opc=8 & tag=4 & cm=1 & cmoff=0 ; cn=1 & cs6 { a:2 = LB + cs6; DT = DT - 2; v:2 = *:2 DT; *:2 a = v; }
:STORE "LB["^cs6^"]", "4" is opc=8 & tag=4 & cm=1 & cmoff=0 ; cn=2 & cs6 { a:2 = LB + cs6; DT = DT - 4; v:4 = *:4 DT; *:4 a = v; }
:STORE "LB[c]", "8" is opc=8 & tag=4 & cm=1 & cmoff=0 ; cn=3 & b1 { mel_block(8:1, LB, 8:2); }
:STORE "DT["^s16a^"]", b1 is opc=8 & tag=5 ; bn=1 & b1 ; s16a { a:2 = DT + s16a; DT = DT - 1; v:1 = *:1 DT; *:1 a = v; }
