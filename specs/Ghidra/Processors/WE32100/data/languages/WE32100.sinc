fl_add:  is kd != 2 & spsw = 0 & det = 0
{
  local a:4 = FA;
  local b:4 = FB;
  local xa:8 = zext(a);
  local xb:8 = zext(b);
  local r:8 = xa + xb;
  NF = (r s< 0);
  ZF = (r == 0);
  VF = ((r >> 8) != 0);
  local ma:8 = zext(a & 0xff);
  local mb:8 = zext(b & 0xff);
  local s:8 = ma + mb;
  CF = ((s >> 8) != 0);
}
