<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="mem"/>
    <range space="calldata"/>
  </global>
  <stackpointer register="SP" space="evmstack" growth="negative"/>
  <default_proto>
    <prototype name="default" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="512" align="32">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="32"><register name="RV"/></pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
