	AddCarry(ShortMemAddrW, LongMemAddrW);
}

# ADDC mem, reg
:addc LongMemAddrW, ShortMemAddrW is ExtCountDec & op=0x14 & ShortMemAddrW; LongMemAddrW {
	AddCarry(LongMemAddrW, ShortMemAddrW);
}

