# SLEIGH specification for the Toshiba TLCS-870/C 8-bit microcontroller core
# (TMP86 series). Written for unlace from Toshiba's "TLCS-870/C Series
# Instruction Set" (INST-1..23, 1999-08-26) for the addressing modes,
# register codes, flag rules and transfer/exchange encodings; the remaining
# encodings follow the opcode tables of the AS macro assembler's TLCS-870/C
# target (used as an oracle only). See ../../README.md.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=2 default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ A W C B E D L H ];
define register offset=0x00 size=2 [ WA BC DE HL ];
define register offset=0x08 size=2 [ IX IY SP PC ];
define register offset=0x10 size=1 [ JF ZF CF HF SF VF PSW RBS ];

define token opbyte (8)
  op     = (0,7)
  op_hi5 = (3,7)
  op_hi3 = (5,7)
  op_hi4 = (4,7)
  op_lo3 = (0,2)
  op_lo4 = (0,3)
  r0     = (0,2)
  rr0    = (0,2)
  g      = (0,2)
  gg     = (0,2)
  gghi   = (0,2)
  gglo   = (0,2)
  b3     = (0,2)
  jrsd   = (0,4) signed
;

define token op2byte (8)
  o2     = (0,7)
  o2hi5  = (3,7)
  o2hi2  = (6,7)
  o2op   = (0,2)
  o2b    = (0,2)
  r3     = (3,5)
  rr3    = (3,5)
  r3lo2  = (0,2)
  rr3lo2 = (0,2)
  xcc3   = (0,2)
;

define token data8 (8)
  n8  = (0,7)
  x8  = (0,7)
  d8  = (0,7) signed
;

define token data16 (16)
  imm16 = (0,15)
  vhi = (8,15)
;

attach variables [ r0 g r3 r3lo2 ] [ A W C B E D L H ];
attach variables [ rr0 gg rr3 rr3lo2 ] [ WA BC DE HL IX IY SP _ ];
attach variables [ gghi ] [ W B D H _ _ _ _ ];
attach variables [ gglo ] [ A C E L _ _ _ _ ];

define pcodeop daa;
define pcodeop das;
define pcodeop software_interrupt;
define pcodeop set_register_bank;

macro setZS(r) {
  ZF = r == 0;
  SF = r s< 0;
}

macro packPSW() {
  PSW = (JF << 7) | (ZF << 6) | (CF << 5) | (HF << 4) | (SF << 3) | (VF << 2);
}

macro unpackPSW() {
  JF = (PSW >> 7) & 1; ZF = (PSW >> 6) & 1; CF = (PSW >> 5) & 1;
  HF = (PSW >> 4) & 1; SF = (PSW >> 3) & 1; VF = (PSW >> 2) & 1;
}

# PUSH stores the high byte at (SP) and the low byte at (SP-1), then SP -= 2.
macro push16(v) {
  local a:2 = SP - 1;
  *:2 a = v;
  SP = SP - 2;
}

macro pop16(v) {
  SP = SP + 2;
  local a:2 = SP - 1;
  v = *:2 a;
}

sd: "+"^d8 is d8 & n8 < 0x80 { export *[const]:2 d8; }
sd: d8     is d8 & n8 > 0x7f { export *[const]:2 d8; }

xa: x8 is x8 & n8 < 0x80 { export *[const]:2 x8; }
xa: x8 is x8 & n8 > 0x7f { export *[const]:2 x8; }
rbsv: v is n8 [ v = n8 >> 1; ] { }
vwa: imm16 is imm16 & vhi < 0x80 { export *[const]:2 imm16; }
vwa: imm16 is imm16 & vhi > 0x7f { export *[const]:2 imm16; }

# Source memory (8-bit and 16-bit accesses differ only for (+SP), which
# pre-increments by the access size). (PC+A) uses the instruction address + 2.
src8X: "("^xa^")" is op=0xe0 ; xa { export xa; }
src8V: "("^vwa^")" is op=0xe1 ; vwa { export vwa; }
src8R: "(DE)"        is op=0xe2 { export DE; }
src8R: "(HL)"        is op=0xe3 { export HL; }
src8R: "(IX)"        is op=0xe4 { export IX; }
src8R: "(IY)"        is op=0xe5 { export IY; }
src8R: "(+SP)"       is op=0xe6 { SP = SP + 1; export SP; }
src8R: "(HL+C)"      is op=0xe7 { local a:2 = HL + sext(C); export a; }
src8D: "(IX"^sd^")"  is op=0xd4 ; sd { local a:2 = IX + sd; export a; }
src8D: "(IY"^sd^")"  is op=0xd5 ; sd { local a:2 = IY + sd; export a; }
src8D: "(SP"^sd^")"  is op=0xd6 ; sd { local a:2 = SP + sd; export a; }
src8D: "(HL"^sd^")"  is op=0xd7 ; sd { local a:2 = HL + sd; export a; }
src8P: "(PC+A)"      is op=0x4f { local a:2 = inst_start + 2 + sext(A); export a; }

src16X: "("^xa^")" is op=0xe0 ; xa { export xa; }
src16V: "("^vwa^")" is op=0xe1 ; vwa { export vwa; }
src16R: "(DE)"        is op=0xe2 { export DE; }
src16R: "(HL)"        is op=0xe3 { export HL; }
src16R: "(IX)"        is op=0xe4 { export IX; }
src16R: "(IY)"        is op=0xe5 { export IY; }
src16R: "(+SP)"       is op=0xe6 { SP = SP + 2; local a:2 = SP - 1; export a; }
src16R: "(HL+C)"      is op=0xe7 { local a:2 = HL + sext(C); export a; }
src16D: "(IX"^sd^")"  is op=0xd4 ; sd { local a:2 = IX + sd; export a; }
src16D: "(IY"^sd^")"  is op=0xd5 ; sd { local a:2 = IY + sd; export a; }
src16D: "(SP"^sd^")"  is op=0xd6 ; sd { local a:2 = SP + sd; export a; }
src16D: "(HL"^sd^")"  is op=0xd7 ; sd { local a:2 = HL + sd; export a; }
src16P: "(PC+A)"      is op=0x4f { local a:2 = inst_start + 2 + sext(A); export a; }

dstX: "("^xa^")" is op=0xf0 ; xa { export xa; }
dstV: "("^vwa^")" is op=0xf1 ; vwa { export vwa; }
dstR: "(DE)"        is op=0xf2 { export DE; }
dstR: "(HL)"        is op=0xf3 { export HL; }
dstR: "(IX)"        is op=0xf4 { export IX; }
dstR: "(IY)"        is op=0xf5 { export IY; }
dstR: "(HL+C)"      is op=0xf7 { local a:2 = HL + sext(C); export a; }
dstD: "(IX"^sd^")"  is op=0x54 ; sd { local a:2 = IX + sd; export a; }
dstD: "(IY"^sd^")"  is op=0x55 ; sd { local a:2 = IY + sd; export a; }
dstD: "(SP"^sd^")"  is op=0x56 ; sd { local a:2 = SP + sd; export a; }
dstD: "(HL"^sd^")"  is op=0x57 ; sd { local a:2 = HL + sd; export a; }


cc: "Z"  is op_lo3=0 { local t:1 = ZF; export t; }
cc: "NZ" is op_lo3=1 { local t:1 = !ZF; export t; }
cc: "CS" is op_lo3=2 { local t:1 = CF; export t; }
cc: "CC" is op_lo3=3 { local t:1 = !CF; export t; }
cc: "LE" is op_lo3=4 { local t:1 = CF || ZF; export t; }
cc: "GT" is op_lo3=5 { local t:1 = !(CF || ZF); export t; }
cc: "T"  is op_lo3=6 { local t:1 = JF; export t; }
cc: "F"  is op_lo3=7 { local t:1 = !JF; export t; }

xcc: "M"   is xcc3=0 { local t:1 = SF; export t; }
xcc: "P"   is xcc3=1 { local t:1 = !SF; export t; }
xcc: "SLT" is xcc3=2 { local t:1 = SF != VF; export t; }
xcc: "SGE" is xcc3=3 { local t:1 = SF == VF; export t; }
xcc: "SLE" is xcc3=4 { local t:1 = ZF || (SF != VF); export t; }
xcc: "SGT" is xcc3=5 { local t:1 = !ZF && (SF == VF); export t; }
xcc: "VS"  is xcc3=6 { local t:1 = VF; export t; }
xcc: "VC"  is xcc3=7 { local t:1 = !VF; export t; }

rel8: dest  is d8 [ dest = inst_next + d8; ] { export *:2 dest; }
rel8p: dest is d8 [ dest = inst_next + d8; ] { export *:2 dest; }
abs16: imm16 is imm16 { export *:2 imm16; }
jrsrel: dest is jrsd [ dest = inst_start + 2 + jrsd; ] { export *:2 dest; }

:ADDC r3,src8V is src8V ; o2hi2=0 & r3 & o2op=0 { local a:1 = r3; local b:1 = *:1 src8V; local c:1 = CF; local t:1 = a + b; local r:1 = t + c; CF = carry(a, b) || carry(t, c); HF = ((a & 0xf) + (b & 0xf) + c) > 0xf; VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; r3 = r; }
:ADDC src8V,n8 is src8V ; o2=0x60 ; n8 { local m:1 = *:1 src8V; local a:1 = m; local b:1 = n8:1; local c:1 = CF; local t:1 = a + b; local r:1 = t + c; CF = carry(a, b) || carry(t, c); HF = ((a & 0xf) + (b & 0xf) + c) > 0xf; VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; m = r; *:1 src8V = m; }
:ADDC rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=0 { local a:2 = rr3; local b:2 = *:2 src16V; local c:2 = zext(CF); local t:2 = a + b; local r:2 = t + c; CF = carry(a, b) || carry(t, c); VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; rr3 = r; }
:ADD r3,src8V is src8V ; o2hi2=0 & r3 & o2op=1 { local a:1 = r3; local b:1 = *:1 src8V; local r:1 = a + b; CF = carry(a, b); HF = ((a & 0xf) + (b & 0xf)) > 0xf; VF = scarry(a, b); setZS(r); JF = CF; r3 = r; }
:ADD src8V,n8 is src8V ; o2=0x61 ; n8 { local m:1 = *:1 src8V; local a:1 = m; local b:1 = n8:1; local r:1 = a + b; CF = carry(a, b); HF = ((a & 0xf) + (b & 0xf)) > 0xf; VF = scarry(a, b); setZS(r); JF = CF; m = r; *:1 src8V = m; }
:ADD rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=1 { local a:2 = rr3; local b:2 = *:2 src16V; local r:2 = a + b; CF = carry(a, b); VF = scarry(a, b); setZS(r); JF = CF; rr3 = r; }
:SUBB r3,src8V is src8V ; o2hi2=0 & r3 & o2op=2 { local a:1 = r3; local b:1 = *:1 src8V; local c:1 = CF; local t:1 = a - b; local r:1 = t - c; CF = (a < b) || (t < c); HF = (a & 0xf) < ((b & 0xf) + c); VF = sborrow(a, b) ^^ sborrow(t, c); setZS(r); JF = CF; r3 = r; }
:SUBB src8V,n8 is src8V ; o2=0x62 ; n8 { local m:1 = *:1 src8V; local a:1 = m; local b:1 = n8:1; local c:1 = CF; local t:1 = a - b; local r:1 = t - c; CF = (a < b) || (t < c); HF = (a & 0xf) < ((b & 0xf) + c); VF = sborrow(a, b) ^^ sborrow(t, c); setZS(r); JF = CF; m = r; *:1 src8V = m; }
:SUBB rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=2 { local a:2 = rr3; local b:2 = *:2 src16V; local c:2 = zext(CF); local t:2 = a - b; local r:2 = t - c; CF = (a < b) || (t < c); VF = sborrow(a, b) ^^ sborrow(t, c); setZS(r); JF = CF; rr3 = r; }
:SUB r3,src8V is src8V ; o2hi2=0 & r3 & o2op=3 { local a:1 = r3; local b:1 = *:1 src8V; local r:1 = a - b; CF = a < b; HF = (a & 0xf) < (b & 0xf); VF = sborrow(a, b); setZS(r); JF = CF; r3 = r; }
:SUB src8V,n8 is src8V ; o2=0x63 ; n8 { local m:1 = *:1 src8V; local a:1 = m; local b:1 = n8:1; local r:1 = a - b; CF = a < b; HF = (a & 0xf) < (b & 0xf); VF = sborrow(a, b); setZS(r); JF = CF; m = r; *:1 src8V = m; }
:SUB rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=3 { local a:2 = rr3; local b:2 = *:2 src16V; local r:2 = a - b; CF = a < b; VF = sborrow(a, b); setZS(r); JF = CF; rr3 = r; }
:AND r3,src8V is src8V ; o2hi2=0 & r3 & o2op=4 { local r:1 = r3 & *:1 src8V; setZS(r); JF = ZF; r3 = r; }
:AND src8V,n8 is src8V ; o2=0x64 ; n8 { local m:1 = *:1 src8V; local r:1 = m & n8:1; setZS(r); JF = ZF; m = r; *:1 src8V = m; }
:AND rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=4 { local r:2 = rr3 & *:2 src16V; setZS(r); JF = ZF; rr3 = r; }
:XOR r3,src8V is src8V ; o2hi2=0 & r3 & o2op=5 { local r:1 = r3 ^ *:1 src8V; setZS(r); JF = ZF; r3 = r; }
:XOR src8V,n8 is src8V ; o2=0x65 ; n8 { local m:1 = *:1 src8V; local r:1 = m ^ n8:1; setZS(r); JF = ZF; m = r; *:1 src8V = m; }
:XOR rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=5 { local r:2 = rr3 ^ *:2 src16V; setZS(r); JF = ZF; rr3 = r; }
:OR r3,src8V is src8V ; o2hi2=0 & r3 & o2op=6 { local r:1 = r3 | *:1 src8V; setZS(r); JF = ZF; r3 = r; }
:OR src8V,n8 is src8V ; o2=0x66 ; n8 { local m:1 = *:1 src8V; local r:1 = m | n8:1; setZS(r); JF = ZF; m = r; *:1 src8V = m; }
:OR rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=6 { local r:2 = rr3 | *:2 src16V; setZS(r); JF = ZF; rr3 = r; }
:CMP r3,src8V is src8V ; o2hi2=0 & r3 & o2op=7 { local a:1 = r3; local b:1 = *:1 src8V; local r:1 = a - b; CF = a < b; HF = (a & 0xf) < (b & 0xf); VF = sborrow(a, b); setZS(r); JF = ZF; }
:CMP src8V,n8 is src8V ; o2=0x67 ; n8 { local m:1 = *:1 src8V; local a:1 = m; local b:1 = n8:1; local r:1 = a - b; CF = a < b; HF = (a & 0xf) < (b & 0xf); VF = sborrow(a, b); setZS(r); JF = ZF; }
:CMP rr3,src16V is src16V ; o2hi2=2 & rr3 & o2op=7 { local a:2 = rr3; local b:2 = *:2 src16V; local r:2 = a - b; CF = a < b; VF = sborrow(a, b); setZS(r); JF = ZF; }
:LD r3lo2,src8V is src8V ; o2hi5=8 & r3lo2 { local v:1 = *:1 src8V; r3lo2 = v; ZF = v == 0; JF = 1; }
:LD rr3lo2,src16V is src16V ; o2hi5=9 & rr3lo2 { rr3lo2 = *:2 src16V; JF = 1; }
:XOR "CF",src8V^"."^o2b is src8V ; o2hi5=0xa & o2b { local v:1 = *:1 src8V; CF = CF ^ ((v >> o2b) & 1); JF = !CF; }
:LD "CF",src8V^"."^o2b is src8V ; o2hi5=0xb & o2b { local v:1 = *:1 src8V; CF = (v >> o2b) & 1; ZF = !CF; JF = ZF; }
:XCH r3lo2,src8V is src8V ; o2hi5=0xe & r3lo2 { local v:1 = *:1 src8V; *:1 src8V = r3lo2; r3lo2 = v; ZF = v == 0; JF = 1; }
:SET src8V^"."^o2b is src8V ; o2hi5=0x18 & o2b { local v:1 = *:1 src8V; local m:1 = 1 << o2b; ZF = (v & m) == 0; JF = ZF; *:1 src8V = v | m; }
:CLR src8V^"."^o2b is src8V ; o2hi5=0x19 & o2b { local v:1 = *:1 src8V; local m:1 = 1 << o2b; ZF = (v & m) == 0; JF = ZF; *:1 src8V = v & ~m; }
:XCH rr3lo2,src16V is src16V ; o2hi5=0x1b & rr3lo2 { local v:2 = *:2 src16V; *:2 src16V = rr3lo2; rr3lo2 = v; JF = 1; }
:CPL src8V^"."^o2b is src8V ; o2hi5=0x1c & o2b { local v:1 = *:1 src8V; local m:1 = 1 << o2b; ZF = (v & m) == 0; JF = ZF; *:1 src8V = v ^ m; }
:LD src8V^"."^o2b,"CF" is src8V ; o2hi5=0x1d & o2b { local v:1 = *:1 src8V; local m:1 = 1 << o2b; *:1 src8V = (v & ~m) | (CF << o2b); JF = 1; }
:INC src8V is src8V ; o2=0xf0 { local v:1 = *:1 src8V + 1; *:1 src8V = v; ZF = v == 0; JF = ZF; }
:DEC src8V is src8V ; o2=0xf8 { local v:1 = *:1 src8V; local r:1 = v - 1; *:1 src8V = r; ZF = r == 0; JF = v == 0; }
:SET src8V^".A" is src8V ; o2=0xf2 { local v:1 = *:1 src8V; local m:1 = 1 << (A & 7); ZF = (v & m) == 0; JF = ZF; *:1 src8V = v | m; }
:LD src8V^".A","CF" is src8V ; o2=0xf3 { local v:1 = *:1 src8V; local b:1 = A & 7; local m:1 = 1 << b; *:1 src8V = (v & ~m) | (CF << b); JF = 1; }
:CLR src8V^".A" is src8V ; o2=0xfa { local v:1 = *:1 src8V; local m:1 = 1 << (A & 7); ZF = (v & m) == 0; JF = ZF; *:1 src8V = v & ~m; }
:CPL src8V^".A" is src8V ; o2=0xfb { local v:1 = *:1 src8V; local m:1 = 1 << (A & 7); ZF = (v & m) == 0; JF = ZF; *:1 src8V = v ^ m; }
:LD "CF",src8V^".A" is src8V ; o2=0xfc { local v:1 = *:1 src8V; CF = (v >> (A & 7)) & 1; ZF = !CF; JF = ZF; }
:ROLD "A",src8V is src8V ; o2=0xf6 { local v:1 = *:1 src8V; local a:1 = A; *:1 src8V = (v << 4) | (a & 0xf); A = (a & 0xf0) | (v >> 4); JF = 1; }
:RORD "A",src8V is src8V ; o2=0xf7 { local v:1 = *:1 src8V; local a:1 = A; *:1 src8V = (v >> 4) | (a << 4); A = (a & 0xf0) | (v & 0xf); JF = 1; }
:CALL src16V is src16V ; o2=0xfd { local t:2 = *:2 src16V; local ra:2 = inst_next; push16(ra); call [t]; }
:JP src16V is src16V ; o2=0xfe { local t:2 = *:2 src16V; goto [t]; }
:LD dstV,r3lo2 is dstV ; o2hi5=0xf & r3lo2 { *:1 dstV = r3lo2; JF = 1; }
:LD dstV,rr3lo2 is dstV ; o2hi5=0xd & rr3lo2 { *:2 dstV = rr3lo2; JF = 1; }
:LD dstV,n8 is dstV ; o2=0xf9 ; n8 { *:1 dstV = n8; JF = 1; }
:ADDC r3,src8X is src8X ; o2hi2=0 & r3 & o2op=0 { local a:1 = r3; local b:1 = *:1 src8X; local c:1 = CF; local t:1 = a + b; local r:1 = t + c; CF = carry(a, b) || carry(t, c); HF = ((a & 0xf) + (b & 0xf) + c) > 0xf; VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; r3 = r; }
:ADDC src8X,n8 is src8X ; o2=0x60 ; n8 { local m:1 = *:1 src8X; local a:1 = m; local b:1 = n8:1; local c:1 = CF; local t:1 = a + b; local r:1 = t + c; CF = carry(a, b) || carry(t, c); HF = ((a & 0xf) + (b & 0xf) + c) > 0xf; VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; m = r; *:1 src8X = m; }
:ADDC rr3,src16X is src16X ; o2hi2=2 & rr3 & o2op=0 { local a:2 = rr3; local b:2 = *:2 src16X; local c:2 = zext(CF); local t:2 = a + b; local r:2 = t + c; CF = carry(a, b) || carry(t, c); VF = scarry(a, b) ^^ scarry(t, c); setZS(r); JF = CF; rr3 = r; }
:ADD r3,src8X is src8X ; o2hi2=0 & r3 & o2op=1 { local a:1 = r3; local b:1 = *:1 src8X; local r:1 = a + b; CF = carry(a, b); HF = ((a & 0xf) + (b & 0xf)) > 0xf; VF = scarry(a, b); setZS(r); JF = CF; r3 = r; }
:ADD src8X,n8 is src8X ; o2=0x61 ; n8 { local m:1 = *:1 src8X; local a:1 = m; local b:1 = n8:1; local r:1 = a + b; CF = carry(a, b); HF = ((a & 0xf) + (b & 0xf)) > 0xf; VF = scarry(a, b); setZS(r); JF = CF; m = r; *:1 src8X = m; }
