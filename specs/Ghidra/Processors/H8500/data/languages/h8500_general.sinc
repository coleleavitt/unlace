:CMP.B SRCB2, gRB is ealo=0x05 ... & SRCB2; g5=0x0e & gRB { local src:1 = SRCB2; subflags(gRB, src); local t:1 = gRB - src; setNZ(t); }
:CMP.B SRCB2, gRB is ealo=0x04 ... & SRCB2; g5=0x0e & gRB { local src:1 = SRCB2; subflags(gRB, src); local t:1 = gRB - src; setNZ(t); }
