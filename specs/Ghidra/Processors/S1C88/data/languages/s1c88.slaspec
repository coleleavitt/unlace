:SUB "A", "A" is dmode=0 & umode=0 & o0=0x10 { a:1 = A; b:1 = A; r:1 = a - b; C = a < b; V = sborrow(a, b); resZN(r); A = r; }
:SUB "A", "A" is dmode=1 & umode=0 & o0=0x10 {  a:1 = A; b:1 = A; r:1 = 0; bcdSub(a, b, 0, r); A = r; }
:SUB "A", "A" is umode=1 & o0=0x10 {  a:1 = A; b:1 = A; r:1 = 0; unpSub(a, b, 0, r, D); A = r; }
