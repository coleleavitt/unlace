<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="jstack" growth="negative"/>
  <default_proto>
    <prototype name="default" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="2"><register name="L0"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L1"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L2"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L3"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L4"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L5"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L6"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="L7"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2"><register name="RVs"/></pentry>
        <pentry minsize="3" maxsize="4"><register name="RV"/></pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
