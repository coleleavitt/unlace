# (kuna) FEAT_PAuth_LR (Armv9.5): the PC (or a label or register holding it) is a second
# modifier, passed as the third operand of the PAC user operations.
PACLRLabel: "#0" is imm16=0 { local a:8 = inst_start; export a; }
PACLRLabel: "#-"^off is imm16 [ off = imm16 * 4; ] { local a:8 = inst_start - off; export a; }

