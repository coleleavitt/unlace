<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="4"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="positive"/>
  <default_proto>
    <prototype name="__c3x" extrapop="-1" stackshift="-1">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="AR2"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="R2"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="R3"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="RC"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="RS"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="RE"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="DP"/>
        <register name="AR3"/>
        <register name="AR4"/>
        <register name="AR5"/>
        <register name="AR6"/>
        <register name="AR7"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="R6"/>
        <register name="R7"/>
      </unaffected>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
        <register name="R2"/>
        <register name="R3"/>
        <register name="AR0"/>
        <register name="AR1"/>
        <register name="AR2"/>
        <register name="IR0"/>
        <register name="IR1"/>
        <register name="BK"/>
        <register name="RS"/>
        <register name="RE"/>
        <register name="RC"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
