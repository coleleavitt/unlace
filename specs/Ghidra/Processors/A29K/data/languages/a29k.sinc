:loadm ce,CNTL,RA,ADDR is (op=0x36 | op=0x37) & ce & cev=1 & CNTL & cntl & RA & ADDR
{ local c:4 = cntl; RA = coprocessorLoad(c, ADDR, CRr); CRr = 0; }
:storem ce,CNTL,RA,ADDR is (op=0x3e | op=0x3f) & ce & cev=1 & CNTL & cntl & RA & ADDR
{ local c:4 = cntl; coprocessorStore(c, ADDR, RA, CRr); CRr = 0; }

########################################################################################
# Traps, interrupts, system
########################################################################################

:emulate VN,RA,RB is op=0xd7 & VN & RA & RB & NA & NB
{ ipa = NA << 2; ipb = NB << 2; trap(VN); }

# interrupt return: CPS from OPS, execution resumes at PC1 (then PC0)
:iret is op=0x88 { cps = ops; local t:4 = pc1; return [t]; }
:iretinv is op=0x8c & id & idv=0 { invalidate(id:1); cps = ops; local t:4 = pc1; return [t]; }
:iretinv id is op=0x8c & id & (idv=1 | idv=2 | idv=3) { invalidate(id:1); cps = ops; local t:4 = pc1; return [t]; }
:inv is op=0x9f & id & idv=0 { invalidate(id:1); }
:inv id is op=0x9f & id & (idv=1 | idv=2 | idv=3) { invalidate(id:1); }
:halt is op=0x89 { halt(); }

########################################################################################
# Floating point (Am29050; the other 29K processors trap to emulation routines that
# implement the same operations). Double-precision operands are a register and its twin,
# the register holding the high word. Exceptions set the sticky bits of FPS when masked in
# FPE, and otherwise their trap status bits (the trap itself is not raised, see FP_TRAP): invalid operation
# (NS, bit 0), overflow (VS, bit 2), divide by zero (DS, bit 5). P-code float operations do
# not report inexact or underflow results, so XS/US are not set.
########################################################################################

# exception "bit" (FPS sticky bit = FPE mask bit; the trap status bit is bit << 8)
macro fpexc(cond, bit, tr) {
	local masked:1 = (fpe & bit) != 0;
	fps = fps | (zext(cond && masked) * bit) | (zext(cond && !masked) * (bit << 8));
	tr = tr || (cond && !masked);
}
# An unmasked exception sets its trap status bit (bit << 8) in FPS. The Floating-Point Exception
# trap itself (vector 22) is not raised: a conditional trap after every floating-point operation
# buried the decompiled arithmetic under exception tests (tried). FP_TRAP marks where it would go.
@define FP_TRAP ""

macro fpchk(a, b, r, tr) {
	fpexc(nan(r) && !nan(a) && !nan(b), 1:4, tr);
	local inf:1 = (r f== (r f+ r)) && (r f!= int2float(0:4));
	local ainf:1 = (a f== (a f+ a)) && (a f!= int2float(0:4));
	local binf:1 = (b f== (b f+ b)) && (b f!= int2float(0:4));
	fpexc(inf && !ainf && !binf, 4:4, tr);
}

macro setD(hi, lo, v) {
	hi = v(4);
	lo = v:4;
}

:fadd RC,RA,RB is op=0xf0 & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; local r:4 = a f+ b; fpchk(a, b, r, tr); RC = r; $(FP_TRAP) }
:fsub RC,RA,RB is op=0xf2 & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; local r:4 = a f- b; fpchk(a, b, r, tr); RC = r; $(FP_TRAP) }
:fmul RC,RA,RB is op=0xf4 & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; local r:4 = a f* b; fpchk(a, b, r, tr); RC = r; $(FP_TRAP) }
:fdiv RC,RA,RB is op=0xf6 & RC & RA & RB
{
	local tr:1 = 0;
	local a:4 = RA; local b:4 = RB;
	fpexc((b f== int2float(0:4)) && (a f!= int2float(0:4)) && !nan(a) && ((a f+ a) f!= a), 32:4, tr);
	local r:4 = a f/ b;
	local zd:1 = (b f== int2float(0:4));
	fpexc(nan(r) && !nan(a) && !nan(b), 1:4, tr);
	local rinf:1 = (r f== (r f+ r)) && (r f!= int2float(0:4));
	local ainf:1 = (a f== (a f+ a)) && (a f!= int2float(0:4));
	fpexc(rinf && !ainf && !zd, 4:4, tr);
	RC = r;
	$(FP_TRAP)
}
:fdmul RC,RA,RB is op=0xf9 & RC & RA & RB & RCT
{
	local tr:1 = 0;
	local a:8 = float2float(RA); local b:8 = float2float(RB); local r:8 = a f* b;
	fpchk(a, b, r, tr); setD(RC, RCT, r);
	$(FP_TRAP)
}
:dadd RC,DA,DB is op=0xf1 & RC & DA & DB & RCT
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; local r:8 = a f+ b; fpchk(a, b, r, tr); setD(RC, RCT, r); $(FP_TRAP) }
:dsub RC,DA,DB is op=0xf3 & RC & DA & DB & RCT
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; local r:8 = a f- b; fpchk(a, b, r, tr); setD(RC, RCT, r); $(FP_TRAP) }
:dmul RC,DA,DB is op=0xf5 & RC & DA & DB & RCT
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; local r:8 = a f* b; fpchk(a, b, r, tr); setD(RC, RCT, r); $(FP_TRAP) }
:ddiv RC,DA,DB is op=0xf7 & RC & DA & DB & RCT
{
	local tr:1 = 0;
	local a:8 = DA; local b:8 = DB;
	fpexc((b f== int2float(0:4)) && (a f!= int2float(0:4)) && !nan(a) && ((a f+ a) f!= a), 32:4, tr);
	local r:8 = a f/ b;
	local zd:1 = (b f== int2float(0:4));
	fpexc(nan(r) && !nan(a) && !nan(b), 1:4, tr);
	local rinf:1 = (r f== (r f+ r)) && (r f!= int2float(0:4));
	local ainf:1 = (a f== (a f+ a)) && (a f!= int2float(0:4));
	fpexc(rinf && !ainf && !zd, 4:4, tr);
	setD(RC, RCT, r);
	$(FP_TRAP)
}

# comparisons: TRUE (bit 31) or FALSE; unordered operands compare false and are invalid
:feq RC,RA,RB is op=0xea & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f== b, r); RC = r; $(FP_TRAP) }
:fgt RC,RA,RB is op=0xec & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f> b, r); RC = r; $(FP_TRAP) }
:fge RC,RA,RB is op=0xee & RC & RA & RB
{ local tr:1 = 0; local a:4 = RA; local b:4 = RB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f>= b, r); RC = r; $(FP_TRAP) }
:deq RC,DA,DB is op=0xeb & RC & DA & DB
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f== b, r); RC = r; $(FP_TRAP) }
:dgt RC,DA,DB is op=0xed & RC & DA & DB
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f> b, r); RC = r; $(FP_TRAP) }
:dge RC,DA,DB is op=0xef & RC & DA & DB
{ local tr:1 = 0; local a:8 = DA; local b:8 = DB; fpexc(nan(a) || nan(b), 1:4, tr); local r:4 = 0; true32(a f>= b, r); RC = r; $(FP_TRAP) }

# CONVERT rc,ra,UI,RND,FD,FS. Formats: 0 integer, 1 single, 2 double. Rounding to an integer:
# 0 nearest, 1 toward -inf, 2 toward +inf, 3 toward zero, 4 the FPE round mode (FRM, bits 7-6)
FRND4: is epsilon { local fm:4 = (fpe >> 6) & 3; export fm; }
RNDM: is rnd=4 & FRND4 { export FRND4; }
RNDM: is rnd { local rm:4 = rnd; export rm; }

# round to nearest even, toward -inf, toward +inf, toward zero (result as a double)
macro roundToInt(x, mode, r) {
	local fl:8 = floor(x);
	local d:8 = x f- fl;
	local one:8 = int2float(1:4);
	local two:8 = int2float(2:4);
	local half:8 = one f/ two;
	local fi:8 = trunc(fl);
	local up:1 = (d f> half) || ((d f== half) && ((fi & 1) != 0));
	local upi:4 = zext(up);
	local upf:8 = int2float(upi);
	local nr:8 = fl f+ upf;
	local m0:8 = 0 - zext(mode == 0 || mode > 3);
	local m1:8 = 0 - zext(mode == 1);
	local m2:8 = 0 - zext(mode == 2);
	local m3:8 = 0 - zext(mode == 3);
	local ti:8 = trunc(x);
	local tz:8 = int2float(ti);
	r = (nr & m0) | (fl & m1) | (ceil(x) & m2) | (tz & m3);
}

CVSRC: is fsv=0 & uiv=0 & RA { local v:8 = int2float(RA); export v; }
CVSRC: is fsv=0 & uiv=1 & RA { local u:8 = zext(RA); local v:8 = int2float(u); export v; }
CVSRC: is fsv=1 & RA { local v:8 = float2float(RA); export v; }
CVSRC: is fsv=2 & DA { export DA; }

:convert RC,RA,ui,rnd,fd,fs is op=0xe4 & RC & RA & ui & rnd & fd & fdv=1 & fs & (fsv=0 | fsv=2) & CVSRC
{ RC = float2float(CVSRC); }
:convert RC,RA,ui,rnd,fd,fs is op=0xe4 & RC & RA & ui & rnd & fd & fdv=2 & fs & (fsv=0 | fsv=1) & CVSRC & RCT
{ local v:8 = CVSRC; setD(RC, RCT, v); }
:convert RC,RA,ui,rnd,fd,fs is op=0xe4 & RC & RA & ui & uiv=0 & rnd & fd & fdv=0 & fs & (fsv=1 | fsv=2) & CVSRC & RNDM
{
	local tr:1 = 0;
	local x:8 = CVSRC; local r:8 = 0; roundToInt(x, RNDM, r);
	local lim:8 = int2float(0x80000000:8); local nlim:8 = int2float(-0x80000000:8);
	fpexc(nan(x) || (r f>= lim) || (r f< nlim), 1:4, tr);
	local i:8 = trunc(r); RC = i:4;
	$(FP_TRAP)
}
:convert RC,RA,ui,rnd,fd,fs is op=0xe4 & RC & RA & ui & uiv=1 & rnd & fd & fdv=0 & fs & (fsv=1 | fsv=2) & CVSRC & RNDM
{
	local tr:1 = 0;
	local x:8 = CVSRC; local r:8 = 0; roundToInt(x, RNDM, r);
	local lim:8 = int2float(0x100000000:8); local nlim:8 = int2float(0:8);
	fpexc(nan(x) || (r f>= lim) || (r f< nlim), 1:4, tr);
	local i:8 = trunc(r); RC = i:4;
	$(FP_TRAP)
}
# other format combinations (same format, reserved formats) raise the CONVERT trap (36)
:convert RC,RA,ui,rnd,fd,fs is op=0xe4 & RC & RA & ui & rnd & fd & fs { trap(36:4); }

:sqrt RC,RA,fs is op=0xe5 & RC & RA & fs & fsv=1
{ local tr:1 = 0; local a:4 = RA; fpexc(a f< int2float(0:4), 1:4, tr); RC = sqrt(a); $(FP_TRAP) }
:sqrt RC,RA,fs is op=0xe5 & RC & RA & fs & fsv=2 & DA & RCT
{ local tr:1 = 0; local a:8 = DA; fpexc(a f< int2float(0:4), 1:4, tr); local r:8 = sqrt(a); setD(RC, RCT, r); $(FP_TRAP) }
:sqrt RC,RA,fs is op=0xe5 & RC & RA & fs { trap(37:4); }

# CLASS: bit 5 sign, bits 4-0 exponent/fraction class (Am29050 manual, CLASS)
macro classify(sgn, bexp, frac, maxexp, fracmax, fracmsb, r) {
	local e:4 = 0;
	e = 0x02 * zext(bexp == 0 && frac != 0 && frac != fracmax) +
		0x03 * zext(bexp == 0 && frac == fracmax) +
		0x08 * zext(bexp != 0 && bexp < maxexp && frac == 0) +
		0x0a * zext(bexp != 0 && bexp < maxexp && frac != 0 && frac != fracmax) +
		0x0b * zext(bexp != 0 && bexp < maxexp && frac == fracmax) +
		0x0c * zext(bexp == maxexp && frac == 0) +
		0x0e * zext(bexp == maxexp && frac != 0 && frac != fracmax) +
		0x0f * zext(bexp == maxexp && frac == fracmax) +
		0x10 * zext(bexp == maxexp + 1 && frac == 0) +
		0x12 * zext(bexp == maxexp + 1 && frac != 0 && (frac & fracmsb) == 0) +
		0x13 * zext(bexp == maxexp + 1 && (frac & fracmsb) != 0);
	r = (zext(sgn) << 5) | e;
}
:class RC,RA,fs is op=0xe6 & RC & RA & fs & fsv=1
{
	local a:4 = RA; local r:4 = 0;
	local bexp:4 = (a >> 23) & 0xff; local frac:4 = a & 0x7fffff;
	classify(a s< 0, bexp, frac, 254:4, 0x7fffff:4, 0x400000:4, r);
	RC = r;
}
:class RC,RA,fs is op=0xe6 & RC & RA & fs & fsv=2 & DA
{
	local a:8 = DA; local r:4 = 0;
	local bexp:8 = (a >> 52) & 0x7ff; local frac:8 = a & 0xfffffffffffff;
	classify(a s< 0, bexp, frac, 2046:8, 0xfffffffffffff:8, 0x8000000000000:8, r);
	RC = r;
}
:class RC,RA,fs is op=0xe6 & RC & RA & fs { trap(38:4); }

# Accumulators: kept as doubles; when the FPE accumulator format ACF (bits 10-9) is 01 (single
# precision) every value written to an accumulator is rounded to single precision.
macro accRound(r) {
	local sgl:1 = ((fpe >> 9) & 3) == 1;
	local rs:4 = float2float(r);
	local rd:8 = float2float(rs);
	r = (rd & (0 - zext(sgl))) | (r & (0 - zext(!sgl)));
}
ACC: is acnv16=0 { export acc0; }
ACC: is acnv16=1 { export acc1; }
ACC: is acnv16=2 { export acc2; }
ACC: is acnv16=3 { export acc3; }
ACCL: is acn=0 { export acc0; }
ACCL: is acn=1 { export acc1; }
ACCL: is acn=2 { export acc2; }
ACCL: is acn=3 { export acc3; }

# FUNC (bits 21-18): bit 3 multiplier 1.0 instead of SRCB, bit 0 negate the multiplier,
# bit 2 third operand 0.0 instead of ACC, bit 1 subtract the third operand
MULS: is f3=0 & f0=0 & RB { local mv:8 = float2float(RB); export mv; }
MULS: is f3=0 & f0=1 & RB { local mv:8 = f- float2float(RB); export mv; }
MULD: is f3=0 & f0=0 & DB { export DB; }
MULD: is f3=0 & f0=1 & DB { local mv:8 = f- DB; export mv; }
MULS: is f3=1 & f0=0 { local mv:8 = int2float(1:4); export mv; }
MULS: is f3=1 & f0=1 { local mv:8 = int2float(-1:4); export mv; }
MULD: is f3=1 & f0=0 { local mv:8 = int2float(1:4); export mv; }
MULD: is f3=1 & f0=1 { local mv:8 = int2float(-1:4); export mv; }
OP3: is f2=0 & ACC { export ACC; }
OP3: is f2=1 { local z:8 = int2float(0:4); export z; }

:fmac func,acn16,RA,RB is op=0xd8 & func & acn16 & ACC & RA & RB & MULS & OP3 & f1=0
{ local a:8 = float2float(RA); local r:8 = (a f* MULS) f+ OP3; accRound(r); ACC = r; }
:fmac func,acn16,RA,RB is op=0xd8 & func & acn16 & ACC & RA & RB & MULS & OP3 & f1=1
{ local a:8 = float2float(RA); local r:8 = (a f* MULS) f- OP3; accRound(r); ACC = r; }
:dmac func,acn16,RA,RB is op=0xd9 & func & acn16 & ACC & RA & RB & DA & MULD & OP3 & f1=0
{ local r:8 = (DA f* MULD) f+ OP3; accRound(r); ACC = r; }
:dmac func,acn16,RA,RB is op=0xd9 & func & acn16 & ACC & RA & RB & DA & MULD & OP3 & f1=1
{ local r:8 = (DA f* MULD) f- OP3; accRound(r); ACC = r; }
:fmsm RC,RA,RB is op=0xda & RC & RA & RB
{ local r:8 = (float2float(RA) f* acc0) f+ float2float(RB); RC = float2float(r); }
:dmsm RC,DA,DB is op=0xdb & RC & DA & DB & RCT
{ local r:8 = (DA f* acc0) f+ DB; setD(RC, RCT, r); }

:mtacc RA,fmt,acn is op=0xe8 & b23_16=1 & RA & fmt & fmtv=1 & acn & ACCL
{ local r:8 = float2float(RA); accRound(r); ACCL = r; }
:mtacc RA,fmt,acn is op=0xe8 & b23_16=1 & RA & fmt & fmtv=2 & acn & ACCL & DA
{ local r:8 = DA; accRound(r); ACCL = r; }
# FMT 0: the source has the accumulator format
:mtacc RA,fmt,acn is op=0xe8 & b23_16=1 & RA & fmt & fmtv=0 & acn & ACCL & DA
{
	local r:8 = DA;
	if (((fpe >> 9) & 3) != 1) goto <dbl>;
	r = float2float(RA);
	<dbl>
	accRound(r); ACCL = r;
}
:mfacc RC,fmt,acn is op=0xe9 & RC & b15_8=1 & fmt & fmtv=1 & acn & ACCL
{ RC = float2float(ACCL); }
:mfacc RC,fmt,acn is op=0xe9 & RC & b15_8=1 & fmt & fmtv=2 & acn & ACCL & RCT
{ local v:8 = ACCL; setD(RC, RCT, v); }
:mfacc RC,fmt,acn is op=0xe9 & RC & b15_8=1 & fmt & fmtv=0 & acn & ACCL & RCT
{
	local v:8 = ACCL;
	if (((fpe >> 9) & 3) == 1) goto <sgl>;
	setD(RC, RCT, v);
	goto <done>;
	<sgl>
	RC = float2float(v);
	<done>
}
