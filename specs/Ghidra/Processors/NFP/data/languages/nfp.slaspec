# ALU operands: field 0-9 is always bank A and field 10-19 bank B; bit 30 swaps which of
# them is the left (A) operand. The destination (field 20-29) is in the bank bit 36 names.
AOP: OSA0  is swap10=0 & OSA0  { export OSA0; }
AOP: OSB10 is swap10=1 & OSB10 { export OSB10; }
BOP: OSB10 is swap10=0 & OSB10 { export OSB10; }
BOP: OSA0  is swap10=1 & OSA0  { export OSA0; }
DST: ODA20 is dbank=0 & ODA20 { export ODA20; }
DST: ODB20 is dbank=1 & ODB20 { export ODB20; }
SA8: QSA0  is swap8=0 & QSA0  { export QSA0; }
SA8: QSB10 is swap8=1 & QSB10 { export QSB10; }
SB8: QSB10 is swap8=0 & QSB10 { export QSB10; }
SB8: QSA0  is swap8=1 & QSA0  { export QSA0; }
D8: QDA20 is dbank=0 & QDA20 { export QDA20; }
D8: QDB20 is dbank=1 & QDB20 { export QDB20; }
CCF: is nocc=1 { }
CCF: is nocc=0 { }

# alu[dst, A, op, B] (bits 39-37 = 101, operator in bits 31-35); bit 40 (no_cc) keeps the flags.
:alu "["^DST^", "^"--"^", B, "^BOP^"]" is cls3=5 & nocc=0 & aluop=0 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = b;
  
  nzflags(r);
  DST = r;
}
:alu "["^DST^", "^"--"^", B, "^BOP^"], no_cc" is cls3=5 & nocc=1 & aluop=0 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = b;
  DST = r;
}
:alu "["^DST^", "^AOP^", +, "^BOP^"]" is cls3=5 & nocc=0 & aluop=1 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = a + b;
  
  nzflags(r); CF = carry(a, b); VF = scarry(a, b);
  DST = r;
}
:alu "["^DST^", "^AOP^", +, "^BOP^"], no_cc" is cls3=5 & nocc=1 & aluop=1 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = a + b;
  DST = r;
}
:alu "["^DST^", "^"--"^", ~B, "^BOP^"]" is cls3=5 & nocc=0 & aluop=4 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = ~b;
  
  nzflags(r);
  DST = r;
}
:alu "["^DST^", "^"--"^", ~B, "^BOP^"], no_cc" is cls3=5 & nocc=1 & aluop=4 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = ~b;
  DST = r;
}
:alu "["^DST^", "^AOP^", AND, "^BOP^"]" is cls3=5 & nocc=0 & aluop=8 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = a & b;
  
  nzflags(r);
  DST = r;
}
:alu "["^DST^", "^AOP^", AND, "^BOP^"], no_cc" is cls3=5 & nocc=1 & aluop=8 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = a & b;
  DST = r;
}
:alu "["^DST^", "^AOP^", ~AND, "^BOP^"]" is cls3=5 & nocc=0 & aluop=12 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = ~a & b;
  
  nzflags(r);
  DST = r;
}
:alu "["^DST^", "^AOP^", ~AND, "^BOP^"], no_cc" is cls3=5 & nocc=1 & aluop=12 & DST & AOP & BOP {
  a:4 = AOP; b:4 = BOP; r:4 = ~a & b;
  DST = r;
