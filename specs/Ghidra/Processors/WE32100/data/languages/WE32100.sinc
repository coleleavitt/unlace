# PSW as an operand: flags composed from / split into C V Z N
macro pswget(o) {
  local cc:4 = zext(CF);
  local vv:4 = zext(VF);
  local zz:4 = zext(ZF);
  local nn:4 = zext(NF);
  o = psw | (cc << 18) | (vv << 19) | (zz << 20) | (nn << 21);
}
# write with the read-only fields (ET, TM, ISC, R: bits 0-6, 8) preserved
macro pswput(v) {
  psw = (psw & 0x17f) | (v & 0xffc3fe80);
  local f:4 = (v >> 18) & 1;
  CF = f:1;
  f = (v >> 19) & 1;
  VF = f:1;
  f = (v >> 20) & 1;
  ZF = f:1;
  f = (v >> 21) & 1;
  NF = f:1;
}
# write every field (context switches, gates, returns)
macro pswset(v) {
  psw = v & 0xffc3ffff;
  local f:4 = (v >> 18) & 1;
  CF = f:1;
  f = (v >> 19) & 1;
  VF = f:1;
  f = (v >> 20) & 1;
  ZF = f:1;
  f = (v >> 21) & 1;
  NF = f:1;
}

