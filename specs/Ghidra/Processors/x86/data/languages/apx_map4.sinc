# PUSH2 / POP2 (3.1.3.1.1): ND=1, Mod=3, EVEX.W is the PPX hint
:PUSH2 apxNDD64,Rmr64 is $(APX_MAP4) & apxND=1 & rexWprefix=0 & apxNDD64 & byte=0xff; mod=3 & reg_opcode=6 & Rmr64 { push88(apxNDD64); push88(Rmr64); }
:POP2 apxNDD64,Rmr64 is $(APX_MAP4) & apxND=1 & rexWprefix=0 & apxNDD64 & byte=0x8f; mod=3 & reg_opcode=0 & Rmr64 { pop88(apxNDD64); pop88(Rmr64); }
:PUSH2P apxNDD64,Rmr64 is $(APX_MAP4) & apxND=1 & rexWprefix=1 & apxNDD64 & byte=0xff; mod=3 & reg_opcode=6 & Rmr64 { push88(apxNDD64); push88(Rmr64); }
:POP2P apxNDD64,Rmr64 is $(APX_MAP4) & apxND=1 & rexWprefix=1 & apxNDD64 & byte=0x8f; mod=3 & reg_opcode=0 & Rmr64 { pop88(apxNDD64); pop88(Rmr64); }
# MOVBE (map-4 0x60/0x61, the register form included)
:MOVBE Reg16,rm16 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=0 & byte=0x60; rm16 & Reg16 ... { local v:2 = rm16; Reg16 = swap_bytes(v); }
:MOVBE rm16,Reg16 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=0 & byte=0x61; rm16 & Reg16 ... { local v:2 = Reg16; rm16 = swap_bytes(v); }
:MOVBE Reg32,rm32 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=1 & byte=0x60; rm32 & Reg32 ... & check_Reg32_dest ... { local v:4 = rm32; Reg32 = swap_bytes(v); build check_Reg32_dest; }
:MOVBE rm32,Reg32 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=1 & byte=0x61; rm32 & Reg32 ... & check_rm32_dest ... { local v:4 = Reg32; rm32 = swap_bytes(v); build check_rm32_dest; }
:MOVBE Reg64,rm64 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=2 & byte=0x60; rm64 & Reg64 ... { local v:8 = rm64; Reg64 = swap_bytes(v); }
:MOVBE rm64,Reg64 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=2 & byte=0x61; rm64 & Reg64 ... { local v:8 = Reg64; rm64 = swap_bytes(v); }
# ADCX (66) / ADOX (F3), map-4 0x66, with NDD
:ADCX Reg32,rm32 is $(APX_MAP4) & apxNF=0 & prefix_66=1 & rexWprefix=0 & apxND=0 & byte=0x66; rm32 & Reg32 ... & check_Reg32_dest ... { local t:5 = zext(Reg32) + zext(rm32) + zext(CF); local c:1 = t(4); CF = c != 0; local res:4 = t:4; Reg32 = res; build check_Reg32_dest; }
:ADCX apxNDD32,Reg32,rm32 is $(APX_MAP4) & apxNF=0 & prefix_66=1 & rexWprefix=0 & apxND=1 & apxNDD32 & apxNDD64 & byte=0x66; rm32 & Reg32 ... { local t:5 = zext(Reg32) + zext(rm32) + zext(CF); local c:1 = t(4); CF = c != 0; local res:4 = t:4; apxNDD64 = zext(res); }
:ADCX Reg64,rm64 is $(APX_MAP4) & apxNF=0 & prefix_66=1 & rexWprefix=1 & apxND=0 & byte=0x66; rm64 & Reg64 ... { local t:9 = zext(Reg64) + zext(rm64) + zext(CF); local c:1 = t(8); CF = c != 0; local res:8 = t:8; Reg64 = res; }
:ADCX apxNDD64,Reg64,rm64 is $(APX_MAP4) & apxNF=0 & prefix_66=1 & rexWprefix=1 & apxND=1 & apxNDD64 & byte=0x66; rm64 & Reg64 ... { local t:9 = zext(Reg64) + zext(rm64) + zext(CF); local c:1 = t(8); CF = c != 0; local res:8 = t:8; apxNDD64 = res; }
:ADOX Reg32,rm32 is $(APX_MAP4) & apxNF=0 & prefix_f3=1 & rexWprefix=0 & apxND=0 & byte=0x66; rm32 & Reg32 ... & check_Reg32_dest ... { local t:5 = zext(Reg32) + zext(rm32) + zext(OF); local c:1 = t(4); OF = c != 0; local res:4 = t:4; Reg32 = res; build check_Reg32_dest; }
:ADOX apxNDD32,Reg32,rm32 is $(APX_MAP4) & apxNF=0 & prefix_f3=1 & rexWprefix=0 & apxND=1 & apxNDD32 & apxNDD64 & byte=0x66; rm32 & Reg32 ... { local t:5 = zext(Reg32) + zext(rm32) + zext(OF); local c:1 = t(4); OF = c != 0; local res:4 = t:4; apxNDD64 = zext(res); }
:ADOX Reg64,rm64 is $(APX_MAP4) & apxNF=0 & prefix_f3=1 & rexWprefix=1 & apxND=0 & byte=0x66; rm64 & Reg64 ... { local t:9 = zext(Reg64) + zext(rm64) + zext(OF); local c:1 = t(8); OF = c != 0; local res:8 = t:8; Reg64 = res; }
:ADOX apxNDD64,Reg64,rm64 is $(APX_MAP4) & apxNF=0 & prefix_f3=1 & rexWprefix=1 & apxND=1 & apxNDD64 & byte=0x66; rm64 & Reg64 ... { local t:9 = zext(Reg64) + zext(rm64) + zext(OF); local c:1 = t(8); OF = c != 0; local res:8 = t:8; apxNDD64 = res; }
# CRC32 (map-4 0xF0/0xF1)
:CRC32 Reg32,rm8 is $(APX_MAP4) & apxND=0 & apxNF=0 & rexWprefix=0 & mandover=0 & byte=0xf0; rm8 & Reg32 ... & check_Reg32_dest ... { Reg32 = crc32(Reg32, rm8); build check_Reg32_dest; }
:CRC32 Reg64,rm8 is $(APX_MAP4) & apxND=0 & apxNF=0 & rexWprefix=1 & mandover=0 & byte=0xf0; rm8 & Reg64 ... { Reg64 = crc32(Reg64, rm8); }
:CRC32 Reg32,rm16 is $(APX_MAP4) & apxND=0 & apxNF=0 & opsize=0 & byte=0xf1; rm16 & Reg32 ... & check_Reg32_dest ... { Reg32 = crc32(Reg32, rm16); build check_Reg32_dest; }
:CRC32 Reg32,rm32 is $(APX_MAP4) & apxND=0 & apxNF=0 & opsize=1 & mandover=0 & byte=0xf1; rm32 & Reg32 ... & check_Reg32_dest ... { Reg32 = crc32(Reg32, rm32); build check_Reg32_dest; }
:CRC32 Reg64,rm64 is $(APX_MAP4) & apxND=0 & apxNF=0 & opsize=2 & byte=0xf1; rm64 & Reg64 ... { Reg64 = crc32(Reg64, rm64); }

# MOVDIR64B MOVDIRI INVEPT INVVPID INVPCID ENQCMD ENQCMDS WRSS WRUSS in map 4 (EGPR forms of the 0F38 instructions)
:MOVDIR64B Reg64, m512 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_66=1 & byte=0xf8; Reg64 ... & m512 { movdir64b(Reg64, m512); }
:MOVDIRI Mem,Reg32 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & prefix_66=0 & rexWprefix=0 & byte=0xf9; Mem & Reg32 ... { *Mem = Reg32; }
:MOVDIRI Mem,Reg64 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & prefix_66=0 & rexWprefix=1 & byte=0xf9; Mem & Reg64 ... { *Mem = Reg64; }
:INVEPT Reg64, m128 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_f3=1 & byte=0xf0; Reg64 ... & m128 { local status:4 = invept(Reg64, m128); vmxflags(status); }
:INVVPID Reg64, m128 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_f3=1 & byte=0xf1; Reg64 ... & m128 { local status:4 = invvpid(Reg64, m128); vmxflags(status); }
:INVPCID Reg64, m128 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_f3=1 & byte=0xf2; Reg64 ... & m128 { invpcid(Reg64, m128); }
:ENQCMD Reg64, m512 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_f2=1 & byte=0xf8; Reg64 ... & m512 { ZF = enqcmd(Reg64, m512); OF = 0; SF = 0; AF = 0; PF = 0; CF = 0; }
:ENQCMDS Reg64, m512 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_f3=1 & byte=0xf8; Reg64 ... & m512 { ZF = enqcmds(Reg64, m512); OF = 0; SF = 0; AF = 0; PF = 0; CF = 0; }
:WRSSD rm32,Reg32 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & prefix_66=0 & rexWprefix=0 & byte=0x66; rm32 & Reg32 ... { writeToShadowStack(rm32, Reg32); }
:WRSSQ rm64,Reg64 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & prefix_66=0 & rexWprefix=1 & byte=0x66; rm64 & Reg64 ... { writeToShadowStack(rm64, Reg64); }
:WRUSSD rm32,Reg32 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_66=1 & rexWprefix=0 & byte=0x65; rm32 & Reg32 ... { writeToUserShadowStack(rm32, Reg32); }
:WRUSSQ rm64,Reg64 is $(APX_MAP4) & apxND=0 & apxNF=0 & prefix_66=1 & rexWprefix=1 & byte=0x65; rm64 & Reg64 ... { writeToUserShadowStack(rm64, Reg64); }

# MUL IMUL DIV IDIV one-operand forms (F6/F7 /4-/7), from ia.sinc
:DIV rm8 is $(APX_MAP4) & apxND=0 & apxNF=0 & byte=0xf6; rm8 & reg_opcode=6 ...            { rm8ext:2 = zext(rm8);
                                                  local quotient = AX / rm8ext;  # DE exception if quotient doesn't fit in AL
                                                  local rem      = AX % rm8ext;
                                                  AL = quotient:1;
                                                  AH = rem:1; }
:DIV^".NF" rm8 is $(APX_MAP4) & apxND=0 & apxNF=1 & byte=0xf6; rm8 & reg_opcode=6 ...            { rm8ext:2 = zext(rm8);
                                                  local quotient = AX / rm8ext;  # DE exception if quotient doesn't fit in AL
                                                  local rem      = AX % rm8ext;
                                                  AL = quotient:1;
                                                  AH = rem:1; }
:DIV rm16 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=0 & byte=0xf7; rm16 & reg_opcode=6 ...    { rm16ext:4 = zext(rm16);
                                                  tmp:4 = (zext(DX) << 16) | zext(AX);   # DE exception if quotient doesn't fit in AX
                                                  local quotient = tmp / rm16ext;
                                                  AX = quotient:2;
                                                  local rem = tmp % rm16ext;
                                                  DX = rem:2; }
:DIV^".NF" rm16 is $(APX_MAP4) & apxND=0 & apxNF=1 & $(APX_PP_V) & opsize=0 & byte=0xf7; rm16 & reg_opcode=6 ...    { rm16ext:4 = zext(rm16);
                                                  tmp:4 = (zext(DX) << 16) | zext(AX);   # DE exception if quotient doesn't fit in AX
                                                  local quotient = tmp / rm16ext;
                                                  AX = quotient:2;
                                                  local rem = tmp % rm16ext;
                                                  DX = rem:2; }
:DIV rm32 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=1 & byte=0xf7; rm32 & check_EDX_dest ... & check_EAX_dest ... & reg_opcode=6 ...    { rm32ext:8 = zext(rm32);
                                                  tmp:8 = (zext(EDX) << 32) | zext(EAX); # DE exception if quotient doesn't fit in EAX
                                                  local quotient = tmp / rm32ext;
                                                  EAX = quotient:4;
                                                  build check_EAX_dest;
                                                  local rem = tmp % rm32ext;
                                                  EDX = rem:4;
                                                  build check_EDX_dest; }
:DIV^".NF" rm32 is $(APX_MAP4) & apxND=0 & apxNF=1 & $(APX_PP_V) & opsize=1 & byte=0xf7; rm32 & check_EDX_dest ... & check_EAX_dest ... & reg_opcode=6 ...    { rm32ext:8 = zext(rm32);
                                                  tmp:8 = (zext(EDX) << 32) | zext(EAX); # DE exception if quotient doesn't fit in EAX
                                                  local quotient = tmp / rm32ext;
                                                  EAX = quotient:4;
                                                  build check_EAX_dest;
                                                  local rem = tmp % rm32ext;
                                                  EDX = rem:4;
                                                  build check_EDX_dest; }
:DIV rm64 is $(LONGMODE_ON) & $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=2 & byte=0xf7; rm64 & reg_opcode=6 ...    { rm64ext:16 = zext(rm64);
                                                  tmp:16 = (zext(RDX) << 64) | zext(RAX); # DE exception if quotient doesn't fit in RAX
                                                  local quotient = tmp / rm64ext;
                                                  RAX = quotient:8;
                                                  local rem = tmp % rm64ext;
                                                  RDX = rem:8; }                                                  
:DIV^".NF" rm64 is $(LONGMODE_ON) & $(APX_MAP4) & apxND=0 & apxNF=1 & $(APX_PP_V) & opsize=2 & byte=0xf7; rm64 & reg_opcode=6 ...    { rm64ext:16 = zext(rm64);
                                                  tmp:16 = (zext(RDX) << 64) | zext(RAX); # DE exception if quotient doesn't fit in RAX
                                                  local quotient = tmp / rm64ext;
                                                  RAX = quotient:8;
                                                  local rem = tmp % rm64ext;
                                                  RDX = rem:8; }                                                  
:IDIV rm8 is $(APX_MAP4) & apxND=0 & apxNF=0 & byte=0xf6;  rm8 & reg_opcode=7 ...           { rm8ext:2 = sext(rm8);
                                                  local quotient = AX s/ rm8ext;  # DE exception if quotient doesn't fit in AL
                                                  local rem = AX s% rm8ext;
                                                  AL = quotient:1;
                                                  AH = rem:1; }
