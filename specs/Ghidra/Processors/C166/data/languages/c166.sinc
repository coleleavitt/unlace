macro Cpl(a) {
	local x = a;
	setPreFlagsAnd(x);
	local result = ~x;
	setPostFlags(result);
	a = result;
}

# CPL Rwn
:cpl rwn is ExtCountDec & op=0x91 & rwm=0 & rwn {
	Cpl(rwn);
}

