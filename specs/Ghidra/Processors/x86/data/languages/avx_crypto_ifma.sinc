# AVX-IFMA (VEX VPMADD52LUQ/HUQ), AVX-VNNI, SM3 and SHA512 (Intel SDM, Intel ISE). User operations; every form
# clears the destination above its vector length. Cross-checked with llvm-objdump (tools/x86_avx512_sweep.py).

define pcodeop vpmadd52luq_avxifma;
define pcodeop vpmadd52huq_avxifma;
:VPMADD52LUQ XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_XmmReg; byte=0xB4; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
{ local tmp:16 = vpmadd52luq_avxifma(XmmReg1, vexVVVV_XmmReg, XmmReg2_m128); ZmmReg1 = zext(tmp); }
:VPMADD52LUQ YmmReg1, vexVVVV_YmmReg, YmmReg2_m256 is $(VEX_NDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_YmmReg; byte=0xB4; (YmmReg1 & ZmmReg1) ... & YmmReg2_m256
{ local tmp:32 = vpmadd52luq_avxifma(YmmReg1, vexVVVV_YmmReg, YmmReg2_m256); ZmmReg1 = zext(tmp); }
:VPMADD52HUQ XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_XmmReg; byte=0xB5; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
{ local tmp:16 = vpmadd52huq_avxifma(XmmReg1, vexVVVV_XmmReg, XmmReg2_m128); ZmmReg1 = zext(tmp); }
:VPMADD52HUQ YmmReg1, vexVVVV_YmmReg, YmmReg2_m256 is $(VEX_NDS) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W1) & vexVVVV_YmmReg; byte=0xB5; (YmmReg1 & ZmmReg1) ... & YmmReg2_m256
{ local tmp:32 = vpmadd52huq_avxifma(YmmReg1, vexVVVV_YmmReg, YmmReg2_m256); ZmmReg1 = zext(tmp); }

define pcodeop vsm3msg1;
define pcodeop vsm3msg2;
define pcodeop vsm3rnds2;
:VSM3MSG1 XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_NONE) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_XmmReg; byte=0xDA; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
{ local tmp:16 = vsm3msg1(XmmReg1, vexVVVV_XmmReg, XmmReg2_m128); ZmmReg1 = zext(tmp); }
:VSM3MSG2 XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_XmmReg; byte=0xDA; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
{ local tmp:16 = vsm3msg2(XmmReg1, vexVVVV_XmmReg, XmmReg2_m128); ZmmReg1 = zext(tmp); }
:VSM3RNDS2 XmmReg1, vexVVVV_XmmReg, XmmReg2_m128, imm8 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F3A) & $(VEX_W0) & vexVVVV_XmmReg; byte=0xDE; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128; imm8
{ local tmp:16 = vsm3rnds2(XmmReg1, vexVVVV_XmmReg, XmmReg2_m128, imm8:1); ZmmReg1 = zext(tmp); }

define pcodeop vsha512msg1;
define pcodeop vsha512msg2;
define pcodeop vsha512rnds2;
:VSHA512MSG1 YmmReg1, XmmReg2 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_F2) & $(VEX_0F38) & vexVVVV=0 & $(VEX_W0); byte=0xCC; mod=3 & (YmmReg1 & ZmmReg1) & XmmReg2
{ local tmp:32 = vsha512msg1(YmmReg1, XmmReg2); ZmmReg1 = zext(tmp); }
:VSHA512MSG2 YmmReg1, YmmReg2 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_F2) & $(VEX_0F38) & vexVVVV=0 & $(VEX_W0); byte=0xCD; mod=3 & (YmmReg1 & ZmmReg1) & YmmReg2
{ local tmp:32 = vsha512msg2(YmmReg1, YmmReg2); ZmmReg1 = zext(tmp); }
