# Samsung SAM8 (S3C8 / S3F8 series) and SAM88RCRI (S3C9 / S3F9 series) 8-bit cores.
#
# Clean-room module written from the Samsung S3C8-series user's manual, chapter 6
# "Instruction Set" (opcode map table 6-5, condition codes table 6-6, per-instruction
# formats), and the S3C9454B/F9454B user's manual (SAM88RCRI register architecture and
# opcode map). Defining SAM88RCRI selects the reduced core.
#
# Address spaces
#   code  64K program memory (instruction fetch, LDC and its variants, CALL #IA vectors)
#   data  64K external data memory (LDE and its variants)
#   rf    the register file page 0: 00-BF and, on SAM8, set 2 (C0-FF) which is reached by
#         register-indirect, indexed, stack and working-register addressing
#   sr    SAM8 only: set 1, reached by direct 8-bit addressing of D0-FF. D0-DF is common,
#         E0-FF is bank 0 at sr:00E0-00FF and bank 1 at sr:01E0-01FF (FLAGS.BA, SB0/SB1)
#
# Working registers R0-R15: on SAM8, R0-R7 are the 8-byte slice at RP0 & F8 and R8-R15 the
# slice at RP1 & F8, both in rf. The context tracks RP0/RP1 when they are known (after SRP,
# SRP0, SRP1 and at the reset entry 0100, where RP0 = C0 and RP1 = C8); otherwise the
# address is computed from RP0/RP1 at run time. SAM88RCRI has no register pointers: its
# working registers are fixed at C0-CF.
#
# FLAGS (D5), RP0 (D6), RP1 (D7), SPH/SPL (D8/D9) and IPH/IPL (DA/DB) are registers; 8-bit
# register operands that name them directly are routed to them. C, Z, S, V, D and H are
# kept as separate flag registers and packed into FLAGS whenever FLAGS is read directly.

define endian=big;
define alignment=1;

define space code     type=ram_space      size=2  default;
define space data     type=ram_space      size=2;
define space rf       type=ram_space      size=1;
@ifndef SAM88RCRI
define space sr       type=ram_space      size=2;
@endif
define space register type=register_space size=2;

define register offset=0x00 size=2 [ SP IP ];
define register offset=0x00 size=1 [ SPH SPL IPH IPL ];
define register offset=0x10 size=2 [ PC ];
define register offset=0x20 size=1 [ C Z S V D H FLAGS RP0 RP1 ];

@ifndef SAM88RCRI
define register offset=0x40 size=4 [ contextreg ];
define context contextreg
	rp0v = (0,0)     # 1: RP0 below is known
	rp0  = (1,5)     # RP0[7:3]
	rp1v = (6,6)     # 1: RP1 below is known
	rp1  = (7,11)    # RP1[7:3]
	bank = (12,12)   # FLAGS.BA, set 1 bank for E0-FF
;
@endif

define token opbyte (8)
	op    = (0,7)
	ophi  = (4,7)
	oplo  = (0,3)
	ophis = (7,7)
	ophii = (4,6)
	ophin = (4,7)
	ophip = (4,7)
;
define token byte1 (8)
	b1    = (0,7)
	b1s   = (0,7) signed
	b1hi  = (4,7)
	b1lo  = (0,3)
	b1t3  = (5,7)
	b1his = (7,7)
	b1hii = (4,6)
	b1hin = (4,7)
	b1hip = (4,7)
	b1los = (3,3)
	b1loi = (0,2)
	b1lon = (0,3)
	b1lop = (0,3)
	b1bit = (1,3) dec
	b1dir = (0,0)
	b1lo0 = (0,0)
	b1pe  = (1,3)
	b1pi  = (1,2)
	b1lo2 = (0,1)
;
define token byte2 (8)
	b2    = (0,7)
	b2s   = (0,7) signed
	b2hi  = (4,7)
	b2lo  = (0,3)
	b2t3  = (5,7)
	b2los = (3,3)
	b2loi = (0,2)
	b2lon = (0,3)
	b2lop = (0,3)
;
define token byte3 (8)
	b3    = (0,7)
;
define token word16 (16)
	w16   = (0,15)
;

attach names [ ophin b1hin b1lon b2lon ] [ "R0" "R1" "R2" "R3" "R4" "R5" "R6" "R7" "R8" "R9" "R10" "R11" "R12" "R13" "R14" "R15" ];
attach names [ ophip b1hip b1lop b2lop ] [ "RR0" "RR1" "RR2" "RR3" "RR4" "RR5" "RR6" "RR7" "RR8" "RR9" "RR10" "RR11" "RR12" "RR13" "RR14" "RR15" ];
attach names [ b1pe ] [ "RR0" "RR2" "RR4" "RR6" "RR8" "RR10" "RR12" "RR14" ];

define pcodeop disableInterrupts;
define pcodeop enableInterrupts;
define pcodeop stop;
define pcodeop idle;
@ifndef SAM88RCRI
define pcodeop waitForInterrupt;
@endif

macro packflags() {
	FLAGS = (C << 7) | (Z << 6) | (S << 5) | (V << 4) | (D << 3) | (H << 2) | (FLAGS & 3);
}

macro unpackflags() {
	C = (FLAGS >> 7) & 1;
	Z = (FLAGS >> 6) & 1;
	S = (FLAGS >> 5) & 1;
	V = (FLAGS >> 4) & 1;
	D = (FLAGS >> 3) & 1;
	H = (FLAGS >> 2) & 1;
}

macro zs(r) {
	Z = (r == 0);
	S = (r s< 0);
}

# the system stack lives in the register file (SPL); a push pre-decrements
macro push8(v) {
	SPL = SPL - 1;
	*[rf]:1 SPL = v;
}
macro pop8(v) {
	v = *[rf]:1 SPL;
	SPL = SPL + 1;
}
macro push16(v) {
	SPL = SPL - 2;
	*[rf]:2 SPL = v;
}
macro pop16(v) {
	v = *[rf]:2 SPL;
	SPL = SPL + 2;
}

# relative branch targets
rel_b1: reloc is b1s [ reloc = inst_next + b1s; ] { export *:1 reloc; }
rel_b2: reloc is b2s [ reloc = inst_next + b2s; ] { export *:1 reloc; }
# direct address (JP, CALL), high byte first
dabs: w16 is w16 { export *:1 w16; }

# condition codes (table 6-6); 8 (always) is decoded as the unconditional form
cc: "F"   is ophi=0x0 { local t:1 = 0; export t; }
cc: "LT"  is ophi=0x1 { local t:1 = (S != V); export t; }
cc: "LE"  is ophi=0x2 { local t:1 = (Z != 0) || (S != V); export t; }
cc: "ULE" is ophi=0x3 { local t:1 = (C != 0) || (Z != 0); export t; }
cc: "OV"  is ophi=0x4 { local t:1 = (V != 0); export t; }
cc: "MI"  is ophi=0x5 { local t:1 = (S != 0); export t; }
cc: "Z"   is ophi=0x6 { local t:1 = (Z != 0); export t; }
cc: "C"   is ophi=0x7 { local t:1 = (C != 0); export t; }
cc: "GE"  is ophi=0x9 { local t:1 = (S == V); export t; }
cc: "GT"  is ophi=0xa { local t:1 = (Z == 0) && (S == V); export t; }
cc: "UGT" is ophi=0xb { local t:1 = (C == 0) && (Z == 0); export t; }
cc: "NOV" is ophi=0xc { local t:1 = (V == 0); export t; }
cc: "PL"  is ophi=0xd { local t:1 = (S == 0); export t; }
cc: "NZ"  is ophi=0xe { local t:1 = (Z == 0); export t; }
cc: "NC"  is ophi=0xf { local t:1 = (C == 0); export t; }

# working register ophi
@ifdef SAM88RCRI
Wr_ophi_a0: wa is ophi & ophin [ wa = 0xc0 | ophi; ] { export *[rf]:1 wa; }
Wr_ophi: ophin is ophi & ophin & Wr_ophi_a0 { export Wr_ophi_a0; }
Wrr_ophi_a1: wa is ophi & ophip [ wa = 0xc0 | ophi; ] { export *[rf]:2 wa; }
Wrr_ophi: ophip is ophi & ophip & Wrr_ophi_a1 { export Wrr_ophi_a1; }
@else
Wr_ophi_a2: wa is rp0v=1 & ophis=0 & ophii & ophin [ wa = (rp0 << 3) | ophii; ] { export *[rf]:1 wa; }
Wr_ophi: ophin is rp0v=1 & ophis=0 & ophii & ophin & Wr_ophi_a2 { export Wr_ophi_a2; }
Wr_ophi_a3: wa is rp1v=1 & ophis=1 & ophii & ophin [ wa = (rp1 << 3) | ophii; ] { export *[rf]:1 wa; }
Wr_ophi: ophin is rp1v=1 & ophis=1 & ophii & ophin & Wr_ophi_a3 { export Wr_ophi_a3; }
Wr_ophi: ophin is rp0v=0 & ophis=0 & ophii & ophin { local a:1 = (RP0 & 0xf8) | ophii; export *[rf]:1 a; }
Wr_ophi: ophin is rp1v=0 & ophis=1 & ophii & ophin { local a:1 = (RP1 & 0xf8) | ophii; export *[rf]:1 a; }
Wrr_ophi_a4: wa is rp0v=1 & ophis=0 & ophii & ophip [ wa = (rp0 << 3) | ophii; ] { export *[rf]:2 wa; }
Wrr_ophi: ophip is rp0v=1 & ophis=0 & ophii & ophip & Wrr_ophi_a4 { export Wrr_ophi_a4; }
Wrr_ophi_a5: wa is rp1v=1 & ophis=1 & ophii & ophip [ wa = (rp1 << 3) | ophii; ] { export *[rf]:2 wa; }
Wrr_ophi: ophip is rp1v=1 & ophis=1 & ophii & ophip & Wrr_ophi_a5 { export Wrr_ophi_a5; }
Wrr_ophi: ophip is rp0v=0 & ophis=0 & ophii & ophip { local a:1 = (RP0 & 0xf8) | ophii; export *[rf]:2 a; }
Wrr_ophi: ophip is rp1v=0 & ophis=1 & ophii & ophip { local a:1 = (RP1 & 0xf8) | ophii; export *[rf]:2 a; }
@endif
Ir_ophi: "@"^Wr_ophi is Wr_ophi { local p:1 = Wr_ophi; export *[rf]:1 p; }

# working register b1hi
@ifdef SAM88RCRI
Wr_b1hi_a6: wa is b1hi & b1hin [ wa = 0xc0 | b1hi; ] { export *[rf]:1 wa; }
Wr_b1hi: b1hin is b1hi & b1hin & Wr_b1hi_a6 { export Wr_b1hi_a6; }
Wrr_b1hi_a7: wa is b1hi & b1hip [ wa = 0xc0 | b1hi; ] { export *[rf]:2 wa; }
Wrr_b1hi: b1hip is b1hi & b1hip & Wrr_b1hi_a7 { export Wrr_b1hi_a7; }
@else
Wr_b1hi_a8: wa is rp0v=1 & b1his=0 & b1hii & b1hin [ wa = (rp0 << 3) | b1hii; ] { export *[rf]:1 wa; }
Wr_b1hi: b1hin is rp0v=1 & b1his=0 & b1hii & b1hin & Wr_b1hi_a8 { export Wr_b1hi_a8; }
Wr_b1hi_a9: wa is rp1v=1 & b1his=1 & b1hii & b1hin [ wa = (rp1 << 3) | b1hii; ] { export *[rf]:1 wa; }
Wr_b1hi: b1hin is rp1v=1 & b1his=1 & b1hii & b1hin & Wr_b1hi_a9 { export Wr_b1hi_a9; }
Wr_b1hi: b1hin is rp0v=0 & b1his=0 & b1hii & b1hin { local a:1 = (RP0 & 0xf8) | b1hii; export *[rf]:1 a; }
Wr_b1hi: b1hin is rp1v=0 & b1his=1 & b1hii & b1hin { local a:1 = (RP1 & 0xf8) | b1hii; export *[rf]:1 a; }
Wrr_b1hi_a10: wa is rp0v=1 & b1his=0 & b1hii & b1hip [ wa = (rp0 << 3) | b1hii; ] { export *[rf]:2 wa; }
Wrr_b1hi: b1hip is rp0v=1 & b1his=0 & b1hii & b1hip & Wrr_b1hi_a10 { export Wrr_b1hi_a10; }
Wrr_b1hi_a11: wa is rp1v=1 & b1his=1 & b1hii & b1hip [ wa = (rp1 << 3) | b1hii; ] { export *[rf]:2 wa; }
Wrr_b1hi: b1hip is rp1v=1 & b1his=1 & b1hii & b1hip & Wrr_b1hi_a11 { export Wrr_b1hi_a11; }
Wrr_b1hi: b1hip is rp0v=0 & b1his=0 & b1hii & b1hip { local a:1 = (RP0 & 0xf8) | b1hii; export *[rf]:2 a; }
Wrr_b1hi: b1hip is rp1v=0 & b1his=1 & b1hii & b1hip { local a:1 = (RP1 & 0xf8) | b1hii; export *[rf]:2 a; }
@endif
Ir_b1hi: "@"^Wr_b1hi is Wr_b1hi { local p:1 = Wr_b1hi; export *[rf]:1 p; }

# working register b1lo
@ifdef SAM88RCRI
Wr_b1lo_a12: wa is b1lo & b1lon [ wa = 0xc0 | b1lo; ] { export *[rf]:1 wa; }
Wr_b1lo: b1lon is b1lo & b1lon & Wr_b1lo_a12 { export Wr_b1lo_a12; }
Wrr_b1lo_a13: wa is b1lo & b1lop [ wa = 0xc0 | b1lo; ] { export *[rf]:2 wa; }
Wrr_b1lo: b1lop is b1lo & b1lop & Wrr_b1lo_a13 { export Wrr_b1lo_a13; }
@else
Wr_b1lo_a14: wa is rp0v=1 & b1los=0 & b1loi & b1lon [ wa = (rp0 << 3) | b1loi; ] { export *[rf]:1 wa; }
Wr_b1lo: b1lon is rp0v=1 & b1los=0 & b1loi & b1lon & Wr_b1lo_a14 { export Wr_b1lo_a14; }
Wr_b1lo_a15: wa is rp1v=1 & b1los=1 & b1loi & b1lon [ wa = (rp1 << 3) | b1loi; ] { export *[rf]:1 wa; }
Wr_b1lo: b1lon is rp1v=1 & b1los=1 & b1loi & b1lon & Wr_b1lo_a15 { export Wr_b1lo_a15; }
Wr_b1lo: b1lon is rp0v=0 & b1los=0 & b1loi & b1lon { local a:1 = (RP0 & 0xf8) | b1loi; export *[rf]:1 a; }
Wr_b1lo: b1lon is rp1v=0 & b1los=1 & b1loi & b1lon { local a:1 = (RP1 & 0xf8) | b1loi; export *[rf]:1 a; }
Wrr_b1lo_a16: wa is rp0v=1 & b1los=0 & b1loi & b1lop [ wa = (rp0 << 3) | b1loi; ] { export *[rf]:2 wa; }
Wrr_b1lo: b1lop is rp0v=1 & b1los=0 & b1loi & b1lop & Wrr_b1lo_a16 { export Wrr_b1lo_a16; }
Wrr_b1lo_a17: wa is rp1v=1 & b1los=1 & b1loi & b1lop [ wa = (rp1 << 3) | b1loi; ] { export *[rf]:2 wa; }
Wrr_b1lo: b1lop is rp1v=1 & b1los=1 & b1loi & b1lop & Wrr_b1lo_a17 { export Wrr_b1lo_a17; }
Wrr_b1lo: b1lop is rp0v=0 & b1los=0 & b1loi & b1lop { local a:1 = (RP0 & 0xf8) | b1loi; export *[rf]:2 a; }
Wrr_b1lo: b1lop is rp1v=0 & b1los=1 & b1loi & b1lop { local a:1 = (RP1 & 0xf8) | b1loi; export *[rf]:2 a; }
@endif
Ir_b1lo: "@"^Wr_b1lo is Wr_b1lo { local p:1 = Wr_b1lo; export *[rf]:1 p; }

# working register b2lo
@ifdef SAM88RCRI
Wr_b2lo_a18: wa is b2lo & b2lon [ wa = 0xc0 | b2lo; ] { export *[rf]:1 wa; }
Wr_b2lo: b2lon is b2lo & b2lon & Wr_b2lo_a18 { export Wr_b2lo_a18; }
Wrr_b2lo_a19: wa is b2lo & b2lop [ wa = 0xc0 | b2lo; ] { export *[rf]:2 wa; }
Wrr_b2lo: b2lop is b2lo & b2lop & Wrr_b2lo_a19 { export Wrr_b2lo_a19; }
@else
Wr_b2lo_a20: wa is rp0v=1 & b2los=0 & b2loi & b2lon [ wa = (rp0 << 3) | b2loi; ] { export *[rf]:1 wa; }
Wr_b2lo: b2lon is rp0v=1 & b2los=0 & b2loi & b2lon & Wr_b2lo_a20 { export Wr_b2lo_a20; }
Wr_b2lo_a21: wa is rp1v=1 & b2los=1 & b2loi & b2lon [ wa = (rp1 << 3) | b2loi; ] { export *[rf]:1 wa; }
Wr_b2lo: b2lon is rp1v=1 & b2los=1 & b2loi & b2lon & Wr_b2lo_a21 { export Wr_b2lo_a21; }
Wr_b2lo: b2lon is rp0v=0 & b2los=0 & b2loi & b2lon { local a:1 = (RP0 & 0xf8) | b2loi; export *[rf]:1 a; }
Wr_b2lo: b2lon is rp1v=0 & b2los=1 & b2loi & b2lon { local a:1 = (RP1 & 0xf8) | b2loi; export *[rf]:1 a; }
Wrr_b2lo_a22: wa is rp0v=1 & b2los=0 & b2loi & b2lop [ wa = (rp0 << 3) | b2loi; ] { export *[rf]:2 wa; }
Wrr_b2lo: b2lop is rp0v=1 & b2los=0 & b2loi & b2lop & Wrr_b2lo_a22 { export Wrr_b2lo_a22; }
Wrr_b2lo_a23: wa is rp1v=1 & b2los=1 & b2loi & b2lop [ wa = (rp1 << 3) | b2loi; ] { export *[rf]:2 wa; }
Wrr_b2lo: b2lop is rp1v=1 & b2los=1 & b2loi & b2lop & Wrr_b2lo_a23 { export Wrr_b2lo_a23; }
Wrr_b2lo: b2lop is rp0v=0 & b2los=0 & b2loi & b2lop { local a:1 = (RP0 & 0xf8) | b2loi; export *[rf]:2 a; }
Wrr_b2lo: b2lop is rp1v=0 & b2los=1 & b2loi & b2lop { local a:1 = (RP1 & 0xf8) | b2loi; export *[rf]:2 a; }
@endif
Ir_b2lo: "@"^Wr_b2lo is Wr_b2lo { local p:1 = Wr_b2lo; export *[rf]:1 p; }

# 8-bit register operand R in b1 (Cx = working register)
Rd_b1: b1 is b1 { export *[rf]:1 b1; }
Rd_b1: Wr_b1lo is b1hi=0xc & Wr_b1lo { export Wr_b1lo; }
Rd_b1: "FLAGS" is b1=0xd5 { packflags(); export FLAGS; }
Rd_b1: "SPL" is b1=0xd9 { export SPL; }
RRd_b1: b1 is b1 { export *[rf]:2 b1; }
RRd_b1: Wrr_b1lo is b1hi=0xc & Wrr_b1lo { export Wrr_b1lo; }
@ifndef SAM88RCRI
Rd_b1: b1 is b1hi=0xd & b1 { export *[sr]:1 b1; }
Rd_b1: b1 is bank=0 & b1t3=7 & b1 { export *[sr]:1 b1; }
Rd_b1_a24: sa is bank=1 & b1t3=7 & b1 [ sa = 0x100 | b1; ] { export *[sr]:1 sa; }
Rd_b1: b1 is bank=1 & b1t3=7 & b1 & Rd_b1_a24 { export Rd_b1_a24; }
Rd_b1: "RP0" is b1=0xd6 { export RP0; }
Rd_b1: "RP1" is b1=0xd7 { export RP1; }
Rd_b1: "SPH" is b1=0xd8 { export SPH; }
Rd_b1: "IPH" is b1=0xda { export IPH; }
Rd_b1: "IPL" is b1=0xdb { export IPL; }
RRd_b1: b1 is b1hi=0xd & b1 { export *[sr]:2 b1; }
RRd_b1: b1 is bank=0 & b1t3=7 & b1 { export *[sr]:2 b1; }
RRd_b1_a25: sa is bank=1 & b1t3=7 & b1 [ sa = 0x100 | b1; ] { export *[sr]:2 sa; }
RRd_b1: b1 is bank=1 & b1t3=7 & b1 & RRd_b1_a25 { export RRd_b1_a25; }
RRd_b1: "SP" is b1=0xd8 { export SP; }
RRd_b1: "IP" is b1=0xda { export IP; }
@endif
# fix-ups after a write to R in b1: FLAGS bits, register pointer tracking
Rpost_b1: is b1=0xd5 { unpackflags(); }
@ifndef SAM88RCRI
Rpost_b1: is b1=0xd6 [ rp0v = 0; globalset(inst_next, rp0v); ] { }
Rpost_b1: is b1=0xd7 [ rp1v = 0; globalset(inst_next, rp1v); ] { }
@endif
Rpost_b1: is b1 { }
IRd_b1: "@"^Rd_b1 is Rd_b1 { local p:1 = Rd_b1; export *[rf]:1 p; }
IRRd_b1: "@"^Rd_b1 is Rd_b1 { local p:1 = Rd_b1; export *[rf]:2 p; }

# 8-bit register operand R in b2 (Cx = working register)
Rd_b2: b2 is b2 { export *[rf]:1 b2; }
Rd_b2: Wr_b2lo is b2hi=0xc & Wr_b2lo { export Wr_b2lo; }
Rd_b2: "FLAGS" is b2=0xd5 { packflags(); export FLAGS; }
Rd_b2: "SPL" is b2=0xd9 { export SPL; }
RRd_b2: b2 is b2 { export *[rf]:2 b2; }
RRd_b2: Wrr_b2lo is b2hi=0xc & Wrr_b2lo { export Wrr_b2lo; }
@ifndef SAM88RCRI
Rd_b2: b2 is b2hi=0xd & b2 { export *[sr]:1 b2; }
Rd_b2: b2 is bank=0 & b2t3=7 & b2 { export *[sr]:1 b2; }
Rd_b2_a26: sa is bank=1 & b2t3=7 & b2 [ sa = 0x100 | b2; ] { export *[sr]:1 sa; }
Rd_b2: b2 is bank=1 & b2t3=7 & b2 & Rd_b2_a26 { export Rd_b2_a26; }
Rd_b2: "RP0" is b2=0xd6 { export RP0; }
Rd_b2: "RP1" is b2=0xd7 { export RP1; }
Rd_b2: "SPH" is b2=0xd8 { export SPH; }
Rd_b2: "IPH" is b2=0xda { export IPH; }
Rd_b2: "IPL" is b2=0xdb { export IPL; }
RRd_b2: b2 is b2hi=0xd & b2 { export *[sr]:2 b2; }
RRd_b2: b2 is bank=0 & b2t3=7 & b2 { export *[sr]:2 b2; }
RRd_b2_a27: sa is bank=1 & b2t3=7 & b2 [ sa = 0x100 | b2; ] { export *[sr]:2 sa; }
RRd_b2: b2 is bank=1 & b2t3=7 & b2 & RRd_b2_a27 { export RRd_b2_a27; }
RRd_b2: "SP" is b2=0xd8 { export SP; }
RRd_b2: "IP" is b2=0xda { export IP; }
@endif
# fix-ups after a write to R in b2: FLAGS bits, register pointer tracking
Rpost_b2: is b2=0xd5 { unpackflags(); }
@ifndef SAM88RCRI
Rpost_b2: is b2=0xd6 [ rp0v = 0; globalset(inst_next, rp0v); ] { }
Rpost_b2: is b2=0xd7 [ rp1v = 0; globalset(inst_next, rp1v); ] { }
@endif
Rpost_b2: is b2 { }
IRd_b2: "@"^Rd_b2 is Rd_b2 { local p:1 = Rd_b2; export *[rf]:1 p; }
