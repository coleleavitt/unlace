<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <char_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="prog"/>
    <range space="data"/>
    <range space="io"/>
  </global>
  <!-- No data stack: CALL/RET use the four-level hardware stack STK0-STK3. SP is a placeholder. -->
  <stackpointer register="SP" space="data" growth="negative"/>
  <returnaddress>
    <register name="STK0"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="ACC"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="ACC"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
