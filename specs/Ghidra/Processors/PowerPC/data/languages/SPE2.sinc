# SPE2 (Signal Processing Engine 2) and EFS2 for NXP e200z4/e200z7 (#98).
# Encodings: the SPE2/EFS2 rows of the binutils PowerPC opcode table (opcode, mask and
# operand fields only). Mnemonics and pcodeop names follow the SPE2 intrinsics (__ev_*).
# Exact: lane add/subtract/negate/abs/min/max, extends, splats, immediate adds, evsl/evsli,
# evmar, and the addressing of every load and store (immediate, indexed, update; the modulo
# "mx" forms read at rA and then advance rA through __circinc). A load or store whose lane
# arrangement the mnemonic does not fix moves its bytes through a named pcodeop.
# Everything else is a named pcodeop: an "a" suffix writes ACC, the "aa"/"an" forms also
# read ACC, and the "3" forms read rD instead of ACC.

define pcodeop __circinc;
define pcodeop __efdcfh;
define pcodeop __efdcth;
