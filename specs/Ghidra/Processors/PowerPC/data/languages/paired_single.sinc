	local s0:4 = float2float(fD);
	psq_store(PSQ_GQR, ea, s0);
	A = ea;
}

:psq_lx fD,RA_OR_ZERO,B,0,PSQX_I is $(NOTVLE) & OP=4 & fD & PSD1 & RA_OR_ZERO & B & PSQX_W=0 & PSQX_I & PSQX_IC=0 & PSQX_XO=6 {
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local v0:4 = *:4 ea;
	fD = float2float(v0);
	local v1:4 = *:4 (ea + 4);
	PSD1 = float2float(v1);
}

:psq_lx fD,RA_OR_ZERO,B,0,PSQX_I is $(NOTVLE) & OP=4 & fD & PSD1 & RA_OR_ZERO & B & PSQX_W=0 & PSQX_I & PSQX_GQR & PSQX_IC!=0 & PSQX_XO=6 {
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local q0:4 = psq_load(PSQX_GQR, ea, 0:1);
	fD = float2float(q0);
	local q1:4 = psq_load(PSQX_GQR, ea, 1:1);
	PSD1 = float2float(q1);
}

:psq_lx fD,RA_OR_ZERO,B,1,PSQX_I is $(NOTVLE) & OP=4 & fD & PSD1 & RA_OR_ZERO & B & PSQX_W=1 & PSQX_I & PSQX_IC=0 & PSQX_XO=6 {
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local v0:4 = *:4 ea;
	fD = float2float(v0);
	PSD1 = int2float(1:4);
}

:psq_lx fD,RA_OR_ZERO,B,1,PSQX_I is $(NOTVLE) & OP=4 & fD & PSD1 & RA_OR_ZERO & B & PSQX_W=1 & PSQX_I & PSQX_GQR & PSQX_IC!=0 & PSQX_XO=6 {
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local q0:4 = psq_load(PSQX_GQR, ea, 0:1);
	fD = float2float(q0);
