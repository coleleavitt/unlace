# ---------------------------------------------------------------- dsp32shift (register amount)
shd16: xdDL is xs_HLd=0 & xdDL { export xdDL; }
shd16: xdDH is xs_HLd=1 & xdDH { export xdDH; }
shs16: xdAL is xs_HLsrc=0 & xdAL { export xdAL; }
shs16: xdAH is xs_HLsrc=1 & xdAH { export xdAH; }
