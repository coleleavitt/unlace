<?xml version="1.0" encoding="UTF-8"?>

<!-- ZDS II style convention: arguments on the stack (one 3-byte slot each),
     results in A (8-bit) or HL (wider); IX is the frame pointer. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="3"/>
    <integer_size value="3"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="io"/>
  </global>
  <stackpointer register="SPL" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="3"/>
  </returnaddress>
  <default_proto>
    <prototype name="__zds" extrapop="3" stackshift="3">
      <input>
        <pentry minsize="1" maxsize="500" align="3">
          <addr offset="3" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="3">
          <register name="HL"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SPL"/>
        <register name="IX"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
