:CALL Cc1,JpHA is JpHA ; b1_hi4=0xd & Cc1 { if (!Cc1) goto inst_next; local t:2 = JpHA; push16(&:2 inst_next); call [t]; }
:JP Abs16 is b0=0xeb ; Abs16 ; b1=0xc8 { goto Abs16; }
:JP Cc1,Abs16 is b0=0xeb ; Abs16 ; b1_hi4=0xc & Cc1 { if (Cc1) goto Abs16; }
:CALL Abs16 is b0=0xeb ; Abs16 ; b1=0xd8 { push16(&:2 inst_next); call Abs16; }
:CALL Cc1,Abs16 is b0=0xeb ; Abs16 ; b1_hi4=0xd & Cc1 { if (!Cc1) goto inst_next; push16(&:2 inst_next); call Abs16; }

# ---- register group (F8-FE)
:MUL "HL",G8 is G8 ; b1=0x12 { HL = zext(L) * zext(G8); }
:DIV "HL",G8 is G8 ; b1=0x13 {
  local d:2 = zext(G8);
  if (d == 0) goto <dz>;
  local q:2 = HL / d;
  local r:2 = HL % d;
  fV = q > 0xff;
  L = q:1; H = r:1;
  goto inst_next;
<dz>
  fV = 1;
  HL = divideByZero(HL);
}
:ADD b1_ixs,G16 is G16 ; b1_hi6=0x05 & b1_ixs { add16r(b1_ixs, G16); }
:TSET b1_bit,G8 is G8 ; b1_hi5=0x03 & b1_bit { bitTest(G8, b1_bit); G8 = G8 | (1 << b1_bit); }
:LD b1_r8,G8 is G8 ; b1_hi5=0x06 & b1_r8 { b1_r8 = G8; }
:LD b1_r16,G16 is G16 ; b1_hi5=0x07 & b1_r16 { b1_r16 = G16; }
:BIT b1_bit,G8 is G8 ; b1_hi5=0x15 & b1_bit { bitTest(G8, b1_bit); }
:RES b1_bit,G8 is G8 ; b1_hi5=0x16 & b1_bit { G8 = G8 & ~(1 << b1_bit); }
:SET b1_bit,G8 is G8 ; b1_hi5=0x17 & b1_bit { G8 = G8 | (1 << b1_bit); }
:LDI is b0=0xfe ; b1=0x58 { *:1 DE = *:1 HL; DE = DE + 1; HL = HL + 1; BC = BC - 1; fH = 0; fN = 0; fV = BC != 0; }
:LDIR is b0=0xfe ; b1=0x59 { *:1 DE = *:1 HL; DE = DE + 1; HL = HL + 1; BC = BC - 1; fH = 0; fN = 0; fV = BC != 0; if (BC != 0) goto inst_start; }
:LDD is b0=0xfe ; b1=0x5a { *:1 DE = *:1 HL; DE = DE - 1; HL = HL - 1; BC = BC - 1; fH = 0; fN = 0; fV = BC != 0; }
:LDDR is b0=0xfe ; b1=0x5b { *:1 DE = *:1 HL; DE = DE - 1; HL = HL - 1; BC = BC - 1; fH = 0; fN = 0; fV = BC != 0; if (BC != 0) goto inst_start; }
:CPI is b0=0xfe ; b1=0x5c { local v:1 = *:1 HL; local a:1 = A; local fc:1 = fC; cp8(a, v); fC = fc; fX = 0; HL = HL + 1; BC = BC - 1; fV = BC != 0; }
:CPIR is b0=0xfe ; b1=0x5d { local v:1 = *:1 HL; local a:1 = A; local fc:1 = fC; cp8(a, v); fC = fc; fX = 0; HL = HL + 1; BC = BC - 1; fV = BC != 0; if (BC != 0 && fZ == 0) goto inst_start; }
:CPD is b0=0xfe ; b1=0x5e { local v:1 = *:1 HL; local a:1 = A; local fc:1 = fC; cp8(a, v); fC = fc; fX = 0; HL = HL - 1; BC = BC - 1; fV = BC != 0; }
:CPDR is b0=0xfe ; b1=0x5f { local v:1 = *:1 HL; local a:1 = A; local fc:1 = fC; cp8(a, v); fC = fc; fX = 0; HL = HL - 1; BC = BC - 1; fV = BC != 0; if (BC != 0 && fZ == 0) goto inst_start; }
:RET is b0=0xfe ; b1=0xd8 { local r:2 = 0; pop16(r); return [r]; }
:RET Cc1 is b0=0xfe ; b1_hi4=0xd & Cc1 { if (!Cc1) goto inst_next; local r:2 = 0; pop16(r); return [r]; }

