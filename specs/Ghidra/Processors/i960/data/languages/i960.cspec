<?xml version="1.0" encoding="UTF-8"?>

<!-- i960 C calling convention (Intel i960 Jx developer's manual 7.3 "Parameter Passing"; GCC's
     i960 back end and Intel's ic960 follow it): up to 12 parameters in g0-g11, results in g0-g3,
     the global registers are not preserved, the local registers r0-r15 are saved and restored by
     call/ret, fp (g15) is the frame pointer. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0" />
    <machine_alignment value="16" />
    <default_alignment value="1" />
    <default_pointer_alignment value="4" />
    <pointer_size value="4" />
    <short_size value="2" />
    <integer_size value="4" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" />
    <long_double_size value="16" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="2" />
      <entry size="4" alignment="4" />
      <entry size="8" alignment="8" />
      <entry size="16" alignment="16" />
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <!-- A procedure entered with call/callx returns with ret to the RIP saved in the caller's
       frame; a leaf procedure entered with bal/balx returns with bx through the address the link
       put in g14 (GCC's .leafproc entries copy g14 to another global first). -->
  <returnaddress>
    <register name="g14"/>
  </returnaddress>
  <!-- The stack grows toward higher addresses. At entry sp = fp + 64: the 64 bytes at fp hold the
       caller's register-set save area of the new frame, and locals follow. -->
  <stackpointer register="sp" space="ram" growth="positive"/>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="g0"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g1"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g2"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g3"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g4"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g5"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g6"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g7"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g8"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g9"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g10"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="g11"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="g0"/>
        </pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="g1" piece2="g0"/>
        </pentry>
        <pentry minsize="9" maxsize="12">
          <addr space="join" piece1="g2" piece2="g1" piece3="g0"/>
        </pentry>
        <pentry minsize="13" maxsize="16">
          <addr space="join" piece1="g3" piece2="g2" piece3="g1" piece4="g0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="pfp"/>
        <register name="sp"/>
        <register name="rip"/>
        <register name="r3"/>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r14"/>
        <register name="r15"/>
        <register name="fp"/>
      </unaffected>
      <killedbycall>
        <register name="g0"/>
        <register name="g1"/>
        <register name="g2"/>
        <register name="g3"/>
        <register name="g4"/>
        <register name="g5"/>
        <register name="g6"/>
        <register name="g7"/>
        <register name="g8"/>
        <register name="g9"/>
        <register name="g10"/>
        <register name="g11"/>
        <register name="g12"/>
        <register name="g13"/>
        <register name="g14"/>
        <register name="cc0"/>
        <register name="cc1"/>
        <register name="cc2"/>
      </killedbycall>
      <!-- The register-set save area below the entry sp (fp .. fp+63) belongs to this function:
           call stores the caller's r0-r15 there and the callee's ret reloads them, so the
           stores are dead in the caller. -->
      <localrange>
        <range space="stack" first="0xffffffc0" last="0xffffffff"/>
        <range space="stack" first="0x0" last="0x7fffffff"/>
      </localrange>
      <!-- At entry the processor has set sp = fp + 64. (call and callx restore the caller's pfp,
           sp and fp in p-code that follows the CALL op: the decompiler sees the state after the
           callee's ret, the emulator leaves the instruction at the CALL.) -->
      <pcode inject="uponentry">
        <body><![CDATA[
          fp = sp - 64;
        ]]></body>
      </pcode>
    </prototype>
  </default_proto>
</compiler_spec>
