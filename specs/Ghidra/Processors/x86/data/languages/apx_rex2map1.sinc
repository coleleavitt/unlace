# lockable.sinc:344
:BTC^lockx Mem,Reg16 is vexMode=3 & vexMMMMM=1 & lockx & unlock & opsize=0 & byte=0xbb; Mem & Reg16 ...		
{
    build lockx;
    build Mem;
    local ptr = Mem + (sext(Reg16) s>> 3);
    local bit=Reg16&7;
    local val = (*:1 ptr >> bit) & 1;
    *:1 ptr= *:1 ptr ^(1<<bit);
    CF=(val!=0);
    build unlock; 
}
# lockable.sinc:356
:BTC^lockx Mem,Reg32 is vexMode=3 & vexMMMMM=1 & lockx & unlock & opsize=1 & byte=0xbb; Mem & Reg32 ...		
{
    build lockx;
    build Mem;
    local ptr = Mem + (sext(Reg32) s>> 3);
    local bit=Reg32&7;
    local val = (*:1 ptr >> bit) & 1;
    *:1 ptr = *:1 ptr ^ (1<<bit);
    CF = (val != 0);
    build unlock;
