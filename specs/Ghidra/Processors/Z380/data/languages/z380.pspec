<?xml version="1.0" encoding="UTF-8"?>

<!-- Reset state: Native mode (XM=0), Word mode (LW=0). -->
<processor_spec>
  <programcounter register="PC"/>
  <context_data>
    <context_set space="ram">
      <set name="xm" val="0"/>
      <set name="lw" val="0"/>
    </context_set>
  </context_data>
  <default_symbols>
    <symbol name="RESET" address="ram:0x00000000" entry="true"/>
  </default_symbols>
</processor_spec>
