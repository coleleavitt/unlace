# alu_shf[dst, A, op, B, shift] (bits 39-37 = 100): B is rotated (sc 0), shifted right
# (sc 1) or left by 32 - n (sc 2) first; sc 3 is dbl_shf, the A:B pair shifted right.
SHB: SB8^", >>rot"^shift is sc=0 & shz!=0 & SB8 & shift { b:4 = SB8; r:4 = (b >> shift) | (b << (32 - shift)); export r; }
SHB: SB8 is sc=0 & shz=0 & SB8 { export SB8; }
SHB: SB8^", >>"^shift is sc=1 & shz!=0 & SB8 & shift { b:4 = SB8; r:4 = b >> shift; export r; }
SHB: SB8^", <<"^sl is sc=2 & shz!=0 & SB8 & shift [ sl = 32 - shift; ] { b:4 = SB8; r:4 = b << sl; export r; }
SHB: SB8^", indirect" is (sc=1 | sc=2) & shz=0 & SB8 { b:4 = SB8; r:4 = indirect_shift(b); export r; }

:alu_shf "["^D8^", "^"--"^", B, "^SHB^"]" is cls3=4 & shfop=0 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = b; nzflags(r);
  D8 = r;
}
:alu_shf "["^D8^", "^"--"^", B, "^SHB^"], no_cc" is cls3=4 & shfop=0 & sc!=3 & nocc=1 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = b; 
  D8 = r;
}
:alu_shf "["^D8^", "^"--"^", ~B, "^SHB^"]" is cls3=4 & shfop=1 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = ~b; nzflags(r);
  D8 = r;
}
:alu_shf "["^D8^", "^"--"^", ~B, "^SHB^"], no_cc" is cls3=4 & shfop=1 & sc!=3 & nocc=1 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = ~b; 
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", AND, "^SHB^"]" is cls3=4 & shfop=2 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = a & b; nzflags(r);
  D8 = r;
}
