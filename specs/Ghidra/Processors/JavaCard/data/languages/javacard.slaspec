}
:dup_x mhi, mlo is op=63 ; mhi & mlo {
  mm:1 = mhi; nn:1 = mlo; jc_dup_x(SP, mm, nn); SP = SP - mhi * 2;
}
:swap_x mhi, mlo is op=64 ; mhi & mlo {
  mm:1 = mhi; nn:1 = mlo; jc_swap_x(SP, mm, nn);
}
:sadd is op=65 {
