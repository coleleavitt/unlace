pushsrc: "A0.X" is pp_grp=4 & pp_reg=0 { local t:4 = sext(A0.X); export t; }
pushsrc: "A0.W" is pp_grp=4 & pp_reg=1 { export A0.W; }
pushsrc: "A1.X" is pp_grp=4 & pp_reg=2 { local t:4 = sext(A1.X); export t; }
pushsrc: "A1.W" is pp_grp=4 & pp_reg=3 { export A1.W; }
pushsrc: "ASTAT" is pp_grp=4 & pp_reg=6 { local t:4 = 0; packASTAT(t); export t; }
pushsrc: "RETS" is pp_grp=4 & pp_reg=7 { export RETS; }
pushsrc: "LC0" is pp_grp=6 & pp_reg=0 { export LC0; }
pushsrc: "LT0" is pp_grp=6 & pp_reg=1 { export LT0; }
pushsrc: "LB0" is pp_grp=6 & pp_reg=2 { export LB0; }
pushsrc: "LC1" is pp_grp=6 & pp_reg=3 { export LC1; }
pushsrc: "LT1" is pp_grp=6 & pp_reg=4 { export LT1; }
pushsrc: "LB1" is pp_grp=6 & pp_reg=5 { export LB1; }
pushsrc: "CYCLES" is pp_grp=6 & pp_reg=6 { export CYCLES; }
pushsrc: "CYCLES2" is pp_grp=6 & pp_reg=7 { export CYCLES2; }
pushsrc: "USP" is pp_grp=7 & pp_reg=0 { export USP; }
pushsrc: "SEQSTAT" is pp_grp=7 & pp_reg=1 { export SEQSTAT; }
pushsrc: "SYSCFG" is pp_grp=7 & pp_reg=2 { export SYSCFG; }
