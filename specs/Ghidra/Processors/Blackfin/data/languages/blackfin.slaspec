  xs_HLd = (29,29)
  xs_HLsrc = (28,28)
  xs_imm = (19,24)
  xs_imms = (19,24) signed
  xs_b8 = (24,24)
  xs_6_8 = (22,24)
  xm_h01 = (31,31)
  xm_h11 = (30,30)
  xm_w0 = (29,29)
  xm_op0 = (27,28)
  xm_h00 = (26,26)
  xm_h10 = (25,25)
  xdA = (16,18)
  xdA2 = (16,18)
  xdB2 = (19,21)
  xdB = (19,21)
  xdC = (22,24)
  xdD = (25,27)
  xdAL = (16,18)
  xdAH = (16,18)
  xdBL = (19,21)
  xdBH = (19,21)
  xdCL = (22,24)
  xdCH = (22,24)
  xdCp = (22,24)
  xdDL = (25,27)
  xdDH = (25,27)
;

attach variables [ dA dA2 dB dC e_dA xdA xdA2 xdB xdB2 xdC xdD ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ pA pA2 pB pC e_pA e_pB pmod_idx pmod_ptr x_lpreg ] [ P0 P1 P2 P3 P4 P5 SP FP ];
attach variables [ dAL dBL dCL pmod_regL xdAL xdBL xdCL xdDL ] [ R0.L R1.L R2.L R3.L R4.L R5.L R6.L R7.L ];
attach variables [ dAH dCH pmod_regH xdAH xdBH xdCH xdDH ] [ R0.H R1.H R2.H R3.H R4.H R5.H R6.H R7.H ];
attach variables [ pmod_reg ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ dBB ] [ R0.B R1.B R2.B R3.B R4.B R5.B R6.B R7.B ];
attach variables [ fp_reg ] [ R0 R1 R2 R3 R4 R5 R6 R7 P0 P1 P2 P3 P4 P5 SP FP ];
attach variables [ xdCp ] [ R1 R2 R3 R4 R5 R6 R7 R0 ];
attach variables [ dm_i dk_i dl_i ] [ I0 I1 I2 I3 ];
attach variables [ dm_m dl_mreg ] [ M0 M1 M2 M3 ];

define pcodeop idle;
define pcodeop csync;
define pcodeop ssync;
define pcodeop emuexcpt;
define pcodeop cli;
define pcodeop sti;
define pcodeop raise;
define pcodeop excpt;
define pcodeop prefetch;
define pcodeop flushinv;
define pcodeop flush;
define pcodeop iflush;
define pcodeop divq;
define pcodeop divs;
define pcodeop add_brev;
define pcodeop i_add_brev;
define pcodeop dsp_mult16;
define pcodeop dsp_mult32;
define pcodeop dsp_mac;
define pcodeop dsp_acc_extract;
define pcodeop dsp_acc_extract32;
define pcodeop dsp_alu;
define pcodeop dsp_alu_pair;
define pcodeop dsp_alu_half;
define pcodeop dsp_acc_op;
define pcodeop dsp_shift;
define pcodeop dsp_shift_half;
define pcodeop dsp_shift_acc;
define pcodeop sat_shift;
define pcodeop rot_cc;
define pcodeop signbits;
define pcodeop ones;
define pcodeop expadj;
define pcodeop bitmux;
define pcodeop vit_max;
define pcodeop extract;
define pcodeop deposit;
define pcodeop bxor;

macro addflags(a, b, r) {
  AZ = r == 0; AN = r s< 0; AC0 = carry(a, b); V = scarry(a, b);
  AC0_COPY = AC0; V_COPY = V; VS = VS | V;
}
macro subflags(a, b, r) {
  AZ = r == 0; AN = r s< 0; AC0 = a >= b; V = sborrow(a, b);
  AC0_COPY = AC0; V_COPY = V; VS = VS | V;
}
macro nzflags(r) { AZ = r == 0; AN = r s< 0; }
macro logflags(r) { AZ = r == 0; AN = r s< 0; AC0 = 0; AC0_COPY = 0; V = 0; V_COPY = 0; }
macro packASTAT(t) {
  t = zext(AZ) | (zext(AN) << 1) | (zext(AC0_COPY) << 2) | (zext(V_COPY) << 3) | (zext(CC) << 5)
    | (zext(AQ) << 6) | (zext(RND_MOD) << 8) | (zext(AC0) << 12) | (zext(AC1) << 13)
    | (zext(AV0) << 16) | (zext(AV0S) << 17) | (zext(AV1) << 18) | (zext(AV1S) << 19)
    | (zext(V) << 24) | (zext(VS) << 25);
}
macro unpackASTAT(t) {
  AZ = (t & 0x1) != 0; AN = (t & 0x2) != 0; AC0_COPY = (t & 0x4) != 0; V_COPY = (t & 0x8) != 0;
  CC = (t & 0x20) != 0; AQ = (t & 0x40) != 0; RND_MOD = (t & 0x100) != 0;
  AC0 = (t & 0x1000) != 0; AC1 = (t & 0x2000) != 0; AV0 = (t & 0x10000) != 0;
  AV0S = (t & 0x20000) != 0; AV1 = (t & 0x40000) != 0; AV1S = (t & 0x80000) != 0;
  V = (t & 0x1000000) != 0; VS = (t & 0x2000000) != 0;
}
macro push(v) { SP = SP - 4; *:4 SP = v; }
macro pop(v) { v = *:4 SP; SP = SP + 4; }
macro sat32(a, b, r) {
  local ov:1 = scarry(a, b);
  local lim:4 = 0x7fffffff + zext(a s< 0);
  r = (zext(ov == 0) * (a + b)) + (zext(ov) * lim);
}
macro satsub32(a, b, r) {
  local ov:1 = sborrow(a, b);
  local lim:4 = 0x7fffffff + zext(a s< 0);
  r = (zext(ov == 0) * (a - b)) + (zext(ov) * lim);
}

c_popr: "" is poprnd { export *[const]:1 poprnd; }
c_opc: "" is d_opc { export *[const]:1 d_opc; }
c_imms: "" is xs_imms { export *[const]:1 xs_imms; }

# ---------------------------------------------------------------- ProgCtrl
ins16: "NOP" is op16=0x0000 { }
ins16: "RTS" is op16=0x0010 { return [RETS]; }
ins16: "RTI" is op16=0x0011 { return [RETI]; }
ins16: "RTX" is op16=0x0012 { return [RETX]; }
ins16: "RTN" is op16=0x0013 { return [RETN]; }
ins16: "RTE" is op16=0x0014 { return [RETE]; }
ins16: "IDLE" is op16=0x0020 { idle(); }
ins16: "CSYNC" is op16=0x0023 { csync(); }
ins16: "SSYNC" is op16=0x0024 { ssync(); }
ins16: "EMUEXCPT" is op16=0x0025 { emuexcpt(); }
ins16: "CLI" dA is op8=0 & prgfunc=3 & poprnd3=0 & dA { dA = cli(); }
ins16: "STI" dA is op8=0 & prgfunc=4 & poprnd3=0 & dA { sti(dA); }
ins16: "JUMP ("^pA^")" is op8=0 & prgfunc=5 & poprnd3=0 & pA { goto [pA]; }
ins16: "CALL ("^pA^")" is op8=0 & prgfunc=6 & poprnd3=0 & pA { RETS = inst_next; call [pA]; }
ins16: "CALL (PC + "^pA^")" is op8=0 & prgfunc=7 & poprnd3=0 & pA { RETS = inst_next; local t:4 = inst_start + pA; call [t]; }
ins16: "JUMP (PC + "^pA^")" is op8=0 & prgfunc=8 & poprnd3=0 & pA { local t:4 = inst_start + pA; goto [t]; }
ins16: "RAISE" poprnd is op8=0 & prgfunc=9 & poprnd & c_popr { raise(c_popr); }
ins16: "EXCPT" poprnd is op8=0 & prgfunc=10 & poprnd & c_popr { excpt(c_popr); }
ins16: "TESTSET ("^pA^")" is op8=0 & prgfunc=11 & poprnd3=0 & pA {
  local t:1 = *:1 pA; CC = t == 0; *:1 pA = t | 0x80;
}

# ---------------------------------------------------------------- CaCTRL
ins16: "PREFETCH["^pA^"]" is op10=0x009 & ca_a=0 & ca_op=0 & pA { prefetch(pA); }
ins16: "FLUSHINV["^pA^"]" is op10=0x009 & ca_a=0 & ca_op=1 & pA { flushinv(pA); }
ins16: "FLUSH["^pA^"]" is op10=0x009 & ca_a=0 & ca_op=2 & pA { flush(pA); }
ins16: "IFLUSH["^pA^"]" is op10=0x009 & ca_a=0 & ca_op=3 & pA { iflush(pA); }
ins16: "PREFETCH["^pA^"++]" is op10=0x009 & ca_a=1 & ca_op=0 & pA { prefetch(pA); pA = pA + 32; }
ins16: "FLUSHINV["^pA^"++]" is op10=0x009 & ca_a=1 & ca_op=1 & pA { flushinv(pA); pA = pA + 32; }
ins16: "FLUSH["^pA^"++]" is op10=0x009 & ca_a=1 & ca_op=2 & pA { flush(pA); pA = pA + 32; }
ins16: "IFLUSH["^pA^"++]" is op10=0x009 & ca_a=1 & ca_op=3 & pA { iflush(pA); pA = pA + 32; }

# ---------------------------------------------------------------- PushPopReg
