    local xb:32 = YmmReg2_m256;
    local xd:32 = YmmReg1;
    local xs0:8 = sext(xd[0,32]) + sext(xa[0,16]) * sext(xb[0,16]) + sext(xa[16,16]) * sext(xb[16,16]);
    xd[0,32] = (xs0:4) * zext((xs0 s<= 0x7fffffff) && (xs0 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs0 s> 0x7fffffff) + 0x80000000 * zext(xs0 s< sext(0x80000000:4));
    local xs1:8 = sext(xd[32,32]) + sext(xa[32,16]) * sext(xb[32,16]) + sext(xa[48,16]) * sext(xb[48,16]);
    xd[32,32] = (xs1:4) * zext((xs1 s<= 0x7fffffff) && (xs1 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs1 s> 0x7fffffff) + 0x80000000 * zext(xs1 s< sext(0x80000000:4));
    local xs2:8 = sext(xd[64,32]) + sext(xa[64,16]) * sext(xb[64,16]) + sext(xa[80,16]) * sext(xb[80,16]);
    xd[64,32] = (xs2:4) * zext((xs2 s<= 0x7fffffff) && (xs2 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs2 s> 0x7fffffff) + 0x80000000 * zext(xs2 s< sext(0x80000000:4));
    local xs3:8 = sext(xd[96,32]) + sext(xa[96,16]) * sext(xb[96,16]) + sext(xa[112,16]) * sext(xb[112,16]);
    xd[96,32] = (xs3:4) * zext((xs3 s<= 0x7fffffff) && (xs3 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs3 s> 0x7fffffff) + 0x80000000 * zext(xs3 s< sext(0x80000000:4));
    local xs4:8 = sext(xd[128,32]) + sext(xa[128,16]) * sext(xb[128,16]) + sext(xa[144,16]) * sext(xb[144,16]);
    xd[128,32] = (xs4:4) * zext((xs4 s<= 0x7fffffff) && (xs4 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs4 s> 0x7fffffff) + 0x80000000 * zext(xs4 s< sext(0x80000000:4));
    local xs5:8 = sext(xd[160,32]) + sext(xa[160,16]) * sext(xb[160,16]) + sext(xa[176,16]) * sext(xb[176,16]);
    xd[160,32] = (xs5:4) * zext((xs5 s<= 0x7fffffff) && (xs5 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs5 s> 0x7fffffff) + 0x80000000 * zext(xs5 s< sext(0x80000000:4));
    local xs6:8 = sext(xd[192,32]) + sext(xa[192,16]) * sext(xb[192,16]) + sext(xa[208,16]) * sext(xb[208,16]);
    xd[192,32] = (xs6:4) * zext((xs6 s<= 0x7fffffff) && (xs6 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs6 s> 0x7fffffff) + 0x80000000 * zext(xs6 s< sext(0x80000000:4));
    local xs7:8 = sext(xd[224,32]) + sext(xa[224,16]) * sext(xb[224,16]) + sext(xa[240,16]) * sext(xb[240,16]);
    xd[224,32] = (xs7:4) * zext((xs7 s<= 0x7fffffff) && (xs7 s>= sext(0x80000000:4))) + 0x7fffffff * zext(xs7 s> 0x7fffffff) + 0x80000000 * zext(xs7 s< sext(0x80000000:4));
    ZmmReg1 = zext(xd);
}
