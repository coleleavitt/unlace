target triple = "x86_64-unknown-linux-gnu"

module asm ".text"
module asm ".globl probe"
module asm ".type probe,@function"
module asm "probe:"
module asm "ldtilecfg (%rdi)"
module asm "sttilecfg (%rsi)"
module asm "tilezero %tmm3"
module asm "tileloadd (%rax,%rcx,1), %tmm0"
module asm "tileloaddt1 (%rdx,%rbx,1), %tmm5"
module asm "tilestored %tmm7, (%rdi,%rsi,1)"
module asm "tdpbssd %tmm2, %tmm1, %tmm0"
module asm "tdpbsud %tmm2, %tmm1, %tmm0"
module asm "tdpbusd %tmm2, %tmm1, %tmm0"
module asm "tdpbuud %tmm2, %tmm1, %tmm0"
module asm "tdpbf16ps %tmm5, %tmm4, %tmm3"
module asm "tdpfp16ps %tmm5, %tmm4, %tmm3"
module asm "tcmmimfp16ps %tmm7, %tmm6, %tmm1"
module asm "tcmmrlfp16ps %tmm7, %tmm6, %tmm1"
module asm "tilerelease"
module asm ".size probe, .-probe"
module asm ".globl kernel"
module asm ".type kernel,@function"
module asm "kernel:"
module asm "ldtilecfg (%rdi)"
module asm "tilezero %tmm0"
module asm "tileloadd (%rsi,%rdx,1), %tmm1"
module asm "tileloadd (%rcx,%rdx,1), %tmm2"
module asm "tdpbssd %tmm2, %tmm1, %tmm0"
module asm "tilestored %tmm0, (%r8,%rdx,1)"
module asm "tilerelease"
module asm "retq"
module asm ".size kernel, .-kernel"
