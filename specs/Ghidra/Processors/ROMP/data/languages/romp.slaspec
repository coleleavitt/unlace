# SLEIGH specification for the IBM ROMP (RT PC processor). Written for unlace
# from the IBM RT PC Hardware Technical Reference, Volume I (75X0232, 1987);
# encodings and corner cases cross-checked against MAME's romp core
# (BSD-3-Clause, read only).

define endian=big;
define alignment=2;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x000 size=4 [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
define register offset=0x100 size=4 [ scr0 scr1 scr2 scr3 scr4 scr5 cous cou ts ecr mq mpcs irb iar ics cs ];
define register offset=0x200 size=4 [ PC ];
define register offset=0x210 size=1 [ LT EQ GT CY OV TB CS2 ];

define token h16(16)
  op4=(12,15) op8=(8,15) ra=(4,7) rb=(0,3) ras=(4,7) rbs=(0,3) ri=(0,3) rx=(8,11)
  ra7=(7,7) bit6=(6,6) bit5=(5,5) bit4=(4,4)
  jbit=(11,11) jcond=(8,10) jdisp=(0,7) signed i4=(8,11)
;
define token w32(32)
  wop8=(24,31) wra=(20,23) wrb=(16,19) wras=(20,23) w7=(23,23) w6=(22,22) w5=(21,21) w4=(20,20)
  wi16=(0,15) wsi16=(0,15) signed wd20=(0,19) signed wba=(0,23)
;

attach variables [ ra rb rx wra wrb ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ ras ] [ scr0 scr1 scr2 scr3 scr4 scr5 cous cou ts ecr mq mpcs irb iar ics cs ];

define pcodeop svc;
define pcodeop load_program_status;
define pcodeop io_read;
define pcodeop io_write;
define pcodeop program_trap;
define pcodeop wait_state;
define pcodeop read_scr;
define pcodeop write_scr;

macro logf(r) { LT = r s< 0; EQ = r == 0; GT = r s> 0; }
macro addf(a, b, cin) {
  local s1:4 = a + b; local r:4 = s1 + zext(cin);
  logf(r); CY = carry(a, b) || carry(s1, zext(cin));
  OV = ((~(a ^ b) & (a ^ r)) s< 0);
}
macro subf(a, b) { local r:4 = a - b; logf(r); CY = a >= b; OV = sborrow(a, b); }
macro packcs(v) { v = zext(CS2 != 0) << 2 | zext(LT) << 6 | zext(EQ) << 5 | zext(GT) << 4 | zext(CY) << 3 | zext(OV) << 1 | zext(TB); }
macro unpackcs(v) { LT = (v & 0x40) != 0; EQ = (v & 0x20) != 0; GT = (v & 0x10) != 0; CY = (v & 8) != 0; CS2 = (v & 4) != 0; OV = (v & 2) != 0; TB = (v & 1) != 0; }

# Condition bits 8-15 of the condition status: 8 is the permanent zero, 13 reserved.
cb: "nop" is ra=8 { export 0:1; }
cb: "lt" is ra=9 { export LT; }
cb: "eq" is ra=10 { export EQ; }
cb: "gt" is ra=11 { export GT; }
cb: "c" is ra=12 { export CY; }
cb: "13" is ra=13 { export CS2; }
cb: "o" is ra=14 { export OV; }
cb: "tb" is ra=15 { export TB; }
wcb: "nop" is wra=8 { export 0:1; }
wcb: "lt" is wra=9 { export LT; }
wcb: "eq" is wra=10 { export EQ; }
wcb: "gt" is wra=11 { export GT; }
wcb: "c" is wra=12 { export CY; }
wcb: "13" is wra=13 { export CS2; }
wcb: "o" is wra=14 { export OV; }
wcb: "tb" is wra=15 { export TB; }
jc: "nop" is jcond=0 { export 0:1; }
jc: "lt" is jcond=1 { export LT; }
jc: "eq" is jcond=2 { export EQ; }
jc: "gt" is jcond=3 { export GT; }
jc: "c" is jcond=4 { export CY; }
jc: "13" is jcond=5 { export CS2; }
jc: "o" is jcond=6 { export OV; }
jc: "tb" is jcond=7 { export TB; }

jrel: addr is jdisp [ addr = inst_start + jdisp * 2; ] { export *:4 addr; }
brel: addr is wd20 [ addr = inst_start + wd20 * 2; ] { export *:4 addr; }
babs: addr is wba [ addr = wba & 0xfffffe; ] { export *:4 addr; }

base: rb is rb { export rb; }
base: "0" is rb & rb=0 { export 0:4; }
wbase: wrb is wrb { export wrb; }
wbase: "0" is wrb & wrb=0 { export 0:4; }

# JI: jump on (not) condition bit; bit 11 is the value that jumps.
:j^jc jrel is op4=0 & jbit=1 & jc & jrel { if (jc) goto jrel; }
:jn^jc jrel is op4=0 & jbit=0 & jc & jrel { if (!jc) goto jrel; }
:j jrel is op4=0 & jbit=0 & jcond=0 & jrel { goto jrel; }

# DS: short displacement loads and stores
:stcs ra, i4^"("^base^")" is op4=1 & ra & i4 & base { local a:4 = base + i4; *:1 a = ra:1; }
:sths ra, d^"("^base^")" is op4=2 & ra & i4 & base [ d = i4 * 2; ] { local a:4 = base + d; *:2 a = ra:2; }
:sts ra, d^"("^base^")" is op4=3 & ra & i4 & base [ d = i4 * 4; ] { local a:4 = base + d; *:4 a = ra; }
:lcs ra, i4^"("^base^")" is op4=4 & ra & i4 & base { local a:4 = base + i4; ra = zext(*:1 a); }
:lhas ra, d^"("^base^")" is op4=5 & ra & i4 & base [ d = i4 * 2; ] { local a:4 = base + d; ra = sext(*:2 a); }
:cas rx, ra, base is op4=6 & rx & ra & base { rx = ra + base; }
:ls ra, d^"("^base^")" is op4=7 & ra & i4 & base [ d = i4 * 4; ] { local a:4 = base + d; ra = *:4 a; }

# BI/BA: branches with 20-bit relative or 24-bit absolute targets; x forms execute the next instruction.
:b brel is wop8=0x88 & wra=8 & brel { goto brel; }
:bnx brel is wop8=0x89 & wra=8 & brel { delayslot(1); goto brel; }
:bn^wcb brel is wop8=0x88 & w7=1 & wcb & brel { if (!wcb) goto brel; }
:bn^wcb^"x" brel is wop8=0x89 & w7=1 & wcb & brel { local c:1 = wcb; delayslot(1); if (!c) goto brel; }
:bala babs is wop8=0x8a & babs { r15 = inst_next; call babs; }
:balax babs is wop8=0x8b & babs { r15 = inst_next + 4; delayslot(1); call babs; }
:bali wra, brel is wop8=0x8c & wra & brel { wra = inst_next; call brel; }
:balix wra, brel is wop8=0x8d & wra & brel { wra = inst_next + 4; delayslot(1); call brel; }
:b^wcb brel is wop8=0x8e & w7=1 & wcb & brel { if (wcb) goto brel; }
:b^wcb^"x" brel is wop8=0x8f & w7=1 & wcb & brel { local c:1 = wcb; delayslot(1); if (c) goto brel; }

# D: 16-bit immediate or displacement
:svc wi16^"("^wbase^")" is wop8=0xc0 & wi16 & wbase { svc(wbase + wi16); }
:ai wra, wrb, wsi16 is wop8=0xc1 & wra & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; addf(a, b, 0:1); wra = a + b; }
:cal16 wra, wi16^"("^wbase^")" is wop8=0xc2 & wra & wi16 & wbase { local v:4 = wbase; wra = (v & 0xffff0000) | zext(v:2 + wi16:2); }
:oiu wra, wrb, wi16 is wop8=0xc3 & wra & wrb & wi16 { local r:4 = (wi16 << 16) | wrb; wra = r; logf(r); }
:oil wra, wrb, wi16 is wop8=0xc4 & wra & wrb & wi16 { local r:4 = wi16 | wrb; wra = r; logf(r); }
:nilz wra, wrb, wi16 is wop8=0xc5 & wra & wrb & wi16 { local r:4 = wi16 & wrb; wra = r; logf(r); }
:nilo wra, wrb, wi16 is wop8=0xc6 & wra & wrb & wi16 { local r:4 = (wi16 | 0xffff0000) & wrb; wra = r; logf(r); }
:xil wra, wrb, wi16 is wop8=0xc7 & wra & wrb & wi16 { local r:4 = wi16 ^ wrb; wra = r; logf(r); }
:cal wra, wsi16^"("^wbase^")" is wop8=0xc8 & wra & wsi16 & wbase { wra = wbase + wsi16; }
:lha wra, wsi16^"("^wbase^")" is wop8=0xca & wra & wsi16 & wbase { local a:4 = wbase + wsi16; wra = sext(*:2 a); }
:ior wra, wi16^"("^wbase^")" is wop8=0xcb & wra & wi16 & wbase { wra = io_read(wbase + wi16); }
:l wra, wsi16^"("^wbase^")" is wop8=0xcd & wra & wsi16 & wbase { local a:4 = wbase + wsi16; wra = *:4 a; }
:lc wra, wsi16^"("^wbase^")" is wop8=0xce & wra & wsi16 & wbase { local a:4 = wbase + wsi16; wra = zext(*:1 a); }
:tsh wra, wsi16^"("^wbase^")" is wop8=0xcf & wra & wsi16 & wbase { local a:4 = wbase + wsi16; local v:2 = *:2 a; *:2 a = v | 0xff00; wra = zext(v); }
:lps wras, wsi16^"("^wbase^")" is wop8=0xd0 & wras & wsi16 & wbase { local a:4 = wbase + wsi16; local t:4 = *:4 a; local csv:2 = *:2 (a + 6); local v:4 = zext(csv); unpackcs(v); load_program_status(a); return [t]; }
:aei wra, wrb, wsi16 is wop8=0xd1 & wra & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = CY; addf(a, b, c); wra = a + b + zext(c); }
:sfi wra, wrb, wsi16 is wop8=0xd2 & wra & wrb & wsi16 { local a:4 = wsi16; local b:4 = wrb; subf(a, b); wra = a - b; }
:cli wrb, wsi16 is wop8=0xd3 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; LT = a < b; EQ = a == b; GT = a > b; }
:ci wrb, wsi16 is wop8=0xd4 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; LT = a s< b; EQ = a == b; GT = a s> b; }
:niuz wra, wrb, wi16 is wop8=0xd5 & wra & wrb & wi16 { local r:4 = (wi16 << 16) & wrb; wra = r; logf(r); }
:niuo wra, wrb, wi16 is wop8=0xd6 & wra & wrb & wi16 { local r:4 = ((wi16 << 16) | 0xffff) & wrb; wra = r; logf(r); }
:xiu wra, wrb, wi16 is wop8=0xd7 & wra & wrb & wi16 { local r:4 = (wi16 << 16) ^ wrb; wra = r; logf(r); }
:cau wra, wi16^"("^wbase^")" is wop8=0xd8 & wra & wi16 & wbase { wra = wbase + (wi16 << 16); }
:lh wra, wsi16^"("^wbase^")" is wop8=0xda & wra & wsi16 & wbase { local a:4 = wbase + wsi16; wra = zext(*:2 a); }
:iow wra, wi16^"("^wbase^")" is wop8=0xdb & wra & wi16 & wbase { io_write(wbase + wi16, wra); }
:sth wra, wsi16^"("^wbase^")" is wop8=0xdc & wra & wsi16 & wbase { local a:4 = wbase + wsi16; *:2 a = wra:2; }
:st wra, wsi16^"("^wbase^")" is wop8=0xdd & wra & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 a = wra; }
:stc wra, wsi16^"("^wbase^")" is wop8=0xde & wra & wsi16 & wbase { local a:4 = wbase + wsi16; *:1 a = wra:1; }
:tnop wrb, wsi16 is wop8=0xcc & w6=0 & w5=0 & w4=0 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = 0:1; if (!c) goto inst_next; program_trap(); }
:tigt wrb, wsi16 is wop8=0xcc & w6=0 & w5=0 & w4=1 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a > b); if (!c) goto inst_next; program_trap(); }
:tieq wrb, wsi16 is wop8=0xcc & w6=0 & w5=1 & w4=0 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a == b); if (!c) goto inst_next; program_trap(); }
:tige wrb, wsi16 is wop8=0xcc & w6=0 & w5=1 & w4=1 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a == b) || (a > b); if (!c) goto inst_next; program_trap(); }
:tilt wrb, wsi16 is wop8=0xcc & w6=1 & w5=0 & w4=0 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a < b); if (!c) goto inst_next; program_trap(); }
:tine wrb, wsi16 is wop8=0xcc & w6=1 & w5=0 & w4=1 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a < b) || (a > b); if (!c) goto inst_next; program_trap(); }
:tile wrb, wsi16 is wop8=0xcc & w6=1 & w5=1 & w4=0 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a < b) || (a == b); if (!c) goto inst_next; program_trap(); }
:trap wrb, wsi16 is wop8=0xcc & w6=1 & w5=1 & w4=1 & wrb & wsi16 { local a:4 = wrb; local b:4 = wsi16; local c:1 = (a < b) || (a == b) || (a > b); if (!c) goto inst_next; program_trap(); }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=0 & wsi16 & wbase { local a:4 = wbase + wsi16; r0 = *:4 (a + 0); r1 = *:4 (a + 4); r2 = *:4 (a + 8); r3 = *:4 (a + 12); r4 = *:4 (a + 16); r5 = *:4 (a + 20); r6 = *:4 (a + 24); r7 = *:4 (a + 28); r8 = *:4 (a + 32); r9 = *:4 (a + 36); r10 = *:4 (a + 40); r11 = *:4 (a + 44); r12 = *:4 (a + 48); r13 = *:4 (a + 52); r14 = *:4 (a + 56); r15 = *:4 (a + 60); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=0 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r0; *:4 (a + 4) = r1; *:4 (a + 8) = r2; *:4 (a + 12) = r3; *:4 (a + 16) = r4; *:4 (a + 20) = r5; *:4 (a + 24) = r6; *:4 (a + 28) = r7; *:4 (a + 32) = r8; *:4 (a + 36) = r9; *:4 (a + 40) = r10; *:4 (a + 44) = r11; *:4 (a + 48) = r12; *:4 (a + 52) = r13; *:4 (a + 56) = r14; *:4 (a + 60) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=1 & wsi16 & wbase { local a:4 = wbase + wsi16; r1 = *:4 (a + 0); r2 = *:4 (a + 4); r3 = *:4 (a + 8); r4 = *:4 (a + 12); r5 = *:4 (a + 16); r6 = *:4 (a + 20); r7 = *:4 (a + 24); r8 = *:4 (a + 28); r9 = *:4 (a + 32); r10 = *:4 (a + 36); r11 = *:4 (a + 40); r12 = *:4 (a + 44); r13 = *:4 (a + 48); r14 = *:4 (a + 52); r15 = *:4 (a + 56); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=1 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r1; *:4 (a + 4) = r2; *:4 (a + 8) = r3; *:4 (a + 12) = r4; *:4 (a + 16) = r5; *:4 (a + 20) = r6; *:4 (a + 24) = r7; *:4 (a + 28) = r8; *:4 (a + 32) = r9; *:4 (a + 36) = r10; *:4 (a + 40) = r11; *:4 (a + 44) = r12; *:4 (a + 48) = r13; *:4 (a + 52) = r14; *:4 (a + 56) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=2 & wsi16 & wbase { local a:4 = wbase + wsi16; r2 = *:4 (a + 0); r3 = *:4 (a + 4); r4 = *:4 (a + 8); r5 = *:4 (a + 12); r6 = *:4 (a + 16); r7 = *:4 (a + 20); r8 = *:4 (a + 24); r9 = *:4 (a + 28); r10 = *:4 (a + 32); r11 = *:4 (a + 36); r12 = *:4 (a + 40); r13 = *:4 (a + 44); r14 = *:4 (a + 48); r15 = *:4 (a + 52); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=2 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r2; *:4 (a + 4) = r3; *:4 (a + 8) = r4; *:4 (a + 12) = r5; *:4 (a + 16) = r6; *:4 (a + 20) = r7; *:4 (a + 24) = r8; *:4 (a + 28) = r9; *:4 (a + 32) = r10; *:4 (a + 36) = r11; *:4 (a + 40) = r12; *:4 (a + 44) = r13; *:4 (a + 48) = r14; *:4 (a + 52) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=3 & wsi16 & wbase { local a:4 = wbase + wsi16; r3 = *:4 (a + 0); r4 = *:4 (a + 4); r5 = *:4 (a + 8); r6 = *:4 (a + 12); r7 = *:4 (a + 16); r8 = *:4 (a + 20); r9 = *:4 (a + 24); r10 = *:4 (a + 28); r11 = *:4 (a + 32); r12 = *:4 (a + 36); r13 = *:4 (a + 40); r14 = *:4 (a + 44); r15 = *:4 (a + 48); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=3 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r3; *:4 (a + 4) = r4; *:4 (a + 8) = r5; *:4 (a + 12) = r6; *:4 (a + 16) = r7; *:4 (a + 20) = r8; *:4 (a + 24) = r9; *:4 (a + 28) = r10; *:4 (a + 32) = r11; *:4 (a + 36) = r12; *:4 (a + 40) = r13; *:4 (a + 44) = r14; *:4 (a + 48) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=4 & wsi16 & wbase { local a:4 = wbase + wsi16; r4 = *:4 (a + 0); r5 = *:4 (a + 4); r6 = *:4 (a + 8); r7 = *:4 (a + 12); r8 = *:4 (a + 16); r9 = *:4 (a + 20); r10 = *:4 (a + 24); r11 = *:4 (a + 28); r12 = *:4 (a + 32); r13 = *:4 (a + 36); r14 = *:4 (a + 40); r15 = *:4 (a + 44); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=4 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r4; *:4 (a + 4) = r5; *:4 (a + 8) = r6; *:4 (a + 12) = r7; *:4 (a + 16) = r8; *:4 (a + 20) = r9; *:4 (a + 24) = r10; *:4 (a + 28) = r11; *:4 (a + 32) = r12; *:4 (a + 36) = r13; *:4 (a + 40) = r14; *:4 (a + 44) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=5 & wsi16 & wbase { local a:4 = wbase + wsi16; r5 = *:4 (a + 0); r6 = *:4 (a + 4); r7 = *:4 (a + 8); r8 = *:4 (a + 12); r9 = *:4 (a + 16); r10 = *:4 (a + 20); r11 = *:4 (a + 24); r12 = *:4 (a + 28); r13 = *:4 (a + 32); r14 = *:4 (a + 36); r15 = *:4 (a + 40); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=5 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r5; *:4 (a + 4) = r6; *:4 (a + 8) = r7; *:4 (a + 12) = r8; *:4 (a + 16) = r9; *:4 (a + 20) = r10; *:4 (a + 24) = r11; *:4 (a + 28) = r12; *:4 (a + 32) = r13; *:4 (a + 36) = r14; *:4 (a + 40) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=6 & wsi16 & wbase { local a:4 = wbase + wsi16; r6 = *:4 (a + 0); r7 = *:4 (a + 4); r8 = *:4 (a + 8); r9 = *:4 (a + 12); r10 = *:4 (a + 16); r11 = *:4 (a + 20); r12 = *:4 (a + 24); r13 = *:4 (a + 28); r14 = *:4 (a + 32); r15 = *:4 (a + 36); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=6 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r6; *:4 (a + 4) = r7; *:4 (a + 8) = r8; *:4 (a + 12) = r9; *:4 (a + 16) = r10; *:4 (a + 20) = r11; *:4 (a + 24) = r12; *:4 (a + 28) = r13; *:4 (a + 32) = r14; *:4 (a + 36) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=7 & wsi16 & wbase { local a:4 = wbase + wsi16; r7 = *:4 (a + 0); r8 = *:4 (a + 4); r9 = *:4 (a + 8); r10 = *:4 (a + 12); r11 = *:4 (a + 16); r12 = *:4 (a + 20); r13 = *:4 (a + 24); r14 = *:4 (a + 28); r15 = *:4 (a + 32); }
:stm wra, wsi16^"("^wbase^")" is wop8=0xd9 & wra & wra=7 & wsi16 & wbase { local a:4 = wbase + wsi16; *:4 (a + 0) = r7; *:4 (a + 4) = r8; *:4 (a + 8) = r9; *:4 (a + 12) = r10; *:4 (a + 16) = r11; *:4 (a + 20) = r12; *:4 (a + 24) = r13; *:4 (a + 28) = r14; *:4 (a + 32) = r15; }
:lm wra, wsi16^"("^wbase^")" is wop8=0xc9 & wra & wra=8 & wsi16 & wbase { local a:4 = wbase + wsi16; r8 = *:4 (a + 0); r9 = *:4 (a + 4); r10 = *:4 (a + 8); r11 = *:4 (a + 12); r12 = *:4 (a + 16); r13 = *:4 (a + 20); r14 = *:4 (a + 24); r15 = *:4 (a + 28); }
