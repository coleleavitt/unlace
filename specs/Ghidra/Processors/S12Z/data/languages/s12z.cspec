<?xml version="1.0" encoding="UTF-8"?>

<!-- NXP S12Z. JSR/BSR push a 3-byte return address and RTS pops it. The default model
     follows the CodeWarrior S12Z register convention as far as it is public: the first
     argument and the result in D2 (16-bit) or D6 (32-bit), further arguments on the stack. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="1"/>
    <pointer_size value="3"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="3"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asm" extrapop="3" stackshift="3" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="D2"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <register name="D6"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="3" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="D2"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <register name="D6"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
      <killedbycall>
        <register name="fC"/>
        <register name="fV"/>
        <register name="fZ"/>
        <register name="fN"/>
        <register name="fH"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
