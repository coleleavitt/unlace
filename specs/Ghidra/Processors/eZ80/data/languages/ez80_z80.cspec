<?xml version="1.0" encoding="UTF-8"?>

<!-- ZDS II style convention: arguments on the stack (one 2-byte slot each),
     results in A (8-bit) or HL (wider); IX is the frame pointer. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="io"/>
  </global>
  <stackpointer register="SPS" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__zds" extrapop="2" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="2">
          <register name="HLs"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SPS"/>
        <register name="IXs"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
