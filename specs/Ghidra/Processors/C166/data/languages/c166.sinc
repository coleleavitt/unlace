macro Compare(a, b) {
	setPreFlagsSub(a, b);
	setPostFlags((a - b));
}

# CMP Rwn, Rwm
:cmp rwn, rwm is ExtCountDec & op=0x40 & rwn & rwm {
	Compare(rwn, rwm);
}

