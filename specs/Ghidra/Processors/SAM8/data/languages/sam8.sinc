:ADC Wr_b1hi, Wr_b1lo is op=0x12; Wr_b1hi & Wr_b1lo {
	local d:1 = Wr_b1hi;
	local s:1 = Wr_b1lo;
	local c:1 = C;
	local r:1 = d + s + c;
