<!--

kuna_atomics (option atomics, docs/spec/02-lift-and-flow.md): a RISC-V AMO lifts to one __sync
builtin. Hand-encoded RV64A instructions, each followed by ret:
  amo_add:  amoadd.w a0, a1, (a0)
  amo_swap: amoswap.d.aqrl a0, a1, (a0)
  amo_or:   amoor.w zero, a1, (a0)
  amo_max:  amomax.w a0, a1, (a0)   (min/max forms are declined)
-->
<binaryimage arch="RISCV:LE:64:default">
<bytechunk space="ram" offset="0x100000" readonly="true">2f25b50067800000</bytechunk>
<symbol space="ram" offset="0x100000" name="amo_add"/>
<bytechunk space="ram" offset="0x100010" readonly="true">2f35b50e67800000</bytechunk>
<symbol space="ram" offset="0x100010" name="amo_swap"/>
<bytechunk space="ram" offset="0x100020" readonly="true">2f20b54067800000</bytechunk>
<symbol space="ram" offset="0x100020" name="amo_or"/>
<bytechunk space="ram" offset="0x100030" readonly="true">2f25b5a067800000</bytechunk>
<symbol space="ram" offset="0x100030" name="amo_max"/>
</binaryimage>
<script>
<com>option atomics auto</com>
<com>load function amo_add</com>
<com>decompile</com>
<com>print C</com>
<com>load function amo_swap</com>
<com>decompile</com>
<com>print C</com>
<com>load function amo_or</com>
<com>decompile</com>
<com>print C</com>
<com>load function amo_max</com>
<com>decompile</com>
<com>print C</com>
</script>
<stringmatch name="amoadd.w" min="1" max="1">^  return __sync_fetch_and_add\(\w+,\w+\);$</stringmatch>
<stringmatch name="amoswap.d" min="1" max="1">^  return __sync_lock_test_and_set\(\w+,\w+\);$</stringmatch>
<stringmatch name="amoor.w into zero" min="1" max="1">^  __sync_fetch_and_or\(\w+,\w+\);$</stringmatch>
<stringmatch name="amomax.w is declined" min="3" max="3">__sync_</stringmatch>
</decompilertest>
