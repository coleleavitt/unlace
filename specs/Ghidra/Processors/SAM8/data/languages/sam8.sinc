:ADD Wr_b1hi, Wr_b1lo is op=0x02; Wr_b1hi & Wr_b1lo {
	local d:1 = Wr_b1hi;
	local s:1 = Wr_b1lo;
	local r:1 = d + s;
	C = carry(d, s);
	V = scarry(d, s);
	H = ((d & 0xf) + (s & 0xf)) > 0xf;
	D = 0;
	zs(r);
	Wr_b1hi = r;
}
