# Toshiba TLCS-870 (TMP87xx) 8-bit microcontroller family.
#
# Sources: Toshiba TLCS-870 Series data books (instruction set chapter), and MAME
# src/devices/cpu/tlcs870 (tlcs870d.cpp, tlcs870_ops*.cpp; BSD-3-Clause) for decode and flags.
# Clean-room: written from those public descriptions; no existing community SLEIGH module was used.
#
# Registers A,W,C,B,E,D,L,H (pairs WA,BC,DE,HL) live in the current RAM register bank on the
# real part; they are modelled as plain registers here (LD RBS,n is a named pcodeop).
# PSW = JF ZF CF HF (bits 7..4). JF is the "jump status" flag tested by JRS T/F and JR T/F.

define endian=little;
define alignment=1;
define space ram type=ram_space size=2 default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ A W C B E D L H ];
define register offset=0x00 size=2 [ WA BC DE HL ];
define register offset=0x10 size=2 [ IX IY SP PC ];
define register offset=0x20 size=1 [ JF ZF CF HF RBS ];

define token op8 (8)
  op = (0,7)
  op_hi5 = (3,7)
  op_hi4 = (4,7)
  op_hi3 = (5,7)
  op_hi6 = (2,7)
  r3 = (0,2)
  rr2 = (0,1)
  b3 = (0,2)
  cc3 = (0,2)
  alu3 = (0,2)
  vec4 = (0,3)
  sd5 = (0,4) signed
;
define token imm8 (8)
  n8 = (0,7)
  s8 = (0,7) signed
;
define token imm16 (16)
  n16 = (0,15)
;

attach variables r3 [ A W C B E D L H ];
attach variables rr2 [ WA BC DE HL ];

define pcodeop swi;
define pcodeop set_register_bank;
define pcodeop daa;
define pcodeop das;

macro setPSW(v) { JF = (v & 0x80) != 0; ZF = (v & 0x40) != 0; CF = (v & 0x20) != 0; HF = (v & 0x10) != 0; }
macro getPSW(v) { v = (JF << 7) | (ZF << 6) | (CF << 5) | (HF << 4); }
macro push16(v) { SP = SP - 2; *:2 SP = v; }
macro pop16(v) { v = *:2 SP; SP = SP + 2; }

macro addflags(a, b) {
  HF = ((a & 0xf) + (b & 0xf)) > 0xf;
  CF = carry(a, b);
}
macro subflags(a, b) {
  HF = (a & 0xf) < (b & 0xf);
  CF = a < b;
}

Imm8: "#"^n8 is n8 { export *[const]:1 n8; }
Imm16: "#"^n16 is n16 { export *[const]:2 n16; }
Dir: "("^n8^")" is n8 { export *:1 n8; }
Dir16: "("^n8^")" is n8 { export *:2 n8; }

# ---- control / misc ----
:NOP is op=0x00 { }
:SWAP "A" is op=0x01 { A = (A << 4) | (A >> 4); }
:MUL "W","A" is op=0x02 { WA = zext(W) * zext(A); ZF = W == 0; JF = ZF; }
:DIV "WA","C" is op=0x03 {
  local d:2 = zext(C);
  CF = d == 0;
  local q:2 = WA / d; local rm:2 = WA % d;
  if (CF) goto <z>;
  CF = q > 0xff; A = q:1; W = rm:1;
  <z>
  ZF = A == 0; JF = CF;
}
:RETI is op=0x04 { local t:2; pop16(t); local p:1 = *:1 SP; SP = SP + 1; setPSW(p); return [t]; }
:RET is op=0x05 { local t:2; pop16(t); return [t]; }
:POP "PSW" is op=0x06 { local p:1 = *:1 SP; SP = SP + 1; setPSW(p); }
:PUSH "PSW" is op=0x07 { local p:1; getPSW(p); SP = SP - 1; *:1 SP = p; }
:DAA "A" is op=0x0a { A = daa(A, CF, HF); CF = daa(CF); ZF = A == 0; JF = CF; }
:DAS "A" is op=0x0b { A = das(A, CF, HF); CF = das(CF); ZF = A == 0; JF = CF; }
:CLR "CF" is op=0x0c { CF = 0; JF = 1; }
:SET "CF" is op=0x0d { CF = 1; JF = 0; }
:CPL "CF" is op=0x0e { CF = !CF; JF = CF; }
:LD "RBS",Imm8 is op=0x0f; Imm8 { RBS = Imm8; set_register_bank(Imm8); JF = 1; }

# ---- 16-bit register ops ----
:INC rr2 is op_hi6=0x04 & rr2 { rr2 = rr2 + 1; ZF = rr2 == 0; JF = ZF; }
:LD rr2,Imm16 is op_hi6=0x05 & rr2; Imm16 { rr2 = Imm16; JF = 1; }
:DEC rr2 is op_hi6=0x06 & rr2 { JF = rr2 == 0; rr2 = rr2 - 1; ZF = rr2 == 0; }

# ---- shifts on A ----
:SHLC "A" is op=0x1c { CF = (A & 0x80) != 0; A = A << 1; ZF = A == 0; JF = CF; }
:SHRC "A" is op=0x1d { CF = (A & 1) != 0; A = A >> 1; ZF = A == 0; JF = CF; }
:ROLC "A" is op=0x1e { local c:1 = CF; CF = (A & 0x80) != 0; A = (A << 1) | c; ZF = A == 0; JF = CF; }
:RORC "A" is op=0x1f { local c:1 = CF; CF = (A & 1) != 0; A = (A >> 1) | (c << 7); ZF = A == 0; JF = CF; }

# ---- direct / (HL) memory ----
:INC Dir is op=0x20; Dir { Dir = Dir + 1; ZF = Dir == 0; JF = ZF; }
:INC "(HL)" is op=0x21 { local t:1 = *:1 HL + 1; *:1 HL = t; ZF = t == 0; JF = ZF; }
:LD "A",Dir is op=0x22; Dir { A = Dir; ZF = A == 0; JF = 1; }
:LD "A","(HL)" is op=0x23 { A = *:1 HL; ZF = A == 0; JF = 1; }
:LDW Dir16,Imm16 is op=0x24; Dir16; Imm16 { Dir16 = Imm16; JF = 1; }
:LDW "(HL)",Imm16 is op=0x25; Imm16 { *:2 HL = Imm16; JF = 1; }
DirS: "("^n8^")" is n8 { export *:1 n8; }
:LD Dir,DirS is op=0x26; DirS; Dir { Dir = DirS; ZF = Dir == 0; JF = 1; }
:DEC Dir is op=0x28; Dir { JF = Dir == 0; Dir = Dir - 1; ZF = Dir == 0; }
:DEC "(HL)" is op=0x29 { local t:1 = *:1 HL; JF = t == 0; t = t - 1; *:1 HL = t; ZF = t == 0; }
:LD Dir,"A" is op=0x2a; Dir { Dir = A; ZF = A == 0; JF = 1; }
:LD "(HL)","A" is op=0x2b { *:1 HL = A; JF = 1; }
:LD Dir,Imm8 is op=0x2c; Dir; Imm8 { Dir = Imm8; JF = 1; }
:LD "(HL)",Imm8 is op=0x2d; Imm8 { *:1 HL = Imm8; JF = 1; }
:CLR Dir is op=0x2e; Dir { Dir = 0; JF = 1; }
:CLR "(HL)" is op=0x2f { *:1 HL = 0; JF = 1; }

# ---- 8-bit register ops ----
:LD r3,Imm8 is op_hi5=0x06 & r3; Imm8 { r3 = Imm8; JF = 1; }
:SET Dir^"."^b3 is op_hi5=0x08 & b3; Dir { local m:1 = 1 << b3; ZF = (Dir & m) == 0; JF = ZF; Dir = Dir | m; }
:CLR Dir^"."^b3 is op_hi5=0x09 & b3; Dir { local m:1 = 1 << b3; ZF = (Dir & m) == 0; JF = ZF; Dir = Dir & ~m; }
:LD "A",r3 is op_hi5=0x0a & r3 { A = r3; ZF = A == 0; JF = 1; }
:LD r3,"A" is op_hi5=0x0b & r3 { r3 = A; ZF = A == 0; JF = 1; }
:INC r3 is op_hi5=0x0c & r3 { r3 = r3 + 1; ZF = r3 == 0; JF = ZF; }
:DEC r3 is op_hi5=0x0d & r3 { JF = r3 == 0; r3 = r3 - 1; ZF = r3 == 0; }

# ---- 8-bit ALU: A <- A op src ----
macro alu_addc(d, s) { local c:1 = CF; local r:1 = d + s + c; HF = ((d & 0xf) + (s & 0xf) + c) > 0xf; CF = carry(d, s) || carry(d + s, c); d = r; ZF = d == 0; JF = CF; }
macro alu_add(d, s) { addflags(d, s); d = d + s; ZF = d == 0; JF = CF; }
macro alu_subb(d, s) { local c:1 = CF; local r:1 = d - s - c; HF = (d & 0xf) < ((s & 0xf) + c); CF = (d < s) || ((d - s) < c); d = r; ZF = d == 0; JF = CF; }
macro alu_sub(d, s) { subflags(d, s); d = d - s; ZF = d == 0; JF = CF; }
macro alu_and(d, s) { d = d & s; ZF = d == 0; JF = ZF; }
macro alu_xor(d, s) { d = d ^ s; ZF = d == 0; JF = ZF; }
macro alu_or(d, s) { d = d | s; ZF = d == 0; JF = ZF; }
macro alu_cmp(d, s) { subflags(d, s); ZF = d == s; JF = ZF; }

AluSrc: Imm8 is op_hi5=0x0e; Imm8 { export Imm8; }
AluSrc: Dir is op_hi5=0x0f; Dir { export Dir; }

:ADDC "A",AluSrc is (op_hi4=0x7 & alu3=0) ... & AluSrc { alu_addc(A, AluSrc); }
:ADD "A",AluSrc is (op_hi4=0x7 & alu3=1) ... & AluSrc { alu_add(A, AluSrc); }
:SUBB "A",AluSrc is (op_hi4=0x7 & alu3=2) ... & AluSrc { alu_subb(A, AluSrc); }
:SUB "A",AluSrc is (op_hi4=0x7 & alu3=3) ... & AluSrc { alu_sub(A, AluSrc); }
:AND "A",AluSrc is (op_hi4=0x7 & alu3=4) ... & AluSrc { alu_and(A, AluSrc); }
:XOR "A",AluSrc is (op_hi4=0x7 & alu3=5) ... & AluSrc { alu_xor(A, AluSrc); }
:OR "A",AluSrc is (op_hi4=0x7 & alu3=6) ... & AluSrc { alu_or(A, AluSrc); }
:CMP "A",AluSrc is (op_hi4=0x7 & alu3=7) ... & AluSrc { alu_cmp(A, AluSrc); }

# ---- branches ----
RelS: dest is sd5 [ dest = inst_start + 2 + sd5; ] { export *:1 dest; }
Rel8: dest is s8 [ dest = inst_start + 2 + s8; ] { export *:1 dest; }

:JRS "T",RelS is op_hi3=0x4 & RelS { local c:1 = JF; JF = 1; if (c) goto RelS; }
:JRS "F",RelS is op_hi3=0x5 & RelS { local c:1 = JF; JF = 1; if (!c) goto RelS; }

CVec: vaddr is vec4 [ vaddr = 0xffc0 + vec4 * 2; ] { export *:2 vaddr; }
:CALLV vec4 is op_hi4=0xc & vec4 & CVec { local tgt:2 = CVec; local ret:2 = inst_next; push16(ret); call [tgt]; }

Cond: "EQ" is cc3=0 { export ZF; }
Cond: "NE" is cc3=1 { local c:1 = !ZF; export c; }
Cond: "LT" is cc3=2 { export CF; }
Cond: "GE" is cc3=3 { local c:1 = !CF; export c; }
Cond: "LE" is cc3=4 { local c:1 = CF || ZF; export c; }
Cond: "GT" is cc3=5 { local c:1 = !(CF || ZF); export c; }
Cond: "T" is cc3=6 { export JF; }
Cond: "F" is cc3=7 { local c:1 = !JF; export c; }

:JR Cond,Rel8 is op_hi5=0x1a & Cond; Rel8 { local c:1 = Cond; JF = 1; if (c) goto Rel8; }
:LD "CF",Dir^"."^b3 is op_hi5=0x1b & b3; Dir { CF = (Dir >> b3) & 1; JF = !CF; }

:LD "SP",Imm16 is op=0xfa; Imm16 { SP = Imm16; JF = 1; }
:JR Rel8 is op=0xfb; Rel8 { JF = 1; goto Rel8; }
Abs16: n16 is n16 { export *:1 n16; }
:CALL Abs16 is op=0xfc; Abs16 { local ret:2 = inst_next; push16(ret); call Abs16; }
PAddr: pa is n8 [ pa = 0xff00 + n8; ] { export *:1 pa; }
:CALLP PAddr is op=0xfd; PAddr { local ret:2 = inst_next; push16(ret); call PAddr; }
:JP Abs16 is op=0xfe; Abs16 { JF = 1; goto Abs16; }
:SWI is op=0xff { local ret:2 = inst_next; push16(ret); local p:1; getPSW(p); SP = SP - 1; *:1 SP = p; local tgt:2 = *:2 0xfffe:2; swi(); call [tgt]; }

# ---- prefix pages (MAME tlcs870d.cpp decode_source / decode_dest / decode_register_prefix) ----
define token op2t (8)
  op2 = (0,7)
  op2_hi5 = (3,7)
  op2_hi6 = (2,7)
  o2r = (0,2)
  o2rr = (0,1)
  o2b = (0,2)
  o2alu = (0,2)
  o2p = (0,0)
;
attach variables o2r [ A W C B E D L H ];
attach variables o2rr [ WA BC DE HL ];

define pcodeop retn;

# memory operand of the e0-e7 (src) and f0-f7 (dst) prefixes; exports the effective address
SrcD: "("^n8^")" is op_hi5=0x1c & r3=0; n8 { export *[const]:2 n8; }
SrcN: "(PC+A)" is op_hi5=0x1c & r3=1 { local a:2 = inst_start + 2 + zext(A); export a; }
SrcN: "(DE)" is op_hi5=0x1c & r3=2 { export DE; }
SrcN: "(HL)" is op_hi5=0x1c & r3=3 { export HL; }
SrcD: "(HL"^s8^")" is op_hi5=0x1c & r3=4; s8 { local a:2 = HL + s8; export a; }
SrcN: "(HL+C)" is op_hi5=0x1c & r3=5 { local a:2 = HL + zext(C); export a; }
SrcN: "(HL+)" is op_hi5=0x1c & r3=6 { local a:2 = HL; HL = HL + 1; export a; }
SrcN: "(-HL)" is op_hi5=0x1c & r3=7 { HL = HL - 1; local a:2 = HL; export a; }

DstD: "("^n8^")" is op_hi5=0x1e & r3=0; n8 { export *[const]:2 n8; }
DstN: "(DE)" is op_hi5=0x1e & r3=2 { export DE; }
DstN: "(HL)" is op_hi5=0x1e & r3=3 { export HL; }
DstD: "(HL"^s8^")" is op_hi5=0x1e & r3=4; s8 { local a:2 = HL + s8; export a; }
DstN: "(HL+)" is op_hi5=0x1e & r3=6 { local a:2 = HL; HL = HL + 1; export a; }
DstN: "(-HL)" is op_hi5=0x1e & r3=7 { HL = HL - 1; local a:2 = HL; export a; }

macro alu16_addc(d, s) { local c:2 = zext(CF); local r:2 = d + s + c; HF = ((d & 0xf) + (s & 0xf) + c) > 0xf; CF = carry(d, s) || carry(d + s, c); d = r; ZF = d == 0; JF = CF; }
macro alu16_subb(d, s) { local c:2 = zext(CF); local r:2 = d - s - c; HF = (d & 0xf) < ((s & 0xf) + c); CF = (d < s) || ((d - s) < c); d = r; ZF = d == 0; JF = CF; }

:ADDC SrcN,"(HL)" is SrcN; op2=96 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_addc(t, s); *:1 SrcN = t; }
:ADDC SrcD,"(HL)" is SrcD; op2=96 { local t:1 = *:1 SrcD; local s:1 = *:1 HL; alu_addc(t, s); *:1 SrcD = t; }
:ADDC SrcN,Imm8 is SrcN; op2=112; Imm8 { local t:1 = *:1 SrcN; alu_addc(t, Imm8); *:1 SrcN = t; }
:ADDC SrcD,Imm8 is SrcD; op2=112; Imm8 { local t:1 = *:1 SrcD; alu_addc(t, Imm8); *:1 SrcD = t; }
:ADDC "A",SrcN is SrcN; op2=120 { local s:1 = *:1 SrcN; alu_addc(A, s); }
:ADDC "A",SrcD is SrcD; op2=120 { local s:1 = *:1 SrcD; alu_addc(A, s); }
:ADDC "WA",rr2 is op_hi6=0x3a & rr2; op2=48 { local s:2 = rr2; alu16_addc(WA, s); }
:ADDC rr2,Imm16 is op_hi6=0x3a & rr2; op2=56; Imm16 { alu16_addc(rr2, Imm16); }
:ADDC "A",r3 is op_hi5=0x1d & r3; op2=96 { local s:1 = r3; alu_addc(A, s); }
:ADDC r3,"A" is op_hi5=0x1d & r3; op2=104 { local s:1 = A; alu_addc(r3, s); }
:ADDC r3,Imm8 is op_hi5=0x1d & r3; op2=112; Imm8 { alu_addc(r3, Imm8); }
:ADD SrcN,"(HL)" is SrcN; op2=97 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_add(t, s); *:1 SrcN = t; }
:ADD SrcD,"(HL)" is SrcD; op2=97 { local t:1 = *:1 SrcD; local s:1 = *:1 HL; alu_add(t, s); *:1 SrcD = t; }
:ADD SrcN,Imm8 is SrcN; op2=113; Imm8 { local t:1 = *:1 SrcN; alu_add(t, Imm8); *:1 SrcN = t; }
:ADD SrcD,Imm8 is SrcD; op2=113; Imm8 { local t:1 = *:1 SrcD; alu_add(t, Imm8); *:1 SrcD = t; }
:ADD "A",SrcN is SrcN; op2=121 { local s:1 = *:1 SrcN; alu_add(A, s); }
:ADD "A",SrcD is SrcD; op2=121 { local s:1 = *:1 SrcD; alu_add(A, s); }
:ADD "WA",rr2 is op_hi6=0x3a & rr2; op2=49 { local s:2 = rr2; alu_add(WA, s); }
:ADD rr2,Imm16 is op_hi6=0x3a & rr2; op2=57; Imm16 { alu_add(rr2, Imm16); }
:ADD "A",r3 is op_hi5=0x1d & r3; op2=97 { local s:1 = r3; alu_add(A, s); }
:ADD r3,"A" is op_hi5=0x1d & r3; op2=105 { local s:1 = A; alu_add(r3, s); }
:ADD r3,Imm8 is op_hi5=0x1d & r3; op2=113; Imm8 { alu_add(r3, Imm8); }
:SUBB SrcN,"(HL)" is SrcN; op2=98 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_subb(t, s); *:1 SrcN = t; }
:SUBB SrcD,"(HL)" is SrcD; op2=98 { local t:1 = *:1 SrcD; local s:1 = *:1 HL; alu_subb(t, s); *:1 SrcD = t; }
:SUBB SrcN,Imm8 is SrcN; op2=114; Imm8 { local t:1 = *:1 SrcN; alu_subb(t, Imm8); *:1 SrcN = t; }
:SUBB SrcD,Imm8 is SrcD; op2=114; Imm8 { local t:1 = *:1 SrcD; alu_subb(t, Imm8); *:1 SrcD = t; }
:SUBB "A",SrcN is SrcN; op2=122 { local s:1 = *:1 SrcN; alu_subb(A, s); }
:SUBB "A",SrcD is SrcD; op2=122 { local s:1 = *:1 SrcD; alu_subb(A, s); }
:SUBB "WA",rr2 is op_hi6=0x3a & rr2; op2=50 { local s:2 = rr2; alu16_subb(WA, s); }
:SUBB rr2,Imm16 is op_hi6=0x3a & rr2; op2=58; Imm16 { alu16_subb(rr2, Imm16); }
:SUBB "A",r3 is op_hi5=0x1d & r3; op2=98 { local s:1 = r3; alu_subb(A, s); }
:SUBB r3,"A" is op_hi5=0x1d & r3; op2=106 { local s:1 = A; alu_subb(r3, s); }
:SUBB r3,Imm8 is op_hi5=0x1d & r3; op2=114; Imm8 { alu_subb(r3, Imm8); }
:SUB SrcN,"(HL)" is SrcN; op2=99 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_sub(t, s); *:1 SrcN = t; }
:SUB SrcD,"(HL)" is SrcD; op2=99 { local t:1 = *:1 SrcD; local s:1 = *:1 HL; alu_sub(t, s); *:1 SrcD = t; }
:SUB SrcN,Imm8 is SrcN; op2=115; Imm8 { local t:1 = *:1 SrcN; alu_sub(t, Imm8); *:1 SrcN = t; }
:SUB SrcD,Imm8 is SrcD; op2=115; Imm8 { local t:1 = *:1 SrcD; alu_sub(t, Imm8); *:1 SrcD = t; }
:SUB "A",SrcN is SrcN; op2=123 { local s:1 = *:1 SrcN; alu_sub(A, s); }
:SUB "A",SrcD is SrcD; op2=123 { local s:1 = *:1 SrcD; alu_sub(A, s); }
:SUB "WA",rr2 is op_hi6=0x3a & rr2; op2=51 { local s:2 = rr2; alu_sub(WA, s); }
:SUB rr2,Imm16 is op_hi6=0x3a & rr2; op2=59; Imm16 { alu_sub(rr2, Imm16); }
:SUB "A",r3 is op_hi5=0x1d & r3; op2=99 { local s:1 = r3; alu_sub(A, s); }
:SUB r3,"A" is op_hi5=0x1d & r3; op2=107 { local s:1 = A; alu_sub(r3, s); }
:SUB r3,Imm8 is op_hi5=0x1d & r3; op2=115; Imm8 { alu_sub(r3, Imm8); }
:AND SrcN,"(HL)" is SrcN; op2=100 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_and(t, s); *:1 SrcN = t; }
:AND SrcD,"(HL)" is SrcD; op2=100 { local t:1 = *:1 SrcD; local s:1 = *:1 HL; alu_and(t, s); *:1 SrcD = t; }
:AND SrcN,Imm8 is SrcN; op2=116; Imm8 { local t:1 = *:1 SrcN; alu_and(t, Imm8); *:1 SrcN = t; }
:AND SrcD,Imm8 is SrcD; op2=116; Imm8 { local t:1 = *:1 SrcD; alu_and(t, Imm8); *:1 SrcD = t; }
:AND "A",SrcN is SrcN; op2=124 { local s:1 = *:1 SrcN; alu_and(A, s); }
:AND "A",SrcD is SrcD; op2=124 { local s:1 = *:1 SrcD; alu_and(A, s); }
:AND "WA",rr2 is op_hi6=0x3a & rr2; op2=52 { local s:2 = rr2; alu_and(WA, s); }
:AND rr2,Imm16 is op_hi6=0x3a & rr2; op2=60; Imm16 { alu_and(rr2, Imm16); }
:AND "A",r3 is op_hi5=0x1d & r3; op2=100 { local s:1 = r3; alu_and(A, s); }
:AND r3,"A" is op_hi5=0x1d & r3; op2=108 { local s:1 = A; alu_and(r3, s); }
:AND r3,Imm8 is op_hi5=0x1d & r3; op2=116; Imm8 { alu_and(r3, Imm8); }
:XOR SrcN,"(HL)" is SrcN; op2=101 { local t:1 = *:1 SrcN; local s:1 = *:1 HL; alu_xor(t, s); *:1 SrcN = t; }
