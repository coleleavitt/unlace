}
:IS_OP ARGV is op=117 & ARGV {
  b:8 = 0; a:8 = 0; pop(b); pop(a); c:1 = (a == b) != (ARGV != 0); r:8 = py_bool(c); push(r);
}
:CONTAINS_OP ARGV is op=118 & ARGV {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_contains(b, a, ARGV); push(r);
}
:BINARY_SUBSCR is op=25 {
  b:8 = 0; a:8 = 0; pop(b); pop(a); r:8 = py_getitem(a, b); push(r);
}
:STORE_SUBSCR is op=60 {
  k:8 = 0; c:8 = 0; v:8 = 0; pop(k); pop(c); pop(v); py_setitem(c, k, v);
}
:DELETE_SUBSCR is op=61 {
  k:8 = 0; c:8 = 0; pop(k); pop(c); py_delitem(c, k);
}
:BINARY_SLICE is op=26 {
  e:8 = 0; s:8 = 0; c:8 = 0; pop(e); pop(s); pop(c); r:8 = py_getslice(c, s, e); push(r);
}
:STORE_SLICE is op=27 {
  e:8 = 0; s:8 = 0; c:8 = 0; v:8 = 0; pop(e); pop(s); pop(c); pop(v); py_setslice(c, s, e, v);
}
:LOAD_CONST ARGV is op=100 & ARGV {
  r:8 = py_const(ARGV); push(r);
}
:RETURN_CONST ARGV is op=121 & ARGV {
  RV = py_const(ARGV); return [0:4];
}
:RETURN_VALUE is op=83 {
  pop(RV); return [0:4];
}
:LOAD_FAST FAST is op=124 & FAST {
  push(FAST);
}
:LOAD_FAST_CHECK FAST is op=127 & FAST {
  push(FAST);
}
:LOAD_FAST_AND_CLEAR FAST is op=143 & FAST {
  push(FAST); FAST = 0;
}
:STORE_FAST FAST is op=125 & FAST {
  v:8 = 0; pop(v); FAST = v;
}
:DELETE_FAST FAST is op=126 & FAST {
  FAST = 0;
}
:LOAD_NAME ARGV is op=101 & ARGV {
  r:8 = py_name(ARGV); push(r);
}
:STORE_NAME ARGV is op=90 & ARGV {
  v:8 = 0; pop(v); py_store_name(ARGV, v);
}
:DELETE_NAME ARGV is op=91 & ARGV {
  py_del_name(ARGV);
}
:LOAD_GLOBAL "NULL+"^GI is op=116 & argb0=1 & arg [ GI = ((hiarg << 8) | arg) >> 1; ] {
  gi:4 = GI; push(0:8); r:8 = py_global(gi); push(r);
}
:LOAD_GLOBAL GI is op=116 & argb0=0 & arg [ GI = ((hiarg << 8) | arg) >> 1; ] {
  gi:4 = GI; r:8 = py_global(gi); push(r);
}
:STORE_GLOBAL ARGV is op=97 & ARGV {
  v:8 = 0; pop(v); py_store_global(ARGV, v);
}
:DELETE_GLOBAL ARGV is op=98 & ARGV {
  py_del_global(ARGV);
}
:LOAD_ATTR "method "^AI is op=106 & argb0=1 & arg [ AI = ((hiarg << 8) | arg) >> 1; ] {
  ai:4 = AI; v:8 = *[pystack]:8 SP; m:8 = py_method(v, ai); *[pystack]:8 SP = m; push(v);
}
:LOAD_ATTR AI is op=106 & argb0=0 & arg [ AI = ((hiarg << 8) | arg) >> 1; ] {
  ai:4 = AI; v:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_getattr(v, ai);
}
:STORE_ATTR ARGV is op=95 & ARGV {
  obj:8 = 0; v:8 = 0; pop(obj); pop(v); py_setattr(obj, ARGV, v);
}
:DELETE_ATTR ARGV is op=96 & ARGV {
  obj:8 = 0; pop(obj); py_delattr(obj, ARGV);
}
:LOAD_DEREF ARGV is op=137 & ARGV {
  r:8 = py_load_deref(ARGV); push(r);
}
:LOAD_CLOSURE ARGV is op=136 & ARGV {
  r:8 = py_load_closure(ARGV); push(r);
}
:LOAD_FROM_DICT_OR_DEREF ARGV is op=176 & ARGV {
  d:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_load_from_dict(d, ARGV);
}
:LOAD_FROM_DICT_OR_GLOBALS ARGV is op=175 & ARGV {
  d:8 = *[pystack]:8 SP; *[pystack]:8 SP = py_load_from_dict(d, ARGV);
}
:STORE_DEREF ARGV is op=138 & ARGV {
  v:8 = 0; pop(v); py_store_deref(ARGV, v);
}
:DELETE_DEREF ARGV is op=139 & ARGV {
  py_del_deref(ARGV);
}
:MAKE_CELL ARGV is op=135 & ARGV {
  py_make_cell(ARGV);
}
:COPY_FREE_VARS ARGV is op=149 & ARGV {
  py_copy_free_vars(ARGV);
}

RELF: tgt is arg [ tgt = inst_next + ((hiarg << 8) | arg) * 2; ] { export *:4 tgt; }
RELB: tgt is arg [ tgt = inst_next - ((hiarg << 8) | arg) * 2; ] { export *:4 tgt; }
FORT: tgt is arg [ tgt = inst_next + ((hiarg << 8) | arg) * 2 + 4; ] { export *:4 tgt; }
SENDT: tgt is arg [ tgt = inst_next + ((hiarg << 8) | arg) * 2 + 2; ] { export *:4 tgt; }

:JUMP_FORWARD RELF is op=110 & RELF { goto RELF; }
:JUMP_BACKWARD RELB is op=140 & RELB { goto RELB; }
:JUMP_BACKWARD_NO_INTERRUPT RELB is op=134 & RELB { goto RELB; }
:POP_JUMP_IF_FALSE RELF is op=114 & RELF { v:8 = 0; pop(v); t:1 = py_truth(v); if (!t) goto RELF; }
