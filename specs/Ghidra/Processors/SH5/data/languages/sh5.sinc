# SuperH SH-5 SHmedia: the 32-bit instruction set of the SH-5 (SH64) cores.
# Written for unlace from the SuperH SH-5 CPU Core Architecture manual
# (Volume 2: SHmedia). Encodings cross-checked against sh64-elf-objdump from
# binutils 2.29.1 (the last release with SH64), used as an oracle only.
#
# 64 general registers (r63 reads as zero), 8 branch-target registers that
# PTA/PTB/PTABS/PTREL load and the branches and BLINK use, 64 single FP
# registers paired into doubles, vectors and matrices. Addresses are 32 bits
# . The SHcompact mode bit of a branch target is not
# modelled: every target is decoded as SHmedia.

define endian=$(ENDIAN);
define alignment=4;

define space ram      type=ram_space      size=8 default;
define space register type=register_space size=4;

define register offset=0x0000 size=8 [
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
	r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
	r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 r60 r61 r62 r63
];
define register offset=0x0400 size=8 [ PC ];
define register offset=0x0408 size=4 [ FPSCR ];
define register offset=0x0500 size=8 [ tr0 tr1 tr2 tr3 tr4 tr5 tr6 tr7 ];
define register offset=0x0600 size=8 [
	sr ssr pssr cr3 intevt expevt pexpevt tra spc pspc resvec vbr cr12 tea cr14 cr15
	dcr kcr0 kcr1 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31
	cr32 cr33 cr34 cr35 cr36 cr37 cr38 cr39 cr40 cr41 cr42 cr43 cr44 cr45 cr46 cr47
	cr48 cr49 cr50 cr51 cr52 cr53 cr54 cr55 cr56 cr57 cr58 cr59 cr60 cr61 ctc usr
];
define register offset=0x1000 size=4 [
	fr0 fr1 fr2 fr3 fr4 fr5 fr6 fr7 fr8 fr9 fr10 fr11 fr12 fr13 fr14 fr15
	fr16 fr17 fr18 fr19 fr20 fr21 fr22 fr23 fr24 fr25 fr26 fr27 fr28 fr29 fr30 fr31
	fr32 fr33 fr34 fr35 fr36 fr37 fr38 fr39 fr40 fr41 fr42 fr43 fr44 fr45 fr46 fr47
	fr48 fr49 fr50 fr51 fr52 fr53 fr54 fr55 fr56 fr57 fr58 fr59 fr60 fr61 fr62 fr63
];
define register offset=0x1000 size=8 [
	dr0 dr2 dr4 dr6 dr8 dr10 dr12 dr14 dr16 dr18 dr20 dr22 dr24 dr26 dr28 dr30
	dr32 dr34 dr36 dr38 dr40 dr42 dr44 dr46 dr48 dr50 dr52 dr54 dr56 dr58 dr60 dr62
];
define register offset=0x1000 size=16 [
	fv0 fv4 fv8 fv12 fv16 fv20 fv24 fv28 fv32 fv36 fv40 fv44 fv48 fv52 fv56 fv60
];
define register offset=0x1000 size=64 [ mtrx0 mtrx16 mtrx32 mtrx48 ];

define register offset=0x0800 size=8 contextreg;
define context contextreg
	ptTgt=(0,31)
	ptTR=(32,34)
	ptOK=(35,35)
;

define token instr(32)
	b31_26=(26,31)
	b25_23=(23,25)
	b25_20=(20,25)
	b19_16=(16,19)
	b15_10=(10,15)
	b15_15=(15,15)
	b9_4=(4,9)
	b9_7=(7,9)
	b3_0=(0,3)
	RM=(20,25)
	RMn=(20,25)
	RN=(10,15)
	RNn=(10,15)
	RD=(4,9)
	RDn=(4,9)
	FG=(20,25)
	FH=(10,15)
	FF=(4,9)
	DG=(20,25)
	DH=(10,15)
	DF=(4,9)
	FPFn=(4,9)
	FVG=(20,25)
	FVH=(10,15)
	FVF=(4,9)
	MTG=(20,25)
	TA=(4,6)
	TB=(20,22)
	TAn=(4,6)
	TBn=(20,22)
	CK=(20,25)
	CJ=(4,9)
	S10=(10,19) signed
	S6=(10,15) signed
	U6=(10,15)
	U5=(10,14)
	S16=(10,25) signed
	U16=(10,25)
;

attach variables [ RM RN RD ] [
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
	r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
	r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 r60 r61 r62 r63
];
attach variables [ FG FH FF ] [
	fr0 fr1 fr2 fr3 fr4 fr5 fr6 fr7 fr8 fr9 fr10 fr11 fr12 fr13 fr14 fr15
	fr16 fr17 fr18 fr19 fr20 fr21 fr22 fr23 fr24 fr25 fr26 fr27 fr28 fr29 fr30 fr31
	fr32 fr33 fr34 fr35 fr36 fr37 fr38 fr39 fr40 fr41 fr42 fr43 fr44 fr45 fr46 fr47
	fr48 fr49 fr50 fr51 fr52 fr53 fr54 fr55 fr56 fr57 fr58 fr59 fr60 fr61 fr62 fr63
];
attach variables [ DG DH DF ] [
	dr0 _ dr2 _ dr4 _ dr6 _ dr8 _ dr10 _ dr12 _ dr14 _
	dr16 _ dr18 _ dr20 _ dr22 _ dr24 _ dr26 _ dr28 _ dr30 _
	dr32 _ dr34 _ dr36 _ dr38 _ dr40 _ dr42 _ dr44 _ dr46 _
	dr48 _ dr50 _ dr52 _ dr54 _ dr56 _ dr58 _ dr60 _ dr62 _
];
attach variables [ FVG FVH FVF ] [
	fv0 _ _ _ fv4 _ _ _ fv8 _ _ _ fv12 _ _ _
	fv16 _ _ _ fv20 _ _ _ fv24 _ _ _ fv28 _ _ _
	fv32 _ _ _ fv36 _ _ _ fv40 _ _ _ fv44 _ _ _
	fv48 _ _ _ fv52 _ _ _ fv56 _ _ _ fv60 _ _ _
];
attach variables [ MTG ] [
	mtrx0 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
	mtrx16 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
	mtrx32 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
	mtrx48 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
];
attach variables [ TA TB ] [ tr0 tr1 tr2 tr3 tr4 tr5 tr6 tr7 ];
attach variables [ CK CJ ] [
	sr ssr pssr cr3 intevt expevt pexpevt tra spc pspc resvec vbr cr12 tea cr14 cr15
	dcr kcr0 kcr1 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31
	cr32 cr33 cr34 cr35 cr36 cr37 cr38 cr39 cr40 cr41 cr42 cr43 cr44 cr45 cr46 cr47
	cr48 cr49 cr50 cr51 cr52 cr53 cr54 cr55 cr56 cr57 cr58 cr59 cr60 cr61 ctc usr
];

define pcodeop alloco;
define pcodeop brk;
define pcodeop fipr;
define pcodeop ftrv;
define pcodeop getcfg;
define pcodeop icbi;
define pcodeop ldhi_l;
define pcodeop ldhi_q;
define pcodeop ldlo_l;
define pcodeop ldlo_q;
define pcodeop mabs_l;
define pcodeop mabs_w;
define pcodeop madd_l;
define pcodeop madd_w;
define pcodeop madds_l;
define pcodeop madds_ub;
define pcodeop madds_w;
define pcodeop mcmpeq_b;
define pcodeop mcmpeq_l;
define pcodeop mcmpeq_w;
define pcodeop mcmpgt_l;
define pcodeop mcmpgt_ub;
define pcodeop mcmpgt_w;
define pcodeop mcmv;
define pcodeop mcnvs_lw;
define pcodeop mcnvs_wb;
define pcodeop mcnvs_wub;
define pcodeop mextr1;
define pcodeop mextr2;
define pcodeop mextr3;
define pcodeop mextr4;
define pcodeop mextr5;
define pcodeop mextr6;
define pcodeop mextr7;
define pcodeop mmacfx_wl;
define pcodeop mmacnfx_wl;
define pcodeop mmul_l;
define pcodeop mmul_w;
define pcodeop mmulfx_l;
define pcodeop mmulfx_w;
define pcodeop mmulfxrp_w;
define pcodeop mmulhi_wl;
define pcodeop mmullo_wl;
define pcodeop mmulsum_wq;
define pcodeop mperm_w;
define pcodeop msad_ubq;
define pcodeop mshalds_l;
define pcodeop mshalds_w;
define pcodeop mshard_l;
define pcodeop mshard_w;
define pcodeop mshards_q;
define pcodeop mshfhi_b;
define pcodeop mshfhi_l;
define pcodeop mshfhi_w;
define pcodeop mshflo_b;
define pcodeop mshflo_l;
define pcodeop mshflo_w;
define pcodeop mshlld_l;
define pcodeop mshlld_w;
define pcodeop mshlrd_l;
define pcodeop mshlrd_w;
define pcodeop msub_l;
define pcodeop msub_w;
define pcodeop msubs_l;
define pcodeop msubs_ub;
define pcodeop msubs_w;
define pcodeop ocbi;
define pcodeop ocbp;
define pcodeop ocbwb;
define pcodeop prefi;
define pcodeop putcfg;
define pcodeop rte;
define pcodeop sleep;
define pcodeop sthi_l;
define pcodeop sthi_q;
define pcodeop stlo_l;
define pcodeop stlo_q;
define pcodeop synci;
define pcodeop synco;
define pcodeop trapa;

# A branch through the target register the last PTA/PT loaded (tracked in
# the context along the flow) branches to that address directly.
ptdest: ptTgt is ptTgt { export *:8 ptTgt; }

# Register sources: r63 reads as zero.
rm: RM is RM { export RM; }
rm: "r63" is RMn=63 { export 0:8; }
rn: RN is RN { export RN; }
rn: "r63" is RNn=63 { export 0:8; }
rds: RD is RD { export RD; }
rds: "r63" is RDn=63 { export 0:8; }
fpf: "fp"^FPFn is FPFn & DF { export DF; }

imm_s10: S10 is S10 { export *[const]:8 S10; }
imm_s6x32: val is S6 [ val = S6 * 32; ] { export *[const]:8 val; }
imm_s6: S6 is S6 { export *[const]:8 S6; }
imm_s10x8: val is S10 [ val = S10 * 8; ] { export *[const]:8 val; }
imm_s10x4: val is S10 [ val = S10 * 4; ] { export *[const]:8 val; }
imm_s10x2: val is S10 [ val = S10 * 2; ] { export *[const]:8 val; }
imm_s16: S16 is S16 { export *[const]:8 S16; }
imm_pcx4: addr is S16 [ addr = inst_start + S16 * 4; ] { export *[const]:8 addr; }
imm_u6: U6 is U6 { export *[const]:8 U6; }
imm_u5: U5 is U5 { export *[const]:8 U5; }
imm_u16: U16 is U16 { export *[const]:8 U16; }

:add rm,rn,RD is b31_26=0 & b19_16=9 & b3_0=0 & rm & rn & RD { RD = rm + rn; }
:add.l rm,rn,RD is b31_26=0 & b19_16=8 & b3_0=0 & rm & rn & RD { local t:4 = rm:4 + rn:4; RD = sext(t); }
:addi rm,imm_s10,RD is b31_26=52 & b3_0=0 & rm & imm_s10 & RD { RD = rm + imm_s10; }
:addi.l rm,imm_s10,RD is b31_26=53 & b3_0=0 & rm & imm_s10 & RD { local t:4 = rm:4 + imm_s10:4; RD = sext(t); }
:addz.l rm,rn,RD is b31_26=0 & b19_16=12 & b3_0=0 & rm & rn & RD { local t:4 = rm:4 + rn:4; RD = zext(t); }
:alloco rm,imm_s6x32 is b31_26=56 & b19_16=4 & b9_4=63 & b3_0=0 & rm & imm_s6x32 { local ea:8 = rm + imm_s6x32; alloco(ea); }
:and rm,rn,RD is b31_26=1 & b19_16=11 & b3_0=0 & rm & rn & RD { RD = rm & rn; }
:andc rm,rn,RD is b31_26=1 & b19_16=15 & b3_0=0 & rm & rn & RD { RD = rm & ~rn; }
:andi rm,imm_s10,RD is b31_26=54 & b3_0=0 & rm & imm_s10 & RD { RD = rm & imm_s10; }
:beq^"/l" rm,rn,TA is b31_26=25 & b19_16=1 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm == rn)) goto <skip>; goto [TA]; <skip> }
:beq^"/u" rm,rn,TA is b31_26=25 & b19_16=1 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm == rn)) goto <skip>; goto [TA]; <skip> }
:beqi^"/l" rm,imm_s6,TA is b31_26=57 & b19_16=1 & b9_7=4 & b3_0=0 & rm & imm_s6 & TA { if (!(rm == imm_s6)) goto <skip>; goto [TA]; <skip> }
:beqi^"/u" rm,imm_s6,TA is b31_26=57 & b19_16=1 & b9_7=0 & b3_0=0 & rm & imm_s6 & TA { if (!(rm == imm_s6)) goto <skip>; goto [TA]; <skip> }
:bge^"/l" rm,rn,TA is b31_26=25 & b19_16=3 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm s>= rn)) goto <skip>; goto [TA]; <skip> }
:bge^"/u" rm,rn,TA is b31_26=25 & b19_16=3 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm s>= rn)) goto <skip>; goto [TA]; <skip> }
:bgeu^"/l" rm,rn,TA is b31_26=25 & b19_16=11 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm >= rn)) goto <skip>; goto [TA]; <skip> }
:bgeu^"/u" rm,rn,TA is b31_26=25 & b19_16=11 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm >= rn)) goto <skip>; goto [TA]; <skip> }
:bgt^"/l" rm,rn,TA is b31_26=25 & b19_16=7 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm s> rn)) goto <skip>; goto [TA]; <skip> }
:bgt^"/u" rm,rn,TA is b31_26=25 & b19_16=7 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm s> rn)) goto <skip>; goto [TA]; <skip> }
:bgtu^"/l" rm,rn,TA is b31_26=25 & b19_16=15 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm > rn)) goto <skip>; goto [TA]; <skip> }
:bgtu^"/u" rm,rn,TA is b31_26=25 & b19_16=15 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm > rn)) goto <skip>; goto [TA]; <skip> }
:blink TB,"r63" is b31_26=17 & b25_23=0 & b19_16=1 & b15_10=63 & b3_0=0 & TB & RD=63 [ ptOK = 0; globalset(inst_next, ptOK); ] { goto [TB]; }
:blink TB,RD is b31_26=17 & b25_23=0 & b19_16=1 & b15_10=63 & b3_0=0 & TB & RD [ ptOK = 0; globalset(inst_next, ptOK); ] { RD = inst_next; call [TB]; }
:bne^"/l" rm,rn,TA is b31_26=25 & b19_16=5 & b9_7=4 & b3_0=0 & rm & rn & TA { if (!(rm != rn)) goto <skip>; goto [TA]; <skip> }
:bne^"/u" rm,rn,TA is b31_26=25 & b19_16=5 & b9_7=0 & b3_0=0 & rm & rn & TA { if (!(rm != rn)) goto <skip>; goto [TA]; <skip> }
:bnei^"/l" rm,imm_s6,TA is b31_26=57 & b19_16=5 & b9_7=4 & b3_0=0 & rm & imm_s6 & TA { if (!(rm != imm_s6)) goto <skip>; goto [TA]; <skip> }
:bnei^"/u" rm,imm_s6,TA is b31_26=57 & b19_16=5 & b9_7=0 & b3_0=0 & rm & imm_s6 & TA { if (!(rm != imm_s6)) goto <skip>; goto [TA]; <skip> }
:brk is b31_26=27 & b25_20=63 & b19_16=5 & b15_10=63 & b9_4=63 & b3_0=0 { brk(); }
:byterev rm,RD is b31_26=0 & b19_16=15 & b15_10=63 & b3_0=0 & rm & RD { local v:8 = rm; RD = (v << 56) | ((v & 0xff00) << 40) | ((v & 0xff0000) << 24) | ((v & 0xff000000) << 8) | ((v >> 8) & 0xff000000) | ((v >> 24) & 0xff0000) | ((v >> 40) & 0xff00) | (v >> 56); }
:cmpeq rm,rn,RD is b31_26=0 & b19_16=1 & b3_0=0 & rm & rn & RD { RD = zext(rm == rn); }
:cmpgt rm,rn,RD is b31_26=0 & b19_16=3 & b3_0=0 & rm & rn & RD { RD = zext(rm s> rn); }
:cmpgtu rm,rn,RD is b31_26=0 & b19_16=7 & b3_0=0 & rm & rn & RD { RD = zext(rm > rn); }
:cmveq rm,rn,RD is b31_26=8 & b19_16=1 & b3_0=0 & rm & rn & RD { if (rm != 0) goto <skip>; RD = rn; <skip> }
:cmvne rm,rn,RD is b31_26=8 & b19_16=5 & b3_0=0 & rm & rn & RD { if (rm == 0) goto <skip>; RD = rn; <skip> }
:fabs.d DG,DF is b31_26=6 & b19_16=1 & b3_0=0 & DG & DF { DF = abs(DG); }
:fabs.s FG,FF is b31_26=6 & b19_16=0 & b3_0=0 & FG & FF { FF = abs(FG); }
:fadd.d DG,DH,DF is b31_26=13 & b19_16=1 & b3_0=0 & DG & DH & DF { DF = DG f+ DH; }
:fadd.s FG,FH,FF is b31_26=13 & b19_16=0 & b3_0=0 & FG & FH & FF { FF = FG f+ FH; }
:fcmpeq.d DG,DH,RD is b31_26=12 & b19_16=9 & b3_0=0 & DG & DH & RD { RD = zext(DG f== DH); }
:fcmpeq.s FG,FH,RD is b31_26=12 & b19_16=8 & b3_0=0 & FG & FH & RD { RD = zext(FG f== FH); }
:fcmpge.d DG,DH,RD is b31_26=12 & b19_16=15 & b3_0=0 & DG & DH & RD { RD = zext(DG f>= DH); }
:fcmpge.s FG,FH,RD is b31_26=12 & b19_16=14 & b3_0=0 & FG & FH & RD { RD = zext(FG f>= FH); }
:fcmpgt.d DG,DH,RD is b31_26=12 & b19_16=13 & b3_0=0 & DG & DH & RD { RD = zext(DG f> DH); }
:fcmpgt.s FG,FH,RD is b31_26=12 & b19_16=12 & b3_0=0 & FG & FH & RD { RD = zext(FG f> FH); }
:fcmpun.d DG,DH,RD is b31_26=12 & b19_16=11 & b3_0=0 & DG & DH & RD { RD = zext(nan(DG) || nan(DH)); }
:fcmpun.s FG,FH,RD is b31_26=12 & b19_16=10 & b3_0=0 & FG & FH & RD { RD = zext(nan(FG) || nan(FH)); }
:fcnv.ds DG,FF is b31_26=14 & b19_16=7 & b3_0=0 & DG & FF { FF = float2float(DG); }
:fcnv.sd FG,DF is b31_26=14 & b19_16=6 & b3_0=0 & FG & DF { DF = float2float(FG); }
:fdiv.d DG,DH,DF is b31_26=13 & b19_16=5 & b3_0=0 & DG & DH & DF { DF = DG f/ DH; }
:fdiv.s FG,FH,FF is b31_26=13 & b19_16=4 & b3_0=0 & FG & FH & FF { FF = FG f/ FH; }
:fgetscr FF is b31_26=7 & b25_20=63 & b19_16=2 & b15_10=63 & b3_0=0 & FF { FF = FPSCR; }
:fipr.s FVG,FVH,FF is b31_26=5 & b19_16=6 & b3_0=0 & FVG & FVH & FF { FF = fipr(FVG, FVH); }
:fld.d rm,imm_s10x8,DF is b31_26=39 & b3_0=0 & rm & imm_s10x8 & DF { local ea:8 = rm + imm_s10x8; DF = *:8 ea; }
:fld.p rm,imm_s10x8,fpf is b31_26=38 & b3_0=0 & rm & imm_s10x8 & fpf { local ea:8 = rm + imm_s10x8; fpf = *:8 ea; }
:fld.s rm,imm_s10x4,FF is b31_26=37 & b3_0=0 & rm & imm_s10x4 & FF { local ea:8 = rm + imm_s10x4; FF = *:4 ea; }
:fldx.d rm,rn,DF is b31_26=7 & b19_16=9 & b3_0=0 & rm & rn & DF { local ea:8 = rm + rn; DF = *:8 ea; }
:fldx.p rm,rn,fpf is b31_26=7 & b19_16=13 & b3_0=0 & rm & rn & fpf { local ea:8 = rm + rn; fpf = *:8 ea; }
:fldx.s rm,rn,FF is b31_26=7 & b19_16=8 & b3_0=0 & rm & rn & FF { local ea:8 = rm + rn; FF = *:4 ea; }
:float.ld FG,DF is b31_26=14 & b19_16=14 & b3_0=0 & FG & DF { DF = int2float(FG); }
:float.ls FG,FF is b31_26=14 & b19_16=12 & b3_0=0 & FG & FF { FF = int2float(FG); }
:float.qd DG,DF is b31_26=14 & b19_16=13 & b3_0=0 & DG & DF { DF = int2float(DG); }
:float.qs DG,FF is b31_26=14 & b19_16=15 & b3_0=0 & DG & FF { FF = int2float(DG); }
:fmac.s FG,FH,FF is b31_26=13 & b19_16=14 & b3_0=0 & FG & FH & FF { FF = (FG f* FH) f+ FF; }
:fmov.d DG,DF is b31_26=14 & b19_16=1 & b3_0=0 & DG & DF { DF = DG; }
:fmov.dq DG,RD is b31_26=12 & b19_16=1 & b3_0=0 & DG & RD { RD = DG; }
:fmov.ls rm,FF is b31_26=7 & b19_16=0 & b15_10=63 & b3_0=0 & rm & FF { FF = rm:4; }
:fmov.qd rm,DF is b31_26=7 & b19_16=1 & b15_10=63 & b3_0=0 & rm & DF { DF = rm; }
:fmov.s FG,FF is b31_26=14 & b19_16=0 & b3_0=0 & FG & FF { FF = FG; }
:fmov.sl FG,RD is b31_26=12 & b19_16=0 & b3_0=0 & FG & RD { RD = sext(FG); }
:fmul.d DG,DH,DF is b31_26=13 & b19_16=7 & b3_0=0 & DG & DH & DF { DF = DG f* DH; }
:fmul.s FG,FH,FF is b31_26=13 & b19_16=6 & b3_0=0 & FG & FH & FF { FF = FG f* FH; }
:fneg.d DG,DF is b31_26=6 & b19_16=3 & b3_0=0 & DG & DF { DF = f- DG; }
:fneg.s FG,FF is b31_26=6 & b19_16=2 & b3_0=0 & FG & FF { FF = f- FG; }
:fputscr FG is b31_26=12 & b19_16=2 & b9_4=63 & b3_0=0 & FG { FPSCR = FG; }
:fsqrt.d DG,DF is b31_26=14 & b19_16=5 & b3_0=0 & DG & DF { DF = sqrt(DG); }
:fsqrt.s FG,FF is b31_26=14 & b19_16=4 & b3_0=0 & FG & FF { FF = sqrt(FG); }
