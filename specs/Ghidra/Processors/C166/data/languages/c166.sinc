# MOVBS/MOVBZ: E = 0; Z from the source byte; N from its sign (MOVBS) or 0 (MOVBZ)
macro MoveSext(a, b) {
	local v:2 = sext(b);
	$(PSW_E) = 0;
	$(PSW_N) = (v s< 0);
	$(PSW_Z) = (v == 0);
	a = v;
}

macro MoveZext(a, b) {
	local v:2 = zext(b);
	$(PSW_E) = 0;
	$(PSW_N) = 0;
	$(PSW_Z) = (v == 0);
	a = v;
}

# MOVBS Rwn, Rbm
:movbs rwm, rbn is ExtCountDec & op=0xD0 & rwm & rbn {
	MoveSext(rwm, rbn);
}

# MOVBS reg, mem
:movbs ShortMemAddrW, LongMemAddrB is ExtCountDec & op=0xD2 & ShortMemAddrW; LongMemAddrB {
	MoveSext(ShortMemAddrW, LongMemAddrB);
}

# MOVBS mem, reg
:movbs LongMemAddrW, ShortMemAddrB is ExtCountDec & op=0xD5 & ShortMemAddrB; LongMemAddrW {
	MoveSext(LongMemAddrW, ShortMemAddrB);
}

# MOVBZ Rwn, Rbm
:movbz rwm, rbn is ExtCountDec & op=0xC0 & rwm & rbn {
	MoveZext(rwm, rbn);
}

# MOVBZ reg, mem
:movbz ShortMemAddrW, LongMemAddrB is ExtCountDec & op=0xC2 & ShortMemAddrW; LongMemAddrB {
	MoveZext(ShortMemAddrW, LongMemAddrB);
}

# MOVBZ mem, reg
:movbz LongMemAddrW, ShortMemAddrB is ExtCountDec & op=0xC5 & ShortMemAddrB; LongMemAddrW {
	MoveZext(LongMemAddrW, ShortMemAddrB);
}

macro Neg(a) {
	local x = a;
	$(PSW_C) = (x != 0);
	$(PSW_V) = (x != 0) && ((x << 1) == 0);
	setE(x);
	local result = 0 - x;
	setPostFlags(result);
	a = result;
}

# NEG Rwn
:neg rwn is ExtCountDec & op=0x81 & rwn & rwm=0 {
	Neg(rwn);
}

# ------

# NEGB Rwn
:negb rbn is ExtCountDec & op=0xA1 & rbn & rbm=0 {
	Neg(rbn);
}


# ------

define pcodeop __atomic;

# ATOMIC #irang2
:atomic SetAtomic is ExtCountDec & op=0xD1 & irang_mode=0 & SetAtomic {
	__atomic(SetAtomic:1);
}

# ------

# BFLDH bitoffQ, #mask8, #data8
:bfldh BitoffAddr, "#"^mask8h, DataImmB is ExtCountDec & op=0x1A & BitoffAddr; DataImmB & mask8h {
	local tmp = BitoffAddr;
	$(PSW_E) = 0;
	$(PSW_V) = 0;
	$(PSW_C) = 0;
	local mask_w:2 = zext(mask8h:1) << 8;
	local data_w:2 = zext(DataImmB) << 8;
	tmp = (tmp & ~mask_w) | data_w;
	BitoffAddr = tmp;
	setPostFlags(tmp);
}

# ------

# BFLDL bitoffQ, #mask8, #data8
:bfldl BitoffAddr, "#"^mask8, "#"^data8h is ExtCountDec & op=0x0A & BitoffAddr; mask8 & data8h {
	local tmp = BitoffAddr;
	$(PSW_E) = 0;
	$(PSW_V) = 0;
	$(PSW_C) = 0;
	tmp = (tmp & ~zext(mask8:1)) | zext(data8h:1);
	BitoffAddr = tmp;
	setPostFlags(tmp);
}

# ------

define pcodeop __disable_watchdog;

# DISWDT
:diswdt is ExtCountDec & op_32=0xA5A55AA5 {
	__disable_watchdog();
}

# ------

define pcodeop __end_of_init;

# EINIT
:einit is ExtCountDec & op_32=0xB5B54AB5 {
	__end_of_init();
}


# ------

define pcodeop __idle;

# IDLE
:idle is ExtCountDec & op_32=0x87877887 {
	__idle();
}

# ------

# NOP
:nop is ExtCountDec & op_noop=0x00CC {
}

# ------

define pcodeop __power_down;

# PWRDN
:pwrdn is ExtCountDec & op_32=0x97976897 {
	__power_down();
}

# ------

define pcodeop __software_reset;

# SRST
:srst is ExtCountDec & op_32=0xB7B748B7 {
	__software_reset();
}

# ------

define pcodeop __service_watchdog;

# SRVWDT
:srvwdt is ExtCountDec & op_32=0xA7A758A7 {
	__service_watchdog();
}

# ------

# JB bitaddrQ.q, rel
:jb BitoffAddr^"."bit_q, rel1623 is ExtCountDec & op=0x8A & BitoffAddr; bit_z = 0 & bit_q & rel1623 {
	if ((BitoffAddr & (1 << bit_q)) == 0) goto inst_next;
	goto rel1623;
}

# JNB bitaddrQ.q, rel
:jnb BitoffAddr^"."bit_q, rel1623 is ExtCountDec & op=0x9A & BitoffAddr; bit_z = 0 & bit_q & rel1623 {
	if ((BitoffAddr & (1 << bit_q)) != 0) goto inst_next;
	goto rel1623;
}

# JBC bitaddrQ.q, rel: jump if the bit is set and clear it; flags N = old bit, Z = not old bit
:jbc BitoffAddr^"."bit_q, rel1623 is ExtCountDec & op=0xAA & BitoffAddr; bit_z = 0 & bit_q & rel1623 {
	local word:2 = BitoffAddr;
	local old:2 = (word >> bit_q) & 1;
	setBitClearFlags(old);
	if (old == 0) goto inst_next;
	BitoffAddr = word & ~(1 << bit_q);
	goto rel1623;
}

# JNBS bitaddrQ.q, rel: jump if the bit is clear and set it
:jnbs BitoffAddr^"."bit_q, rel1623 is ExtCountDec & op=0xBA & BitoffAddr; bit_z = 0 & bit_q & rel1623 {
	local word:2 = BitoffAddr;
	local old:2 = (word >> bit_q) & 1;
	setBitClearFlags(old);
	if (old == 1) goto inst_next;
	BitoffAddr = word | (1 << bit_q);
	goto rel1623;
}

# JMPA cc, caddr
:jmpa cc1215, absCaddr is ExtCountDec & op=0xEA & rwm = 0 & cc1215; absCaddr {
	build cc1215;
	goto absCaddr;
}

# ------

# JMPI cc, [Rwn]
:jmpi cc1215, [rwm] is ExtCountDec & op=0x9C & cc1215 & rwm {
	build cc1215;
	local currAddr:3 = inst_start;
	local jmpAddr:3 = (currAddr & 0xFF0000) | zext(rwm);
	goto [jmpAddr];
}

# ------

# JMPR cc, rel
:jmpr cc0407, rel0815 is ExtCountDec & op0003=0xD & cc0407 & rel0815 {
	build cc0407;
	goto rel0815;
}

# ------

# JMPS seg, caddr
:jmps relSeg is ExtCountDec & op=0xFA ... & relSeg {
	local target:3 = &relSeg;
	CSP = zext(target[16,8]);
	goto relSeg;
}

# ------

# CALLA cc, caddr
:calla cc1215, absCaddr is ExtCountDec & op=0xCA & rwm = 0 & cc1215; absCaddr {
	build cc1215;
	PushNext();
	call absCaddr;
}

# ------

# CALLI cc, [Rwn]
:calli cc1215, [rwm] is ExtCountDec & op=0xAB & cc1215 & rwm {
	build cc1215;
	PushNext();
	local currAddr:3 = inst_start;
	local jmpAddr:3 = (currAddr & 0xFF0000) | zext(rwm);
	call [jmpAddr];
}

# ------

# CALLR rel
:callr rel0815 is ExtCountDec & op=0xBB & rel0815 {
	PushNext();
	call rel0815;
}

# ------

# CALLS seg, caddr: pushes CSP, then IP
:calls relSeg is ExtCountDec & op=0xDA ... & relSeg {
	local cs:2 = 0;
	CurrentCsp(cs);
	PushRet(cs);
	PushNext();
	local target:3 = &relSeg;
	CSP = zext(target[16,8]);
	call relSeg;
}

# ------

# PCALL reg, caddr: pushes the register, then IP
:pcall ShortMemAddrW, absCaddr is ExtCountDec & op=0xE2 & ShortMemAddrW; absCaddr {
	local pushed:2 = ShortMemAddrW;
	setE(pushed);
	setPostFlags(pushed);
	Push(pushed);
	PushNext();
	call absCaddr;
}

# ------

# RET
:ret is ExtCountDec & op_noop=0xCB {
	ReturnIntra();
}

# ------

# RETI: pops IP, CSP (segmentation enabled: SYSCON.SGTDIS = 0) and PSW
:reti is ExtCountDec & op_noop=0x88FB {
	local newip:2 = 0;
	local newcsp:2 = 0;
	local newpsw:2 = 0;
	PopRet(newip);
	PopRet(newcsp);
	Pop(newpsw);
	PSW = newpsw;
	CSP = newcsp;
	local retAddr:3 = (zext(newcsp & 0xff) << 16) | zext(newip);
	return [retAddr];
}

# ------

# RETP reg: pops IP, then the register
:retp ShortMemAddrW is ExtCountDec & op=0xEB & ShortMemAddrW {
	local newip:2 = 0;
	local popped:2 = 0;
	PopRet(newip);
	Pop(popped);
	ShortMemAddrW = popped;
	setE(popped);
	setPostFlags(popped);
	local retAddr:3 = (inst_start & 0xFF0000) | zext(newip);
	return [retAddr];
}

# ------

# RETS: pops IP, then CSP
:rets is ExtCountDec & op_noop=0xDB {
	ReturnInter();
}

# ------

# DIV Rwn: a divisor of zero sets V and leaves MD unchanged (the hardware result is not valid)
:div rwn is ExtCountDec & op=0x4B & RWnRWmEqual & rwn {
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_E) = 0;
	$(PSW_V) = (rwn == 0);
	if (rwn == 0) goto <done>;
	local dividend:2 = MDL;
	MDL = dividend s/ rwn;
	MDH = dividend s% rwn;
	<done>
	setPostFlags(MDL);
}

# ------

# DIVL Rwn
:divl rwn is ExtCountDec & op=0x6B & RWnRWmEqual & rwn {
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_E) = 0;
	$(PSW_V) = (rwn == 0);
	if (rwn == 0) goto <done>;
	local md:4 = zext(MDL) | (zext(MDH) << 16);
	local res:4 = md s/ sext(rwn);
	local rem:4 = md s% sext(rwn);
	MDL = res:2;
	MDH = rem:2;
	$(PSW_V) = (res != sext(res:2));
	<done>
	setPostFlags(MDL);
}

# ------

# DIVLU Rwn
:divlu rwn is ExtCountDec & op=0x7B & RWnRWmEqual & rwn {
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_E) = 0;
	$(PSW_V) = (rwn == 0);
	if (rwn == 0) goto <done>;
	local md:4 = zext(MDL) | (zext(MDH) << 16);
	local res:4 = md / zext(rwn);
	local rem:4 = md % zext(rwn);
	MDL = res:2;
	MDH = rem:2;
	$(PSW_V) = (res > 0xFFFF);
	<done>
	setPostFlags(MDL);
}

# ------

# DIVU Rwn
:divu rwn is ExtCountDec & op=0x5B & RWnRWmEqual & rwn {
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_E) = 0;
	$(PSW_V) = (rwn == 0);
	if (rwn == 0) goto <done>;
	local dividend:2 = MDL;
	MDL = dividend / rwn;
	MDH = dividend % rwn;
	<done>
	setPostFlags(MDL);
}

# ------

# MUL Rwn, Rwm
:mul rwn, rwm is ExtCountDec & op=0x0B & rwn & rwm {
	local res:4 = sext(rwn) * sext(rwm);
	MDL = res[0,16];
	MDH = res[16,16];
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_V) = (res != sext(res:2));
	$(PSW_E) = 0;
	setPostFlags(res);
}

# ------

# MULU Rwn, Rwm
:mulu rwn, rwm is ExtCountDec & op=0x1B & rwn & rwm {
	local res:4 = zext(rwn) * zext(rwm);
	MDL = res[0,16];
	MDH = res[16,16];
	MDC = MDC | (1 << 4);
	$(PSW_C) = 0;
	$(PSW_V) = (res > 0xFFFF);
	$(PSW_E) = 0;
	setPostFlags(res);
}

# ------

# POP reg: E, Z, N from the popped word
:pop ShortMemAddrW is ExtCountDec & op=0xFC & ShortMemAddrW {
	local popped:2 = 0;
	Pop(popped);
	setE(popped);
	setPostFlags(popped);
	ShortMemAddrW = popped;
}

# ------

# PUSH reg: E, Z, N from the pushed word
:push ShortMemAddrW is ExtCountDec & op=0xEC & ShortMemAddrW {
	local pushed:2 = ShortMemAddrW;
	setE(pushed);
	setPostFlags(pushed);
	Push(pushed);
}

# ------

# PRIOR Rwn, Rwm
:prior rwn, rwm is ExtCountDec & op=0x2B & rwn & rwm {
	rwn = 0;
	if (rwm == 0) goto <end>;
	rwn = lzcount(rwm);
	<end>
	$(PSW_N) = 0;
	$(PSW_C) = 0;
	$(PSW_V) = 0;
	$(PSW_Z) = (rwm == 0x0);
	$(PSW_E) = 0;
}

# ------

# EXTR #irang2
:extr SetExtr is ExtCountDec & op=0xD1 & irang_mode=2 & SetExtr { local NOP:1 = 0; }

# ------

# EXTP Rwm, #irang2
:extp SetExtpInd is ExtCountDec & op=0xDC & irang_mode=1 & SetExtpInd { local NOP:1 = 0; }

# EXTP #page, #irang2
:extp SetExtp is ExtCountDec & (op=0xD7 & irang_mode=1) ...& SetExtp { local NOP:1 = 0; }

# ------

# EXTPR Rwm, #irang2
:extpr SetExtpInd is ExtCountDec & op=0xDC & irang_mode=3 & SetExtpInd & SetExtr { local NOP:1 = 0; }

# EXTPR #page, #irang2
:extpr SetExtp is ExtCountDec & (op=0xD7 & irang_mode=3 & SetExtr) ... & SetExtp { local NOP:1 = 0; }

# ------

# EXTS Rwm, #irang2
:exts SetExtsInd is ExtCountDec & op=0xDC & irang_mode=0 & SetExtsInd { local NOP:1 = 0; }

# EXTPR #page, #irang2
:exts SetExts is ExtCountDec & (op=0xD7 & irang_mode=0) ... & SetExts { local NOP:1 = 0; }

# ------

# EXTSR Rwm, #irang2
:extsr SetExtsInd is ExtCountDec & op=0xDC & irang_mode=2 & SetExtsInd & SetExtr { local NOP:1 = 0; }

# EXTSR #page, #irang2
:extsr SetExts is ExtCountDec & (op=0xD7 & irang_mode=2 & SetExtr) ... & SetExts { local NOP:1 = 0; }


# ------

# SCXT reg, #data16: push the register, then load it
:scxt ShortMemAddrW, DataImmW is ExtCountDec & op=0xC6 & ShortMemAddrW; DataImmW {
	local old:2 = ShortMemAddrW;
	local new:2 = DataImmW;
	Push(old);
	ShortMemAddrW = new;
}

# SCXT reg, mem
:scxt ShortMemAddrW, LongMemAddrW is ExtCountDec & op=0xD6 & ShortMemAddrW; LongMemAddrW {
	local old:2 = ShortMemAddrW;
	local new:2 = LongMemAddrW;
	Push(old);
	ShortMemAddrW = new;
}

# ------

# TRAP #trap7: enters the interrupt vector (segment 0, address 4 * trap7) like an interrupt, without
# changing the CPU priority; assumes segmentation is enabled (SYSCON.SGTDIS = 0), so CSP is pushed.
:trap "#"^trap7 is ExtCountDec & op=0x9B & trap7 & trapAddr {
	local cs:2 = 0;
	CurrentCsp(cs);
	Push(PSW);
	PushRet(cs);
	PushNext();
	CSP = 0;
	call trapAddr;
}
