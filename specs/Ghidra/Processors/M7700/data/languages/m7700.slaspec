# Mitsubishi / Renesas 7700 Family CPU (M37700, M37702, M37710, ... and the 7750/7751 additions).
# Written for unlace (#98) from the Renesas 7700 Family Software Manual: chapter 4 instruction pages
# and the Appendix 2 hexadecimal instruction code tables (opcode pages 1, 42h and 89h).
# Data length (m), index length (x) and decimal mode (D) are decode-time context bits that
# SEP/CLP/SEM/CLM commit along the flow; memory is the 16 MB space of bank:address.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=3 default;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ A B X Y _ DPR PC PS ];
define register offset=0x30 size=3 [ S ];
define register offset=0x00 size=1 [ AL AH BL BH XL XH YL YH ];
define register offset=0x20 size=1 [ PG DT fN fV fm fx fD fI fZ fC IPL ];
define register offset=0x40 size=4 [ contextreg ];

define context contextreg
  mflag = (0,0)
  xflag = (1,1)
  dmode = (2,2)
;

define token op0(8) o0 = (0,7);
define token op1(8) o1 = (0,7);
define token t8(8) u8 = (0,7) s8 = (0,7) signed b8_m = (5,5) b8_x = (4,4) b8_d = (3,3);
define token t8b(8) v8 = (0,7);
define token t8c(8) w8 = (0,7) sw8 = (0,7) signed;
define token t16(16) u16 = (0,15) s16 = (0,15) signed;
define token t16b(16) v16 = (0,15);
define token t24(24) u24 = (0,23);

define pcodeop software_interrupt;
define pcodeop wait;
define pcodeop stop;
define pcodeop decimal_add;
define pcodeop decimal_sub;
define pcodeop decimal_add_carry;
define pcodeop decimal_sub_carry;

macro packPS(v) {
  v = (zext(IPL) << 8) | (zext(fN) << 7) | (zext(fV) << 6) | (zext(fm) << 5) | (zext(fx) << 4)
    | (zext(fD) << 3) | (zext(fI) << 2) | (zext(fZ) << 1) | zext(fC);
  PS = v;
}
macro unpackPS(v) {
  PS = v & 0x7ff;
  IPL = v[8,3]; fN = v[7,1]; fV = v[6,1]; fm = v[5,1]; fx = v[4,1]; fD = v[3,1]; fI = v[2,1]; fZ = v[1,1]; fC = v[0,1];
}
macro push1(v) { *:1 S = v; S = S - 1; }
macro push2(v) { S = S - 2; *:2 (S + 1) = v; }
macro pull1(v) { S = S + 1; v = *:1 S; }
macro pull2(v) { v = *:2 (S + 1); S = S + 2; }
macro resZN1(r) { fZ = (r == 0); fN = (r s< 0); }
macro resZN2(r) { fZ = (r == 0); fN = (r s< 0); }

XR: is xflag=0 { export X; }
XR: is xflag=1 { t:2 = zext(X:1); export t; }
YR: is xflag=0 { export Y; }
YR: is xflag=1 { t:2 = zext(Y:1); export t; }

Dir: u8 is u8 { a:3 = zext(DPR) + u8; export a; }
DirX: u8^",X" is u8 & XR { a:3 = zext(DPR) + u8 + zext(XR); export a; }
DirY: u8^",Y" is u8 & YR { a:3 = zext(DPR) + u8 + zext(YR); export a; }
DirInd: "("^u8^")" is u8 { p:3 = zext(DPR) + u8; q:2 = *:2 p; a:3 = (zext(DT) << 16) | zext(q); export a; }
DirXInd: "("^u8^",X)" is u8 & XR { p:3 = zext(DPR) + u8 + zext(XR); q:2 = *:2 p; a:3 = (zext(DT) << 16) | zext(q); export a; }
DirIndY: "("^u8^"),Y" is u8 & YR { p:3 = zext(DPR) + u8; q:2 = *:2 p; a:3 = ((zext(DT) << 16) | zext(q)) + zext(YR); export a; }
DirLInd: "L("^u8^")" is u8 { p:3 = zext(DPR) + u8; a:3 = *:3 p; export a; }
DirLIndY: "L("^u8^"),Y" is u8 & YR { p:3 = zext(DPR) + u8; q:3 = *:3 p; a:3 = q + zext(YR); export a; }
Sr: u8^",S" is u8 { a:3 = S + u8; export a; }
SrIndY: "("^u8^",S),Y" is u8 & YR { p:3 = S + u8; q:2 = *:2 p; a:3 = ((zext(DT) << 16) | zext(q)) + zext(YR); export a; }
Abs: u16 is u16 { a:3 = (zext(DT) << 16) | u16; export a; }
AbsX: u16^",X" is u16 & XR { a:3 = ((zext(DT) << 16) | u16) + zext(XR); export a; }
AbsY: u16^",Y" is u16 & YR { a:3 = ((zext(DT) << 16) | u16) + zext(YR); export a; }
Abl: u24 is u24 { export *[const]:3 u24; }
AblX: u24^",X" is u24 & XR { a:3 = u24 + zext(XR); export a; }

Imm8: "#"^u8 is u8 { export *[const]:1 u8; }
Imm16: "#"^u16 is u16 { export *[const]:2 u16; }
Imm8b: "#"^v8 is v8 { export *[const]:1 v8; }
Imm16b: "#"^v16 is v16 { export *[const]:2 v16; }

Rel8: dest is s8 [ dest = (inst_next & 0xff0000) | ((inst_next + s8) & 0xffff); ] { export *:1 dest; }
Rel8b: dest is sw8 [ dest = (inst_next & 0xff0000) | ((inst_next + sw8) & 0xffff); ] { export *:1 dest; }
Rel16: dest is s16 [ dest = (inst_next & 0xff0000) | ((inst_next + s16) & 0xffff); ] { export *:1 dest; }
JAbs: dest is u16 [ dest = (inst_start & 0xff0000) | u16; ] { export *:1 dest; }
JAbl: u24 is u24 { export *:1 u24; }

:BRK Imm8 is o0=0x00; Imm8 { r2:2 = inst_next; push1(PG); push2(r2); p:2 = 0; packPS(p); push2(p); fI = 1; software_interrupt(Imm8); }
:ORA "A", DirXInd is mflag=0 & o0=0x01; DirXInd { r:2 = A | *:2 DirXInd; resZN2(r); A = r; }
:ORA "A", DirXInd is mflag=1 & o0=0x01; DirXInd { r:1 = AL | *:1 DirXInd; resZN1(r); AL = r; }
:ORA "A", Sr is mflag=0 & o0=0x03; Sr { r:2 = A | *:2 Sr; resZN2(r); A = r; }
:ORA "A", Sr is mflag=1 & o0=0x03; Sr { r:1 = AL | *:1 Sr; resZN1(r); AL = r; }
:SEB Imm16b, Dir is mflag=0 & o0=0x04; Dir; Imm16b { *:2 Dir = *:2 Dir | Imm16b; }
:SEB Imm8b, Dir is mflag=1 & o0=0x04; Dir; Imm8b { *:1 Dir = *:1 Dir | Imm8b; }
:ORA "A", Dir is mflag=0 & o0=0x05; Dir { r:2 = A | *:2 Dir; resZN2(r); A = r; }
:ORA "A", Dir is mflag=1 & o0=0x05; Dir { r:1 = AL | *:1 Dir; resZN1(r); AL = r; }
:ASL Dir is mflag=0 & o0=0x06; Dir { v:2 = *:2 Dir; fC = (v s< 0); r:2 = v << 1; resZN2(r); *:2 Dir = r; }
:ASL Dir is mflag=1 & o0=0x06; Dir { v:1 = *:1 Dir; fC = (v s< 0); r:1 = v << 1; resZN1(r); *:1 Dir = r; }
:ORA "A", DirLInd is mflag=0 & o0=0x07; DirLInd { r:2 = A | *:2 DirLInd; resZN2(r); A = r; }
:ORA "A", DirLInd is mflag=1 & o0=0x07; DirLInd { r:1 = AL | *:1 DirLInd; resZN1(r); AL = r; }
:PHP is o0=0x08 { v:2 = 0; packPS(v); push2(v); }
:ORA "A", Imm16 is mflag=0 & o0=0x09; Imm16 { r:2 = A | Imm16; resZN2(r); A = r; }
:ORA "A", Imm8 is mflag=1 & o0=0x09; Imm8 { r:1 = AL | Imm8; resZN1(r); AL = r; }
:ASL "A" is mflag=0 & o0=0x0a { v:2 = A; fC = (v s< 0); r:2 = v << 1; resZN2(r); A = r; }
:ASL "A" is mflag=1 & o0=0x0a { v:1 = AL; fC = (v s< 0); r:1 = v << 1; resZN1(r); AL = r; }
:PHD is o0=0x0b { push2(DPR); }
:SEB Imm16b, Abs is mflag=0 & o0=0x0c; Abs; Imm16b { *:2 Abs = *:2 Abs | Imm16b; }
:SEB Imm8b, Abs is mflag=1 & o0=0x0c; Abs; Imm8b { *:1 Abs = *:1 Abs | Imm8b; }
:ORA "A", Abs is mflag=0 & o0=0x0d; Abs { r:2 = A | *:2 Abs; resZN2(r); A = r; }
:ORA "A", Abs is mflag=1 & o0=0x0d; Abs { r:1 = AL | *:1 Abs; resZN1(r); AL = r; }
:ASL Abs is mflag=0 & o0=0x0e; Abs { v:2 = *:2 Abs; fC = (v s< 0); r:2 = v << 1; resZN2(r); *:2 Abs = r; }
:ASL Abs is mflag=1 & o0=0x0e; Abs { v:1 = *:1 Abs; fC = (v s< 0); r:1 = v << 1; resZN1(r); *:1 Abs = r; }
:ORA "A", Abl is mflag=0 & o0=0x0f; Abl { r:2 = A | *:2 Abl; resZN2(r); A = r; }
:ORA "A", Abl is mflag=1 & o0=0x0f; Abl { r:1 = AL | *:1 Abl; resZN1(r); AL = r; }
:BPL Rel8 is o0=0x10; Rel8 { if (!fN) goto Rel8; }
:ORA "A", DirIndY is mflag=0 & o0=0x11; DirIndY { r:2 = A | *:2 DirIndY; resZN2(r); A = r; }
:ORA "A", DirIndY is mflag=1 & o0=0x11; DirIndY { r:1 = AL | *:1 DirIndY; resZN1(r); AL = r; }
:ORA "A", DirInd is mflag=0 & o0=0x12; DirInd { r:2 = A | *:2 DirInd; resZN2(r); A = r; }
:ORA "A", DirInd is mflag=1 & o0=0x12; DirInd { r:1 = AL | *:1 DirInd; resZN1(r); AL = r; }
:ORA "A", SrIndY is mflag=0 & o0=0x13; SrIndY { r:2 = A | *:2 SrIndY; resZN2(r); A = r; }
:ORA "A", SrIndY is mflag=1 & o0=0x13; SrIndY { r:1 = AL | *:1 SrIndY; resZN1(r); AL = r; }
:CLB Imm16b, Dir is mflag=0 & o0=0x14; Dir; Imm16b { *:2 Dir = *:2 Dir & ~Imm16b; }
:CLB Imm8b, Dir is mflag=1 & o0=0x14; Dir; Imm8b { *:1 Dir = *:1 Dir & ~Imm8b; }
:ORA "A", DirX is mflag=0 & o0=0x15; DirX { r:2 = A | *:2 DirX; resZN2(r); A = r; }
:ORA "A", DirX is mflag=1 & o0=0x15; DirX { r:1 = AL | *:1 DirX; resZN1(r); AL = r; }
:ASL DirX is mflag=0 & o0=0x16; DirX { v:2 = *:2 DirX; fC = (v s< 0); r:2 = v << 1; resZN2(r); *:2 DirX = r; }
:ASL DirX is mflag=1 & o0=0x16; DirX { v:1 = *:1 DirX; fC = (v s< 0); r:1 = v << 1; resZN1(r); *:1 DirX = r; }
:ORA "A", DirLIndY is mflag=0 & o0=0x17; DirLIndY { r:2 = A | *:2 DirLIndY; resZN2(r); A = r; }
:ORA "A", DirLIndY is mflag=1 & o0=0x17; DirLIndY { r:1 = AL | *:1 DirLIndY; resZN1(r); AL = r; }
:CLC is o0=0x18 { fC = 0; }
:ORA "A", AbsY is mflag=0 & o0=0x19; AbsY { r:2 = A | *:2 AbsY; resZN2(r); A = r; }
:ORA "A", AbsY is mflag=1 & o0=0x19; AbsY { r:1 = AL | *:1 AbsY; resZN1(r); AL = r; }
:DEC "A" is mflag=0 & o0=0x1a { v:2 = A; r:2 = v - 1; resZN2(r); A = r; }
:DEC "A" is mflag=1 & o0=0x1a { v:1 = AL; r:1 = v - 1; resZN1(r); AL = r; }
:TAS is o0=0x1b { S = zext(A); }
:CLB Imm16b, Abs is mflag=0 & o0=0x1c; Abs; Imm16b { *:2 Abs = *:2 Abs & ~Imm16b; }
:CLB Imm8b, Abs is mflag=1 & o0=0x1c; Abs; Imm8b { *:1 Abs = *:1 Abs & ~Imm8b; }
:ORA "A", AbsX is mflag=0 & o0=0x1d; AbsX { r:2 = A | *:2 AbsX; resZN2(r); A = r; }
:ORA "A", AbsX is mflag=1 & o0=0x1d; AbsX { r:1 = AL | *:1 AbsX; resZN1(r); AL = r; }
:ASL AbsX is mflag=0 & o0=0x1e; AbsX { v:2 = *:2 AbsX; fC = (v s< 0); r:2 = v << 1; resZN2(r); *:2 AbsX = r; }
:ASL AbsX is mflag=1 & o0=0x1e; AbsX { v:1 = *:1 AbsX; fC = (v s< 0); r:1 = v << 1; resZN1(r); *:1 AbsX = r; }
:ORA "A", AblX is mflag=0 & o0=0x1f; AblX { r:2 = A | *:2 AblX; resZN2(r); A = r; }
:ORA "A", AblX is mflag=1 & o0=0x1f; AblX { r:1 = AL | *:1 AblX; resZN1(r); AL = r; }
:JSR JAbs is o0=0x20; JAbs { r2:2 = inst_next; push2(r2); call JAbs; }
:AND "A", DirXInd is mflag=0 & o0=0x21; DirXInd { r:2 = A & *:2 DirXInd; resZN2(r); A = r; }
:AND "A", DirXInd is mflag=1 & o0=0x21; DirXInd { r:1 = AL & *:1 DirXInd; resZN1(r); AL = r; }
:JSRL JAbl is o0=0x22; JAbl & u24 { rp:3 = inst_next; g0:1 = PG; push1(g0); r2:2 = rp:2; push2(r2); t:3 = u24; PG = t(2); call JAbl; }
:AND "A", Sr is mflag=0 & o0=0x23; Sr { r:2 = A & *:2 Sr; resZN2(r); A = r; }
:AND "A", Sr is mflag=1 & o0=0x23; Sr { r:1 = AL & *:1 Sr; resZN1(r); AL = r; }
:BBS Imm16b, Dir, Rel8b is mflag=0 & o0=0x24; Dir; Imm16b; Rel8b { if ((*:2 Dir & Imm16b) == Imm16b) goto Rel8b; }
:BBS Imm8b, Dir, Rel8b is mflag=1 & o0=0x24; Dir; Imm8b; Rel8b { if ((*:1 Dir & Imm8b) == Imm8b) goto Rel8b; }
:AND "A", Dir is mflag=0 & o0=0x25; Dir { r:2 = A & *:2 Dir; resZN2(r); A = r; }
:AND "A", Dir is mflag=1 & o0=0x25; Dir { r:1 = AL & *:1 Dir; resZN1(r); AL = r; }
:ROL Dir is mflag=0 & o0=0x26; Dir { v:2 = *:2 Dir; c0:2 = zext(fC); fC = (v s< 0); r:2 = (v << 1) | c0; resZN2(r); *:2 Dir = r; }
:ROL Dir is mflag=1 & o0=0x26; Dir { v:1 = *:1 Dir; c0:1 = zext(fC); fC = (v s< 0); r:1 = (v << 1) | c0; resZN1(r); *:1 Dir = r; }
:AND "A", DirLInd is mflag=0 & o0=0x27; DirLInd { r:2 = A & *:2 DirLInd; resZN2(r); A = r; }
:AND "A", DirLInd is mflag=1 & o0=0x27; DirLInd { r:1 = AL & *:1 DirLInd; resZN1(r); AL = r; }
:PLP is o0=0x28 { v:2 = 0; pull2(v); unpackPS(v); }
:AND "A", Imm16 is mflag=0 & o0=0x29; Imm16 { r:2 = A & Imm16; resZN2(r); A = r; }
:AND "A", Imm8 is mflag=1 & o0=0x29; Imm8 { r:1 = AL & Imm8; resZN1(r); AL = r; }
:ROL "A" is mflag=0 & o0=0x2a { v:2 = A; c0:2 = zext(fC); fC = (v s< 0); r:2 = (v << 1) | c0; resZN2(r); A = r; }
:ROL "A" is mflag=1 & o0=0x2a { v:1 = AL; c0:1 = zext(fC); fC = (v s< 0); r:1 = (v << 1) | c0; resZN1(r); AL = r; }
:PLD is o0=0x2b { v:2 = 0; pull2(v); DPR = v; }
:BBS Imm16b, Abs, Rel8b is mflag=0 & o0=0x2c; Abs; Imm16b; Rel8b { if ((*:2 Abs & Imm16b) == Imm16b) goto Rel8b; }
:BBS Imm8b, Abs, Rel8b is mflag=1 & o0=0x2c; Abs; Imm8b; Rel8b { if ((*:1 Abs & Imm8b) == Imm8b) goto Rel8b; }
:AND "A", Abs is mflag=0 & o0=0x2d; Abs { r:2 = A & *:2 Abs; resZN2(r); A = r; }
:AND "A", Abs is mflag=1 & o0=0x2d; Abs { r:1 = AL & *:1 Abs; resZN1(r); AL = r; }
:ROL Abs is mflag=0 & o0=0x2e; Abs { v:2 = *:2 Abs; c0:2 = zext(fC); fC = (v s< 0); r:2 = (v << 1) | c0; resZN2(r); *:2 Abs = r; }
:ROL Abs is mflag=1 & o0=0x2e; Abs { v:1 = *:1 Abs; c0:1 = zext(fC); fC = (v s< 0); r:1 = (v << 1) | c0; resZN1(r); *:1 Abs = r; }
:AND "A", Abl is mflag=0 & o0=0x2f; Abl { r:2 = A & *:2 Abl; resZN2(r); A = r; }
:AND "A", Abl is mflag=1 & o0=0x2f; Abl { r:1 = AL & *:1 Abl; resZN1(r); AL = r; }
:BMI Rel8 is o0=0x30; Rel8 { if (fN) goto Rel8; }
:AND "A", DirIndY is mflag=0 & o0=0x31; DirIndY { r:2 = A & *:2 DirIndY; resZN2(r); A = r; }
:AND "A", DirIndY is mflag=1 & o0=0x31; DirIndY { r:1 = AL & *:1 DirIndY; resZN1(r); AL = r; }
:AND "A", DirInd is mflag=0 & o0=0x32; DirInd { r:2 = A & *:2 DirInd; resZN2(r); A = r; }
:AND "A", DirInd is mflag=1 & o0=0x32; DirInd { r:1 = AL & *:1 DirInd; resZN1(r); AL = r; }
:AND "A", SrIndY is mflag=0 & o0=0x33; SrIndY { r:2 = A & *:2 SrIndY; resZN2(r); A = r; }
:AND "A", SrIndY is mflag=1 & o0=0x33; SrIndY { r:1 = AL & *:1 SrIndY; resZN1(r); AL = r; }
:BBC Imm16b, Dir, Rel8b is mflag=0 & o0=0x34; Dir; Imm16b; Rel8b { if ((*:2 Dir & Imm16b) == 0) goto Rel8b; }
:BBC Imm8b, Dir, Rel8b is mflag=1 & o0=0x34; Dir; Imm8b; Rel8b { if ((*:1 Dir & Imm8b) == 0) goto Rel8b; }
:AND "A", DirX is mflag=0 & o0=0x35; DirX { r:2 = A & *:2 DirX; resZN2(r); A = r; }
:AND "A", DirX is mflag=1 & o0=0x35; DirX { r:1 = AL & *:1 DirX; resZN1(r); AL = r; }
:ROL DirX is mflag=0 & o0=0x36; DirX { v:2 = *:2 DirX; c0:2 = zext(fC); fC = (v s< 0); r:2 = (v << 1) | c0; resZN2(r); *:2 DirX = r; }
:ROL DirX is mflag=1 & o0=0x36; DirX { v:1 = *:1 DirX; c0:1 = zext(fC); fC = (v s< 0); r:1 = (v << 1) | c0; resZN1(r); *:1 DirX = r; }
:AND "A", DirLIndY is mflag=0 & o0=0x37; DirLIndY { r:2 = A & *:2 DirLIndY; resZN2(r); A = r; }
:AND "A", DirLIndY is mflag=1 & o0=0x37; DirLIndY { r:1 = AL & *:1 DirLIndY; resZN1(r); AL = r; }
:SEC is o0=0x38 { fC = 1; }
:AND "A", AbsY is mflag=0 & o0=0x39; AbsY { r:2 = A & *:2 AbsY; resZN2(r); A = r; }
:AND "A", AbsY is mflag=1 & o0=0x39; AbsY { r:1 = AL & *:1 AbsY; resZN1(r); AL = r; }
:INC "A" is mflag=0 & o0=0x3a { v:2 = A; r:2 = v + 1; resZN2(r); A = r; }
:INC "A" is mflag=1 & o0=0x3a { v:1 = AL; r:1 = v + 1; resZN1(r); AL = r; }
:TSA is o0=0x3b { A = S:2; }
:BBC Imm16b, Abs, Rel8b is mflag=0 & o0=0x3c; Abs; Imm16b; Rel8b { if ((*:2 Abs & Imm16b) == 0) goto Rel8b; }
:BBC Imm8b, Abs, Rel8b is mflag=1 & o0=0x3c; Abs; Imm8b; Rel8b { if ((*:1 Abs & Imm8b) == 0) goto Rel8b; }
:AND "A", AbsX is mflag=0 & o0=0x3d; AbsX { r:2 = A & *:2 AbsX; resZN2(r); A = r; }
:AND "A", AbsX is mflag=1 & o0=0x3d; AbsX { r:1 = AL & *:1 AbsX; resZN1(r); AL = r; }
:ROL AbsX is mflag=0 & o0=0x3e; AbsX { v:2 = *:2 AbsX; c0:2 = zext(fC); fC = (v s< 0); r:2 = (v << 1) | c0; resZN2(r); *:2 AbsX = r; }
:ROL AbsX is mflag=1 & o0=0x3e; AbsX { v:1 = *:1 AbsX; c0:1 = zext(fC); fC = (v s< 0); r:1 = (v << 1) | c0; resZN1(r); *:1 AbsX = r; }
:AND "A", AblX is mflag=0 & o0=0x3f; AblX { r:2 = A & *:2 AblX; resZN2(r); A = r; }
:AND "A", AblX is mflag=1 & o0=0x3f; AblX { r:1 = AL & *:1 AblX; resZN1(r); AL = r; }
:RTI is o0=0x40 { p:2 = 0; pull2(p); unpackPS(p); v:2 = 0; pull2(v); g:1 = 0; pull1(g); PG = g; t:3 = (zext(g) << 16) | zext(v); return [t]; }
:EOR "A", DirXInd is mflag=0 & o0=0x41; DirXInd { r:2 = A ^ *:2 DirXInd; resZN2(r); A = r; }
:EOR "A", DirXInd is mflag=1 & o0=0x41; DirXInd { r:1 = AL ^ *:1 DirXInd; resZN1(r); AL = r; }
:EOR "A", Sr is mflag=0 & o0=0x43; Sr { r:2 = A ^ *:2 Sr; resZN2(r); A = r; }
