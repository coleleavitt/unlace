# ALU Status Register (special register 132) fields: DF, V, N, Z, C (bits 11-7), BP (6-5),
# FC (4-0). BP and FC are also special registers 133 and 134.
define register offset=0x2000 size=1 [ DF V N Z C ];
define register offset=0x2010 size=4 [ BPr FCr CRr ];

# Am29050 floating-point accumulators (double precision)
define register offset=0x4000 size=8 [ acc0 acc1 acc2 acc3 ];

define register offset=0x5000 size=4 [ pc ];
define register offset=0x6000 size=4 [ contextreg ];

define token instr (32)
	op = (24,31)
	op7 = (25,31)
	m = (24,24)
	rc = (16,23)
	rc_l = (23,23)
	rc_n = (16,22) dec
	rc_g = (16,22)
	ra = (8,15)
	ra_l = (15,15)
	ra_n = (8,14) dec
	ra_g = (8,14)
	rb = (0,7)
	rb_l = (7,7)
	rb_n = (0,6) dec
	rb_g = (0,6)
	i8 = (0,7)
	i8dec = (0,7) dec
	ihi = (16,23)
	ihis = (16,23) signed
	vn = (16,23)
	sa = (8,15)
	ce = (23,23) dec
	cntl = (16,22)
	as = (22,22)
	pa = (21,21)
	sb = (20,20)
	ua = (19,19)
	opt = (16,18)
	b23_16 = (16,23)
	b15_8 = (8,15)
	b7_0 = (0,7)
	b7_4 = (4,7)
	ui = (7,7) dec
	rnd = (4,6) dec
	fd = (2,3) dec
	fs = (0,1) dec
	fmt = (2,3) dec
	acn = (0,1) dec
	func = (18,21) dec
	f3 = (21,21)
	f2 = (20,20)
	f1 = (19,19)
	f0 = (18,18)
	acn16 = (16,17) dec
	id = (16,17) dec
	b23_22 = (22,23)
	cev = (23,23)
	uiv = (7,7)
	fdv = (2,3)
	fsv = (0,1)
	fmtv = (2,3)
	idv = (16,17)
	acnv16 = (16,17)
	b23_18 = (18,23)
	b15_2 = (2,15)
;

define context contextreg
	unused = (0,0)
;

