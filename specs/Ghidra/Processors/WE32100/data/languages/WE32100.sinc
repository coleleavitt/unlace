{
  local a:4 = FA;
  local b:4 = FB;
  local xa:8 = sext(a);
  local xb:8 = sext(b);
  local r:8 = xa + xb;
  NF = (r s< 0);
  ZF = (r == 0);
  local tb:8 = r + 0x80;
  VF = ((tb >> 8) != 0);
  local ma:8 = zext(a & 0xff);
  local mb:8 = zext(b & 0xff);
  local s:8 = ma + mb;
  CF = ((s >> 8) != 0);
