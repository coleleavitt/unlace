    xd[96,32] = xd[96,32] + xp3;
    local xp4:4 = zext(xa[128,8]) * sext(xb[128,8]) + zext(xa[136,8]) * sext(xb[136,8]) + zext(xa[144,8]) * sext(xb[144,8]) + zext(xa[152,8]) * sext(xb[152,8]);
    xd[128,32] = xd[128,32] + xp4;
