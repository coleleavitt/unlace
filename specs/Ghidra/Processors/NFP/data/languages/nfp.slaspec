:jump "["^JREG^", "^JIMM^"], defer[3]" is cls7=0x74 & f31=0 & defer=3 & JREG & JIMM { t:4 = JREG * 8; delayslot(17); goto [t]; }


:ctx_arb "[kill]" is cls5=0x1c & evz=0 & noload=0 & bpt=0 { ctx_kill(); return [0:4]; }
:ctx_arb "[voluntary]" is cls5=0x1c & evz=1 & bpt=0 & resume=0 { ctx_arb(1:2); }
:ctx_arb "[bpt]" is cls5=0x1c & bpt=1 { ctx_arb(0:2); }
:ctx_arb "["^evmask^"]" is cls5=0x1c & bpt=0 & resume=0 & evmask { em:2 = evmask; ctx_arb(em); }
:ctx_arb "["^evmask^"], br["^TGT^"]" is cls5=0x1c & bpt=0 & resume=1 & evmask & TGT { em:2 = evmask; ctx_arb(em); goto TGT; }
CSRS: OSB10 is o0_hi2=3 & o10_hi2!=3 & OSB10 { export OSB10; }
CSRS: OSA0 is (o0_hi2!=3 | o10_hi2=3) & OSA0 { export OSA0; }
:local_csr_wr "["^csrnum^", "^CSRS^"]" is cls7=0x7e & b40=0 & b20=0 & csrwr=1 & csrnum & CSRS { cn:2 = csrnum; local_csr_wr(cn, CSRS); }
:local_csr_rd "["^csrnum^"]" is cls7=0x7e & b40=0 & b20=0 & csrwr=0 & csrnum { cn:2 = csrnum; LCSR_DATA = local_csr_rd(cn); }
:mul_step "["^AOP^", "^BOP^"], "^mtype^", "^mstep is cls7=0x7c & f24_29=0 & mtype & mstep & AOP & BOP & DST { mt:1 = mtype; ms:1 = mstep; DST = mult_step(AOP, BOP, mt, ms); }
CMDA: QSA0 is QSA0 { export QSA0; }
CMDB: QSB10 is QSB10 { export QSB10; }
:cmd "["^cmd_tgt^", $xfer_"^cmd_xfer^", "^CMDA^", "^CMDB^", "^cl^"], sig"^cmd_sig is b39=0 & cmz<5 & cmd_mode & cmd_tgt & cmd_xfer & cmd_sig & cmd_len & CMDA & CMDB [ cl = cmd_len + 1; ] {
  t:1 = cmd_tgt; md:1 = cmd_mode; x:1 = cmd_xfer; n:1 = cl; s:1 = cmd_sig; cpp_cmd(t, md, x, CMDA, CMDB, n, s);
}
:cmd "["^cmd_tgt^", $xfer_"^cmd_xfer^", "^cmd_b^", "^cmd_a^"], sig"^cmd_sig is b39=0 & cmz>=5 & cmd_mode & cmd_tgt & cmd_xfer & cmd_sig & cmd_len & cmd_a & cmd_b {
  t:1 = cmd_tgt; md:1 = cmd_mode; x:1 = cmd_xfer; av:2 = (cmd_b << 8) | cmd_a; n:1 = cmd_len; s:1 = cmd_sig; cpp_cmd(t, md, x, av, n, s);
}
