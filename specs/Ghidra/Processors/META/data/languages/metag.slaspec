# Shifts (major 5): bits 6-7 pick the shift, bit 25 an immediate count in bits 9-13, bit 27 sets the flags.
SA: RS9  is ibit=0 & RS9  { c:4 = RS9 & 0x1f; export c; }
SA: "#"imm5 is ibit=1 & imm5 { export *[const]:4 imm5; }
