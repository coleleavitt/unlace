# CCMP/CTEST source condition (same codes as Jcc except 1010 = T and 1011 = F) and default flags value.
apxScc: "O"  is apxSCC=0   { export OF; }
apxScc: "NO" is apxSCC=1   { local t = !OF; export t; }
apxScc: "B"  is apxSCC=2   { export CF; }
apxScc: "NB" is apxSCC=3   { local t = !CF; export t; }
apxScc: "Z"  is apxSCC=4   { export ZF; }
apxScc: "NZ" is apxSCC=5   { local t = !ZF; export t; }
apxScc: "BE" is apxSCC=6   { local t = CF || ZF; export t; }
apxScc: "A"  is apxSCC=7   { local t = !(CF || ZF); export t; }
apxScc: "S"  is apxSCC=8   { export SF; }
apxScc: "NS" is apxSCC=9   { local t = !SF; export t; }
apxScc: "T"  is apxSCC=10  { local t:1 = 1; export t; }
apxScc: "F"  is apxSCC=11  { local t:1 = 0; export t; }
apxScc: "L"  is apxSCC=12  { local t = OF != SF; export t; }
apxScc: "GE" is apxSCC=13  { local t = OF == SF; export t; }
apxScc: "LE" is apxSCC=14  { local t = ZF || (OF != SF); export t; }
apxScc: "G"  is apxSCC=15  { local t = !ZF && (OF == SF); export t; }

apxDfv: "{dfv=}" is apxDFV=0 { }
apxDfv: "{dfv=cf}" is apxDFV=1 { }
apxDfv: "{dfv=zf}" is apxDFV=2 { }
apxDfv: "{dfv=zf,cf}" is apxDFV=3 { }
apxDfv: "{dfv=sf}" is apxDFV=4 { }
apxDfv: "{dfv=sf,cf}" is apxDFV=5 { }
apxDfv: "{dfv=sf,zf}" is apxDFV=6 { }
apxDfv: "{dfv=sf,zf,cf}" is apxDFV=7 { }
apxDfv: "{dfv=of}" is apxDFV=8 { }
apxDfv: "{dfv=of,cf}" is apxDFV=9 { }
apxDfv: "{dfv=of,zf}" is apxDFV=10 { }
apxDfv: "{dfv=of,zf,cf}" is apxDFV=11 { }
apxDfv: "{dfv=of,sf}" is apxDFV=12 { }
apxDfv: "{dfv=of,sf,cf}" is apxDFV=13 { }
apxDfv: "{dfv=of,sf,zf}" is apxDFV=14 { }
apxDfv: "{dfv=of,sf,zf,cf}" is apxDFV=15 { }

# JMPABS (3.1.3.3): REX2 with M0=0 and W=0, opcode A1, a 64-bit absolute target.
apxAbs64: imm64 is imm64 { export *[ram]:8 imm64; }
:JMPABS apxAbs64 is $(LONGMODE_ON) & vexMode=0 & rex2prefix=1 & rexWprefix=0 & byte=0xa1; apxAbs64 { goto apxAbs64; }

