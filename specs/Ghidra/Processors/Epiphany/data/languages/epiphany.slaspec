:strd RD6, [RN6], "+"^D11 is xop4=12 & xws=3 & xb4=1 & xpm=1 & xsub=0 & RD6 & RN6 & D11 & RD6N { local ea = RN6; *:4 ea = RD6; *:4 (ea + 4) = RD6N; RN6 = ea + 8*D11; }
:strd RD6, [RN6], "-"^D11 is xop4=12 & xws=3 & xb4=1 & xpm=1 & xsub=1 & RD6 & RN6 & D11 & RD6N { local ea = RN6; *:4 ea = RD6; *:4 (ea + 4) = RD6N; RN6 = ea - 8*D11; }
