dsp32: xdD^" = ASHIFT "^xdA^" BY "^xdBL is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=0 & xs_6_8=0 & d_opc=2 & xs_sop=0 & xdD & xdA & xdBL {
  local amt:1 = xdBL:1; amt = (amt << 2) s>> 2; local a4:4 = sext(amt); local v:4 = xdA;
  if (a4 s< 0) goto <right>;
  xdD = v << a4; goto <done>;
  <right>
  xdD = v s>> (-a4);
  <done>
  nzflags(xdD);
}
dsp32: xdD^" = ASHIFT "^xdA^" BY "^xdBL^" (S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=0 & xs_6_8=0 & d_opc=2 & xs_sop=1 & xdD & xdA & xdBL { xdD = sat_shift(xdA, xdBL); nzflags(xdD); }
