<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="2" />
    <char_size value="1" />
    <short_size value="2" />
    <integer_size value="2" />
    <long_size value="4" />
  </data_organization>
  <global>
    <range space="code"/>
    <range space="data"/>
  </global>
  <stackpointer register="SP" space="data"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="3"/>
  </returnaddress>
  <default_proto>
    <!-- No compiler targets the core; this models hand-written E0C62 assembler routines that
         take and return values in A and B and leave the index registers to the callee. CALL
         and CALZ push three return-address nibbles that RET pops. -->
    <prototype name="__asm" extrapop="3" stackshift="3">
      <input>
        <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
        <pentry minsize="1" maxsize="1"><register name="B"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1"><register name="A"/></pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
      <killedbycall>
        <register name="A"/>
        <register name="B"/>
        <register name="C"/>
        <register name="Z"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
