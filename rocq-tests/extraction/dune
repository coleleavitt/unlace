; The extracted Coq oracle (knownbits_oracle.ml/.mli) + the driver, built into a
; single executable that emits the differential-oracle vector file. The .ml/.mli
; are regenerated by `coqc Extract.v` (see extraction_oracle.sh); we suppress
; warnings on the machine-generated extracted code.
(executable
 (name oracle_driver)
 (modules oracle_driver knownbits_oracle)
 (libraries zarith)
 (flags
  (:standard -w -a)))
