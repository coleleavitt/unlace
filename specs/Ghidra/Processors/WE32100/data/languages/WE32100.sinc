wmask:  is det = 0 | det = 1
{
  WM = 0xff;
}
wmask:  is det = 2 | det = 3
{
  WM = 0xffff;
}
wmask:  is det = 4 | det = 5
{
  WM = 0xffffffff;
}

fl_insf:  is kd = 2
{
  local nf:1 = 0;
}
fl_insf:  is kd != 2 & spsw = 1
{
  local nf:1 = 0;
}
fl_insf:  is kd != 2 & spsw = 0 & det = 0
{
  local res:4 = DV;
  NF = (res:1 s< 0);
  ZF = (res:1 == 0);
  CF = 0;
  local a:4 = FA;
  local b:4 = FB;
  local w:4 = (a & 0x1f) + 1;
  local o:4 = b & 0x1f;
  local m:4 = 0xffffffff >> (32 - w);
  local ro:4 = 32 - o;
  local fm:4 = (m << o) | (m >> ro);
  VF = ((fm & 0xffffff00) != 0);
}
