:SBC "A", "A" is dmode=0 & umode=0 & o0=0x18 { a:1 = A; b:1 = A; r:1 = a - b - zext(C); t:1 = a - b; C = (a < b) || (t < zext(C)); V = sborrow(a, b) ^^ sborrow(t, zext(C)); resZN(r); A = r; }
:SBC "A", "A" is dmode=1 & umode=0 & o0=0x18 {  a:1 = A; b:1 = A; r:1 = 0; bcdSub(a, b, C, r); A = r; }
