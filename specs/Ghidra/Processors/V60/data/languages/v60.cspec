<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="4"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
    <range space="io"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <default_proto>
    <prototype name="__jsr" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="R0"/>
        </pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="R1" piece2="R0"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="FP"/>
        <register name="AP"/>
      </unaffected>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
      </killedbycall>
    </prototype>
  </default_proto>
  <prototype name="__call" extrapop="unknown" stackshift="8">
    <input>
      <pentry minsize="1" maxsize="500" align="4">
        <addr offset="8" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="4">
        <register name="R0"/>
      </pentry>
      <pentry minsize="5" maxsize="8">
        <addr space="join" piece1="R1" piece2="R0"/>
      </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="FP"/>
      <register name="AP"/>
    </unaffected>
    <killedbycall>
      <register name="R0"/>
      <register name="R1"/>
    </killedbycall>
  </prototype>
</compiler_spec>
