mvsrc: "L1" is rm_gs=3 & rm_src=5 { export L1; }
mvsrc: "L2" is rm_gs=3 & rm_src=6 { export L2; }
mvsrc: "L3" is rm_gs=3 & rm_src=7 { export L3; }
mvsrc: "A0.X" is rm_gs=4 & rm_src=0 { local t:4 = sext(A0.X); export t; }
mvsrc: "A0.W" is rm_gs=4 & rm_src=1 { export A0.W; }
mvsrc: "A1.X" is rm_gs=4 & rm_src=2 { local t:4 = sext(A1.X); export t; }
mvsrc: "A1.W" is rm_gs=4 & rm_src=3 { export A1.W; }
mvsrc: "ASTAT" is rm_gs=4 & rm_src=6 { local t:4 = 0; packASTAT(t); export t; }
mvsrc: "RETS" is rm_gs=4 & rm_src=7 { export RETS; }
mvsrc: "LC0" is rm_gs=6 & rm_src=0 { export LC0; }
mvsrc: "LT0" is rm_gs=6 & rm_src=1 { export LT0; }
mvsrc: "LB0" is rm_gs=6 & rm_src=2 { export LB0; }
mvsrc: "LC1" is rm_gs=6 & rm_src=3 { export LC1; }
mvsrc: "LT1" is rm_gs=6 & rm_src=4 { export LT1; }
mvsrc: "LB1" is rm_gs=6 & rm_src=5 { export LB1; }
mvsrc: "CYCLES" is rm_gs=6 & rm_src=6 { export CYCLES; }
mvsrc: "CYCLES2" is rm_gs=6 & rm_src=7 { export CYCLES2; }
mvsrc: "USP" is rm_gs=7 & rm_src=0 { export USP; }
mvsrc: "SEQSTAT" is rm_gs=7 & rm_src=1 { export SEQSTAT; }
mvsrc: "SYSCFG" is rm_gs=7 & rm_src=2 { export SYSCFG; }
mvsrc: "RETI" is rm_gs=7 & rm_src=3 { export RETI; }
mvsrc: "RETX" is rm_gs=7 & rm_src=4 { export RETX; }
mvsrc: "RETN" is rm_gs=7 & rm_src=5 { export RETN; }
mvsrc: "RETE" is rm_gs=7 & rm_src=6 { export RETE; }
mvsrc: "EMUDAT" is rm_gs=7 & rm_src=7 { export EMUDAT; }

