:POPCNT Reg16, rm16 is $(APX_MAP4) & apxND=0 & apxNF=0 & $(APX_PP_V) & opsize=0 &            byte=0x88; Reg16 ... & rm16 { popcountflags(rm16); Reg16 = popcount(rm16); }
