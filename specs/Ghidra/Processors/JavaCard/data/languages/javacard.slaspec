define pcodeop jc_arraylength;
define pcodeop jc_athrow;
define pcodeop jc_checkcast;
define pcodeop jc_instanceof;
define pcodeop jc_impdep;
:nop is op=0 {
  
}
:aconst_null is op=1 {
  push2(0:2);
