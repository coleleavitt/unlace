# Analog Devices Blackfin (ADSP-BF5xx / BF6xx) core instruction set.
# Written from the Blackfin Processor Programming Reference (ADI, rev 2.2);
# encodings cross-checked against the GNU binutils bfin disassembler output.

define endian=little;
define alignment=2;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 P0 P1 P2 P3 P4 P5 SP FP
                                     I0 I1 I2 I3 M0 M1 M2 M3 B0 B1 B2 B3 L0 L1 L2 L3 ];
define register offset=0x00 size=2 [ R0.L R0.H R1.L R1.H R2.L R2.H R3.L R3.H R4.L R4.H R5.L R5.H R6.L R6.H R7.L R7.H P0.L P0.H P1.L P1.H P2.L P2.H P3.L P3.H P4.L P4.H P5.L P5.H SP.L SP.H FP.L FP.H I0.L I0.H I1.L I1.H I2.L I2.H I3.L I3.H M0.L M0.H M1.L M1.H M2.L M2.H M3.L M3.H B0.L B0.H B1.L B1.H B2.L B2.H B3.L B3.H L0.L L0.H L1.L L1.H L2.L L2.H L3.L L3.H ];
define register offset=0x00 size=1 [ R0.B _ _ _ R1.B _ _ _ R2.B _ _ _ R3.B _ _ _ R4.B _ _ _ R5.B _ _ _ R6.B _ _ _ R7.B _ _ _ ];
define register offset=0x80 size=8 [ A0 A1 ];
define register offset=0x80 size=4 [ A0.W _ A1.W _ ];
define register offset=0x84 size=1 [ A0.X ];
define register offset=0x8c size=1 [ A1.X ];
define register offset=0x90 size=4 [ RETS LC0 LT0 LB0 LC1 LT1 LB1 CYCLES CYCLES2 USP SEQSTAT SYSCFG
                                     RETI RETX RETN RETE EMUDAT PC MVTMP ];
define register offset=0x100 size=1 [ CC AZ AN AC0 AC1 AV0 AV0S AV1 AV1S AQ V VS AC0_COPY V_COPY RND_MOD ];
define register offset=0x200 size=4 [ contextreg ];

define context contextreg
  lpend  = (0,0) noflow
  lpc    = (1,1) noflow
  lpdelta = (2,13) noflow
;

