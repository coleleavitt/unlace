}

# VMINMAXPSZrrib (avx10_2.sinc)
:VMINMAXPS ZmmReg1^ZmmOpMask32, evexV5_ZmmReg, ZmmReg2, "{sae}", imm8 is $(EVEX_NONE) & $(EVEX_L512) & $(VEX_PRE_66) & $(VEX_0F3A) & $(VEX_W0) & ZmmOpMask32 & evexV5_ZmmReg & evexRcOn=1; byte=0x52; mod=3 & ZmmReg1 & ZmmReg2; imm8
{
	ZmmResult = avx10_vminmaxps(evexV5_ZmmReg, ZmmReg2, imm8:1);
