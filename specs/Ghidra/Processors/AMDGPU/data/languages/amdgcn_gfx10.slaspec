:s_subvector_loop_end uimm16 is e4=0xb & sopkop=28 & uimm16 { }

# f64 division helpers and the class compares (real-code sweep: clang -O2 f64 division).
:v_div_scale_f64 i0vp, i8_lo7d, F64_j0, F64_j9, F64_j18 is e6=0x35 ... & vop3op=366 ... & i0vp ... & i8_lo7d ... & F64_j0 ... & F64_j9 ... & F64_j18 ... {
  i0vp = div_scale(F64_j0, F64_j9, F64_j18); i8_lo7d = 0;
}
:v_div_fmas_f64 i0vp, F64_j0, F64_j9, F64_j18 is e6=0x35 ... & vop3op=368 ... & i0vp ... & F64_j0 ... & F64_j9 ... & F64_j18 ... {
  i0vp = (F64_j0 f* F64_j9) f+ F64_j18;
}
:v_div_fixup_f64 i0vp, F64_j0, F64_j9, F64_j18 is e6=0x35 ... & vop3op=352 ... & i0vp ... & F64_j0 ... & F64_j9 ... & F64_j18 ... {
  i0vp = div_fixup(F64_j0, F64_j9, F64_j18);
}
:v_cmp_class_f64 "vcc", V64F_i0, i9_vg is e7=0x3e ... & vopcop=168 ... & V64F_i0 ... & i9_vg ... { c:1 = cmp_class(V64F_i0, i9_vg); vcc_lo = zext(c); }
:v_cmp_class_f64_e64 i0_lo7d, F64_j0, V32_j9 is e6=0x35 ... & vop3op=168 ... & i0_h=0 ... & i0_lo7d ... & F64_j0 ... & (e6 ; V32_j9 ...) ... { c:1 = cmp_class(F64_j0, V32_j9); i0_lo7d = zext(c); }
:v_cmp_class_f32 "vcc", V32_i0, i9_vg is e7=0x3e ... & vopcop=136 ... & V32_i0 ... & i9_vg ... { c:1 = cmp_class(V32_i0, i9_vg); vcc_lo = zext(c); }
:v_cmp_class_f32_e64 i0_lo7d, F32_j0, V32_j9 is e6=0x35 ... & vop3op=136 ... & i0_h=0 ... & i0_lo7d ... & F32_j0 ... & (e6 ; V32_j9 ...) ... { c:1 = cmp_class(F32_j0, V32_j9); i0_lo7d = zext(c); }
