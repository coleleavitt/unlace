:ADDW2 sa,dmod is op=0x9c; sa; dmod; commit; fl_add [ et = 5; ]
{
  local a:4 = sa;
  local b:4 = dmod;
  FA = a;
  FB = b;
  DV = a + b;
  build commit;
  build fl_add;
}
