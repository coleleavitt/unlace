	if (!sg3) goto <sgbox1>;
		local sg5:4 = frs1:4;
		sv4 = sg5;
	<sgbox1>
	local sg6:8 = frs2 >> 32;
	local sg7:4 = sg6:4;
	local sg8:1 = sg7 == 0xffffffff:4;
	local sv9:4 = 0x7fc00000:4;
	if (!sg8) goto <sgbox2>;
