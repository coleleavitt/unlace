{ local tmp:32 = vsha512rnds2(YmmReg1, vexVVVV_YmmReg, XmmReg2); ZmmReg1 = zext(tmp); }

# AVX-VNNI (VEX VPDPBUSD/VPDPBUSDS/VPDPWSSD/VPDPWSSDS): dword dot products accumulated into the
# destination, the S forms saturating the exact sum to a signed dword (Intel SDM). Checked natively.
:VPDPBUSD XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NDS) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_XmmReg; byte=0x50; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
{
    local xa:16 = vexVVVV_XmmReg;
    local xb:16 = XmmReg2_m128;
    local xd:16 = XmmReg1;
    local xp0:4 = zext(xa[0,8]) * sext(xb[0,8]) + zext(xa[8,8]) * sext(xb[8,8]) + zext(xa[16,8]) * sext(xb[16,8]) + zext(xa[24,8]) * sext(xb[24,8]);
    xd[0,32] = xd[0,32] + xp0;
    local xp1:4 = zext(xa[32,8]) * sext(xb[32,8]) + zext(xa[40,8]) * sext(xb[40,8]) + zext(xa[48,8]) * sext(xb[48,8]) + zext(xa[56,8]) * sext(xb[56,8]);
    xd[32,32] = xd[32,32] + xp1;
    local xp2:4 = zext(xa[64,8]) * sext(xb[64,8]) + zext(xa[72,8]) * sext(xb[72,8]) + zext(xa[80,8]) * sext(xb[80,8]) + zext(xa[88,8]) * sext(xb[88,8]);
    xd[64,32] = xd[64,32] + xp2;
    local xp3:4 = zext(xa[96,8]) * sext(xb[96,8]) + zext(xa[104,8]) * sext(xb[104,8]) + zext(xa[112,8]) * sext(xb[112,8]) + zext(xa[120,8]) * sext(xb[120,8]);
    xd[96,32] = xd[96,32] + xp3;
    ZmmReg1 = zext(xd);
}
