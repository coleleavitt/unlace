<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="2" />
    <char_size value="1" />
    <short_size value="2" />
    <integer_size value="2" />
    <long_size value="4" />
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="S" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="1" size="2"/>
  </returnaddress>
  <default_proto>
    <!-- Mitsubishi NC79 convention (assumed, as for the 7700): the first argument in A (B for a second word),
         the rest on the stack above the 2-byte return address; results in A (B:A for 32 bits).
         JSR pushes the return address high byte first, so S points one below it. -->
    <prototype name="__stdcall" extrapop="2" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="2"><register name="A"/></pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="3" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2"><register name="A"/></pentry>
        <pentry minsize="3" maxsize="4"><register name="E"/></pentry>
      </output>
      <unaffected>
        <register name="S"/>
        <register name="DPR0"/>
        <register name="DPR1"/>
        <register name="DPR2"/>
        <register name="DPR3"/>
        <register name="DT"/>
      </unaffected>
      <killedbycall>
        <register name="A"/>
        <register name="B"/>
        <register name="X"/>
        <register name="Y"/>
        <register name="fN"/>
        <register name="fV"/>
        <register name="fZ"/>
        <register name="fC"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
