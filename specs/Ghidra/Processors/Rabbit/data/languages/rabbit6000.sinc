# Rabbit 6000 additions on top of the 4000 set: the 49 page (ALU with
# pointer-register and stack operands, pointer block moves, the multiply-
# accumulate loops, AES / SHA / MD5 helpers, the pointer-register chain
# shifts), 16/32-bit ALU on (IX+d)/(IY+d), SWAP, TSTNULL, CNVC/CNVD, MUL/MULU
# HL,DE and the ALTS / ALTSD prefixes. Included by rabbit.sinc under
# @define R6000. Written from Rabbit Semiconductor's Rabbit 6000 instruction
# spreadsheet; encodings cross-checked against z88dk's r6k test table.

define pcodeop puma;
define pcodeop pums;
define pcodeop aessr;
define pcodeop aesisr;
define pcodeop aesmc;
define pcodeop aesimc;


# 49 page: ALU with pointer-register and stack operands
:ADD "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=0 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a + v; C_flag = carry(a, v); LV_flag = scarry(a, v); resultFlags(r); T32 = r; build wJKHL; }
:ADD dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=0 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); add8(dA, A, v); }
:ADD dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=0 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local a:2 = HL; local r:2 = a + v; C_flag = carry(a, v); LV_flag = scarry(a, v); resultFlags(r); dHL = r; }
:ADD "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=0 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a + v; C_flag = carry(a, v); LV_flag = scarry(a, v); resultFlags(r); T32 = r; build wJKHL; }
:ADD dA,spn is $(N4) q0_8=0x49 ; q0_8=0x89 & dA ; spn { local v:1 = *[ram]:1 spn; add8(dA, A, v); }
:ADD dHL,spn is $(N4) q0_8=0x49 ; q0_8=0x8a & dHL ; spn { local v:2 = *[ram]:2 spn; local a:2 = HL; local r:2 = a + v; C_flag = carry(a, v); LV_flag = scarry(a, v); resultFlags(r); dHL = r; }
:ADD "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0x8b ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a + v; C_flag = carry(a, v); LV_flag = scarry(a, v); resultFlags(r); T32 = r; build wJKHL; }
:ADC "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=1 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a + v; r = t + c; C_flag = carry(a, v) || carry(t, c); LV_flag = scarry(a, v) ^^ scarry(t, c); resultFlags(r); T32 = r; build wJKHL; }
:ADC dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=1 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); adc8(dA, A, v); }
:ADC dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=1 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); adc16(dHL, HL, v); }
:ADC "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=1 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a + v; r = t + c; C_flag = carry(a, v) || carry(t, c); LV_flag = scarry(a, v) ^^ scarry(t, c); resultFlags(r); T32 = r; build wJKHL; }
:ADC dA,spn is $(N4) q0_8=0x49 ; q0_8=0x99 & dA ; spn { local v:1 = *[ram]:1 spn; adc8(dA, A, v); }
:ADC dHL,spn is $(N4) q0_8=0x49 ; q0_8=0x9a & dHL ; spn { local v:2 = *[ram]:2 spn; adc16(dHL, HL, v); }
:ADC "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0x9b ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a + v; r = t + c; C_flag = carry(a, v) || carry(t, c); LV_flag = scarry(a, v) ^^ scarry(t, c); resultFlags(r); T32 = r; build wJKHL; }
:SUB "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=2 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); T32 = r; build wJKHL; }
:SUB dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=2 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); sub8(dA, A, v); }
:SUB dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=2 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local a:2 = HL; local r:2 = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); dHL = r; }
:SUB "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=2 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); T32 = r; build wJKHL; }
:SUB dA,spn is $(N4) q0_8=0x49 ; q0_8=0xa9 & dA ; spn { local v:1 = *[ram]:1 spn; sub8(dA, A, v); }
:SUB dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xaa & dHL ; spn { local v:2 = *[ram]:2 spn; local a:2 = HL; local r:2 = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); dHL = r; }
:SUB "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xab ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); T32 = r; build wJKHL; }
:SBC "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=3 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a - v; r = t - c; C_flag = (a < v) || (t < c); LV_flag = sborrow(a, v) ^^ sborrow(t, c); resultFlags(r); T32 = r; build wJKHL; }
:SBC dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=3 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); sbc8(dA, A, v); }
:SBC dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=0 & qmid2=3 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); sbc16(dHL, HL, v); }
:SBC "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=0 & qmid2=3 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a - v; r = t - c; C_flag = (a < v) || (t < c); LV_flag = sborrow(a, v) ^^ sborrow(t, c); resultFlags(r); T32 = r; build wJKHL; }
:SBC dA,spn is $(N4) q0_8=0x49 ; q0_8=0xb9 & dA ; spn { local v:1 = *[ram]:1 spn; sbc8(dA, A, v); }
:SBC dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xba & dHL ; spn { local v:2 = *[ram]:2 spn; sbc16(dHL, HL, v); }
:SBC "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xbb ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; local c:4 = zext(C_flag); local t:4 = a - v; r = t - c; C_flag = (a < v) || (t < c); LV_flag = sborrow(a, v) ^^ sborrow(t, c); resultFlags(r); T32 = r; build wJKHL; }
:AND "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=0 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a & v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:AND dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=0 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); local r:1 = A & v; logic8(r); dA = r; }
:AND dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=0 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local r:2 = HL & v; logic16(r); dHL = r; }
:AND "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=0 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a & v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:AND dA,spn is $(N4) q0_8=0x49 ; q0_8=0xc9 & dA ; spn { local v:1 = *[ram]:1 spn; local r:1 = A & v; logic8(r); dA = r; }
:AND dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xca & dHL ; spn { local v:2 = *[ram]:2 spn; local r:2 = HL & v; logic16(r); dHL = r; }
:AND "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xcb ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a & v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:XOR "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=1 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a ^ v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:XOR dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=1 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); local r:1 = A ^ v; logic8(r); dA = r; }
:XOR dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=1 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local r:2 = HL ^ v; logic16(r); dHL = r; }
:XOR "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=1 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a ^ v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:XOR dA,spn is $(N4) q0_8=0x49 ; q0_8=0xd9 & dA ; spn { local v:1 = *[ram]:1 spn; local r:1 = A ^ v; logic8(r); dA = r; }
:XOR dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xda & dHL ; spn { local v:2 = *[ram]:2 spn; local r:2 = HL ^ v; logic16(r); dHL = r; }
:XOR "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xdb ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a ^ v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:OR "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=2 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a | v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:OR dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=2 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); local r:1 = A | v; logic8(r); dA = r; }
:OR dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=2 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local r:2 = HL | v; logic16(r); dHL = r; }
:OR "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=2 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a | v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:OR dA,spn is $(N4) q0_8=0x49 ; q0_8=0xe9 & dA ; spn { local v:1 = *[ram]:1 spn; local r:1 = A | v; logic8(r); dA = r; }
:OR dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xea & dHL ; spn { local v:2 = *[ram]:2 spn; local r:2 = HL | v; logic16(r); dHL = r; }
:OR "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xeb ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a | v; C_flag = 0; LV_flag = (r & 0xF0000000) != 0; resultFlags(r); T32 = r; build wJKHL; }
:CP "JKHL",qp01 is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=3 & qp01 & qlo4 & r6m=0 { local a:4 = 0; getJKHL(a); local v:4 = qp01; local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); }
:CP dA,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=3 & qp01 & r6m=1 & dA ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); cp8(A, v); }
:CP dHL,"("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=1 & qmid2=3 & qp01 & r6m=2 & dHL ; pdisp { local ea:4 = qp01 + pdisp; local v:2 = 0; pld(v, ea); local a:2 = HL; local r:2 = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); }
:CP "JKHL","("^qp01^pdisp^")" is $(N4) wJKHL & q0_8=0x49 ; qhi2=1 & qmid2=3 & qp01 & r6m=3 ; pdisp { local ea:4 = qp01 + pdisp; local v:4 = 0; pld(v, ea); local a:4 = 0; getJKHL(a); local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); }
:CP dA,spn is $(N4) q0_8=0x49 ; q0_8=0xf9 & dA ; spn { local v:1 = *[ram]:1 spn; cp8(A, v); }
:CP dHL,spn is $(N4) q0_8=0x49 ; q0_8=0xfa & dHL ; spn { local v:2 = *[ram]:2 spn; local a:2 = HL; local r:2 = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); }
:CP "JKHL",spn is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xfb ; spn { local v:4 = *[ram]:4 spn; local a:4 = 0; getJKHL(a); local r:4 = 0; r = a - v; C_flag = a < v; LV_flag = sborrow(a, v); resultFlags(r); }
:INC "("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=2 & qmid2=2 & qp01 & r6m=1 ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); local r:1 = v + 1; LV_flag = scarry(v, 1:1); resultFlags(r); pst(ea, r); }
:DEC "("^qp01^pdisp^")" is $(N4) q0_8=0x49 ; qhi2=2 & qmid2=3 & qp01 & r6m=1 ; pdisp { local ea:4 = qp01 + pdisp; local v:1 = 0; pld(v, ea); local r:1 = v - 1; LV_flag = sborrow(v, 1:1); resultFlags(r); pst(ea, r); }
:PLDI is $(N4) q0_8=0x49 ; q0_8=0xa0 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + 1; PY = PY + 1; LV_flag = BC != 0; }
:PLDIR is $(N4) q0_8=0x49 ; q0_8=0xb0 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + 1; PY = PY + 1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLDISR is $(N4) q0_8=0x49 ; q0_8=0x90 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PY = PY + 1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLSIR is $(N4) q0_8=0x49 ; q0_8=0xf0 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + 1; PY = PY + 1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLSIDR is $(N4) q0_8=0x49 ; q0_8=0xd0 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + 1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLDD is $(N4) q0_8=0x49 ; q0_8=0xa8 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + -1; PY = PY + -1; LV_flag = BC != 0; }
:PLDDR is $(N4) q0_8=0x49 ; q0_8=0xb8 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + -1; PY = PY + -1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLDDSR is $(N4) q0_8=0x49 ; q0_8=0x98 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PY = PY + -1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLSDR is $(N4) q0_8=0x49 ; q0_8=0xf8 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + -1; PY = PY + -1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PLSDDR is $(N4) q0_8=0x49 ; q0_8=0xd8 { local v:1 = 0; pld(v, PY); pst(PX, v); BC = BC - 1; PX = PX + -1; LV_flag = BC != 0; if (BC != 0) goto inst_start; }
:PUMA is $(N4) q0_8=0x49 ; q0_8=0xC0 { C_flag = puma(PX, PY, PZ, BC, DE, DE_, C_flag); BC = 0; }
:PUMS is $(N4) q0_8=0x49 ; q0_8=0xC8 { C_flag = pums(PX, PY, PZ, BC, DE, DE_, C_flag); BC = 0; }
:AESSR is $(N4) q0_8=0x49 ; q0_8=0xa2 { aessr(); }
:AESISR is $(N4) q0_8=0x49 ; q0_8=0xa3 { aesisr(); }
:AESMC is $(N4) q0_8=0x49 ; q0_8=0xb2 { aesmc(); }
:AESIMC is $(N4) q0_8=0x49 ; q0_8=0xb3 { aesimc(); }
:SHAF1 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xc2 { T32 = ((PX ^ PY) & PW) ^ PY; build wJKHL; }
:SHAF2 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xd2 { T32 = ((PW | PX) & PY) | (PW & PX); build wJKHL; }
:SHAF3 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xe2 { T32 = PW ^ PX ^ PY; build wJKHL; }
:MD5F1 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xc3 { T32 = (PW & PX) | ((~PW) & PY); build wJKHL; }
:MD5F2 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xd3 { T32 = (PY & PW) | ((~PY) & PX); build wJKHL; }
:MD5F3 is $(N4) wJKHL & q0_8=0x49 ; q0_8=0xe3 { T32 = PX ^ (PW | (~PY)); build wJKHL; }
