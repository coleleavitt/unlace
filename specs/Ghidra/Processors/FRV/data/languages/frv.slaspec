define register offset=0x0300 size=8 [ acc0 acc1 acc2 acc3 acc4 acc5 acc6 acc7 acc8 acc9 acc10 acc11 acc12 acc13 acc14 acc15 acc16 acc17 acc18 acc19 acc20 acc21 acc22 acc23 acc24 acc25 acc26 acc27 acc28 acc29 acc30 acc31 acc32 acc33 acc34 acc35 acc36 acc37 acc38 acc39 acc40 acc41 acc42 acc43 acc44 acc45 acc46 acc47 acc48 acc49 acc50 acc51 acc52 acc53 acc54 acc55 acc56 acc57 acc58 acc59 acc60 acc61 acc62 acc63 ];
define register offset=0x0500 size=1 [ accg0 accg1 accg2 accg3 accg4 accg5 accg6 accg7 accg8 accg9 accg10 accg11 accg12 accg13 accg14 accg15 accg16 accg17 accg18 accg19 accg20 accg21 accg22 accg23 accg24 accg25 accg26 accg27 accg28 accg29 accg30 accg31 accg32 accg33 accg34 accg35 accg36 accg37 accg38 accg39 accg40 accg41 accg42 accg43 accg44 accg45 accg46 accg47 accg48 accg49 accg50 accg51 accg52 accg53 accg54 accg55 accg56 accg57 accg58 accg59 accg60 accg61 accg62 accg63 ];
