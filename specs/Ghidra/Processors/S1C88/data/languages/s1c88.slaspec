:SBC "A", Imm8 is dmode=1 & umode=0 & o0=0x1A; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; bcdSub(a, b, C, r); A = r; }
:SBC "A", Imm8 is umode=1 & o0=0x1A; Imm8 {  a:1 = A; b:1 = Imm8; r:1 = 0; unpSub(a, b, C, r, D); A = r; }
:SBC "A", MHL is dmode=0 & umode=0 & o0=0x1B; MHL { a:1 = A; b:1 = *:1 MHL; r:1 = a - b - zext(C); t:1 = a - b; C = (a < b) || (t < zext(C)); V = sborrow(a, b) ^^ sborrow(t, zext(C)); resZN(r); A = r; }
