<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>
  <context_data>
    <context_set space="ram">
      <set name="phase" val="0"/>
    </context_set>
  </context_data>
  <volatile outputop="write_sfr" inputop="read_sfr">
    <range space="ram" first="0x0" last="0x03ff"/>
  </volatile>
</processor_spec>
