:INC rm8 is $(APX_MAP4) & apxNF=0 & apxND=0 & byte=0xfe; rm8 & reg_opcode=0 ... { local a:1 = rm8; OF = scarry(a, 1); local res = a + 1; resultflags(res); rm8 = res; }
