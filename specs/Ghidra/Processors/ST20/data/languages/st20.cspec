<?xml version="1.0" encoding="UTF-8"?>

<!-- ST20-C2/C4. call moves Wptr down four words and stores the return address at
     word 0 and Areg, Breg, Creg at words 1-3 of the new workspace; further arguments
     are stored by the caller at words 0.. of its own workspace, i.e. words 4.. of the
     callee's. So all arguments sit on the stack from offset 4, the first three being the
     evaluation stack at the call. ret reloads Iptr from word 0 and moves Wptr back up
     four words. The result is returned in Areg. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="4"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="4"/>
    <pointer_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="Wptr" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <default_proto>
    <prototype name="__st20" extrapop="16" stackshift="16">
      <input>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="Areg"/>
        </pentry>
      </output>
      <unaffected>
        <register name="Wptr"/>
      </unaffected>
      <killedbycall>
        <register name="Areg"/>
        <register name="Breg"/>
        <register name="Creg"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
