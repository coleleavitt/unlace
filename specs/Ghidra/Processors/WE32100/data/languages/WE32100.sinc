:JMP jmp_t is op=0x24; jmp_t
{
  build jmp_t;
}
:JSB jsb_t is op=0x34; jsb_t
{
  build jsb_t;
}
:CALL ea1,call_t is op=0x2c; ea1; call_t
{
  NAP = ea1;
  build call_t;
}

:BPT is op=0x2e
{
  psw = (psw & 0xffffff80) | 0x73;
  *:4 sp = inst_next;
  local pv:4 = 0;
  pswget(pv);
  *:4 (sp + 4) = pv;
  local g1:4 = 0;
  local g2:4 = *:4 g1;
  g2 = g2 + 112;
  local np:4 = *:4 g2;
  np = (np & 0xfffe1880) | ((psw & 0x1800) >> 2) | (psw & 0x1e000) | (psw & 0x100) | 0x3f;
  local npc:4 = *:4 (g2 + 4);
  pswset(np);
  sp = sp + 8;
  call [npc];
}
:EXTOP bd is op=0x14; bd
{
  psw = (psw & 0xffffff80) | 0x1b;
  *:4 sp = inst_start;
  local pv:4 = 0;
  pswget(pv);
  *:4 (sp + 4) = pv;
  local g1:4 = 0;
  local g2:4 = *:4 g1;
  g2 = g2 + 24;
  local np:4 = *:4 g2;
  np = (np & 0xfffe1880) | ((psw & 0x1800) >> 2) | (psw & 0x1e000) | (psw & 0x100) | 0x3f;
  local npc:4 = *:4 (g2 + 4);
  pswset(np);
  sp = sp + 8;
  call [npc];
}
:WAIT is op=0x2f
{
  wait_for_interrupt();
}
:CFLUSH is op=0x27
{
  cache_flush();
}
:MVERNO is op=0x30; op2=0x09
{
  r0 = 0x1a;
}
:ENBVJMP is op=0x30; op2=0x0d
{
  mmu_enable();
  goto [r0];
}
:DISVJMP is op=0x30; op2=0x13
{
  mmu_disable();
  goto [r0];
}
:INTACK is op=0x30; op2=0x2f
{
  r0 = interrupt_acknowledge();
}
:MOVBLW is op=0x30; op2=0x19
{
  <top>
  if (r2 == 0) goto <done>;
  *:4 r1 = *:4 r0;
  r2 = r2 - 1;
  r0 = r0 + 4;
  r1 = r1 + 4;
  goto <top>;
  <done>
}
:STREND is op=0x30; op2=0x1f
{
  <top>
  local ch:1 = *:1 r0;
  if (ch == 0) goto <done>;
  r0 = r0 + 1;
  goto <top>;
  <done>
}
:STRCPY is op=0x30; op2=0x35
{
  <top>
  local ch:1 = *:1 r0;
  *:1 r1 = ch;
  if (ch == 0) goto <done>;
  r0 = r0 + 1;
  r1 = r1 + 1;
  goto <top>;
  <done>
}
:GATE is op=0x30; op2=0x61
{
  *:4 sp = inst_next;
  psw = (psw & 0xffffff80) | 0x0a;
  local pv:4 = 0;
  pswget(pv);
  *:4 (sp + 4) = pv;
  local i1:4 = r0 & 0x7c;
  local i2:4 = r1 & 0x7ff8;
  local g2:4 = *:4 i1;
  g2 = g2 + i2;
  local np:4 = *:4 g2;
  np = (np & 0xfffe1880) | ((psw & 0x1800) >> 2) | (psw & 0x1e000) | (psw & 0x100) | 0x3f;
  local npc:4 = *:4 (g2 + 4);
  pswset(np);
  sp = sp + 8;
  call [npc];
}
:RETG is op=0x30; op2=0x45
{
  local npsw:4 = *:4 (sp - 4);
  local rpc:4 = *:4 (sp - 8);
  npsw = (npsw & 0xfc7e1e80) | (psw & 0x0381e100) | 0x3b;
  pswset(npsw);
  sp = sp - 8;
  return [rpc];
}
:CALLPS is op=0x30; op2=0xac
{
  local np:4 = r0;
  *:4 isp = pcbp;
  isp = isp + 4;
  psw = (psw & 0xffffff80) | 0x01;
  *:4 (pcbp + 4) = inst_next;
  psw = (psw & 0xfffffeff) | ((*:4 np) & 0x100);
  local ov:4 = 0;
  pswget(ov);
  *:4 pcbp = ov;
  *:4 (pcbp + 8) = sp;
  if ((psw & 0x100) == 0) goto <nor>;
  *:4 (pcbp + 24) = fp;
  *:4 (pcbp + 28) = r0;
  *:4 (pcbp + 32) = r1;
  *:4 (pcbp + 36) = r2;
  *:4 (pcbp + 40) = r3;
  *:4 (pcbp + 44) = r4;
  *:4 (pcbp + 48) = r5;
  *:4 (pcbp + 52) = r6;
  *:4 (pcbp + 56) = r7;
  *:4 (pcbp + 60) = r8;
  *:4 (pcbp + 20) = ap;
  fp = pcbp + 52;
  <nor>
  pcbp = np;
  local nps:4 = *:4 pcbp;
  nps = nps & 0xfffffffb;
  pswset(nps);
  local npc:4 = *:4 (pcbp + 4);
  sp = *:4 (pcbp + 8);
  if ((psw & 0x80) == 0) goto <noi>;
  psw = psw & 0xffffff7f;
  pcbp = pcbp + 12;
  <noi>
  psw = (psw & 0xffffff80) | 0x3b;
  if ((psw & 0x100) == 0) goto <nob>;
  r0 = pcbp + 64;
  r2 = *:4 r0;
  r0 = r0 + 4;
  <outer>
  if (r2 == 0) goto <odone>;
  r1 = *:4 r0;
  r0 = r0 + 4;
  <inner>
  if (r2 == 0) goto <idone>;
  *:4 r1 = *:4 r0;
  r2 = r2 - 1;
  r0 = r0 + 4;
  r1 = r1 + 4;
  goto <inner>;
  <idone>
  r2 = *:4 r0;
  r0 = r0 + 4;
  goto <outer>;
  <odone>
  r0 = r0 + 4;
  <nob>
  call [npc];
}
:RETPS is op=0x30; op2=0xc8
{
  isp = isp - 4;
  local np:4 = *:4 isp;
  local nps0:4 = *:4 np;
  psw = (psw & 0xfffffeff) | (nps0 & 0x100);
  pcbp = np;
  local nps:4 = *:4 pcbp;
  nps = nps & 0xfffffffb;
  pswset(nps);
  local npc:4 = *:4 (pcbp + 4);
  sp = *:4 (pcbp + 8);
  if ((psw & 0x80) == 0) goto <noi>;
  psw = psw & 0xffffff7f;
  pcbp = pcbp + 12;
  <noi>
  psw = (psw & 0xffffff80) | 0x3b;
  if ((psw & 0x100) == 0) goto <nob>;
  r0 = pcbp + 64;
  r2 = *:4 r0;
  r0 = r0 + 4;
  <outer>
  if (r2 == 0) goto <odone>;
  r1 = *:4 r0;
  r0 = r0 + 4;
  <inner>
  if (r2 == 0) goto <idone>;
  *:4 r1 = *:4 r0;
  r2 = r2 - 1;
  r0 = r0 + 4;
  r1 = r1 + 4;
  goto <inner>;
  <idone>
  r2 = *:4 r0;
  r0 = r0 + 4;
  goto <outer>;
  <odone>
  r0 = r0 + 4;
  <nob>
  if ((psw & 0x100) == 0) goto <nor>;
  fp = *:4 (np + 24);
  r0 = *:4 (np + 28);
  r1 = *:4 (np + 32);
  r2 = *:4 (np + 36);
  r3 = *:4 (np + 40);
  r4 = *:4 (np + 44);
  r5 = *:4 (np + 48);
  r6 = *:4 (np + 52);
  r7 = *:4 (np + 56);
  r8 = *:4 (np + 60);
  ap = *:4 (np + 20);
  <nor>
  return [npc];
}
