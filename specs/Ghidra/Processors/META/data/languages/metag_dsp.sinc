# DSP operand forms: a data-unit register (unit from bit 24) below 16, or a DSP RAM location
# (field values 16..31) the model does not track.
DST19: d0_19 is fb24=0 & fb23=0 & d0_19 { export d0_19; }
DST19: d1_19 is fb24=1 & fb23=0 & d1_19 { export d1_19; }
DST19: "[DSPRAM]" is fb23=1 { export DSPRAM; }
SRC14: d0_14 is fb24=0 & fb18=0 & d0_14 { export d0_14; }
SRC14: d1_14 is fb24=1 & fb18=0 & d1_14 { export d1_14; }
SRC14: "[DSPRAM]" is fb18=1 { export DSPRAM; }
SRC9: d0_9 is fb24=0 & fb13=0 & d0_9 { export d0_9; }
SRC9: d1_9 is fb24=1 & fb13=0 & d1_9 { export d1_9; }
SRC9: "[DSPRAM]" is fb13=1 { export DSPRAM; }
DSTC: d0_19 is fb24=0 & d0_19 { export d0_19; }
DSTC: d1_19 is fb24=1 & d1_19 { export d1_19; }
SRCC14: d0_14 is fb24=0 & d0_14 { export d0_14; }
SRCC14: d1_14 is fb24=1 & d1_14 { export d1_14; }
SRCC9: d0_9 is fb24=0 & d0_9 { export d0_9; }
SRCC9: d1_9 is fb24=1 & d1_9 { export d1_9; }

