<decompilertest>
<binaryimage arch="Dalvik:LE:32:DEX_Android12">
<!--
    Kuna DEX loader, synchronized and finally: P9 Java output, option
    javasync (default off; kuna-dex-javatry.xml covers the off form). The
    script loads the committed DEX fixture built from
    tests/stages/fixtures/dex/Tries.java and prints Java with the option on.

    Asserts #1-#2: sync's try, whose catch-all releases the monitor and
    rethrows, prints as synchronized (a0) { } with no monitor call left.
    Asserts #3-#5: withFinally's catch-all, which repeats the append the
    normal path runs after the try, prints as a finally clause; the rethrow
    and the normal path's copy go.
-->
<bytechunk space="ram" offset="0x0" readonly="true">0e00</bytechunk>
<symbol space="ram" offset="0x0" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/dex/tries.dex</com>
  <com>option setlanguage java-language</com>
  <com>option javasync on</com>
  <com>read symbols</com>
  <com>load function demo::Tries::sync</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file tests/stages/fixtures/dex/tries.dex</com>
  <com>option setlanguage java-language</com>
  <com>option javasync on</com>
  <com>read symbols</com>
  <com>load function demo::Tries::withFinally</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="javasync #1: sync prints synchronized (a0)" min="1" max="1">synchronized \(a0\) \{</stringmatch>
<stringmatch name="javasync #2: no monitor call is left" min="0" max="0">monitorEnter|monitorExit</stringmatch>
<stringmatch name="javasync #3: withFinally prints a finally clause" min="1" max="1">finally \{
a0\.append\(v2\);
\}</stringmatch>
<stringmatch name="javasync #4: the finally code prints once" min="1" max="1">a0\.append\(v2\);</stringmatch>
<stringmatch name="javasync #5: no catch-all or rethrow is left" min="0" max="0">catch \(Throwable|throw v</stringmatch>
</decompilertest>
