# AMD Am29000 family (29K): Am29000, Am29005, Am29030/35, Am29050, Am29200/205/240/243/245.
#
# Originally written by mumbel (https://github.com/mumbel/ghidra_a29k, Apache-2.0); reworked by
# the Ghidra-Rare project from AMD's Am29000 User's Manual (1987) and Am29050 Microprocessor
# User's Manual (1991). See CREDITS.md.
#
# Register model
# --------------
# Global registers gr0-gr127 live in the register space. gr0 is not a register: as an operand
# it means "the register whose number is in IPA, IPB or IPC" (for RA, RB, RC).
#
# Local registers lr0-lr127 are the processor's stack cache: lrN is absolute register
# 128 + ((gr1 >> 2) + N) mod 128, and it holds the run-time stack word at address gr1 + 4*N
# (the absolute register number is bits 8-2 of that address; the stack-cache spill and fill
# trap handlers keep the two consistent). This module models lrN as that memory word,
# *[ram]:4 (gr1 + 4*N). This is what makes calls work in Ghidra: a callee allocates its frame
# with "sub gr1,gr1,n", so the caller's lr2 becomes the callee's lr(n/4+2); with the memory
# view both are the same stack word (gr1 at entry + 8), i.e. an ordinary stack parameter, and
# the return address that "call lr0,..." writes is the word at gr1 at entry.
# Consequence: an operand gr0 whose indirect pointer names a local register reaches a separate
# absolute local register file (lra0-lra127), not the memory view; only trap handlers and
# context-switch code do that.
#
# Booleans: the 29K's TRUE is bit 31 set (compare instructions write 0x80000000 or 0; jumps
# test bit 31).

define alignment=4;

define space ram type=ram_space size=4 default;
define space io type=ram_space size=4;
define space register type=register_space size=4;

define register offset=0x0000 size=4 [
	gr0 gr1 gr2 gr3 gr4 gr5 gr6 gr7
	gr8 gr9 gr10 gr11 gr12 gr13 gr14 gr15
	gr16 gr17 gr18 gr19 gr20 gr21 gr22 gr23
	gr24 gr25 gr26 gr27 gr28 gr29 gr30 gr31
	gr32 gr33 gr34 gr35 gr36 gr37 gr38 gr39
	gr40 gr41 gr42 gr43 gr44 gr45 gr46 gr47
	gr48 gr49 gr50 gr51 gr52 gr53 gr54 gr55
	gr56 gr57 gr58 gr59 gr60 gr61 gr62 gr63
	gr64 gr65 gr66 gr67 gr68 gr69 gr70 gr71
	gr72 gr73 gr74 gr75 gr76 gr77 gr78 gr79
	gr80 gr81 gr82 gr83 gr84 gr85 gr86 gr87
	gr88 gr89 gr90 gr91 gr92 gr93 gr94 gr95
	gr96 gr97 gr98 gr99 gr100 gr101 gr102 gr103
	gr104 gr105 gr106 gr107 gr108 gr109 gr110 gr111
	gr112 gr113 gr114 gr115 gr116 gr117 gr118 gr119
	gr120 gr121 gr122 gr123 gr124 gr125 gr126 gr127
];
# absolute local register file, reached only through gr0 (IPA/IPB/IPC); see the notes above
define register offset=0x0200 size=4 [
	lra0 lra1 lra2 lra3 lra4 lra5 lra6 lra7
	lra8 lra9 lra10 lra11 lra12 lra13 lra14 lra15
