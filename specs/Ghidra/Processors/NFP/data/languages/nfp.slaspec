  a:4 = SA8; b:4 = SHB; r:4 = a & b; 
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", ~AND, "^SHB^"]" is cls3=4 & shfop=3 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = ~a & b; nzflags(r);
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", ~AND, "^SHB^"], no_cc" is cls3=4 & shfop=3 & sc!=3 & nocc=1 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = ~a & b; 
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", AND~, "^SHB^"]" is cls3=4 & shfop=4 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = a & ~b; nzflags(r);
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", AND~, "^SHB^"], no_cc" is cls3=4 & shfop=4 & sc!=3 & nocc=1 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = a & ~b; 
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", OR, "^SHB^"]" is cls3=4 & shfop=5 & sc!=3 & nocc=0 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = a | b; nzflags(r);
  D8 = r;
}
:alu_shf "["^D8^", "^SA8^", OR, "^SHB^"], no_cc" is cls3=4 & shfop=5 & sc!=3 & nocc=1 & D8 & SA8 & SHB {
  a:4 = SA8; b:4 = SHB; r:4 = a | b; 
  D8 = r;
}
:asr "["^D8^", "^SB8^", >>"^shift^"]" is cls3=4 & shfop=6 & sc!=3 & D8 & SB8 & shift { b:4 = SB8; r:4 = b s>> shift; nzflags(r); D8 = r; }
:dbl_shf "["^D8^", "^SA8^", "^SB8^", >>"^shift^"]" is cls3=4 & shfop<6 & sc=3 & D8 & SA8 & SB8 & shift {
  v:8 = (zext(SA8) << 32) | zext(SB8); v = v >> shift; r:4 = v:4; nzflags(r); D8 = r;
}
:byte_align "["^D8^", "^SB8^"]" is cls3=4 & shfop=7 & D8 & SB8 & SA8 { D8 = byte_align(SA8, SB8); }


# immed (bits 39-36 = 1111, 35 = 0): a 16-bit value from bits 20-27 and the immediate operand
# field, optionally inverted, placed in byte (immed_bN), word (immed_wN) or shifted left by
# 8 * bits 33-34; the other operand field is the destination (A or B bank).
IDST: ODA0 is o0_hi2!=3 & ODA0 { export ODA0; }
IDST: ODB10 is o0_hi2=3 & ODB10 { export ODB10; }
IVAL: "0x"^iv is o10_hi2=3 & imm8hi & o10_lo8 & inv=0 [ iv = (imm8hi << 8) | o10_lo8; ] { export *[const]:4 iv; }
IVAL: "0x"^iv is o10_hi2!=3 & imm8hi & o0_lo8 & inv=0 [ iv = (imm8hi << 8) | o0_lo8; ] { export *[const]:4 iv; }
IVAL: "0x"^iv is o10_hi2=3 & imm8hi & o10_lo8 & inv=1 [ iv = (((imm8hi << 8) | o10_lo8) $xor 0xffff) | 0xffff0000; ] { export *[const]:4 iv; }
IVAL: "0x"^iv is o10_hi2!=3 & imm8hi & o0_lo8 & inv=1 [ iv = (((imm8hi << 8) | o0_lo8) $xor 0xffff) | 0xffff0000; ] { export *[const]:4 iv; }
:nop is cls4=15 & b35=0 & b32=0 & b40=0 & o0_hi2=3 & o10_hi2=3 & imm8hi=0 & o10_lo8=0 { }
:immed "["^IDST^", "^IVAL^"]" is cls4=15 & b35=0 & b32=0 & b40=0 & by=0 & wd=0 & bsz=0 & IDST & IVAL { IDST = IVAL; }
:immed "["^IDST^", "^IVAL^", <<"^sh^"]" is cls4=15 & b35=0 & b32=0 & b40=0 & by=0 & wd=0 & bsz!=0 & bshift & IDST & IVAL [ sh = bshift * 8; ] { IDST = IVAL << sh; }
:immed_b^bshift "["^IDST^", "^IVAL^"]" is cls4=15 & b35=0 & b32=0 & b40=0 & by=1 & bshift & IDST & IVAL {
  sh:4 = bshift * 8;
  v:4 = (IVAL & 0xff) << sh; m:4 = 0xff << sh; IDST = (IDST & ~m) | v;
}
:immed_w^wn "["^IDST^", "^IVAL^"]" is cls4=15 & b35=0 & b32=0 & b40=0 & by=0 & wd=1 & bshift & IDST & IVAL [ wn = bshift >> 1; ] {
  sh:4 = wn * 16;
  v:4 = (IVAL & 0xffff) << sh; m:4 = 0xffff << sh; IDST = (IDST & ~m) | v;
}


# ld_field[dst, mask, src, shift] (bits 39-35 = 11000): the bytes selected by the 4-bit mask
# come from the shifted source; ld_field_w_clr clears the others; load_cc sets the flags.
LDD: QDA0  is swap8=0 & QDA0  { export QDA0; }
LDD: QDB10 is swap8=1 & QDB10 { export QDB10; }
LDS: QSB10 is swap8=0 & QSB10 { export QSB10; }
LDS: QSA0  is swap8=1 & QSA0  { export QSA0; }
LSH: LDS is sc=0 & shz=0 & LDS { export LDS; }
LSH: LDS^", >>rot"^shift is sc=0 & shz!=0 & LDS & shift { b:4 = LDS; r:4 = (b >> shift) | (b << (32 - shift)); export r; }
LSH: LDS^", >>"^shift is sc=1 & LDS & shift { b:4 = LDS; r:4 = b >> shift; export r; }
LSH: LDS^", <<"^sl is sc=2 & shz!=0 & LDS & shift [ sl = 32 - shift; ] { b:4 = LDS; r:4 = b << sl; export r; }
LSH: LDS^", <<indirect" is sc=2 & shz=0 & LDS { b:4 = LDS; r:4 = indirect_shift(b); export r; }
LSH: LDS^", >>dbl"^shift is sc=3 & LDS & shift { b:4 = LDS; r:4 = indirect_shift(b); export r; }
:ld_field "["^LDD^", "^bmask^", "^LSH^"]" is ldcc=0 & cls5=0x18 & b40=0 & b33=0 & f21_23=0 & zerof=0 & bmask & LDD & LSH {
  bm:4 = ((bmask & 1) * 0xff) | ((bmask & 2) * 0x7f80) | ((bmask & 4) * 0x3fc000) | ((bmask & 8) * 0x1fe00000);
  v:4 = LSH; d:4 = (LDD & ~bm) | (v & bm);
  LDD = d;
}
:ld_field "["^LDD^", "^bmask^", "^LSH^"], load_cc" is ldcc=1 & cls5=0x18 & b40=0 & b33=0 & f21_23=0 & zerof=0 & bmask & LDD & LSH {
  bm:4 = ((bmask & 1) * 0xff) | ((bmask & 2) * 0x7f80) | ((bmask & 4) * 0x3fc000) | ((bmask & 8) * 0x1fe00000);
  v:4 = LSH; d:4 = (LDD & ~bm) | (v & bm);
  nzflags(d);
  LDD = d;
}
:ld_field_w_clr "["^LDD^", "^bmask^", "^LSH^"]" is ldcc=0 & cls5=0x18 & b40=0 & b33=0 & f21_23=0 & zerof=1 & bmask & LDD & LSH {
  bm:4 = ((bmask & 1) * 0xff) | ((bmask & 2) * 0x7f80) | ((bmask & 4) * 0x3fc000) | ((bmask & 8) * 0x1fe00000);
  v:4 = LSH; d:4 = v & bm;
  LDD = d;
}
:ld_field_w_clr "["^LDD^", "^bmask^", "^LSH^"], load_cc" is ldcc=1 & cls5=0x18 & b40=0 & b33=0 & f21_23=0 & zerof=1 & bmask & LDD & LSH {
  bm:4 = ((bmask & 1) * 0xff) | ((bmask & 2) * 0x7f80) | ((bmask & 4) * 0x3fc000) | ((bmask & 8) * 0x1fe00000);
  v:4 = LSH; d:4 = v & bm;
  nzflags(d);
  LDD = d;
}


# Branches: the target instruction number is bit 40 : bits 22-34 (byte address 8 * n);
# bits 20-21 defer that many following instructions past the branch.
TGT: ta is thi & tlo [ ta = ((thi << 13) | tlo) * 8; ] { export *:4 ta; }

BYR: QSB10 is o0_b5=1 & QSB10 { export QSB10; }
BYR: QSA0 is o0_b5=0 & QSA0 { export QSA0; }
BYV: QSA0 is o0_b5=1 & QSA0 { export QSA0; }
BYV: QSB10 is o0_b5=0 & QSB10 { export QSB10; }
BBR: QSB10 is o0_b5=1 & QSB10 { export QSB10; }
BBR: QSA0 is o0_b5=0 & QSA0 { export QSA0; }
BBN: bn is o0_b5=1 & o0_hi8_2 & o0_lo5 [ bn = (((o0_hi8_2 << 5) | o0_lo5) - 1) & 0x1f; ] { export *[const]:4 bn; }
BBN: bn is o0_b5=0 & o10_hi8_2 & o10_lo5 [ bn = (((o10_hi8_2 << 5) | o10_lo5) - 1) & 0x1f; ] { export *[const]:4 bn; }
JREG: OSB10 is o0_hi2=3 & OSB10 { export OSB10; }
JREG: OSA0 is o0_hi2!=3 & OSA0 { export OSA0; }
JIMM: "."^jv is o0_hi2=3 & brimm & o0_lo8 [ jv = (brimm << 8) | o0_lo8; ] { export *[const]:4 jv; }
JIMM: "."^jv is o0_hi2!=3 & brimm & o10_lo8 [ jv = (brimm << 8) | o10_lo8; ] { export *[const]:4 jv; }
TGT2: "."^tn is thi & tlo [ tn = (thi << 13) | tlo; ] { export *[const]:4 tn; }
:beq "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=0 & defer=0 & TGT { c:1 = ZF;  if (c) goto TGT; }
:bne "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=1 & defer=0 & TGT { c:1 = !ZF;  if (c) goto TGT; }
:bmi "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=2 & defer=0 & TGT { c:1 = NF;  if (c) goto TGT; }
:bpl "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=3 & defer=0 & TGT { c:1 = !NF;  if (c) goto TGT; }
:bcs "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=4 & defer=0 & TGT { c:1 = CF;  if (c) goto TGT; }
:bcc "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=5 & defer=0 & TGT { c:1 = !CF;  if (c) goto TGT; }
:bvs "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=6 & defer=0 & TGT { c:1 = VF;  if (c) goto TGT; }
:bvc "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=7 & defer=0 & TGT { c:1 = !VF;  if (c) goto TGT; }
:bge "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=8 & defer=0 & TGT { c:1 = NF == VF;  if (c) goto TGT; }
:blt "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=9 & defer=0 & TGT { c:1 = NF != VF;  if (c) goto TGT; }
:ble "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=10 & defer=0 & TGT { c:1 = ZF || (NF != VF);  if (c) goto TGT; }
:bgt "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=11 & defer=0 & TGT { c:1 = !ZF && (NF == VF);  if (c) goto TGT; }
:br "["^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=24 & defer=0 & TGT {  goto TGT; }
:br_ctx_eq "["^ctxsig^", "^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=16 & defer=0 & ctxsig & TGT { cs:1 = ctxsig; c:1 = ctx_state(16:1, cs);  if (c) goto TGT; }
:br_ctx_ne "["^ctxsig^", "^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=17 & defer=0 & ctxsig & TGT { cs:1 = ctxsig; c:1 = ctx_state(17:1, cs);  if (c) goto TGT; }
:br_signal "["^ctxsig^", "^TGT^"]" is cls5=0x1b & f5_7=1 & f10_13=0 & f18_19=0 & brop=18 & defer=0 & ctxsig & TGT { cs:1 = ctxsig; c:1 = ctx_state(18:1, cs);  if (c) goto TGT; }
