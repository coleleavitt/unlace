vd80: "-" is Vdk=7 ; Vfdr {}
va80: "-" is Vak=7 ; Vfar {}
vb80: vb80v is Vimm=0 ... & vb80v { local t:4 = 0; export t; }
vbs9: is Vl7=0 ; Vi2=0 { local t:4 = 0; export t; }
vbs9: "+"^off is Vl7 ; Vi2 [ off = ((Vi2 & 1) << 7) | Vl7; ] { local t:4 = off; export t; }
vbs9: "-"^off is Vl7 ; Vi2 & Vi2hi=1 [ off = 256 - (((Vi2 & 1) << 7) | Vl7); ] { local t:4 = -off; export t; }
vb80: Vfbr^vbs9 is (Vimm=0 & Vbk=7 ; Vfbr) & vbs9 { local t:4 = Vfbr + vbs9; export t; }
vb80: imm is Vimm=1 & Vimm10 ; Vfb [ imm = (Vfb << 10) | Vimm10; ] { local t:4 = imm; export t; }
vsru80: Vsru is Vsrusel=0 & Vsru {}
vsru80: Vsru is Vsrusel=1 & Vsru & Vsrureg & Vsruop { local t:1 = Vsruop; Vsrureg = vector_sru(t); }
vflags80: Vrep^Vsetf80^Vpred80^vsru80 is Vrep & Vsetf80 ; Vpred80 & vsru80 { build vsru80; }

# memory operand: (rb) in the 48-bit forms; in the 80-bit forms either a vector/immediate operand
# or imm16(rs+=rX) when D or A is the 1110 discard pattern carrying the stride register
vmemb48: (Vbreg) is Vimm=0 & Vbk=7 & Vbreg45=0 & Vbreg { export Vbreg; }
# rb:6 with bit 4 or 5 set: no scalar register (binutils-vc4 marks the bits "?bitN?")
vmemb48: ("r"^Vbreg6) is Vimm=0 & Vbk=7 & Vbreg6 { local t:4 = 0; export t; }
vmemb48: vb48 is vb48 { export vb48; }
vmemimm: off is Vl7 ; Vi7 & Vi2 [ off = (((Vi7 << 2) | Vi2) << 7) | Vl7; ] { local t:4 = off; export t; }

# 48-bit memory operations
:"v"^Vmwidth^"ld" vd48, va48, vmemb48^vflags48 is Vclass=0x1e & Vkind=0 & Vmop=0 & Vmwidth & Vaccw & vd48 & va48 & vmemb48 & vflags48 { vector_load(0:1, vmemb48); }
:"v"^Vmwidth^"lookupmh" vd48, va48, vmemb48^vflags48 is Vclass=0x1e & Vkind=0 & Vmop=1 & Vmwidth & Vaccw & vd48 & va48 & vmemb48 & vflags48 { vector_load(1:1, vmemb48); }
