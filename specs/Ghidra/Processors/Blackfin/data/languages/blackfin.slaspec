mvsrc: "FP" is rm_gs=1 & rm_src=7 { export FP; }
mvsrc: "I0" is rm_gs=2 & rm_src=0 { export I0; }
mvsrc: "I1" is rm_gs=2 & rm_src=1 { export I1; }
mvsrc: "I2" is rm_gs=2 & rm_src=2 { export I2; }
mvsrc: "I3" is rm_gs=2 & rm_src=3 { export I3; }
mvsrc: "M0" is rm_gs=2 & rm_src=4 { export M0; }
mvsrc: "M1" is rm_gs=2 & rm_src=5 { export M1; }
mvsrc: "M2" is rm_gs=2 & rm_src=6 { export M2; }
mvsrc: "M3" is rm_gs=2 & rm_src=7 { export M3; }
mvsrc: "B0" is rm_gs=3 & rm_src=0 { export B0; }
mvsrc: "B1" is rm_gs=3 & rm_src=1 { export B1; }
mvsrc: "B2" is rm_gs=3 & rm_src=2 { export B2; }
mvsrc: "B3" is rm_gs=3 & rm_src=3 { export B3; }
