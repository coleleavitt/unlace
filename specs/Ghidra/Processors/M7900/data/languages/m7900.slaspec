# Mitsubishi / Renesas 7900 Series CPU (M37902, M37905, M37906, ...).
# Written for unlace (#98) from the Renesas 7900 Series Software Manual: chapter 2 (registers),
# chapter 3 (addressing), and the machine-code rows of the chapter 4 instruction pages.
# Data length (m), index length (x) and decimal mode (D) are decode-time context bits that
# SEP/CLP/SEM/CLM commit along the flow. dpr4 selects the DPR0-DPR3 direct-page mode
# (processor mode register 1); it is set per language in the pspec.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=3 default;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ A B X Y _ DPR0 DPR1 DPR2 DPR3 PC PS ];
define register offset=0x00 size=4 [ E ];
define register offset=0x00 size=1 [ AL AH BL BH XL XH YL YH ];
define register offset=0x20 size=1 [ PG DT fN fV fm fx fD fI fZ fC IPL ];
define register offset=0x30 size=3 [ S ];
define register offset=0x40 size=4 [ contextreg ];

define context contextreg
  mflag = (0,0)
  xflag = (1,1)
  dmode = (2,2)
  dpr4  = (3,3)
;

define token op0(8) o0 = (0,7) o0hi5 = (3,7) o0lo3 = (0,2) signed;
define token op1(8) o1 = (0,7) o1lo5 = (0,4) o1hi3 = (5,7) o1lo4 = (0,3) o1hi4 = (4,7) o1b7 = (7,7) o1b6 = (6,6) o1b5 = (5,5) o1b4 = (4,4) o1b3 = (3,3) o1b2 = (2,2) o1b1 = (1,1) o1b0 = (0,0) o1m = (5,5) o1x = (4,4) o1d = (3,3);
define token r11lo(8) r11l = (0,7);

define token s1_8(8) u1_8 = (0,7) s1_8s = (0,7) signed sel1 = (6,7) off1 = (0,5);
define token s1_16(16) u1_16 = (0,15) s1_16s = (0,15) signed;
define token s1_24(24) u1_24 = (0,23);
define token s1_32(32) u1_32 = (0,31);
define token s2_8(8) u2_8 = (0,7) s2_8s = (0,7) signed sel2 = (6,7) off2 = (0,5);
define token s2_16(16) u2_16 = (0,15) s2_16s = (0,15) signed;
define token s2_24(24) u2_24 = (0,23);
define token s2_32(32) u2_32 = (0,31);
define token s3_8(8) u3_8 = (0,7) s3_8s = (0,7) signed sel3 = (6,7) off3 = (0,5);
define token s3_16(16) u3_16 = (0,15) s3_16s = (0,15) signed;
define token s3_24(24) u3_24 = (0,23);
define token s3_32(32) u3_32 = (0,31);
define token s4_8(8) u4_8 = (0,7) s4_8s = (0,7) signed sel4 = (6,7) off4 = (0,5);
define token s4_16(16) u4_16 = (0,15) s4_16s = (0,15) signed;
define token s4_24(24) u4_24 = (0,23);
define token s4_32(32) u4_32 = (0,31);
define token s5_8(8) u5_8 = (0,7) s5_8s = (0,7) signed sel5 = (6,7) off5 = (0,5);
define token s5_16(16) u5_16 = (0,15) s5_16s = (0,15) signed;
define token s5_24(24) u5_24 = (0,23);
define token s5_32(32) u5_32 = (0,31);
define token s6_8(8) u6_8 = (0,7) s6_8s = (0,7) signed sel6 = (6,7) off6 = (0,5);
define token s6_16(16) u6_16 = (0,15) s6_16s = (0,15) signed;
define token s6_24(24) u6_24 = (0,23);
define token s6_32(32) u6_32 = (0,31);
define token s7_8(8) u7_8 = (0,7) s7_8s = (0,7) signed sel7 = (6,7) off7 = (0,5);
define token s7_16(16) u7_16 = (0,15) s7_16s = (0,15) signed;
define token s7_24(24) u7_24 = (0,23);
define token s7_32(32) u7_32 = (0,31);
define token s8_8(8) u8_8 = (0,7) s8_8s = (0,7) signed sel8 = (6,7) off8 = (0,5);
define token s8_16(16) u8_16 = (0,15) s8_16s = (0,15) signed;
define token s8_24(24) u8_24 = (0,23);
define token s8_32(32) u8_32 = (0,31);
define token s9_8(8) u9_8 = (0,7) s9_8s = (0,7) signed sel9 = (6,7) off9 = (0,5);
define token s9_16(16) u9_16 = (0,15) s9_16s = (0,15) signed;
define token s9_24(24) u9_24 = (0,23);
define token s9_32(32) u9_32 = (0,31);
define token s10_8(8) u10_8 = (0,7) s10_8s = (0,7) signed sel10 = (6,7) off10 = (0,5);
define token s10_16(16) u10_16 = (0,15) s10_16s = (0,15) signed;
define token s10_24(24) u10_24 = (0,23);
define token s10_32(32) u10_32 = (0,31);
define token s11_8(8) u11_8 = (0,7) s11_8s = (0,7) signed sel11 = (6,7) off11 = (0,5);
define token s11_16(16) u11_16 = (0,15) s11_16s = (0,15) signed;
define token s11_24(24) u11_24 = (0,23);
define token s11_32(32) u11_32 = (0,31);
define token s12_8(8) u12_8 = (0,7) s12_8s = (0,7) signed sel12 = (6,7) off12 = (0,5);
define token s12_16(16) u12_16 = (0,15) s12_16s = (0,15) signed;
define token s12_24(24) u12_24 = (0,23);
define token s12_32(32) u12_32 = (0,31);
define token s13_8(8) u13_8 = (0,7) s13_8s = (0,7) signed sel13 = (6,7) off13 = (0,5);
define token s13_16(16) u13_16 = (0,15) s13_16s = (0,15) signed;
define token s13_24(24) u13_24 = (0,23);
define token s13_32(32) u13_32 = (0,31);
define token s14_8(8) u14_8 = (0,7) s14_8s = (0,7) signed sel14 = (6,7) off14 = (0,5);
define token s14_16(16) u14_16 = (0,15) s14_16s = (0,15) signed;
define token s14_24(24) u14_24 = (0,23);
define token s14_32(32) u14_32 = (0,31);

define pcodeop software_interrupt;
define pcodeop wait;
define pcodeop stop;
define pcodeop decimal_add;
define pcodeop decimal_sub;
define pcodeop decimal_add_carry;
define pcodeop decimal_sub_carry;
define pcodeop repeat_multiply_accumulate;

macro packPS(v) {
  v = (zext(IPL) << 8) | (zext(fN) << 7) | (zext(fV) << 6) | (zext(fm) << 5) | (zext(fx) << 4)
    | (zext(fD) << 3) | (zext(fI) << 2) | (zext(fZ) << 1) | zext(fC);
  PS = v;
}
macro unpackPS(v) {
  PS = v & 0x7ff;
  IPL = v[8,3]; fN = v[7,1]; fV = v[6,1]; fm = v[5,1]; fx = v[4,1]; fD = v[3,1]; fI = v[2,1]; fZ = v[1,1]; fC = v[0,1];
}
macro push1(v) { *:1 S = v; S = S - 1; }
macro push2(v) { S = S - 2; *:2 (S + 1) = v; }
macro push4(v) { S = S - 4; *:4 (S + 1) = v; }
macro pull1(v) { S = S + 1; v = *:1 S; }
macro pull2(v) { v = *:2 (S + 1); S = S + 2; }
macro resZN(r) { fZ = (r == 0); fN = (r s< 0); }

XR: is xflag=0 { export X; }
XR: is xflag=1 { t:2 = zext(X:1); export t; }
YR: is xflag=0 { export Y; }
YR: is xflag=1 { t:2 = zext(Y:1); export t; }

DP1: is dpr4=0 & u1_8 { a:3 = zext(DPR0) + u1_8; export a; }
DP1: is dpr4=1 & sel1=0 & off1 { a:3 = zext(DPR0) + off1; export a; }
DP1: is dpr4=1 & sel1=1 & off1 { a:3 = zext(DPR1) + off1; export a; }
DP1: is dpr4=1 & sel1=2 & off1 { a:3 = zext(DPR2) + off1; export a; }
DP1: is dpr4=1 & sel1=3 & off1 { a:3 = zext(DPR3) + off1; export a; }
Dir1: u1_8 is u1_8 & DP1 { export DP1; }
DirX1: u1_8^",X" is u1_8 & DP1 & XR { a:3 = DP1 + zext(XR); export a; }
DirY1: u1_8^",Y" is u1_8 & DP1 & YR { a:3 = DP1 + zext(YR); export a; }
DirInd1: "("^u1_8^")" is u1_8 & DP1 { q:2 = *:2 DP1; a:3 = (zext(DT) << 16) | zext(q); export a; }
DirXInd1: "("^u1_8^",X)" is u1_8 & DP1 & XR { p:3 = DP1 + zext(XR); q:2 = *:2 p; a:3 = (zext(DT) << 16) | zext(q); export a; }
DirIndY1: "("^u1_8^"),Y" is u1_8 & DP1 & YR { q:2 = *:2 DP1; a:3 = ((zext(DT) << 16) | zext(q)) + zext(YR); export a; }
DirL1: "L("^u1_8^")" is u1_8 & DP1 { a:3 = *:3 DP1; export a; }
DirLY1: "L("^u1_8^"),Y" is u1_8 & DP1 & YR { q:3 = *:3 DP1; a:3 = q + zext(YR); export a; }
Sr1: u1_8^",S" is u1_8 { a:3 = S + u1_8; export a; }
SrIndY1: "("^u1_8^",S),Y" is u1_8 & YR { p:3 = S + u1_8; q:2 = *:2 p; a:3 = ((zext(DT) << 16) | zext(q)) + zext(YR); export a; }
Abs1: u1_16 is u1_16 { a:3 = (zext(DT) << 16) | u1_16; export a; }
AbsX1: u1_16^",X" is u1_16 & XR { a:3 = ((zext(DT) << 16) | u1_16) + zext(XR); export a; }
AbsY1: u1_16^",Y" is u1_16 & YR { a:3 = ((zext(DT) << 16) | u1_16) + zext(YR); export a; }
Abl1: u1_24 is u1_24 { export *[const]:3 u1_24; }
AblX1: u1_24^",X" is u1_24 & XR { a:3 = u1_24 + zext(XR); export a; }
Imm8_1: "#"^u1_8 is u1_8 { export *[const]:1 u1_8; }
Imm16_1: "#"^u1_16 is u1_16 { export *[const]:2 u1_16; }
Imm32_1: "#"^u1_32 is u1_32 { export *[const]:4 u1_32; }
Rel8_1: dest is s1_8s [ dest = (inst_next & 0xff0000) | ((inst_next + s1_8s) & 0xffff); ] { export *:1 dest; }
Rel16_1: dest is s1_16s [ dest = (inst_next & 0xff0000) | ((inst_next + s1_16s) & 0xffff); ] { export *:1 dest; }

DP2: is dpr4=0 & u2_8 { a:3 = zext(DPR0) + u2_8; export a; }
DP2: is dpr4=1 & sel2=0 & off2 { a:3 = zext(DPR0) + off2; export a; }
DP2: is dpr4=1 & sel2=1 & off2 { a:3 = zext(DPR1) + off2; export a; }
DP2: is dpr4=1 & sel2=2 & off2 { a:3 = zext(DPR2) + off2; export a; }
DP2: is dpr4=1 & sel2=3 & off2 { a:3 = zext(DPR3) + off2; export a; }
Dir2: u2_8 is u2_8 & DP2 { export DP2; }
DirX2: u2_8^",X" is u2_8 & DP2 & XR { a:3 = DP2 + zext(XR); export a; }
Abs2: u2_16 is u2_16 { a:3 = (zext(DT) << 16) | u2_16; export a; }
AbsX2: u2_16^",X" is u2_16 & XR { a:3 = ((zext(DT) << 16) | u2_16) + zext(XR); export a; }
Imm8_2: "#"^u2_8 is u2_8 { export *[const]:1 u2_8; }
Imm16_2: "#"^u2_16 is u2_16 { export *[const]:2 u2_16; }
Imm32_2: "#"^u2_32 is u2_32 { export *[const]:4 u2_32; }
Rel8_2: dest is s2_8s [ dest = (inst_next & 0xff0000) | ((inst_next + s2_8s) & 0xffff); ] { export *:1 dest; }

DP3: is dpr4=0 & u3_8 { a:3 = zext(DPR0) + u3_8; export a; }
DP3: is dpr4=1 & sel3=0 & off3 { a:3 = zext(DPR0) + off3; export a; }
DP3: is dpr4=1 & sel3=1 & off3 { a:3 = zext(DPR1) + off3; export a; }
