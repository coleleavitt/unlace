# Argument instructions: set or add a sign-extended 8-bit number to B, A, T or X.
:SAB disp is op5=30 & argadd=0 & argreg=0 & disp { B = disp; }
:AAB disp is op5=30 & argadd=1 & argreg=0 & disp { local o:2 = B; local w:2 = disp; B = o + w; addflags(o, w, B); }
:SAA disp is op5=30 & argadd=0 & argreg=1 & disp { A = disp; }
:AAA disp is op5=30 & argadd=1 & argreg=1 & disp { local o:2 = A; local w:2 = disp; A = o + w; addflags(o, w, A); }
:SAT disp is op5=30 & argadd=0 & argreg=2 & disp { T = disp; }
:AAT disp is op5=30 & argadd=1 & argreg=2 & disp { local o:2 = T; local w:2 = disp; T = o + w; addflags(o, w, T); }
:SAX disp is op5=30 & argadd=0 & argreg=3 & disp { X = disp; }
:AAX disp is op5=30 & argadd=1 & argreg=3 & disp { local o:2 = X; local w:2 = disp; X = o + w; addflags(o, w, X); }

# Bit operations on bit bn of register dr (dr 0: the status register, whose
# bits 0-7 are PTM TG K Z Q O C M).
bnv: val is bn [ val = bn * 8; ] { }
lvlv: val is lvl [ val = lvl * 8; ] { }
bopbit: "SSPTM" is dr=0 & bn=0 { export PTM; }
bopbit: "SSTG" is dr=0 & bn=1 { export TG; }
bopbit: "SSK" is dr=0 & bn=2 { export K; }
bopbit: "SSZ" is dr=0 & bn=3 { export Z; }
bopbit: "SSQ" is dr=0 & bn=4 { export Q; }
bopbit: "SSO" is dr=0 & bn=5 { export O; }
bopbit: "SSC" is dr=0 & bn=6 { export C; }
bopbit: "SSM" is dr=0 & bn=7 { export M; }
:BSET "ZRO "^bopbit is op5=31 & bopsub=0 & bopbit { local b:1 = bopbit; b = 0; bopbit = b; }
:BSET "ZRO "^bnv^","^"D"^drr is op5=31 & bopsub=0 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = 0; drr = (drr & ~msk) | (zext(b) << bn); }
:BSET "ZRO "^bnv^","^"STS" is op5=31 & bopsub=0 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = 0; STS = (STS & ~msk) | (zext(b) << bn); }
:BSET "ONE "^bopbit is op5=31 & bopsub=1 & bopbit { local b:1 = bopbit; b = 1; bopbit = b; }
:BSET "ONE "^bnv^","^"D"^drr is op5=31 & bopsub=1 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = 1; drr = (drr & ~msk) | (zext(b) << bn); }
:BSET "ONE "^bnv^","^"STS" is op5=31 & bopsub=1 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = 1; STS = (STS & ~msk) | (zext(b) << bn); }
:BSET "BCM "^bopbit is op5=31 & bopsub=2 & bopbit { local b:1 = bopbit; b = !b; bopbit = b; }
:BSET "BCM "^bnv^","^"D"^drr is op5=31 & bopsub=2 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = !b; drr = (drr & ~msk) | (zext(b) << bn); }
:BSET "BCM "^bnv^","^"STS" is op5=31 & bopsub=2 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = !b; STS = (STS & ~msk) | (zext(b) << bn); }
:BSET "BAC "^bopbit is op5=31 & bopsub=3 & bopbit { local b:1 = bopbit; b = K; bopbit = b; }
:BSET "BAC "^bnv^","^"D"^drr is op5=31 & bopsub=3 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = K; drr = (drr & ~msk) | (zext(b) << bn); }
:BSET "BAC "^bnv^","^"STS" is op5=31 & bopsub=3 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = K; STS = (STS & ~msk) | (zext(b) << bn); }
:BSKP "ZRO "^bopbit is op5=31 & bopsub=4 & bopbit & skip1 { local b:1 = bopbit; if (b == 0) goto skip1; }
:BSKP "ZRO "^bnv^","^"D"^drr is op5=31 & bopsub=4 & bn & bnv & drr & dr!=0 & skip1 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; if (b == 0) goto skip1; }
:BSKP "ZRO "^bnv^","^"STS" is op5=31 & bopsub=4 & bn & bnv & dr=0 & bnc>7 & skip1 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; if (b == 0) goto skip1; }
:BSKP "ONE "^bopbit is op5=31 & bopsub=5 & bopbit & skip1 { local b:1 = bopbit; if (b != 0) goto skip1; }
:BSKP "ONE "^bnv^","^"D"^drr is op5=31 & bopsub=5 & bn & bnv & drr & dr!=0 & skip1 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; if (b != 0) goto skip1; }
:BSKP "ONE "^bnv^","^"STS" is op5=31 & bopsub=5 & bn & bnv & dr=0 & bnc>7 & skip1 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; if (b != 0) goto skip1; }
:BSKP "BCM "^bopbit is op5=31 & bopsub=6 & bopbit & skip1 { local b:1 = bopbit; if (b != K) goto skip1; }
:BSKP "BCM "^bnv^","^"D"^drr is op5=31 & bopsub=6 & bn & bnv & drr & dr!=0 & skip1 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; if (b != K) goto skip1; }
:BSKP "BCM "^bnv^","^"STS" is op5=31 & bopsub=6 & bn & bnv & dr=0 & bnc>7 & skip1 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; if (b != K) goto skip1; }
:BSKP "BAC "^bopbit is op5=31 & bopsub=7 & bopbit & skip1 { local b:1 = bopbit; if (b == K) goto skip1; }
:BSKP "BAC "^bnv^","^"D"^drr is op5=31 & bopsub=7 & bn & bnv & drr & dr!=0 & skip1 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; if (b == K) goto skip1; }
:BSKP "BAC "^bnv^","^"STS" is op5=31 & bopsub=7 & bn & bnv & dr=0 & bnc>7 & skip1 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; if (b == K) goto skip1; }
:BSTC bopbit is op5=31 & bopsub=8 & bopbit { local b:1 = bopbit; b = !K; K = 1; bopbit = b; }
:BSTC bnv^","^"D"^drr is op5=31 & bopsub=8 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = !K; K = 1; drr = (drr & ~msk) | (zext(b) << bn); }
:BSTC bnv^","^"STS" is op5=31 & bopsub=8 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = !K; K = 1; STS = (STS & ~msk) | (zext(b) << bn); }
:BSTA bopbit is op5=31 & bopsub=9 & bopbit { local b:1 = bopbit; b = K; K = 0; bopbit = b; }
:BSTA bnv^","^"D"^drr is op5=31 & bopsub=9 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; b = K; K = 0; drr = (drr & ~msk) | (zext(b) << bn); }
:BSTA bnv^","^"STS" is op5=31 & bopsub=9 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; b = K; K = 0; STS = (STS & ~msk) | (zext(b) << bn); }
:BLDC bopbit is op5=31 & bopsub=10 & bopbit { local b:1 = bopbit; K = !b; }
:BLDC bnv^","^"D"^drr is op5=31 & bopsub=10 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = !b; }
:BLDC bnv^","^"STS" is op5=31 & bopsub=10 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = !b; }
:BLDA bopbit is op5=31 & bopsub=11 & bopbit { local b:1 = bopbit; K = b; }
:BLDA bnv^","^"D"^drr is op5=31 & bopsub=11 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = b; }
:BLDA bnv^","^"STS" is op5=31 & bopsub=11 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = b; }
:BANC bopbit is op5=31 & bopsub=12 & bopbit { local b:1 = bopbit; K = K && !b; }
:BANC bnv^","^"D"^drr is op5=31 & bopsub=12 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = K && !b; }
:BANC bnv^","^"STS" is op5=31 & bopsub=12 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = K && !b; }
:BAND bopbit is op5=31 & bopsub=13 & bopbit { local b:1 = bopbit; K = K && b; }
:BAND bnv^","^"D"^drr is op5=31 & bopsub=13 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = K && b; }
:BAND bnv^","^"STS" is op5=31 & bopsub=13 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = K && b; }
:BORC bopbit is op5=31 & bopsub=14 & bopbit { local b:1 = bopbit; K = K || !b; }
:BORC bnv^","^"D"^drr is op5=31 & bopsub=14 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = K || !b; }
:BORC bnv^","^"STS" is op5=31 & bopsub=14 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = K || !b; }
:BORA bopbit is op5=31 & bopsub=15 & bopbit { local b:1 = bopbit; K = K || b; }
:BORA bnv^","^"D"^drr is op5=31 & bopsub=15 & bn & bnv & drr & dr!=0 { local msk:2 = 1 << bn; local b:1 = (drr & msk) != 0; K = K || b; }
:BORA bnv^","^"STS" is op5=31 & bopsub=15 & bn & bnv & dr=0 & bnc>7 { local msk:2 = 1 << bn; local b:1 = (STS & msk) != 0; K = K || b; }

# System control, transfer and inter-level instructions (opcode 15)
macro packsts(v) {
	v = (STS & 0xff00) | zext(PTM) | (zext(TG) << 1) | (zext(K) << 2) | (zext(Z) << 3) | (zext(Q) << 4) | (zext(O) << 5) | (zext(C) << 6) | (zext(M) << 7);
}
:TRA "STS" is op5=26 & b6_10=0 & b4_5=0 & ir=1 { local v:2 = 0; packsts(v); A = v; }
:TRA ir is op5=26 & b6_10=0 & b4_5=0 & ir { A = transfer_from_internal(ir:1); }
:TRR "STS" is op5=26 & b6_10=1 & b4_5=0 & ir=1 { PTM = (A & 1) != 0; TG = (A & 2) != 0; K = (A & 4) != 0; Z = (A & 8) != 0; Q = (A & 16) != 0; O = (A & 32) != 0; C = (A & 64) != 0; M = (A & 128) != 0; STS = (STS & 0xff) | (A & 0xff00); }
:TRR ir is op5=26 & b6_10=1 & b4_5=0 & ir { transfer_to_internal(ir:1, A); }
:MCL ir is op5=26 & b6_10=2 & b4_5=0 & ir { masked_clear_internal(ir:1, A); }
:MST ir is op5=26 & b6_10=3 & b4_5=0 & ir { masked_set_internal(ir:1, A); }
:OPCOM is op5=26 & b0_10=256 { opcom(); }
:IOF is op5=26 & b0_10=257 { interrupt_off(); }
:ION is op5=26 & b0_10=258 { interrupt_on(); }
:POF is op5=26 & b0_10=260 { paging_off(0:1); }
:PIOF is op5=26 & b0_10=261 { paging_off(1:1); interrupt_off(); }
:SEX is op5=26 & b0_10=262 { set_extended_address(); }
:REX is op5=26 & b0_10=263 { reset_extended_address(); }
:PON is op5=26 & b0_10=264 { paging_on(0:1); }
:PION is op5=26 & b0_10=266 { paging_on(1:1); interrupt_on(); }
:IOXT is op5=26 & b0_10=269 { A = io_transfer_t(T, A); }
:EXAM is op5=26 & b0_10=270 { T = memory_examine(AD); }
:DEPO is op5=26 & b0_10=271 { memory_deposit(AD, T); }
:WAIT udisp is op5=26 & b8_10=2 & udisp { wait_level(udisp:1); }
:NLZ disp is op5=26 & b8_10=3 & disp { FA = float_normalize(A, disp:1); }
:DNZ disp is op5=26 & b8_10=4 & disp { A = float_denormalize(FA, disp:1); T = 0; D = 0; }
:SRB lvlv is op5=26 & b7_10=10 & lvl & lvlv & b0_2=2 { store_register_block(lvl:1, X); }
:LRB lvlv is op5=26 & b7_10=11 & lvl & lvlv & b0_2=0 { load_register_block(lvl:1, X); }
:MON disp is op5=26 & b8_10=6 & disp { monitor_call(disp:1); }
:IRW lvlv "D"^drr is op5=26 & b7_10=14 & lvl & lvlv & drr & dr { inter_register_write(lvl:1, dr:1, A); }
:IRR lvlv "D"^drr is op5=26 & b7_10=15 & lvl & lvlv & drr & dr { A = inter_register_read(lvl:1, dr:1); }

# Input/output
:IOX b0_10 is op5=29 & b0_10 { A = io_transfer(b0_10:2, A); }
