define endian=little;

@define XLEN 4
@define XLEN2 8
@define FLEN 8

@define CONTEXTLEN 4

# custom-0 belongs to the T-Head extensions; no generic placeholders there
@define CUSTOM0_VENDOR "xthead"

@define ADDRSIZE "32"
@define FPSIZE "64"

@include "riscv.reg.sinc"
