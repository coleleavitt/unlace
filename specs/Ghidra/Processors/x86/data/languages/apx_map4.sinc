:CFCMOV^cc Reg64,rm64 is $(APX_MAP4) & $(APX_PP_V) & opsize=2 & apxND=0 & apxNF=0 & row=4 & cc; rm64 & Reg64 ... { local v:8 = 0; if (!cc) goto <z>; v = rm64; <z> Reg64 = v; }
