# AVX-NE-CONVERT (Intel SDM / ISE 319433): VEX.128/256, W0, memory sources only except VCVTNEPS2BF16.
# VBCSTNEBF162PS F3 0F38 B1, VBCSTNESH2PS 66 0F38 B1, VCVTNEEBF162PS F3 0F38 B0, VCVTNEEPH2PS 66 0F38 B0,
# VCVTNEOBF162PS F2 0F38 B0, VCVTNEOPH2PS NP 0F38 B0, VCVTNEPS2BF16 F3 0F38 72. Each is a user operation.

define pcodeop vbcstnebf162ps;
:VBCSTNEBF162PS XmmReg1, m16 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_F3) & $(VEX_0F38) & $(VEX_W0); byte=0xb1; (XmmReg1 & ZmmReg1) ... & m16 {
	local tmp:16 = vbcstnebf162ps(m16);
	ZmmReg1 = zext(tmp);
}
:VBCSTNEBF162PS YmmReg1, m16 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_F3) & $(VEX_0F38) & $(VEX_W0); byte=0xb1; (YmmReg1 & ZmmReg1) ... & m16 {
	local tmp:32 = vbcstnebf162ps(m16);
	ZmmReg1 = zext(tmp);
}
define pcodeop vbcstnesh2ps;
:VBCSTNESH2PS XmmReg1, m16 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0); byte=0xb1; (XmmReg1 & ZmmReg1) ... & m16 {
	local tmp:16 = vbcstnesh2ps(m16);
	ZmmReg1 = zext(tmp);
}
:VBCSTNESH2PS YmmReg1, m16 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0); byte=0xb1; (YmmReg1 & ZmmReg1) ... & m16 {
	local tmp:32 = vbcstnesh2ps(m16);
	ZmmReg1 = zext(tmp);
}
