# SETcc and SETcc.zu (F2, row 4; EVEX.ND selects zero-upper for a register destination)
:SET^cc rm8 is $(APX_MAP4) & apxND=0 & prefix_f2=1 & row=4 & cc; rm8 { rm8 = cc; }
:SETZU^cc Rmr8 is $(APX_MAP4) & apxND=1 & prefix_f2=1 & row=4 & cc; mod=3 & Rmr8 & Rmr64 { Rmr64 = zext(cc); }
:SETZU^cc m8 is $(APX_MAP4) & apxND=1 & prefix_f2=1 & row=4 & cc; m8 { m8 = cc; }

# CCMPscc / CTESTscc (3.1.3.2.1): a false SCC sets OF SF ZF CF from dfv, PF from dfv.CF, clears AF
:CCMP^apxScc apxDfv rm8,Reg8 is $(APX_MAP4) & apxND=0 & apxScc & apxDfv & apxDfvOF & apxDfvSF & apxDfvZF & apxDfvCF & byte=0x38; rm8 & Reg8 ... { local a:1 = rm8; local b:1 = Reg8; local sc:1 = apxScc; if (sc == 0) goto <dflt>; subflags(a, b); local d = a - b; resultflags(d); goto inst_next; <dflt> OF = apxDfvOF; SF = apxDfvSF; ZF = apxDfvZF; CF = apxDfvCF; PF = apxDfvCF; AF = 0; }
