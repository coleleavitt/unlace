# Fujitsu FR-V (FR400, FR450, FR500, FR550) instruction set.
#
# Written for unlace from the FR-V instruction-set manuals. The decode table was
# generated from the binutils CGEN opcode table (frv-opc.c: the field layout and
# mask/value of each instruction; no text copied), so every FR-V instruction
# binutils knows decodes. Instructions are 32-bit big-endian; bit 31 is the
# VLIW pack bit (".p" marks an instruction that is not the last of its packet).
# Packets are lifted sequentially. Integer, branch, load/store, check, float
# and conditional (CCi/cond) instructions carry p-code; media, coprocessor,
# cache and trap instructions are named user ops writing their destination.

define endian=big;
define alignment=4;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x0000 size=4 [ gr0 gr1 gr2 gr3 gr4 gr5 gr6 gr7 gr8 gr9 gr10 gr11 gr12 gr13 gr14 gr15 gr16 gr17 gr18 gr19 gr20 gr21 gr22 gr23 gr24 gr25 gr26 gr27 gr28 gr29 gr30 gr31 gr32 gr33 gr34 gr35 gr36 gr37 gr38 gr39 gr40 gr41 gr42 gr43 gr44 gr45 gr46 gr47 gr48 gr49 gr50 gr51 gr52 gr53 gr54 gr55 gr56 gr57 gr58 gr59 gr60 gr61 gr62 gr63 ];
