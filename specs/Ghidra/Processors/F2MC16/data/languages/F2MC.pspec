<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <programcounter register="UPC"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0x0" last="0xff"/>
  </volatile>
  <context_data>
    <!-- reset values of the bank registers (manual 3.7); override them where a program changes them -->
    <tracked_set space="ram">
      <set name="DTB" val="0"/>
      <set name="ADB" val="0"/>
      <set name="USB" val="0"/>
      <set name="SSB" val="0"/>
      <set name="SPB" val="0"/>
    </tracked_set>
  </context_data>
  <register_data>
    <register name="contextreg" hidden="true"/>
    <register name="nC" hidden="true"/>
    <register name="nV" hidden="true"/>
    <register name="nZ" hidden="true"/>
    <register name="nN" hidden="true"/>
    <register name="nT" hidden="true"/>
  </register_data>
  <default_symbols>
    <!-- interrupt vectors (manual table 6.4-1): INTn at FFFFFC - 4n, 24-bit address. INT8 (reset) to INT255
         are code pointers marked as entries, so auto-analysis disassembles the reset routine and the
         handlers; INT0-INT7 share their area with the CALLV vectors and are labels only. -->
