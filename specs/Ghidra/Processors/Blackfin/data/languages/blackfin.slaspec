# ---------------------------------------------------------------- dsp32shiftimm
shimm5: n is xs_imm [ n = xs_imm & 0x1f; ] { export *[const]:4 n; }
shneg5: n is xs_imm [ n = (64 - xs_imm) & 0x1f; ] { export *[const]:4 n; }
macro vshl(d, s, n) { local hi:2 = s(2); local lo:2 = s:2; hi = hi << n; lo = lo << n; d = (zext(hi) << 16) | zext(lo); }
macro vshr(d, s, n) { local hi:2 = s(2); local lo:2 = s:2; hi = hi >> n; lo = lo >> n; d = (zext(hi) << 16) | zext(lo); }
macro vsar(d, s, n) { local hi:2 = s(2); local lo:2 = s:2; hi = hi s>> n; lo = lo s>> n; d = (zext(hi) << 16) | zext(lo); }
shimm: xs_imm is xs_imm { export *[const]:4 xs_imm; }
shneg: n is xs_imm [ n = (64 - xs_imm) & 0x3f; ] { export *[const]:4 n; }
dsp32: shd16^" = "^shs16^" >>> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=0 & xs_sop=0 & shd16 & shs16 & shneg { shd16 = shs16 s>> shneg; nzflags(shd16); }
dsp32: shd16^" = "^shs16^" << "^shimm^" (S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=0 & xs_sop=1 & xs_b8=0 & shd16 & shs16 & shimm { shd16 = sat_shift(shs16, shimm:1); nzflags(shd16); }
dsp32: shd16^" = "^shs16^" >>> "^shneg^" (S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=0 & xs_sop=1 & xs_b8=1 & shd16 & shs16 & shneg { shd16 = shs16 s>> shneg; nzflags(shd16); }
dsp32: shd16^" = "^shs16^" << "^shimm is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=0 & xs_sop=2 & xs_b8=0 & shd16 & shs16 & shimm { shd16 = shs16 << shimm; nzflags(shd16); }
dsp32: shd16^" = "^shs16^" >> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=0 & xs_sop=2 & xs_b8=1 & shd16 & shs16 & shneg { shd16 = shs16 >> shneg; nzflags(shd16); }
dsp32: xdD^" = "^xdA^" >>> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=2 & xs_sop=0 & xdD & xdA & shneg { xdD = xdA s>> shneg; nzflags(xdD); }
dsp32: xdD^" = "^xdA^" << "^shimm^" (S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=2 & xs_sop=1 & xdD & xdA & shimm { xdD = sat_shift(xdA, shimm:1); nzflags(xdD); }
dsp32: xdD^" = "^xdA^" << "^shimm is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=2 & xs_sop=2 & xs_b8=0 & xdD & xdA & shimm { xdD = xdA << shimm; nzflags(xdD); }
dsp32: xdD^" = "^xdA^" >> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=2 & xs_sop=2 & xs_b8=1 & xdD & xdA & shneg { xdD = xdA >> shneg; nzflags(xdD); }
dsp32: xdD^" = ROT "^xdA^" BY "^xs_imms is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=2 & xs_sop=3 & xdD & xdA & xs_imms & c_imms { xdD = rot_cc(xdA, c_imms, CC); CC = rot_cc(xdA, c_imms, CC, 1:1); }
dsp32: xdD^" = "^xdA^" >>> "^shneg^" (V)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=1 & xs_sop=0 & xdD & xdA & shneg { local v:4 = xdA; vsar(xdD, v, shneg); }
dsp32: xdD^" = "^xdA^" << "^shimm5^" (V, S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=1 & xs_sop=1 & xs_b8=0 & xdD & xdA & shimm5 { xdD = sat_shift(xdA, shimm5:1, 1:1); }
dsp32: xdD^" = "^xdA^" >>> "^shneg5^" (V, S)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=1 & xs_sop=1 & xs_b8=1 & xdD & xdA & shneg5 { local v:4 = xdA; vsar(xdD, v, shneg5); }
dsp32: xdD^" = "^xdA^" >> "^shneg^" (V)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=1 & xs_sop=2 & xs_b8=1 & xdD & xdA & shneg { local v:4 = xdA; vshr(xdD, v, shneg); }
dsp32: xdD^" = "^xdA^" << "^shimm5^" (V)" is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=1 & xs_sop=2 & xs_b8=0 & xdD & xdA & shimm5 { local v:4 = xdA; vshl(xdD, v, shimm5); }
acc: "A0" is xs_HLsrc=0 { export A0; }
acc: "A1" is xs_HLsrc=1 { export A1; }
accs: "A0" is xs_HLsrc=0 { export A0; }
accs: "A1" is xs_HLsrc=1 { export A1; }
dsp32: acc^" = "^accs^" << "^shimm is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=3 & xs_sop=0 & xs_b8=0 & acc & accs & shimm { local t:5 = acc:5; t = t << shimm; acc = sext(t); }
dsp32: acc^" = "^accs^" >>> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=3 & xs_sop=0 & xs_b8=1 & acc & accs & shneg { local t:5 = acc:5; t = t s>> shneg; acc = sext(t); }
dsp32: acc^" = "^accs^" >> "^shneg is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=3 & xs_sop=1 & acc & accs & shneg { local t:5 = acc:5; t = t >> shneg; acc = sext(t); }
dsp32: acc^" = ROT "^accs^" BY "^xs_imms is e_op4=0xc & d_code2=3 & d_b8=0 & d_b7=1 & d_opc=3 & xs_sop=2 & acc & accs & xs_imms & c_imms { acc = rot_cc(acc, c_imms, CC); CC = rot_cc(acc, c_imms, CC, 1:1); }

# ---------------------------------------------------------------- root
par1: ins16 is ins16 { build ins16; }
par2: ins16 is ins16 { build ins16; }

ins: ins16 is ins16 { build ins16; }
ins: ins32 is ins32 { build ins32; }
ins: dsp32 is e_op4=0xc & d_M=0 & dsp32 { build dsp32; }
ins: dsp32 " || " par1 " || " par2 is e_op4=0xc & d_M=1 & dsp32 ; par1 ; par2 { build dsp32; build par1; build par2; }


lptop: reloc is lpdelta [ reloc = inst_start - (lpdelta << 1); ] { export *:4 reloc; }

:^ins is lpend=0 & ins { build ins; }
:^ins is lpend=1 & lpc=0 & ins & lptop {
  build ins;
  if (LC0 == 0) goto inst_next;
  LC0 = LC0 - 1;
  if (LC0 == 0) goto inst_next;
  goto lptop;
}
:^ins is lpend=1 & lpc=1 & ins & lptop {
  build ins;
  if (LC1 == 0) goto inst_next;
  LC1 = LC1 - 1;
  if (LC1 == 0) goto inst_next;
  goto lptop;
}

