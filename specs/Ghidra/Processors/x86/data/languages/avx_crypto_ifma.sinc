    xd[160,32] = xd[160,32] + xp5;
    local xp6:4 = zext(xa[192,8]) * sext(xb[192,8]) + zext(xa[200,8]) * sext(xb[200,8]) + zext(xa[208,8]) * sext(xb[208,8]) + zext(xa[216,8]) * sext(xb[216,8]);
    xd[192,32] = xd[192,32] + xp6;
    local xp7:4 = zext(xa[224,8]) * sext(xb[224,8]) + zext(xa[232,8]) * sext(xb[232,8]) + zext(xa[240,8]) * sext(xb[240,8]) + zext(xa[248,8]) * sext(xb[248,8]);
