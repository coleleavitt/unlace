define endian=$(ENDIAN);

define alignment=2;

define space ram type=ram_space size=3 default;
define space register type=register_space size=2;

define pcodeop GetPagedOffset;
define pcodeop segment;
define pcodeop c166_switch_load;  # Special load for switch tables - injector emits segment() when followed by jmpi
# Return frames: the IP/CSP words that CALL*, TRAP and RET* put on and take off the system stack are bookkeeping
# for the decompiler (the cspec replaces these operations by nothing); in the emulator they push and pop on SP.
define pcodeop c166_push_ret;
define pcodeop c166_pop_ret;
define pcodeop c166_reg_offset_addr;  # [rwm+#imm] address calc - if imm<0x200: segment(0, rwm+imm), else: DPP-paged

define register offset=0 size=2
	[ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 IP ];
define register offset=0 size=1
	[ RL0 RH0 RL1 RH1 RL2 RH2 RL3 RH3 RL4 RH4 RL5 RH5 RL6 RH6 RL7 RH7 ];

# The CPU registers that are also SFRs. They live in the register space; the 'reg', 'bitoff' and 'mem'
# operand tables below map their SFR addresses (0xFE00 + 2 * reg, ...) to these registers, so that
# 'mov psw,#x', 'bset psw.11' or 'push sp' act on the registers that the other instructions use.
define register offset=0xFE00 size=2 [ DPP0 DPP1 DPP2 DPP3 CSP _ MDH MDL CP SP STKOV STKUN ];
define register offset=0xFF0E size=2 [ MDC PSW ];
# byte views (low/high byte) for MOVB, BSET on bytes, and odd 'mem' addresses
define register offset=0xFE00 size=1 [ DPP0_L DPP0_H DPP1_L DPP1_H DPP2_L DPP2_H DPP3_L DPP3_H ];
define register offset=0xFE0C size=1 [ MDH_L MDH_H MDL_L MDL_H CP_L CP_H SP_L SP_H STKOV_L STKOV_H STKUN_L STKUN_H ];
define register offset=0xFF0E size=1 [ MDC_L MDC_H PSW_L PSW_H ];
define register offset=0x58 size=2 [ ExtpValue ];
define register offset=0x5a size=1 [ ExtsValue ];

define register offset=0x50 size=8 contextreg;
define context contextreg
	Counter = (0,2)
	ExtrEn  = (3,3)
	ExtpEn  = (4,4)
	ExtsEn  = (5,5)
	Extp    = (6,21)
	Exts    = (22, 29)
	TmpR    = (30,30)
	TmpP    = (31,31)
	TmpS    = (32,32)
;

@define PSW_N "PSW[0,1]"
@define PSW_C "PSW[1,1]"
@define PSW_V "PSW[2,1]"
@define PSW_Z "PSW[3,1]"
@define PSW_E "PSW[4,1]"

# E: "Set if the value of op2 represents the lowest possible negative number" (the end of a table).
# The test is size independent: v is the lowest negative number iff v != 0 and 2 * v wraps to 0.
macro setE(v) {
	$(PSW_E) = (v != 0) && ((v << 1) == 0);
}

macro setPreFlags(a, b) {
	$(PSW_C) = carry(a, b);
	$(PSW_V) = scarry(a, b);
	setE(b);
}

macro setPostFlags(result) {
	$(PSW_N) = (result s< 0);
	$(PSW_Z) = (result == 0x0);
}

macro setPreFlagsCarry(a, b) {
	local lastCarry = $(PSW_C);
	local sum = a + b;
	$(PSW_C) = carry(a, b) | carry(sum, zext(lastCarry));
	$(PSW_V) = scarry(a, b) ^ scarry(sum, zext(lastCarry));
	setE(b);
}

macro setPostFlagsCarry(result) {
	local lastZero = $(PSW_Z);
	$(PSW_N) = (result s< 0);
	$(PSW_Z) = (result == 0x0) && (lastZero);
}

macro setPreFlagsAnd(b) {
	$(PSW_C) = 0;
	$(PSW_V) = 0;
	setE(b);
}

macro setPreFlagsSub(a, b) {
	$(PSW_C) = a < b;
	$(PSW_V) = sborrow(a, b);
	setE(b);
}

macro setPreFlagsSubCarry(a, b) {
	local lastCarry = $(PSW_C);
	local diff = a - b;
	$(PSW_C) = (a < b) | ((a == b) & lastCarry);
	$(PSW_V) = sborrow(a, b) ^ sborrow(diff, zext(lastCarry));
	setE(b);
}

# Bit instructions: E=0; Z = NOR, V = OR, C = AND, N = XOR of the two bits (BAND, BOR, BXOR, BCMP)
macro setBitwiseFlags(a, b) {
	local tmpa:1 = a:1;
	local tmpb:1 = b:1;
	$(PSW_N) = tmpa ^ tmpb;
	$(PSW_C) = tmpa & tmpb;
	$(PSW_V) = tmpa | tmpb;
	$(PSW_Z) = !$(PSW_V);
	$(PSW_E) = 0;
}

# BSET, BCLR, BMOV, BMOVN, JBC, JNBS: N = previous state of the (source) bit, Z = its complement
macro setBitClearFlags(a) {
	$(PSW_N) = a == 1;
	$(PSW_C) = 0;
	$(PSW_V) = 0;
	$(PSW_Z) = !$(PSW_N);
	$(PSW_E) = 0;
}

macro setDivFlags(a) {
	$(PSW_C) = 0;
	$(PSW_V) = (a == 0x0);
	$(PSW_E) = 0;
}

# The system stack pointer is the SFR SP (R0 is only the software convention of the C compilers for a user
# stack). The system stack is always in segment 0 (no DPP translation).
macro Push(a) {
	SP = SP - 2;
	local sp_push:3 = zext(SP);
	*:2 sp_push = a;
}

macro Pop(a) {
	local sp_pop:3 = zext(SP);
	a = *:2 sp_pop;
	SP = SP + 2;
}

# push a word of the return frame (return address, CSP) on the system stack
macro PushRet(a) {
	c166_push_ret(a);
}

# pop a word of the return frame
macro PopRet(a) {
	a = c166_pop_ret();
}

# push the 16-bit IP of the next instruction (the return address)
macro PushNext() {
	local nxt:3 = inst_next;
	local nxt2:2 = nxt:2;
	PushRet(nxt2);
}

# CSP of the executing code: the 16-bit segment number the program counter is in
macro CurrentCsp(c) {
	local csw:3 = (inst_start >> 16) & 0xff;
	c = csw:2;
}

# RET: pop IP; continue in the current code segment
macro ReturnIntra() {
	local newip:2 = 0;
	PopRet(newip);
	local retAddr:3 = (inst_start & 0xFF0000) | zext(newip);
	return [retAddr];
}

# RETS: pop IP, then CSP
macro ReturnInter() {
	local newip:2 = 0;
	local newcsp:2 = 0;
	PopRet(newip);
	PopRet(newcsp);
	CSP = newcsp;
	local retAddr:3 = (zext(newcsp & 0xff) << 16) | zext(newip);
	return [retAddr];
}

define token instr_16(16)
	op        = (0, 7)
	op0003    = (0,3)
	cond0407  =(4,7)
	op_noop   = (0,15)
	bit_q_0407  = (4,7)
	rwn          = (12,15)
	rbn          = (12,15)
	cond            = (12,15)
	rwm          = ( 8,11)
	rbm          = ( 8,11)
	idx_imm 	 = (11,11)
	idx_mode	 = (10,10)
	data3		 = ( 8,10)
	data4        = (12,15)
	rwi			 = (8,9)
	irang2       = (12,13)
	irang_mode   = (14,15)
	rel       = (8, 15)  signed
	urel      = (8, 15)
	trap7     = (9, 15)  dec
	reg       = (8, 15)
	bitoff    = (8,14)
	bitoff_high_bit  =(15,15)
	reg_high = (12,15)
	reg_low = (8,11)
	reg_low_b = (8,11)
;

define token instr_16_2(16)
	caddr = (0,15)
	page  = (0,15)
	seg   = (0,15)
	page10 = (0,9)
	seg8   = (0,7)
	data16 = (0, 15)
	mem = (0,15)
	z      = (4, 7)
	z_high_bit = (7,7)
	z_2    = (0, 3)
	bitaddr_z = (0,6)
	bit_z  = (8,11)	    dec
	bit_q  = (12,15)	dec
	mask8 = (0,7)
	data8h = (8,15)
	mask8h = (8,15)
	rel_32 = (0,7)	signed
;

define token instr_32(32)
	op_32 = (0,31)
;

attach variables [ rwn rwm reg_low z z_2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ rbn rbm reg_low_b ] [ RL0 RH0 RL1 RH1 RL2 RH2 RL3 RH3 RL4 RH4 RL5 RH5 RL6 RH6 RL7 RH7 ];
attach variables [ rwi ] [ r0 r1 r2 r3 ];

DataImmW: "#"^data16  is data16 { export *[const]:2 data16; }
DataImmB: "#"^data16  is data16 { export *[const]:1 data16; }

# r0 (stack pointer) - direct access (rwi & rwi=0: define first, then constrain)
IndexImmW: [rwi] is rwi & rwi=0 & idx_imm=1 & idx_mode=0 { export *:2 rwi; }
IndexImmW: [rwi^"+"] is rwi & rwi=0 & idx_imm=1 & idx_mode=1 { local addr:2 = rwi; rwi = rwi + 2; export *:2 addr; }
# Other registers - use segment
IndexImmW: [rwi] is idx_imm=1 & idx_mode=0 & rwi { local addr:3 = c166_reg_offset_addr(rwi, 0:2); export *:2 addr; }
IndexImmW: [rwi^"+"] is idx_imm=1 & idx_mode=1 & rwi { local addr:3 = c166_reg_offset_addr(rwi, 0:2); export *:2 addr; rwi = rwi + 2; }
IndexImmW: "#"^data3 is idx_imm=0 & data3 { export *[const]:2 data3; }

# r0 (stack pointer) - direct access for bytes (rwi & rwi=0: define first, then constrain)
IndexImmB: [rwi] is rwi & rwi=0 & idx_imm=1 & idx_mode=0 { export *:1 rwi; }
IndexImmB: [rwi^"+"] is rwi & rwi=0 & idx_imm=1 & idx_mode=1 { local addr:2 = rwi; rwi = rwi + 1; export *:1 addr; }
# Other registers - use segment for bytes
IndexImmB: [rwi] is idx_imm=1 & idx_mode=0 & rwi { local addr:3 = c166_reg_offset_addr(rwi, 0:2); export *:1 addr; }
IndexImmB: [rwi^"+"] is idx_imm=1 & idx_mode=1 & rwi { local addr:3 = c166_reg_offset_addr(rwi, 0:2); export *:1 addr; rwi = rwi + 1; }
IndexImmB: "#"^data3 is idx_imm=0 & data3 { export *[const]:1 data3; }


ShortMemAddrW: regoff is ExtrEn=0 & reg_high < 0xf & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:3 = regoff; export *:2tmp; }
ShortMemAddrW: regoff is ExtrEn=1 & reg_high < 0xf & reg [ regoff = 0xF000 + (2 * reg); ] { local tmp:3 = regoff; export *:2tmp; }
ShortMemAddrW: reg_low is reg_high=0xf & reg_low { export reg_low; }
ShortMemAddrB: regoff is ExtrEn=0 & reg_high < 0xf & reg [ regoff = 0xFE00 + (2 * reg); ] { local tmp:3 = regoff; export *:1tmp; }
ShortMemAddrB: regoff is ExtrEn=1 & reg_high < 0xf & reg [ regoff = 0xF000 + (2 * reg); ] { local tmp:3 = regoff; export *:1tmp; }
ShortMemAddrB: reg_low_b is reg_high=0xf & reg_low_b { export reg_low_b; }



BitoffAddr: regoff is ExtrEn=0 & bitoff_high_bit=0 & reg_high < 0xf & bitoff [ regoff = 0xFD00 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: regoff is ExtrEn=0 & bitoff_high_bit=1 & reg_high < 0xf & bitoff [ regoff = 0xFF00 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: regoff is ExtrEn=1 & bitoff_high_bit=0 & reg_high < 0xf & bitoff [ regoff = 0xFD00 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: regoff is ExtrEn=1 & bitoff_high_bit=1 & reg_high < 0xf & bitoff [ regoff = 0xF100 + (2 * bitoff); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddr: reg_low is reg_high=0xf & reg_low { export reg_low; }


BitoffAddrZ: regoff is ExtrEn=0 & z_high_bit=0 & z < 0xf & bitaddr_z [ regoff = 0xFD00 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: regoff is ExtrEn=0 & z_high_bit=1 & z < 0xf & bitaddr_z [ regoff = 0xFF00 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: regoff is ExtrEn=1 & z_high_bit=0 & z < 0xf & bitaddr_z [ regoff = 0xFD00 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: regoff is ExtrEn=1 & z_high_bit=1 & z < 0xf & bitaddr_z [ regoff = 0xF100 + (2 * bitaddr_z); ] { local tmp:3 = regoff; export *:2tmp; }
BitoffAddrZ: z_2 is z=0xf & z_2 { export z_2; }

# ---- SFRs that are CPU registers (see the register definitions): short 'reg' numbers, bit offsets and 'mem' addresses
# map to the registers, so that the flags, the stack pointer and the DPPs are the same objects for every instruction.
ShortMemAddrW: "DPP0" is ExtrEn=0 & reg=0x0 & reg { export DPP0; }
ShortMemAddrB: "DPP0_L" is ExtrEn=0 & reg=0x0 & reg { export DPP0_L; }
ShortMemAddrW: "DPP1" is ExtrEn=0 & reg=0x1 & reg { export DPP1; }
ShortMemAddrB: "DPP1_L" is ExtrEn=0 & reg=0x1 & reg { export DPP1_L; }
ShortMemAddrW: "DPP2" is ExtrEn=0 & reg=0x2 & reg { export DPP2; }
ShortMemAddrB: "DPP2_L" is ExtrEn=0 & reg=0x2 & reg { export DPP2_L; }
ShortMemAddrW: "DPP3" is ExtrEn=0 & reg=0x3 & reg { export DPP3; }
ShortMemAddrB: "DPP3_L" is ExtrEn=0 & reg=0x3 & reg { export DPP3_L; }
ShortMemAddrW: "MDH" is ExtrEn=0 & reg=0x6 & reg { export MDH; }
ShortMemAddrB: "MDH_L" is ExtrEn=0 & reg=0x6 & reg { export MDH_L; }
ShortMemAddrW: "MDL" is ExtrEn=0 & reg=0x7 & reg { export MDL; }
ShortMemAddrB: "MDL_L" is ExtrEn=0 & reg=0x7 & reg { export MDL_L; }
ShortMemAddrW: "CP" is ExtrEn=0 & reg=0x8 & reg { export CP; }
ShortMemAddrB: "CP_L" is ExtrEn=0 & reg=0x8 & reg { export CP_L; }
ShortMemAddrW: "SP" is ExtrEn=0 & reg=0x9 & reg { export SP; }
ShortMemAddrB: "SP_L" is ExtrEn=0 & reg=0x9 & reg { export SP_L; }
ShortMemAddrW: "STKOV" is ExtrEn=0 & reg=0xa & reg { export STKOV; }
ShortMemAddrB: "STKOV_L" is ExtrEn=0 & reg=0xa & reg { export STKOV_L; }
ShortMemAddrW: "STKUN" is ExtrEn=0 & reg=0xb & reg { export STKUN; }
ShortMemAddrB: "STKUN_L" is ExtrEn=0 & reg=0xb & reg { export STKUN_L; }
ShortMemAddrW: "MDC" is ExtrEn=0 & reg=0x87 & reg { export MDC; }
ShortMemAddrB: "MDC_L" is ExtrEn=0 & reg=0x87 & reg { export MDC_L; }
ShortMemAddrW: "PSW" is ExtrEn=0 & reg=0x88 & reg { export PSW; }
ShortMemAddrB: "PSW_L" is ExtrEn=0 & reg=0x88 & reg { export PSW_L; }
ShortMemAddrW: "CSP" is ExtrEn=0 & reg=0x04 & reg { local csw:3 = (inst_start >> 16) & 0xff; local cs:2 = csw:2; export cs; }
ShortMemAddrB: "CSP" is ExtrEn=0 & reg=0x04 & reg { local csw:3 = (inst_start >> 16) & 0xff; local cs:1 = csw:1; export cs; }
ShortMemAddrW: "ZEROS" is ExtrEn=0 & reg=0x8e & reg { export 0:2; }
ShortMemAddrB: "ZEROS" is ExtrEn=0 & reg=0x8e & reg { export 0:1; }
ShortMemAddrW: "ONES" is ExtrEn=0 & reg=0x8f & reg { local tmp:2 = 0xffff; export tmp; }
ShortMemAddrB: "ONES" is ExtrEn=0 & reg=0x8f & reg { local tmp:1 = 0xff; export tmp; }
BitoffAddr: "MDC" is ExtrEn=0 & reg=0x87 & reg { export MDC; }
BitoffAddrZ: "MDC" is ExtrEn=0 & z_high_bit=1 & bitaddr_z=0x7 & z { export MDC; }
BitoffAddr: "PSW" is ExtrEn=0 & reg=0x88 & reg { export PSW; }
BitoffAddrZ: "PSW" is ExtrEn=0 & z_high_bit=1 & bitaddr_z=0x8 & z { export PSW; }
BitoffAddr: "ZEROS" is ExtrEn=0 & reg=0x8e & reg { export 0:2; }
BitoffAddr: "ONES" is ExtrEn=0 & reg=0x8f & reg { local tmp:2 = 0xffff; export tmp; }
BitoffAddrZ: "ZEROS" is ExtrEn=0 & z_high_bit=1 & bitaddr_z=0x0e & z { export 0:2; }
BitoffAddrZ: "ONES" is ExtrEn=0 & z_high_bit=1 & bitaddr_z=0x0f & z { local tmp:2 = 0xffff; export tmp; }


SetAtomic: "#"^range is irang2 [ range = irang2 + 1; Counter = range; globalset(inst_start, Counter); ] { local tmp:1 = range:1; export tmp; }
SetExtr: SetAtomic is SetAtomic [ ExtrEn = 1; globalset(inst_start, ExtrEn); ] { local NOP:1 = 0; }
SetExtpInd: rwm, SetAtomic is rwm & SetAtomic [ ExtpEn = 1; globalset(inst_start, ExtpEn); Extp=0; globalset(inst_start, Extp); ] { ExtpValue = rwm & 0x3ff; }
SetExtp: "#"^page10, SetAtomic is rwm=0 & SetAtomic; page10 [ ExtpEn = 1; globalset(inst_start, ExtpEn); Extp=page10; globalset(inst_start, Extp); ] { ExtpValue = page10; }
SetExtsInd: rwm, SetAtomic is rwm & SetAtomic [ ExtsEn = 1; globalset(inst_start, ExtsEn); Exts=0; globalset(inst_start, Exts); ] { ExtsValue = rwm:1; }
SetExts: "#"^seg8, SetAtomic is rwm = 0 & SetAtomic; seg8 [ ExtsEn = 1; globalset(inst_start, ExtsEn); Exts=seg8; globalset(inst_start, Exts); ] { ExtsValue = seg8; }
ExtCountDec: is Counter=0 [ ExtrEn=0; globalset(inst_start, ExtrEn); ExtpEn=0; globalset(inst_start, ExtpEn); ExtsEn=0; globalset(inst_start, ExtsEn); Extp=0; globalset(inst_start, Extp); Exts=0; globalset(inst_start, Exts); ] { local NOP:1 = 0; }
# The last instruction of the window still sees the extension flags (they are saved in Tmp*, cleared for the
# following instruction by globalset, and restored for the instruction itself).
ExtCountDec: is Counter=1 [ TmpR=ExtrEn; TmpP=ExtpEn; TmpS=ExtsEn; Counter=0; ExtrEn=0; ExtpEn=0; ExtsEn=0; Extp=0; Exts=0;
	globalset(inst_next, Counter); globalset(inst_next, ExtrEn); globalset(inst_next, ExtpEn); globalset(inst_next, ExtsEn);
	globalset(inst_next, Extp); globalset(inst_next, Exts);
	ExtrEn=TmpR; ExtpEn=TmpP; ExtsEn=TmpS; ] { local NOP:1 = 0; }
ExtCountDec: is Counter!=0 & Counter!=1 [ Counter = Counter - 1; globalset(inst_start, Counter);] { local NOP:1 = 0; }

LongMemAddrW: mem is mem { local tmp:3 = GetPagedOffset(mem:2); export *:2tmp; }
LongMemAddrB: mem is mem { local tmp:3 = GetPagedOffset(mem:2); export *:1tmp; }

# 'mem' addresses of the same SFRs (DPP3 = 3 is what the SFR area needs), unless an EXTP/EXTS window is active
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe00 & mem [ memoff = 0 + mem; ] { export DPP0; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe00 & mem [ memoff = 0 + mem; ] { export DPP0_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe01 & mem [ memoff = 0 + mem; ] { export DPP0_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe02 & mem [ memoff = 0 + mem; ] { export DPP1; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe02 & mem [ memoff = 0 + mem; ] { export DPP1_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe03 & mem [ memoff = 0 + mem; ] { export DPP1_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe04 & mem [ memoff = 0 + mem; ] { export DPP2; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe04 & mem [ memoff = 0 + mem; ] { export DPP2_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe05 & mem [ memoff = 0 + mem; ] { export DPP2_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe06 & mem [ memoff = 0 + mem; ] { export DPP3; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe06 & mem [ memoff = 0 + mem; ] { export DPP3_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe07 & mem [ memoff = 0 + mem; ] { export DPP3_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0c & mem [ memoff = 0 + mem; ] { export MDH; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0c & mem [ memoff = 0 + mem; ] { export MDH_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0d & mem [ memoff = 0 + mem; ] { export MDH_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0e & mem [ memoff = 0 + mem; ] { export MDL; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0e & mem [ memoff = 0 + mem; ] { export MDL_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe0f & mem [ memoff = 0 + mem; ] { export MDL_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe10 & mem [ memoff = 0 + mem; ] { export CP; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe10 & mem [ memoff = 0 + mem; ] { export CP_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe11 & mem [ memoff = 0 + mem; ] { export CP_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe12 & mem [ memoff = 0 + mem; ] { export SP; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe12 & mem [ memoff = 0 + mem; ] { export SP_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe13 & mem [ memoff = 0 + mem; ] { export SP_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe14 & mem [ memoff = 0 + mem; ] { export STKOV; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe14 & mem [ memoff = 0 + mem; ] { export STKOV_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe15 & mem [ memoff = 0 + mem; ] { export STKOV_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe16 & mem [ memoff = 0 + mem; ] { export STKUN; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe16 & mem [ memoff = 0 + mem; ] { export STKUN_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe17 & mem [ memoff = 0 + mem; ] { export STKUN_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff0e & mem [ memoff = 0 + mem; ] { export MDC; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff0e & mem [ memoff = 0 + mem; ] { export MDC_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff0f & mem [ memoff = 0 + mem; ] { export MDC_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff10 & mem [ memoff = 0 + mem; ] { export PSW; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff10 & mem [ memoff = 0 + mem; ] { export PSW_L; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff11 & mem [ memoff = 0 + mem; ] { export PSW_H; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe08 & mem [ memoff = 0 + mem; ] { local csw:3 = (inst_start >> 16) & 0xff; local cs:2 = csw:2; export cs; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xfe08 & mem [ memoff = 0 + mem; ] { local csw:3 = (inst_start >> 16) & 0xff; local cs:1 = csw:1; export cs; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1c & mem [ memoff = 0 + mem; ] { export 0:2; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1c & mem [ memoff = 0 + mem; ] { export 0:1; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1d & mem [ memoff = 0 + mem; ] { export 0:1; }
LongMemAddrW: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1e & mem [ memoff = 0 + mem; ] { local tmp:2 = 0xffff; export tmp; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1e & mem [ memoff = 0 + mem; ] { local tmp:1 = 0xff; export tmp; }
LongMemAddrB: memoff is ExtsEn=0 & ExtpEn=0 & mem=0xff1f & mem [ memoff = 0 + mem; ] { local tmp:1 = 0xff; export tmp; }



# Register-indirect accesses go through c166_reg_offset_addr so EXTP/EXTS overrides
# and DPP-paged translation are honoured (segment(0, reg) ignored both).
# Direct r0 forms preserve stack analysis when no override is active.
RwnIndW: [rwn] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { export *:2 rwn; }
RwnIndWP: [rwn+] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { local addr:2 = rwn; rwn=rwn+2; export *:2 addr; }
RwmIndW: [rwm] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { export *:2 rwm; }
RwmIndWP: [rwm+] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { local addr:2 = rwm; rwm=rwm+2; export *:2 addr; }
RwmIndWM: [-rwm] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { rwm=rwm-2; export *:2 rwm; }
RwmIndWOff: [rwm+DataImmW] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0; DataImmW { local off:2 = DataImmW + rwm; export *[ram]:2 off; }

RwnIndW: [rwn] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:2 addr; }
RwnIndWP: [rwn+] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:2 addr; rwn=rwn+2; }
RwmIndW: [rwm] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; }
RwmIndWP: [rwm+] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; rwm=rwm+2; }
RwmIndWM: [-rwm] is rwm { rwm=rwm-2; local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:2 addr; }
RwmIndWOff: [rwm+DataImmW] is rwm; DataImmW { local addr:3 = c166_reg_offset_addr(rwm, DataImmW); export *[ram]:2 addr; }

# Byte variants use same address injector.
RwnIndB: [rwn] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { export *:1 rwn; }
RwnIndBP: [rwn+] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwn & rwn=0 { local addr:2 = rwn; rwn=rwn+1; export *:1 addr; }
RwmIndB: [rwm] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { export *:1 rwm; }
RwmIndBP: [rwm+] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { local addr:2 = rwm; rwm=rwm+1; export *:1 addr; }
RwmIndBM: [-rwm] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0 { rwm=rwm-1; export *:1 rwm; }
RwmIndBOff: [rwm+DataImmW] is Counter=0 & ExtpEn=0 & ExtsEn=0 & rwm & rwm=0; DataImmW { local off:2 = DataImmW + rwm; export *[ram]:1 off; }

RwnIndB: [rwn] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:1 addr; }
RwnIndBP: [rwn+] is rwn { local addr:3 = c166_reg_offset_addr(rwn, 0:2); export *:1 addr; rwn=rwn+1; }
RwmIndB: [rwm] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; }
RwmIndBP: [rwm+] is rwm { local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; rwm=rwm+1; }
RwmIndBM: [-rwm] is rwm { rwm=rwm-1; local addr:3 = c166_reg_offset_addr(rwm, 0:2); export *:1 addr; }
RwmIndBOff: [rwm+DataImmW] is rwm; DataImmW { local addr:3 = c166_reg_offset_addr(rwm, DataImmW); export *[ram]:1 addr; }

RWnRWmEqual: is rwn=rwm { local NOP:1 = 0; }

rel0815: addr is rel [ addr = inst_next + (2 * rel); ] { export *[ram]:2 addr; }
rel1623: addr is rel_32 [ addr = inst_next + (2 * rel_32); ] { export *[ram]:2 addr; }
relSeg: addr is urel; caddr [ addr = (urel << 16) | caddr; ] { export *[ram]:2 addr; }
absCaddr: addr is caddr [ addr = (inst_start & 0xFF0000) | caddr; ] { export *[ram]:2 addr; }
trapAddr: addr is trap7 [ addr = trap7 << 2; ] { export *[ram]:2 addr; }

cc0407:"cc_UC"	is cond0407=0x0 { local NOP:1 = 0; }
cc0407:"cc_NET"	is cond0407=0x1 { if   ($(PSW_Z) | $(PSW_E)) goto inst_next; }
cc0407:"cc_EQ"	is cond0407=0x2 { if   !$(PSW_Z) goto inst_next; }
cc0407:"cc_NE"	is cond0407=0x3 { if    $(PSW_Z) goto inst_next; }
cc0407:"cc_V"	is cond0407=0x4 { if   !$(PSW_V) goto inst_next; }
cc0407:"cc_NV"	is cond0407=0x5 { if    $(PSW_V) goto inst_next; }
cc0407:"cc_N"	is cond0407=0x6 { if   !$(PSW_N) goto inst_next; }
cc0407:"cc_NN"	is cond0407=0x7 { if    $(PSW_N) goto inst_next; }
cc0407:"cc_C"	is cond0407=0x8 { if   !$(PSW_C) goto inst_next; }
cc0407:"cc_NC"	is cond0407=0x9 { if    $(PSW_C) goto inst_next; }
cc0407:"cc_SGT"	is cond0407=0xA { if   ($(PSW_Z) | ($(PSW_N) ^ $(PSW_V))) goto inst_next; }
cc0407:"cc_SLE"	is cond0407=0xB { if  !($(PSW_Z) | ($(PSW_N) ^ $(PSW_V))) goto inst_next; }
cc0407:"cc_SLT"	is cond0407=0xC { if  !($(PSW_N) ^ $(PSW_V)) goto inst_next; }
cc0407:"cc_SGE"	is cond0407=0xD { if   ($(PSW_N) ^ $(PSW_V)) goto inst_next; }
cc0407:"cc_UGT"	is cond0407=0xE { if   ($(PSW_Z) | $(PSW_C)) goto inst_next; }
cc0407:"cc_ULE"	is cond0407=0xF { if  !($(PSW_Z) | $(PSW_C)) goto inst_next; }


