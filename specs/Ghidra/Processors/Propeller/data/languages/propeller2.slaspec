:^CS^"abs" DR, SV^FCZ is CS & fb21=0 & fb22=1 & fb23=0 & fb24=0 & fb25=1 & fb26=1 & fb27=0 & DR & SV & FCZ & RT { build CS; local vd:4 = DR; local vs:4 = SV; res = vs; if (vs s>= 0) goto <p>; res = 0 - vs; <p> cf = vs s< 0; zf = res == 0; DR = res; build FCZ; build RT; }
:^CS^"neg" DR, SV^FCZ is CS & fb21=1 & fb22=1 & fb23=0 & fb24=0 & fb25=1 & fb26=1 & fb27=0 & DR & SV & FCZ & RT { build CS; local vd:4 = DR; local vs:4 = SV; res = 0 - vs; cf = res s< 0; zf = res == 0; DR = res; build FCZ; build RT; }
