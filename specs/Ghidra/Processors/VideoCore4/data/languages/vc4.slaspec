# 80-bit memory operations
:"v"^Vmwidth^"ld" vd80, va80, vb80^vflags80 is (Vclass=0x1f & Vkind=0 & Vmop=0 & Vmwidth & Vaccw) ... & vd80 & va80 & vb80 & vflags80 { vector_load(0:1, vb80); build vflags80; }
:"v"^Vmwidth^"ld" "-", va80, vmemimm^"("^Vrsb^"+="^Vfdr^")"^vflags80 is (Vclass=0x1f & Vkind=0 & Vmop=0 & Vmwidth & Vaccw & Vdk=7 & Vddir=0 & Vimm=0 & Vbk=7 & Vbdir=0 ; Vrsb & Vfdr) & va80 & vmemimm & vflags80 { local a:4 = Vrsb + vmemimm; vector_load(0:1, a); build vflags80; }
