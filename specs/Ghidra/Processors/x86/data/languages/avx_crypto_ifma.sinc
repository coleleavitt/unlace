    local xs0:8 = sext(xd[0,32]) + zext(xa[0,8]) * sext(xb[0,8]) + zext(xa[8,8]) * sext(xb[8,8]) + zext(xa[16,8]) * sext(xb[16,8]) + zext(xa[24,8]) * sext(xb[24,8]);
