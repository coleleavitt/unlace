# Shifts: register T, D, A or AD; arithmetic, rotate, zero-in or link-in (M);
# a signed 6-bit count, negative for right. M gets the last bit shifted out.
shc: shcnt is shcnt { }
:SHT shc is op5=27 & shreg=0 & shtype=0 & shc & shcnt {
	local v:2 = T; local o:2 = v; local cnt:1 = shcnt;
	if (cnt s< 0) goto <right>;
	local n:2 = zext(cnt);
	if (n == 0) goto <done>;
	v = v << n; M = ((o >> (16 - n)) & 1) != 0; goto <done>;
<right>
	n = zext(-cnt);
	v = v s>> n; M = ((o >> (n - 1)) & 1) != 0; 
<done>
	T = v;
}
:SHT "ROT "^shc is op5=27 & shreg=0 & shtype=1 & shc & shcnt {
	local v:2 = T; local o:2 = v; local cnt:1 = shcnt;
	if (cnt s< 0) goto <right>;
	local n:2 = zext(cnt);
	if (n == 0) goto <done>;
	v = (v << n) | (v >> (16 - n)); M = ((o >> (16 - n)) & 1) != 0; goto <done>;
<right>
	n = zext(-cnt);
	v = (v >> n) | (v << (16 - n)); M = ((o >> (n - 1)) & 1) != 0; 
<done>
	T = v;
}
:SHT "ZIN "^shc is op5=27 & shreg=0 & shtype=2 & shc & shcnt {
	local v:2 = T; local o:2 = v; local cnt:1 = shcnt;
	if (cnt s< 0) goto <right>;
	local n:2 = zext(cnt);
	if (n == 0) goto <done>;
	v = v << n; M = ((o >> (16 - n)) & 1) != 0; goto <done>;
<right>
	n = zext(-cnt);
	v = v >> n; M = ((o >> (n - 1)) & 1) != 0; 
<done>
	T = v;
}
:SHT "LIN "^shc is op5=27 & shreg=0 & shtype=3 & shc & shcnt {
	local v:2 = T; local o:2 = v; local cnt:1 = shcnt;
	if (cnt s< 0) goto <right>;
	local n:2 = zext(cnt);
	if (n == 0) goto <done>;
	v = (v << n) | (zext(M) * ((1 << n) - 1)); M = ((o >> (16 - n)) & 1) != 0; goto <done>;
<right>
	n = zext(-cnt);
	v = (v >> n) | (zext(M) * ~(-1:2 >> n)); M = ((o >> (n - 1)) & 1) != 0; 
<done>
	T = v;
}
:SHD shc is op5=27 & shreg=1 & shtype=0 & shc & shcnt {
