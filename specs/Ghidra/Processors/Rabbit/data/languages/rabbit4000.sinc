:CALL "(IY)" is pfx=2 & q0_8=0xEA { push16(&:2 inst_next); call [IY]; }
:TEST "IY" is pfx=2 & q0_8=0x4C { local v:2 = IY; resultFlags(v); LV_flag = 0; C_flag = 0; }
:LDL dps,"HL" is pfx=2 & qhi2=2 & dps & qlo4=0xF { dps = 0xffff0000 | zext(HL); }
:LDL dps,"IY" is pfx=2 & qhi2=2 & dps & qlo4=0xC { dps = 0xffff0000 | zext(IY); }
:LD dA,"(IY+A)" is pfx=2 & q0_8=0x06 & dA { local a:2 = IY + zext(A); dA = *[ram]:1 a; }

# Unprefixed 16- and 32-bit additions (opcodes freed by moving LD r,g and the ALU to 7F)
:LD "BC","HL" is $(N4) q0_8=0x91 { BC = HL; }
:LD "DE","HL" is $(N4) q0_8=0xB1 { DE = HL; }
:LD dHL,"BC" is $(N4) q0_8=0x81 & dHL { dHL = BC; }
:LD dHL,"DE" is $(N4) q0_8=0xA1 & dHL { dHL = DE; }
:LD dHL,"LXPC" is $(N4) q0_8=0x9F & dHL { dHL = LXPC; }
:LD "LXPC","HL" is $(N4) q0_8=0x97 { LXPC = HL & 0x0fff; }
:LD "JK",imm16 is $(N4) q0_8=0xA9 ; imm16 { JK = imm16; }
:LD "JK",mAbs2 is $(N4) q0_8=0x99 ; mAbs2 { JK = mAbs2; }
:LD mAbs2,"JK" is $(N4) q0_8=0x89 ; mAbs2 { mAbs2 = JK; }
:LD "BCDE",aAbs is $(N4) wBCDE & q0_8=0x93 ; aAbs { local v:4 = *[ram]:4 aAbs; T32 = v; build wBCDE; }
:LD aAbs,"BCDE" is $(N4) q0_8=0x83 ; aAbs { local v:4 = 0; getBCDE(v); *[ram]:4 aAbs = v; }
:LD "BCDE",simm8 is $(N4) wBCDE & q0_8=0xa3 ; simm8 { local v:4 = sext(simm8:1); T32 = v; build wBCDE; }
:LD "JKHL",aAbs is $(N4) wJKHL & q0_8=0x94 ; aAbs { local v:4 = *[ram]:4 aAbs; T32 = v; build wJKHL; }
:LD aAbs,"JKHL" is $(N4) q0_8=0x84 ; aAbs { local v:4 = 0; getJKHL(v); *[ram]:4 aAbs = v; }
:LD "JKHL",simm8 is $(N4) wJKHL & q0_8=0xa4 ; simm8 { local v:4 = sext(simm8:1); T32 = v; build wJKHL; }
:LDF dA,lmn is $(N4) q0_8=0x9A & dA ; lmn { dA = *[phys]:1 lmn; }
:LDF lmn,"A" is $(N4) q0_8=0x8A ; lmn { *[phys]:1 lmn = A; }
:LDF dHL,lmn is $(N4) q0_8=0x92 & dHL ; lmn { dHL = *[phys]:2 lmn; }
:LDF lmn,"HL" is $(N4) q0_8=0x82 ; lmn { *[phys]:2 lmn = HL; }
:LD dHL,"(SP+HL)" is $(NP) op0_8=0xED ; q0_8=0xFE & dHL { local a:2 = SP + HL; dHL = *[ram]:2 a; }
:LD dA,"HTR" is $(NP) op0_8=0xED ; q0_8=0x50 & dA { dA = HTR; }
:LD "HTR","A" is $(NP) op0_8=0xED ; q0_8=0x40 { HTR = A; }
:ADD dHL,"JK" is $(N4) q0_8=0x65 & dHL { local a:2 = HL; local b:2 = JK; C_flag = carry(a, b); LV_flag = scarry(a, b); local r:2 = a + b; resultFlags(r); dHL = r; }
:SUB dHL,"JK" is $(N4) q0_8=0x45 & dHL { local a:2 = HL; local b:2 = JK; C_flag = a < b; LV_flag = sborrow(a, b); local r:2 = a - b; resultFlags(r); dHL = r; }
:SUB dHL,"DE" is $(N4) q0_8=0x55 & dHL { local a:2 = HL; local b:2 = DE; C_flag = a < b; LV_flag = sborrow(a, b); local r:2 = a - b; resultFlags(r); dHL = r; }
:XOR dHL,"DE" is $(N4) q0_8=0x54 & dHL { local r:2 = HL ^ DE; logic16(r); dHL = r; }
:CP "HL",simm8 is $(N4) q0_8=0x48 ; simm8 { local a:2 = HL; local b:2 = sext(simm8:1); C_flag = a < b; LV_flag = sborrow(a, b); local r:2 = a - b; resultFlags(r); }
:CP "HL","DE" is $(NP) op0_8=0xED ; q0_8=0x48 { local a:2 = HL; local b:2 = DE; C_flag = a < b; LV_flag = sborrow(a, b); local r:2 = a - b; resultFlags(r); }
:TEST "HL" is $(N4) q0_8=0x4C { resultFlags(HL); LV_flag = 0; C_flag = 0; }
:TEST "BC" is $(NP) op0_8=0xED ; q0_8=0x4C { resultFlags(BC); LV_flag = 0; C_flag = 0; }
:NEG dHL is $(N4) q0_8=0x4D & dHL { local v:2 = HL; local r:2 = -v; C_flag = v != 0; LV_flag = sborrow(0:2, v); resultFlags(r); dHL = r; }
:CLR dHL is $(N4) q0_8=0xBF & dHL { dHL = 0; }
:MULU is $(N4) q0_8=0xA7 { local p:4 = zext(BC) * zext(DE); HL = p(2); BC = p:2; }
:RL "HL" is $(N4) q0_8=0x42 { local v:2 = HL; local r:2 = v; r = (v << 1) | zext(C_flag); C_flag = (v >> 15) != 0; rotFlags16(r); HL = r; }
:RL "BC" is $(N4) q0_8=0x62 { local v:2 = BC; local r:2 = v; r = (v << 1) | zext(C_flag); C_flag = (v >> 15) != 0; rotFlags16(r); BC = r; }
:RLC "BC" is $(N4) q0_8=0x60 { local v:2 = BC; local r:2 = v; r = (v << 1) | (v >> 15); C_flag = (v >> 15) != 0; rotFlags16(r); BC = r; }
:RLC "DE" is $(N4) q0_8=0x50 { local v:2 = DE; local r:2 = v; r = (v << 1) | (v >> 15); C_flag = (v >> 15) != 0; rotFlags16(r); DE = r; }
:RRC "BC" is $(N4) q0_8=0x61 { local v:2 = BC; local r:2 = v; r = (v >> 1) | (v << 15); C_flag = (v & 1) != 0; rotFlags16(r); BC = r; }
:RRC "DE" is $(N4) q0_8=0x51 { local v:2 = DE; local r:2 = v; r = (v >> 1) | (v << 15); C_flag = (v & 1) != 0; rotFlags16(r); DE = r; }
:RR "BC" is $(N4) q0_8=0x63 { local v:2 = BC; local r:2 = v; r = (v >> 1) | (zext(C_flag) << 15); C_flag = (v & 1) != 0; rotFlags16(r); BC = r; }
:EX "BC","HL" is $(N4) q0_8=0xB3 { local t:2 = BC; BC = HL; HL = t; }
:EX "JK","HL" is $(N4) q0_8=0xB9 { local t:2 = JK; JK = HL; HL = t; }
:EX "BCDE","JKHL" is $(N4) q0_8=0xB4 { local t:2 = BC; BC = JK; JK = t; t = DE; DE = HL; HL = t; }
:EX "BC'","HL" is $(NP) op0_8=0xED ; q0_8=0x74 { local t:2 = BC_; BC_ = HL; HL = t; }
:EX "JK'","HL" is $(NP) op0_8=0xED ; q0_8=0x7C { local t:2 = JK_; JK_ = HL; HL = t; }
:ADD "JKHL","BCDE" is $(NP) wJKHL & op0_8=0xED ; q0_8=0xc6 { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = 0; r = a + b; C_flag = carry(a, b); resultFlags(r); T32 = r; build wJKHL; }
:SUB "JKHL","BCDE" is $(NP) wJKHL & op0_8=0xED ; q0_8=0xd6 { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = 0; r = a - b; C_flag = a < b; LV_flag = sborrow(a, b); resultFlags(r); T32 = r; build wJKHL; }
:AND "JKHL","BCDE" is $(NP) wJKHL & op0_8=0xED ; q0_8=0xe6 { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = 0; r = a & b; C_flag = 0; resultFlags(r); T32 = r; build wJKHL; }
:OR "JKHL","BCDE" is $(NP) wJKHL & op0_8=0xED ; q0_8=0xf6 { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = 0; r = a | b; C_flag = 0; resultFlags(r); T32 = r; build wJKHL; }
:XOR "JKHL","BCDE" is $(NP) wJKHL & op0_8=0xED ; q0_8=0xee { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = 0; r = a ^ b; C_flag = 0; resultFlags(r); T32 = r; build wJKHL; }
:CP "JKHL","BCDE" is $(NP) op0_8=0xED ; q0_8=0x58 { local a:4 = 0; getJKHL(a); local b:4 = 0; getBCDE(b); local r:4 = a - b; C_flag = a < b; LV_flag = sborrow(a, b); resultFlags(r); }
:FLAG r4fcc,dHL is $(NP) op0_8=0xED ; r4fcc & qlo3=4 & ((qhi2=3 & qcc<4) | (qhi2=2 & qcc>3)) & dHL { dHL = zext(r4fcc); }
# Control flow
:JR r4cc,rel8 is $(N4) qhi2=2 & r4cc & qlo3=0 ; rel8 { if (r4cc) goto rel8; }
:JP r4cc,abs16 is $(N4) qhi2=2 & r4cc & qlo3=2 ; abs16 { if (r4cc) goto abs16; }
:JRE rel16 is $(N4) q0_8=0x98 ; rel16 { goto rel16; }
:JRE r4fcc,rel16 is $(NP) op0_8=0xED ; r4fcc & qlo3=3 & ((qhi2=3 & qcc<4) | (qhi2=2 & qcc>3)) ; rel16 { if (r4fcc) goto rel16; }
:DWJNZ rel8 is $(NP) op0_8=0xED ; q0_8=0x10 ; rel8 { local b:2 = BC - 1; BC = b; if (b != 0) goto rel8; }
:CALL "(HL)" is $(NP) op0_8=0xED ; q0_8=0xEA { push16(&:2 inst_next); call [HL]; }
:PUSH imm16 is $(NP) op0_8=0xED ; q0_8=0xA5 ; imm16 { push16(imm16:2); }
:LLJP imm16x,abs16 is $(N4) q0_8=0x87 ; abs16 ; imm16x { LXPC = imm16x & 0x0fff; goto abs16; }
:LLJP r4fcc,imm16x,abs16 is $(NP) op0_8=0xED ; r4fcc & qlo3=2 & ((qhi2=3 & qcc<4) | (qhi2=2 & qcc>3)) ; abs16 ; imm16x { if (!r4fcc) goto inst_next; LXPC = imm16x & 0x0fff; goto abs16; }
:LLCALL imm16x,abs16 is $(N4) q0_8=0x8F ; abs16 ; imm16x { push16(LXPC); push16(&:2 inst_next); LXPC = imm16x & 0x0fff; call abs16; }
:LLCALL "(JKHL)" is $(NP) op0_8=0xED ; q0_8=0xFA { push16(LXPC); push16(&:2 inst_next); LXPC = JK & 0x0fff; call [HL]; }
:LLRET is $(NP) op0_8=0xED ; q0_8=0x8B { local t:2 = 0; pop16(t); pop16(LXPC); return [t]; }
# System, block and table instructions
:CBM imm8 is $(NP) op0_8=0xED ; q0_8=0x00 ; imm8 { cbm(imm8:1); }
:COPY is $(NP) op0_8=0xED ; q0_8=0x80 { block_copy(PX, PY, BC); BC = 0; }
:COPYR is $(NP) op0_8=0xED ; q0_8=0x88 { block_copy_reverse(PX, PY, BC); BC = 0; }
:EXP is $(NP) op0_8=0xED ; q0_8=0xD9 { exp_exchange(); }
:FSYSCALL is $(NP) op0_8=0xED ; q0_8=0x55 { push16(&:2 inst_next); fsyscall(); }
:SBOX dA is $(NP) op0_8=0xED ; q0_8=0x02 & dA { dA = sbox(A); }
:IBOX dA is $(NP) op0_8=0xED ; q0_8=0x12 & dA { dA = ibox(A); }
:SETSYSP imm16 is $(NP) op0_8=0xED ; q0_8=0xB1 ; imm16 { set_system_protect(imm16:2); }
:SETUSRP imm16 is $(NP) op0_8=0xED ; q0_8=0xB5 ; imm16 { set_user_protect(imm16:2); }
:SYSRET is $(NP) op0_8=0xED ; q0_8=0x83 { local t:2 = sysret(); return [t]; }
