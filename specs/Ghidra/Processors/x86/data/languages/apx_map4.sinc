# CMOVcc (NDD) and CFCMOVcc (Table 3.5); a false condition suppresses the memory access of CFCMOVcc
:CFCMOV^cc Reg16,rm16 is $(APX_MAP4) & $(APX_PP_V) & opsize=0 & apxND=0 & apxNF=0 & row=4 & cc; rm16 & Reg16 ... & Reg64 ... { local v:2 = 0; if (!cc) goto <z>; v = rm16; <z> Reg64 = zext(v); }
