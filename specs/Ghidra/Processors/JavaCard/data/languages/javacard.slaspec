# Java Card virtual machine bytecode (Java Card Platform 3.1, Classic Edition). Written for
# unlace from the Java Card Platform Virtual Machine Specification v3.1 (Oracle), chapters 7
# (instruction set) and 8 (opcodes); no text is copied. The operand stack and the local
# variables are made of 16-bit words: a short or a reference is one word, an int two (big
# endian). The stack is the jstack space (SP addresses the top word, a push moves it down);
# local word n is the register Ln and the int in words n, n+1 is In. Fields, statics,
# arrays, object creation and method invocation are user-ops on 16-bit references.

define endian=big;
define alignment=1;

define space ram    type=ram_space      size=2 default;
define space jstack type=ram_space      size=2;
define space register type=register_space size=2;

define register offset=0x0000 size=2 [ PC SP RVs ];
define register offset=0x0010 size=4 [ RV ];
define register offset=0x0100 size=2 [ L0 L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11 L12 L13 L14 L15 L16 L17 L18 L19 L20 L21 L22 L23 L24 L25 L26 L27 L28 L29 L30 L31 L32 L33 L34 L35 L36 L37 L38 L39 L40 L41 L42 L43 L44 L45 L46 L47 L48 L49 L50 L51 L52 L53 L54 L55 L56 L57 L58 L59 L60 L61 L62 L63 L64 L65 L66 L67 L68 L69 L70 L71 L72 L73 L74 L75 L76 L77 L78 L79 L80 L81 L82 L83 L84 L85 L86 L87 L88 L89 L90 L91 L92 L93 L94 L95 L96 L97 L98 L99 L100 L101 L102 L103 L104 L105 L106 L107 L108 L109 L110 L111 L112 L113 L114 L115 L116 L117 L118 L119 L120 L121 L122 L123 L124 L125 L126 L127 L128 L129 L130 L131 L132 L133 L134 L135 L136 L137 L138 L139 L140 L141 L142 L143 L144 L145 L146 L147 L148 L149 L150 L151 L152 L153 L154 L155 L156 L157 L158 L159 L160 L161 L162 L163 L164 L165 L166 L167 L168 L169 L170 L171 L172 L173 L174 L175 L176 L177 L178 L179 L180 L181 L182 L183 L184 L185 L186 L187 L188 L189 L190 L191 L192 L193 L194 L195 L196 L197 L198 L199 L200 L201 L202 L203 L204 L205 L206 L207 L208 L209 L210 L211 L212 L213 L214 L215 L216 L217 L218 L219 L220 L221 L222 L223 L224 L225 L226 L227 L228 L229 L230 L231 L232 L233 L234 L235 L236 L237 L238 L239 L240 L241 L242 L243 L244 L245 L246 L247 L248 L249 L250 L251 L252 L253 L254 L255 ];
