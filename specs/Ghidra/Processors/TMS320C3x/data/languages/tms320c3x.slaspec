# SLEIGH specification for the Texas Instruments TMS320C3x (C30, C31, C32, C33)
# and the C3x-compatible core of the TMS320C4x
#
# Written from the TI TMS320C3x User's Guide (SPRU031) and the TMS320C4x User's
# Guide (SPRU063). Memory is word addressed: one address unit is a 32-bit word.
# R0-R11 are the extended-precision registers: R0-R11 name their integer view
# (bits 31-0, what integer instructions read and write) and R0E-R11E the whole
# 40-bit register. The TI floating-point formats are not IEEE, so floating-point
# arithmetic and conversions are user ops on the extended values (ti_*). The
# system stack grows upward: PUSH pre-increments SP, POP post-decrements it.

define endian=little;
define alignment=4;

define space ram      type=ram_space      size=4 wordsize=4 default;
define space register type=register_space size=4;

define register offset=0x000 size=8 [ R0E R1E R2E R3E R4E R5E R6E R7E R8E R9E R10E R11E ];
define register offset=0x000 size=4 [ R0 _ R1 _ R2 _ R3 _ R4 _ R5 _ R6 _ R7 _ R8 _ R9 _ R10 _ R11 _ ];
define register offset=0x080 size=4 [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 DP IR0 IR1 BK SP ST IE IF IOF RS RE RC PC ];
define register offset=0x100 size=1 [ C V Z N UF LV LUF GIE ];

define token iw (32)
	cls    = (29,31)
	cls2   = (30,31)
	top4   = (28,31)
	top6   = (26,31)
	top8   = (24,31)
	top9   = (23,31)
	opc6   = (23,28)
	popc   = (25,29)
	g      = (21,22)
	tb22   = (22,22)
	tb21   = (21,21)
	dint   = (16,20)
	dflt   = (16,20)
	dnum   = (16,20)
	cond5  = (16,20)
	cn5    = (16,20)
	lcn    = (23,27)
	lcond  = (23,27)
	sint   = (0,4)
	sflt   = (0,4)
	snum   = (0,4)
	src16  = (0,15)
	simm16 = (0,15) signed
	imod   = (11,15)
	iar    = (8,10)
	idisp  = (0,7)
	s1int  = (8,12)
	s1flt  = (8,12)
	hmod   = (11,15)
	har    = (8,10)
	lmod   = (3,7)
	lar    = (0,2)
	bbit   = (25,25)
	dbit   = (21,21)
	dbar   = (22,24)
	addr24 = (0,23)
	tvec   = (0,4)
	tbit5  = (5,5)
	pd1    = (22,24)
	pd1x   = (22,24)
	ps1    = (19,21)
	ps1x   = (19,21)
	ps3    = (16,18)
	ps3x   = (16,18)
;

attach variables [ dint sint s1int ] [ R0 R1 R2 R3 R4 R5 R6 R7 AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 DP IR0 IR1 BK SP ST IE IF IOF RS RE RC R8 R9 R10 R11 ];
attach variables [ dflt sflt s1flt ] [ R0E R1E R2E R3E R4E R5E R6E R7E _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ R8E R9E R10E R11E ];
attach variables [ iar har lar dbar ] [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 ];
attach variables [ pd1 ps1 ps3 ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ pd1x ps1x ps3x ] [ R0E R1E R2E R3E R4E R5E R6E R7E ];
attach names [ cond5 lcond ] [ "U" "LO" "LS" "HI" "HS" "EQ" "NE" "LT" "LE" "GT" "GE" "c0B" "NV" "V" "NUF" "UF" "NLV" "LV" "NLUF" "LUF" "ZUF" "c15" "c16" "c17" "c18" "c19" "c1A" "c1B" "c1C" "c1D" "c1E" "c1F" ];

define pcodeop ti_ldf32;
define pcodeop ti_stf32;
define pcodeop ti_short_float;
define pcodeop ti_addf;
define pcodeop ti_subf;
define pcodeop ti_mpyf;
define pcodeop ti_negf;
define pcodeop ti_absf;
define pcodeop ti_fix;
define pcodeop ti_float;
define pcodeop ti_norm;
define pcodeop ti_rnd;
define pcodeop ti_lde;
define pcodeop ti_ldm;
define pcodeop ti_is_negative;
define pcodeop ti_is_zero;
define pcodeop circular_add;
define pcodeop bit_reversed_add;
define pcodeop idle;
define pcodeop interrupt_acknowledge;
define pcodeop signal_interlock;
define pcodeop interlocked_load;
define pcodeop interlocked_store;
define pcodeop repeat_single;
define pcodeop repeat_block;
define pcodeop software_interrupt;

macro nz(r) {
	N = r s< 0;
	Z = r == 0;
}

macro logicFlags(r) {
	nz(r);
	V = 0;
	UF = 0;
}

macro fflags(r) {
	N = ti_is_negative(r);
	Z = ti_is_zero(r);
	V = 0;
	UF = 0;
}

macro addOp(d, a, b, ci) {
	local s:8 = zext(a) + zext(b) + zext(ci);
	local r:4 = s:4;
	C = (s >> 32) != 0;
	V = ((a ^ r) & (b ^ r)) s< 0;
	LV = LV | V;
	UF = 0;
	nz(r);
	d = r;
}

macro subOp(d, a, b, bi) {
	local s:8 = zext(a) - zext(b) - zext(bi);
	local r:4 = s:4;
	C = (s >> 32) != 0;
	V = ((a ^ b) & (a ^ r)) s< 0;
	LV = LV | V;
	UF = 0;
	nz(r);
	d = r;
}

macro mpyOp(d, a, b) {
	local x:3 = a:3;
	local y:3 = b:3;
	local p:8 = sext(x) * sext(y);
	local r:4 = p:4;
	V = (sext(r) != p);
	LV = LV | V;
	UF = 0;
	nz(r);
	d = r;
}

macro shiftOp(d, a, cnt, arith) {
	local c:1 = cnt:1;
	c = (c << 1) s>> 1;
	local v:4 = a;
	local r:4 = v;
	if (c s< 0) goto <right>;
	if (c == 0) goto <done>;
	C = ((v >> zext(32 - c)) & 1) != 0;
	r = v << zext(c);
	goto <done>;
<right>
	local m:1 = -c;
	C = ((v >> zext(m - 1)) & 1) != 0;
	r = v >> zext(m);
	if (arith == 0) goto <done>;
	r = v s>> zext(m);
<done>
	V = 0;
	UF = 0;
	nz(r);
	d = r;
}

macro push(v) {
	SP = SP + 1;
	*:4 SP = v;
}

macro pop(v) {
	v = *:4 SP;
	SP = SP - 1;
}

cc: cond5 is cn5=1 & cond5 { local f:1 = C != 0; export f; }
cc: cond5 is cn5=2 & cond5 { local f:1 = (C != 0) || (Z != 0); export f; }
cc: cond5 is cn5=3 & cond5 { local f:1 = (C == 0) && (Z == 0); export f; }
cc: cond5 is cn5=4 & cond5 { local f:1 = C == 0; export f; }
cc: cond5 is cn5=5 & cond5 { local f:1 = Z != 0; export f; }
cc: cond5 is cn5=6 & cond5 { local f:1 = Z == 0; export f; }
cc: cond5 is cn5=7 & cond5 { local f:1 = N != 0; export f; }
cc: cond5 is cn5=8 & cond5 { local f:1 = (N != 0) || (Z != 0); export f; }
cc: cond5 is cn5=9 & cond5 { local f:1 = (N == 0) && (Z == 0); export f; }
cc: cond5 is cn5=10 & cond5 { local f:1 = N == 0; export f; }
cc: cond5 is cn5=12 & cond5 { local f:1 = V == 0; export f; }
cc: cond5 is cn5=13 & cond5 { local f:1 = V != 0; export f; }
cc: cond5 is cn5=14 & cond5 { local f:1 = UF == 0; export f; }
cc: cond5 is cn5=15 & cond5 { local f:1 = UF != 0; export f; }
cc: cond5 is cn5=16 & cond5 { local f:1 = LV == 0; export f; }
cc: cond5 is cn5=17 & cond5 { local f:1 = LV != 0; export f; }
cc: cond5 is cn5=18 & cond5 { local f:1 = LUF == 0; export f; }
cc: cond5 is cn5=19 & cond5 { local f:1 = LUF != 0; export f; }
cc: cond5 is cn5=20 & cond5 { local f:1 = (Z != 0) || (UF != 0); export f; }
lc: lcond is lcn=0 & lcond { local f:1 = 1; export f; }
lc: lcond is lcn=1 & lcond { local f:1 = C != 0; export f; }
lc: lcond is lcn=2 & lcond { local f:1 = (C != 0) || (Z != 0); export f; }
lc: lcond is lcn=3 & lcond { local f:1 = (C == 0) && (Z == 0); export f; }
lc: lcond is lcn=4 & lcond { local f:1 = C == 0; export f; }
lc: lcond is lcn=5 & lcond { local f:1 = Z != 0; export f; }
lc: lcond is lcn=6 & lcond { local f:1 = Z == 0; export f; }
lc: lcond is lcn=7 & lcond { local f:1 = N != 0; export f; }
lc: lcond is lcn=8 & lcond { local f:1 = (N != 0) || (Z != 0); export f; }
lc: lcond is lcn=9 & lcond { local f:1 = (N == 0) && (Z == 0); export f; }
lc: lcond is lcn=10 & lcond { local f:1 = N == 0; export f; }
lc: lcond is lcn=12 & lcond { local f:1 = V == 0; export f; }
lc: lcond is lcn=13 & lcond { local f:1 = V != 0; export f; }
lc: lcond is lcn=14 & lcond { local f:1 = UF == 0; export f; }
lc: lcond is lcn=15 & lcond { local f:1 = UF != 0; export f; }
lc: lcond is lcn=16 & lcond { local f:1 = LV == 0; export f; }
lc: lcond is lcn=17 & lcond { local f:1 = LV != 0; export f; }
lc: lcond is lcn=18 & lcond { local f:1 = LUF == 0; export f; }
lc: lcond is lcn=19 & lcond { local f:1 = LUF != 0; export f; }
lc: lcond is lcn=20 & lcond { local f:1 = (Z != 0) || (UF != 0); export f; }
ind8: "*+"^iar^"("^idisp^")" is imod=0 & iar & idisp { local a:4 = iar + idisp; export *:4 a; }
ind8: "*-"^iar^"("^idisp^")" is imod=1 & iar & idisp { local a:4 = iar - idisp; export *:4 a; }
ind8: "*++"^iar^"("^idisp^")" is imod=2 & iar & idisp { iar = iar + idisp; local a:4 = iar; export *:4 a; }
ind8: "*--"^iar^"("^idisp^")" is imod=3 & iar & idisp { iar = iar - idisp; local a:4 = iar; export *:4 a; }
ind8: "*"^iar^"++("^idisp^")" is imod=4 & iar & idisp { local a:4 = iar; iar = iar + idisp; export *:4 a; }
ind8: "*"^iar^"--("^idisp^")" is imod=5 & iar & idisp { local a:4 = iar; iar = iar - idisp; export *:4 a; }
ind8: "*"^iar^"++("^idisp^")%" is imod=6 & iar & idisp { local a:4 = iar; local dd:4 = idisp; iar = circular_add(iar, dd, BK); export *:4 a; }
ind8: "*"^iar^"--("^idisp^")%" is imod=7 & iar & idisp { local a:4 = iar; local nd:4 = idisp; nd = -nd; iar = circular_add(iar, nd, BK); export *:4 a; }
ind8: "*+"^iar^"(IR0)" is imod=8 & iar & idisp { local a:4 = iar + IR0; export *:4 a; }
ind8: "*-"^iar^"(IR0)" is imod=9 & iar & idisp { local a:4 = iar - IR0; export *:4 a; }
ind8: "*++"^iar^"(IR0)" is imod=10 & iar & idisp { iar = iar + IR0; local a:4 = iar; export *:4 a; }
ind8: "*--"^iar^"(IR0)" is imod=11 & iar & idisp { iar = iar - IR0; local a:4 = iar; export *:4 a; }
ind8: "*"^iar^"++(IR0)" is imod=12 & iar & idisp { local a:4 = iar; iar = iar + IR0; export *:4 a; }
ind8: "*"^iar^"--(IR0)" is imod=13 & iar & idisp { local a:4 = iar; iar = iar - IR0; export *:4 a; }
ind8: "*"^iar^"++(IR0)%" is imod=14 & iar & idisp { local a:4 = iar; iar = circular_add(iar, IR0, BK); export *:4 a; }
ind8: "*"^iar^"--(IR0)%" is imod=15 & iar & idisp { local a:4 = iar; local nd:4 = IR0; nd = -nd; iar = circular_add(iar, nd, BK); export *:4 a; }
ind8: "*+"^iar^"(IR1)" is imod=16 & iar & idisp { local a:4 = iar + IR1; export *:4 a; }
ind8: "*-"^iar^"(IR1)" is imod=17 & iar & idisp { local a:4 = iar - IR1; export *:4 a; }
ind8: "*++"^iar^"(IR1)" is imod=18 & iar & idisp { iar = iar + IR1; local a:4 = iar; export *:4 a; }
ind8: "*--"^iar^"(IR1)" is imod=19 & iar & idisp { iar = iar - IR1; local a:4 = iar; export *:4 a; }
ind8: "*"^iar^"++(IR1)" is imod=20 & iar & idisp { local a:4 = iar; iar = iar + IR1; export *:4 a; }
ind8: "*"^iar^"--(IR1)" is imod=21 & iar & idisp { local a:4 = iar; iar = iar - IR1; export *:4 a; }
ind8: "*"^iar^"++(IR1)%" is imod=22 & iar & idisp { local a:4 = iar; iar = circular_add(iar, IR1, BK); export *:4 a; }
ind8: "*"^iar^"--(IR1)%" is imod=23 & iar & idisp { local a:4 = iar; local nd:4 = IR1; nd = -nd; iar = circular_add(iar, nd, BK); export *:4 a; }
ind8: "*"^iar is imod=24 & iar { export *:4 iar; }
ind8: "*"^iar^"++(IR0)B" is imod=25 & iar { local a:4 = iar; iar = bit_reversed_add(iar, IR0); export *:4 a; }
indHi: "*+"^har^"(1)" is hmod=0 & har { local a:4 = har + 1; export *:4 a; }
indHi: "*-"^har^"(1)" is hmod=1 & har { local a:4 = har - 1; export *:4 a; }
indHi: "*++"^har^"(1)" is hmod=2 & har { har = har + 1; local a:4 = har; export *:4 a; }
indHi: "*--"^har^"(1)" is hmod=3 & har { har = har - 1; local a:4 = har; export *:4 a; }
indHi: "*"^har^"++(1)" is hmod=4 & har { local a:4 = har; har = har + 1; export *:4 a; }
indHi: "*"^har^"--(1)" is hmod=5 & har { local a:4 = har; har = har - 1; export *:4 a; }
indHi: "*"^har^"++(1)%" is hmod=6 & har { local a:4 = har; local dd:4 = 1; har = circular_add(har, dd, BK); export *:4 a; }
indHi: "*"^har^"--(1)%" is hmod=7 & har { local a:4 = har; local nd:4 = 1; nd = -nd; har = circular_add(har, nd, BK); export *:4 a; }
indHi: "*+"^har^"(IR0)" is hmod=8 & har { local a:4 = har + IR0; export *:4 a; }
indHi: "*-"^har^"(IR0)" is hmod=9 & har { local a:4 = har - IR0; export *:4 a; }
indHi: "*++"^har^"(IR0)" is hmod=10 & har { har = har + IR0; local a:4 = har; export *:4 a; }
indHi: "*--"^har^"(IR0)" is hmod=11 & har { har = har - IR0; local a:4 = har; export *:4 a; }
indHi: "*"^har^"++(IR0)" is hmod=12 & har { local a:4 = har; har = har + IR0; export *:4 a; }
indHi: "*"^har^"--(IR0)" is hmod=13 & har { local a:4 = har; har = har - IR0; export *:4 a; }
indHi: "*"^har^"++(IR0)%" is hmod=14 & har { local a:4 = har; har = circular_add(har, IR0, BK); export *:4 a; }
indHi: "*"^har^"--(IR0)%" is hmod=15 & har { local a:4 = har; local nd:4 = IR0; nd = -nd; har = circular_add(har, nd, BK); export *:4 a; }
indHi: "*+"^har^"(IR1)" is hmod=16 & har { local a:4 = har + IR1; export *:4 a; }
indHi: "*-"^har^"(IR1)" is hmod=17 & har { local a:4 = har - IR1; export *:4 a; }
indHi: "*++"^har^"(IR1)" is hmod=18 & har { har = har + IR1; local a:4 = har; export *:4 a; }
indHi: "*--"^har^"(IR1)" is hmod=19 & har { har = har - IR1; local a:4 = har; export *:4 a; }
indHi: "*"^har^"++(IR1)" is hmod=20 & har { local a:4 = har; har = har + IR1; export *:4 a; }
indHi: "*"^har^"--(IR1)" is hmod=21 & har { local a:4 = har; har = har - IR1; export *:4 a; }
indHi: "*"^har^"++(IR1)%" is hmod=22 & har { local a:4 = har; har = circular_add(har, IR1, BK); export *:4 a; }
indHi: "*"^har^"--(IR1)%" is hmod=23 & har { local a:4 = har; local nd:4 = IR1; nd = -nd; har = circular_add(har, nd, BK); export *:4 a; }
indHi: "*"^har is hmod=24 & har { export *:4 har; }
indHi: "*"^har^"++(IR0)B" is hmod=25 & har { local a:4 = har; har = bit_reversed_add(har, IR0); export *:4 a; }
indLo: "*+"^lar^"(1)" is lmod=0 & lar { local a:4 = lar + 1; export *:4 a; }
indLo: "*-"^lar^"(1)" is lmod=1 & lar { local a:4 = lar - 1; export *:4 a; }
indLo: "*++"^lar^"(1)" is lmod=2 & lar { lar = lar + 1; local a:4 = lar; export *:4 a; }
indLo: "*--"^lar^"(1)" is lmod=3 & lar { lar = lar - 1; local a:4 = lar; export *:4 a; }
indLo: "*"^lar^"++(1)" is lmod=4 & lar { local a:4 = lar; lar = lar + 1; export *:4 a; }
indLo: "*"^lar^"--(1)" is lmod=5 & lar { local a:4 = lar; lar = lar - 1; export *:4 a; }
indLo: "*"^lar^"++(1)%" is lmod=6 & lar { local a:4 = lar; local dd:4 = 1; lar = circular_add(lar, dd, BK); export *:4 a; }
indLo: "*"^lar^"--(1)%" is lmod=7 & lar { local a:4 = lar; local nd:4 = 1; nd = -nd; lar = circular_add(lar, nd, BK); export *:4 a; }
indLo: "*+"^lar^"(IR0)" is lmod=8 & lar { local a:4 = lar + IR0; export *:4 a; }
indLo: "*-"^lar^"(IR0)" is lmod=9 & lar { local a:4 = lar - IR0; export *:4 a; }
indLo: "*++"^lar^"(IR0)" is lmod=10 & lar { lar = lar + IR0; local a:4 = lar; export *:4 a; }
indLo: "*--"^lar^"(IR0)" is lmod=11 & lar { lar = lar - IR0; local a:4 = lar; export *:4 a; }
indLo: "*"^lar^"++(IR0)" is lmod=12 & lar { local a:4 = lar; lar = lar + IR0; export *:4 a; }
indLo: "*"^lar^"--(IR0)" is lmod=13 & lar { local a:4 = lar; lar = lar - IR0; export *:4 a; }
indLo: "*"^lar^"++(IR0)%" is lmod=14 & lar { local a:4 = lar; lar = circular_add(lar, IR0, BK); export *:4 a; }
indLo: "*"^lar^"--(IR0)%" is lmod=15 & lar { local a:4 = lar; local nd:4 = IR0; nd = -nd; lar = circular_add(lar, nd, BK); export *:4 a; }
indLo: "*+"^lar^"(IR1)" is lmod=16 & lar { local a:4 = lar + IR1; export *:4 a; }
indLo: "*-"^lar^"(IR1)" is lmod=17 & lar { local a:4 = lar - IR1; export *:4 a; }
indLo: "*++"^lar^"(IR1)" is lmod=18 & lar { lar = lar + IR1; local a:4 = lar; export *:4 a; }
indLo: "*--"^lar^"(IR1)" is lmod=19 & lar { lar = lar - IR1; local a:4 = lar; export *:4 a; }
indLo: "*"^lar^"++(IR1)" is lmod=20 & lar { local a:4 = lar; lar = lar + IR1; export *:4 a; }
indLo: "*"^lar^"--(IR1)" is lmod=21 & lar { local a:4 = lar; lar = lar - IR1; export *:4 a; }
indLo: "*"^lar^"++(IR1)%" is lmod=22 & lar { local a:4 = lar; lar = circular_add(lar, IR1, BK); export *:4 a; }
indLo: "*"^lar^"--(IR1)%" is lmod=23 & lar { local a:4 = lar; local nd:4 = IR1; nd = -nd; lar = circular_add(lar, nd, BK); export *:4 a; }
indLo: "*"^lar is lmod=24 & lar { export *:4 lar; }
indLo: "*"^lar^"++(IR0)B" is lmod=25 & lar { local a:4 = lar; lar = bit_reversed_add(lar, IR0); export *:4 a; }

direct: "@"^src16 is src16 { local a:4 = (DP << 16) | src16; export *:4 a; }

srcInt: sint is g=0 & sint { export sint; }
srcInt: direct is g=1 & direct { export direct; }
srcInt: ind8 is g=2 & ind8 { export ind8; }
srcInt: "#"^simm16 is g=3 & simm16 { local v:4 = simm16; export v; }

srcUns: sint is g=0 & sint { export sint; }
srcUns: direct is g=1 & direct { export direct; }
srcUns: ind8 is g=2 & ind8 { export ind8; }
srcUns: "#"^src16 is g=3 & src16 { local v:4 = src16; export v; }

srcFlt: sflt is g=0 & sflt { export sflt; }
srcFlt: direct is g=1 & direct { local v:8 = ti_ldf32(direct); export v; }
srcFlt: ind8 is g=2 & ind8 { local v:8 = ti_ldf32(ind8); export v; }
srcFlt: "#"^src16 is g=3 & src16 { local h:2 = src16; local v:8 = ti_short_float(h); export v; }

memEA: direct is g=1 & direct { export direct; }
memEA: ind8 is g=2 & ind8 { export ind8; }

s1i: s1int is tb22=0 & s1int { export s1int; }
s1i: indHi is tb22=1 & indHi { export indHi; }
s2i: sint is tb21=0 & sint { export sint; }
s2i: indLo is tb21=1 & indLo { export indLo; }
s1f: s1flt is tb22=0 & s1flt { export s1flt; }
s1f: indHi is tb22=1 & indHi { local v:8 = ti_ldf32(indHi); export v; }
s2f: sflt is tb21=0 & sflt { export sflt; }
s2f: indLo is tb21=1 & indLo { local v:8 = ti_ldf32(indLo); export v; }

brel: a is simm16 [ a = inst_next + simm16; ] { export *:4 a; }
breld: a is simm16 [ a = inst_start + 3 + simm16; ] { export *:4 a; }
babs: addr24 is addr24 { export *:4 addr24; }

:ABSF srcFlt, dflt is cls=0 & opc6=0x0 & srcFlt & dflt { local r:8 = ti_absf(srcFlt); dflt = r; fflags(r); }
:ABSI srcInt, dint is cls=0 & opc6=0x1 & srcInt & dint { local s:4 = srcInt; local r:4 = s; if (s s>= 0) goto <p>; r = -s; <p> V = s == 0x80000000; LV = LV | V; UF = 0; nz(r); dint = r; }
:ADDC srcInt, dint is cls=0 & opc6=0x2 & srcInt & dint { addOp(dint, dint, srcInt, C); }
:ADDF srcFlt, dflt is cls=0 & opc6=0x3 & srcFlt & dflt { local r:8 = ti_addf(dflt, srcFlt); dflt = r; fflags(r); }
:ADDI srcInt, dint is cls=0 & opc6=0x4 & srcInt & dint { local z:1 = 0; addOp(dint, dint, srcInt, z); }
:AND srcUns, dint is cls=0 & opc6=0x5 & srcUns & dint { local r:4 = dint & srcUns; logicFlags(r); dint = r; }
:ANDN srcUns, dint is cls=0 & opc6=0x6 & srcUns & dint { local r:4 = dint & ~srcUns; logicFlags(r); dint = r; }
:ASH srcInt, dint is cls=0 & opc6=0x7 & srcInt & dint { shiftOp(dint, dint, srcInt, 1:1); }
:CMPF srcFlt, dflt is cls=0 & opc6=0x8 & srcFlt & dflt { local r:8 = ti_subf(dflt, srcFlt); fflags(r); }
:CMPI srcInt, dint is cls=0 & opc6=0x9 & srcInt & dint { local z:1 = 0; local t:4 = 0; subOp(t, dint, srcInt, z); }
:FIX srcFlt, dint is cls=0 & opc6=0xa & srcFlt & dint { local r:4 = ti_fix(srcFlt); dint = r; nz(r); }
:FLOAT srcInt, dflt is cls=0 & opc6=0xb & srcInt & dflt { local r:8 = ti_float(srcInt); dflt = r; fflags(r); }
:LDE srcFlt, dflt is cls=0 & opc6=0xd & srcFlt & dflt { dflt = ti_lde(dflt, srcFlt); }
:LDF srcFlt, dflt is cls=0 & opc6=0xe & srcFlt & dflt { local r:8 = srcFlt; dflt = r; fflags(r); }
:LDFI srcFlt, dflt is cls=0 & opc6=0xf & srcFlt & dflt { local r:8 = srcFlt; dflt = r; fflags(r); interlocked_load(); }
:LDI srcInt, dint is cls=0 & opc6=0x10 & srcInt & dint { local r:4 = srcInt; dint = r; logicFlags(r); }
:LDII srcInt, dint is cls=0 & opc6=0x11 & srcInt & dint { local r:4 = srcInt; dint = r; logicFlags(r); interlocked_load(); }
:LDM srcFlt, dflt is cls=0 & opc6=0x12 & srcFlt & dflt { dflt = ti_ldm(dflt, srcFlt); }
:LSH srcInt, dint is cls=0 & opc6=0x13 & srcInt & dint { shiftOp(dint, dint, srcInt, 0:1); }
:MPYF srcFlt, dflt is cls=0 & opc6=0x14 & srcFlt & dflt { local r:8 = ti_mpyf(dflt, srcFlt); dflt = r; fflags(r); }
:MPYI srcInt, dint is cls=0 & opc6=0x15 & srcInt & dint { mpyOp(dint, dint, srcInt); }
:NEGB srcInt, dint is cls=0 & opc6=0x16 & srcInt & dint { local z:4 = 0; subOp(dint, z, srcInt, C); }
:NEGF srcFlt, dflt is cls=0 & opc6=0x17 & srcFlt & dflt { local r:8 = ti_negf(srcFlt); dflt = r; fflags(r); }
:NEGI srcInt, dint is cls=0 & opc6=0x18 & srcInt & dint { local z:4 = 0; local zb:1 = 0; subOp(dint, z, srcInt, zb); }
:NORM srcFlt, dflt is cls=0 & opc6=0x1a & srcFlt & dflt { local r:8 = ti_norm(srcFlt); dflt = r; fflags(r); }
:NOT srcUns, dint is cls=0 & opc6=0x1b & srcUns & dint { local r:4 = ~srcUns; logicFlags(r); dint = r; }
:OR srcUns, dint is cls=0 & opc6=0x20 & srcUns & dint { local r:4 = dint | srcUns; logicFlags(r); dint = r; }
:RND srcFlt, dflt is cls=0 & opc6=0x21 & srcFlt & dflt { local r:8 = ti_rnd(srcFlt); dflt = r; fflags(r); }
:SIGI srcInt, dint is cls=0 & opc6=0x2b & srcInt & dint { signal_interlock(); local r:4 = srcInt; dint = r; }
:SUBB srcInt, dint is cls=0 & opc6=0x2c & srcInt & dint { subOp(dint, dint, srcInt, C); }
:SUBF srcFlt, dflt is cls=0 & opc6=0x2e & srcFlt & dflt { local r:8 = ti_subf(dflt, srcFlt); dflt = r; fflags(r); }
:SUBI srcInt, dint is cls=0 & opc6=0x2f & srcInt & dint { local z:1 = 0; subOp(dint, dint, srcInt, z); }
:SUBRB srcInt, dint is cls=0 & opc6=0x30 & srcInt & dint { subOp(dint, srcInt, dint, C); }
:SUBRF srcFlt, dflt is cls=0 & opc6=0x31 & srcFlt & dflt { local r:8 = ti_subf(srcFlt, dflt); dflt = r; fflags(r); }
:SUBRI srcInt, dint is cls=0 & opc6=0x32 & srcInt & dint { local z:1 = 0; subOp(dint, srcInt, dint, z); }
:TSTB srcUns, dint is cls=0 & opc6=0x33 & srcUns & dint { local r:4 = dint & srcUns; logicFlags(r); }
:XOR srcUns, dint is cls=0 & opc6=0x34 & srcUns & dint { local r:4 = dint ^ srcUns; logicFlags(r);  dint = r; }
:SUBC srcInt, dint is cls=0 & opc6=0x2d & srcInt & dint {
	local s:4 = srcInt;
	local t:4 = dint - s;
	if (t s< 0) goto <shift>;
	dint = (t << 1) | 1;
	goto <done>;
<shift>
	dint = dint << 1;
<done>
}
:IDLE is cls=0 & opc6=0x0c { GIE = 1; idle(); }
:NOP is cls=0 & opc6=0x19 & g=0 { }
:NOP ind8 is cls=0 & opc6=0x19 & g=2 & ind8 { local t:4 = ind8; }
:POP dint is cls=0 & opc6=0x1c & dint { local v:4; pop(v); dint = v; logicFlags(v); }
:POPF dflt is cls=0 & opc6=0x1d & dflt { local v:4; pop(v); local r:8 = ti_ldf32(v); dflt = r; fflags(r); }
:PUSH dint is cls=0 & opc6=0x1e & dint { push(dint); }
:PUSHF dflt is cls=0 & opc6=0x1f & dflt { local v:4 = ti_stf32(dflt); push(v); }
:ROL dint is cls=0 & opc6=0x22 & dint { local v:4 = dint; C = (v >> 31) != 0; dint = (v << 1) | (v >> 31); logicFlags(dint); }
:ROLC dint is cls=0 & opc6=0x23 & dint { local v:4 = dint; local c:4 = zext(C); C = (v >> 31) != 0; dint = (v << 1) | c; logicFlags(dint); }
:ROR dint is cls=0 & opc6=0x24 & dint { local v:4 = dint; C = (v & 1) != 0; dint = (v >> 1) | (v << 31); logicFlags(dint); }
:RORC dint is cls=0 & opc6=0x25 & dint { local v:4 = dint; local c:4 = zext(C); C = (v & 1) != 0; dint = (v >> 1) | (c << 31); logicFlags(dint); }
:RPTS srcUns is cls=0 & opc6=0x26 & srcUns { RC = srcUns; RS = inst_next; RE = inst_next; repeat_single(RC); }
:STF dflt, memEA is cls=0 & opc6=0x27 & dflt & memEA { memEA = ti_stf32(dflt); }
:STFI dflt, memEA is cls=0 & opc6=0x28 & dflt & memEA { memEA = ti_stf32(dflt); interlocked_store(); }
:STI dint, memEA is cls=0 & opc6=0x29 & dint & memEA { memEA = dint; }
:STII dint, memEA is cls=0 & opc6=0x2a & dint & memEA { memEA = dint; interlocked_store(); }
:IACK memEA is cls=0 & opc6=0x35 & memEA { interrupt_acknowledge(memEA); }

:LDF^lc srcFlt, dflt is top4=4 & lc & srcFlt & dflt { if (!lc) goto inst_next; dflt = srcFlt; }
:LDI^lc srcInt, dint is top4=5 & lc & srcInt & dint { if (!lc) goto inst_next; dint = srcInt; }

:ADDC3 s2i, s1i, dint is cls=1 & opc6=0x0 & s1i & s2i & dint { addOp(dint, s1i, s2i, C); }
:ADDF3 s2f, s1f, dflt is cls=1 & opc6=0x1 & s1f & s2f & dflt { local r:8 = ti_addf(s1f, s2f); dflt = r; fflags(r); }
:ADDI3 s2i, s1i, dint is cls=1 & opc6=0x2 & s1i & s2i & dint { local z:1 = 0; addOp(dint, s1i, s2i, z); }
:AND3 s2i, s1i, dint is cls=1 & opc6=0x3 & s1i & s2i & dint { local r:4 = s1i & s2i; logicFlags(r); dint = r; }
:ANDN3 s2i, s1i, dint is cls=1 & opc6=0x4 & s1i & s2i & dint { local r:4 = s1i & ~s2i; logicFlags(r); dint = r; }
:ASH3 s2i, s1i, dint is cls=1 & opc6=0x5 & s1i & s2i & dint { shiftOp(dint, s1i, s2i, 1:1); }
:CMPF3 s2f, s1f is cls=1 & opc6=0x6 & s1f & s2f { local r:8 = ti_subf(s1f, s2f); fflags(r); }
:CMPI3 s2i, s1i is cls=1 & opc6=0x7 & s1i & s2i { local z:1 = 0; local t:4 = 0; subOp(t, s1i, s2i, z); }
:LSH3 s2i, s1i, dint is cls=1 & opc6=0x8 & s1i & s2i & dint { shiftOp(dint, s1i, s2i, 0:1); }
:MPYF3 s2f, s1f, dflt is cls=1 & opc6=0x9 & s1f & s2f & dflt { local r:8 = ti_mpyf(s1f, s2f); dflt = r; fflags(r); }
:MPYI3 s2i, s1i, dint is cls=1 & opc6=0xa & s1i & s2i & dint { mpyOp(dint, s1i, s2i); }
:OR3 s2i, s1i, dint is cls=1 & opc6=0xb & s1i & s2i & dint { local r:4 = s1i | s2i; logicFlags(r); dint = r; }
:SUBB3 s2i, s1i, dint is cls=1 & opc6=0xc & s1i & s2i & dint { subOp(dint, s1i, s2i, C); }
:SUBF3 s2f, s1f, dflt is cls=1 & opc6=0xd & s1f & s2f & dflt { local r:8 = ti_subf(s1f, s2f); dflt = r; fflags(r); }
:SUBI3 s2i, s1i, dint is cls=1 & opc6=0xe & s1i & s2i & dint { local z:1 = 0; subOp(dint, s1i, s2i, z); }
:TSTB3 s2i, s1i is cls=1 & opc6=0xf & s1i & s2i { local r:4 = s1i & s2i; logicFlags(r); }
:XOR3 s2i, s1i, dint is cls=1 & opc6=0x10 & s1i & s2i & dint { local r:4 = s1i ^ s2i; logicFlags(r); dint = r; }
:ABSF indLo, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0x4 & indLo & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = ti_absf(v2); fflags(r); pd1x = r; indHi = sv; }
:ABSI indLo, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x5 & indLo & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2; if (v2 s>= 0) goto <p>; r = -v2; <p> logicFlags(r); pd1 = r; indHi = sv; }
:ADDF3 indLo, ps1x, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0x6 & indLo & ps1x & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = ti_addf(v2, ps1x); fflags(r); pd1x = r; indHi = sv; }
:ADDI3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x7 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2 + ps1; logicFlags(r); pd1 = r; indHi = sv; }
:AND3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x8 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2 & ps1; logicFlags(r); pd1 = r; indHi = sv; }
:ASH3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x9 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4; shiftOp(r, ps1, v2, 1:1);  pd1 = r; indHi = sv; }
:FIX indLo, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0xa & indLo & pd1 & ps3 & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ps3; local r:4 = ti_fix(v2); logicFlags(r); pd1 = r; indHi = sv; }
:FLOAT indLo, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0xb & indLo & pd1x & ps3x & indHi { local v2:4 = indLo; local sv:4 = ti_stf32(ps3x); local r:8 = ti_float(v2); fflags(r); pd1x = r; indHi = sv; }
:LDF indLo, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0xc & indLo & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = v2; fflags(r); pd1x = r; indHi = sv; }
:LDI indLo, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0xd & indLo & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2; logicFlags(r); pd1 = r; indHi = sv; }
:LSH3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0xe & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4; shiftOp(r, ps1, v2, 0:1);  pd1 = r; indHi = sv; }
:MPYF3 indLo, ps1x, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0xf & indLo & ps1x & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = ti_mpyf(v2, ps1x); fflags(r); pd1x = r; indHi = sv; }
:MPYI3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x10 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4; mpyOp(r, v2, ps1);  pd1 = r; indHi = sv; }
:NEGF indLo, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0x11 & indLo & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = ti_negf(v2); fflags(r); pd1x = r; indHi = sv; }
:NEGI indLo, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x12 & indLo & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = -v2; logicFlags(r); pd1 = r; indHi = sv; }
:NOT indLo, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x13 & indLo & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = ~v2; logicFlags(r); pd1 = r; indHi = sv; }
:OR3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x14 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2 | ps1; logicFlags(r); pd1 = r; indHi = sv; }
:SUBF3 indLo, ps1x, pd1x "||" "STF" ps3x, indHi is cls2=3 & popc=0x15 & indLo & ps1x & pd1x & ps3x & indHi { local v2:8 = ti_ldf32(indLo); local sv:4 = ti_stf32(ps3x); local r:8 = ti_subf(ps1x, v2); fflags(r); pd1x = r; indHi = sv; }
:SUBI3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x16 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = ps1 - v2; logicFlags(r); pd1 = r; indHi = sv; }
:XOR3 indLo, ps1, pd1 "||" "STI" ps3, indHi is cls2=3 & popc=0x17 & indLo & ps1 & pd1 & ps3 & indHi { local v2:4 = indLo; local sv:4 = ps3; local r:4 = v2 ^ ps1; logicFlags(r); pd1 = r; indHi = sv; }

:BR babs is top8=0x60 & babs { goto babs; }
:BRD babs is top8=0x61 & babs { delayslot(12); goto babs; }
:CALL babs is top8=0x62 & babs { local ret:4 = inst_next; push(ret); call babs; }
:RPTB babs is top8=0x64 & babs { RS = inst_next; RE = &babs; repeat_block(RC); }
:SWI is top8=0x66 { software_interrupt(); }

:B^cc brel is top6=0x1a & bbit=1 & dbit=0 & cc & brel { if (cc) goto brel; }
:B^cc^"D" breld is top6=0x1a & bbit=1 & dbit=1 & cc & breld { local f:1 = cc; delayslot(12); if (f) goto breld; }
:B^cc sint is top6=0x1a & bbit=0 & dbit=0 & cc & sint { if (!cc) goto inst_next; goto [sint]; }
:B^cc^"D" sint is top6=0x1a & bbit=0 & dbit=1 & cc & sint { local f:1 = cc; local t:4 = sint; delayslot(12); if (!f) goto inst_next; goto [t]; }
:BU brel is top6=0x1a & bbit=1 & dbit=0 & cn5=0 & brel { goto brel; }
:BU sint is top6=0x1a & bbit=0 & dbit=0 & cn5=0 & sint { goto [sint]; }

:DB^cc dbar, brel is top6=0x1b & bbit=1 & dbit=0 & dbar & cc & brel { dbar = dbar - 1; if ((dbar s>= 0) && cc) goto brel; }
:DB^cc^"D" dbar, breld is top6=0x1b & bbit=1 & dbit=1 & dbar & cc & breld { dbar = dbar - 1; local f:1 = (dbar s>= 0) && cc; delayslot(12); if (f) goto breld; }
:DB^cc dbar, sint is top6=0x1b & bbit=0 & dbit=0 & dbar & cc & sint { dbar = dbar - 1; if (!((dbar s>= 0) && cc)) goto inst_next; goto [sint]; }

:CALL^cc brel is top6=0x1c & bbit=1 & cc & brel { if (!cc) goto inst_next; local ret:4 = inst_next; push(ret); call brel; }
:CALL^cc sint is top6=0x1c & bbit=0 & cc & sint { if (!cc) goto inst_next; local ret:4 = inst_next; push(ret); call [sint]; }

:TRAP^cc tvec is top6=0x1d & cc & tbit5=1 & tvec { if (!cc) goto inst_next; GIE = 0; local ret:4 = inst_next; push(ret); local va:4 = 0x20 + tvec; local t:4 = *:4 va; call [t]; }

:RETI^cc is top9=0xf0 & cc { if (!cc) goto inst_next; GIE = 1; local r:4; pop(r); return [r]; }
:RETS^cc is top9=0xf1 & cc { if (!cc) goto inst_next; local r:4; pop(r); return [r]; }
:RETIU is top9=0xf0 & cn5=0 { GIE = 1; local r:4; pop(r); return [r]; }
:RETSU is top9=0xf1 & cn5=0 { local r:4; pop(r); return [r]; }

:BUD breld is top6=0x1a & bbit=1 & dbit=1 & cn5=0 & breld { delayslot(12); goto breld; }
:BUD sint is top6=0x1a & bbit=0 & dbit=1 & cn5=0 & sint { local t:4 = sint; delayslot(12); goto [t]; }
:DBU dbar, brel is top6=0x1b & bbit=1 & dbit=0 & dbar & cn5=0 & brel { dbar = dbar - 1; if (dbar s>= 0) goto brel; }
:DBUD dbar, breld is top6=0x1b & bbit=1 & dbit=1 & dbar & cn5=0 & breld { dbar = dbar - 1; local f:1 = dbar s>= 0; delayslot(12); if (f) goto breld; }
:DBU dbar, sint is top6=0x1b & bbit=0 & dbit=0 & dbar & cn5=0 & sint { dbar = dbar - 1; if (dbar s< 0) goto inst_next; goto [sint]; }
:CALLU brel is top6=0x1c & bbit=1 & cn5=0 & brel { local ret:4 = inst_next; push(ret); call brel; }
:CALLU sint is top6=0x1c & bbit=0 & cn5=0 & sint { local ret:4 = inst_next; push(ret); call [sint]; }
:TRAPU tvec is top6=0x1d & cn5=0 & tbit5=1 & tvec { GIE = 0; local ret:4 = inst_next; push(ret); local va:4 = 0x20 + tvec; local t:4 = *:4 va; call [t]; }
