# V8 Ignition bytecode, as built into V8 13.6 (Node.js 24). Written for unlace from V8's
# src/interpreter/bytecodes.h and bytecode-operands.h (BSD-3-Clause; the opcode order,
# operand types and implicit accumulator use are read from them, no text copied) and checked
# against node --print-bytecode. Ignition is an accumulator machine: ACC is the implicit
# operand, frame registers r0.. and parameters a0.. (and the receiver) are explicit ones.
# Wide and ExtraWide prefixes scale the scalable operands to 2 and 4 bytes; a scaled
# register operand addresses the frame space. Values are 8-byte tagged references, Smi
# immediates are plain integers, and property access, calls, operators and the runtime are
# user-ops.

define endian=little;
define alignment=1;

define space ram   type=ram_space      size=4 default;
define space frame type=ram_space      size=4;
define space register type=register_space size=4;

define register offset=0x0000 size=4 [ PC ];
define register offset=0x0010 size=8 [ ACC RV ];
define register offset=0x1000 size=8 [ fx0 fx1 this a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 a32 a33 a34 a35 a36 a37 a38 a39 a40 a41 a42 a43 a44 a45 a46 a47 a48 a49 a50 a51 a52 a53 a54 a55 a56 a57 a58 a59 a60 a61 a62 a63 a64 a65 a66 a67 a68 a69 a70 a71 a72 a73 a74 a75 a76 a77 a78 a79 a80 a81 a82 a83 a84 a85 a86 a87 a88 a89 a90 a91 a92 a93 a94 a95 a96 a97 a98 a99 a100 a101 a102 a103 a104 a105 a106 a107 a108 a109 a110 a111 a112 a113 a114 a115 a116 a117 a118 a119 a120 a121 a122 a123 a124 r121 r120 r119 r118 r117 r116 r115 r114 r113 r112 r111 r110 r109 r108 r107 r106 r105 r104 r103 r102 r101 r100 r99 r98 r97 r96 r95 r94 r93 r92 r91 r90 r89 r88 r87 r86 r85 r84 r83 r82 r81 r80 r79 r78 r77 r76 r75 r74 r73 r72 r71 r70 r69 r68 r67 r66 r65 r64 r63 r62 r61 r60 r59 r58 r57 r56 r55 r54 r53 r52 r51 r50 r49 r48 r47 r46 r45 r44 r43 r42 r41 r40 r39 r38 r37 r36 r35 r34 r33 r32 r31 r30 r29 r28 r27 r26 r25 r24 r23 r22 r21 r20 r19 r18 r17 r16 r15 r14 r13 r12 r11 r10 r9 r8 r7 r6 r5 r4 r3 r2 r1 r0 fm6 fm5 fm4 fm3 fm2 fm1 ];
define register offset=0x2000 size=4 [ contextreg ];

define context contextreg
  scale = (0,1)
;

define token opc(8)
  op = (0,7)
;

define token t8_1(8)
  u8_1 = (0,7)
  s8_1 = (0,7) signed
  r8_1 = (0,7)
;
define token t16_1(16)
  u16_1 = (0,15)
  s16_1 = (0,15) signed
;
define token t32_1(32)
  u32_1 = (0,31)
  s32_1 = (0,31) signed
;
