<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
  <data_organization>
    <pointer_size value="4"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
  </data_organization>
  <stackpointer register="A0StP" space="ram" growth="positive"/>
  <returnaddress>
    <register name="D1RtP"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4"><register name="D1Ar1"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar2"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D1Ar3"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar4"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D1Ar5"/></pentry>
        <pentry minsize="1" maxsize="4"><register name="D0Ar6"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4"><register name="D0Re0"/></pentry>
      </output>
      <unaffected>
        <register name="A0StP"/>
        <register name="A0FrP"/>
        <register name="A1GbP"/>
        <register name="A1LbP"/>
        <register name="D0.5"/>
        <register name="D0.6"/>
        <register name="D0.7"/>
        <register name="D1.5"/>
        <register name="D1.6"/>
        <register name="D1.7"/>
      </unaffected>
      <killedbycall>
        <register name="D1RtP"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
