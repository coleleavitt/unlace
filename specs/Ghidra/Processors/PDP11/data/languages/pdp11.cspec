<?xml version="1.0" encoding="UTF-8"?>

<!-- PDP-11 C calling convention (Unix V7 cc, GCC pdp11): arguments on the
     stack above the return address, result in R0 (R0:R1 for 32 bits, R0 high),
     R2-R5 preserved by the callee. -->
<compiler_spec>
  <data_organization>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="2"/>
      <entry size="8" alignment="2"/>
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__cdecl" extrapop="2" stackshift="2">
      <input>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="R0"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="R0" piece2="R1"/>
        </pentry>
      </output>
      <unaffected>
        <register name="R2"/>
        <register name="R3"/>
        <register name="R4"/>
        <register name="R5"/>
        <register name="SP"/>
      </unaffected>
      <killedbycall>
        <register name="R0"/>
        <register name="R1"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
